<%- include('../partials/app-start', { title: `${t('changePassword')} - BESTCRM`, activeNav: 'account-password' }) %>
        <header class="page-header">
          <div>
            <div class="eyebrow"><%= t('accountSecurity') %></div>
            <h1><%= t('changePassword') %></h1>
            <p class="muted"><%= t('changePasswordDescription') %></p>
          </div>
        </header>

        <form class="form-panel" method="post" action="/account/password">
          <%- csrfField() %>
          <% if (error) { %>
            <p class="error-text" role="alert"><%= error %></p>
          <% } %>

          <label>
            <%= t('currentPassword') %>
            <input name="currentPassword" type="password" autocomplete="current-password" required>
          </label>
          <label>
            <%= t('newPassword') %>
            <input
              name="newPassword"
              type="password"
              autocomplete="new-password"
              minlength="6"
              maxlength="128"
              aria-describedby="password-requirements"
              required
            >
          </label>
          <label>
            <%= t('confirmNewPassword') %>
            <input
              name="confirmPassword"
              type="password"
              autocomplete="new-password"
              minlength="6"
              maxlength="128"
              required
            >
          </label>
          <p id="password-requirements" class="muted"><%= t('passwordRequirements') %></p>

          <div class="inline-actions">
            <button type="submit"><%= t('changePassword') %></button>
            <a class="secondary-action" href="/workbench"><%= t('cancel') %></a>
          </div>
        </form>
<%- include('../partials/app-end') %>
