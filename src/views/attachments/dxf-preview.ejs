<%- include('../partials/app-start', { title: `${attachment.originalName} - ${t('preview')} - BESTCRM`, activeNav }) %>
        <%
          const previewContextLabelKey = typeof contextLabelKey !== 'undefined' ? contextLabelKey : 'opportunities';
          const previewContextText = typeof contextText !== 'undefined' ? contextText : `${opportunity.opportunityNo} - ${opportunity.title}`;
          const previewBackUrl = typeof backUrl !== 'undefined' ? backUrl : `/opportunities/${opportunity.id}`;
          const previewBackLabelKey = typeof backLabelKey !== 'undefined' ? backLabelKey : 'backToOpportunity';
        %>
        <header class="page-header">
          <div>
            <div class="eyebrow"><%= t(previewContextLabelKey) %></div>
            <h1><%= t('cadPreview') %></h1>
            <div class="muted"><%= previewContextText %></div>
          </div>
          <div class="page-actions">
            <a class="quick-action secondary-action" href="<%= previewBackUrl %>"><%= t(previewBackLabelKey) %></a>
            <a class="quick-action" href="<%= downloadUrl %>"><%= t('download') %></a>
          </div>
        </header>

        <section class="content-section">
          <h2><%= attachment.originalName %></h2>
          <div class="section-body">
            <% if (preview.entityCount > 0) { %>
              <div class="cad-preview-frame">
                <%- preview.svg %>
              </div>
            <% } else { %>
              <p class="muted"><%= t('dxfNoDrawableEntities') %></p>
            <% } %>
          </div>
        </section>
<%- include('../partials/app-end') %>
