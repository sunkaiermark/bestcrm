<!doctype html>
<html lang="<%= typeof language === 'undefined' ? 'en' : language %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>BESTCRM <%= t('recoveryCodesTitle') %></title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f4f7fa;
        --panel: #ffffff;
        --line: #d8e1e8;
        --ink: #17212b;
        --muted: #647484;
        --accent: #0f766e;
        --accent-dark: #0b5f59;
        --warning-bg: #fff7ed;
        --warning: #9a3412;
        --danger-bg: #fef2f2;
        --danger: #991b1b;
      }

      * { box-sizing: border-box; }

      body {
        min-height: 100vh;
        margin: 0;
        background: linear-gradient(180deg, rgba(15, 118, 110, 0.08), rgba(15, 118, 110, 0)), var(--bg);
        color: var(--ink);
        font: 18px/1.5 system-ui, "Microsoft YaHei", sans-serif;
      }

      .recovery-shell { min-height: 100vh; display: grid; place-items: center; padding: 24px; }
      .recovery-card { width: min(100%, 650px); border: 1px solid var(--line); border-radius: 8px; background: var(--panel); box-shadow: 0 18px 48px rgba(23, 33, 43, 0.12); padding: 30px; }
      .login-logo { display: block; height: auto; margin: 0 auto 22px; max-width: 100%; width: 224px; }
      h1 { margin: 0 0 10px; font-size: 28px; font-weight: 650; }
      .introduction { margin: 0 0 18px; color: var(--muted); }
      .warning { margin: 0 0 18px; border: 1px solid #fed7aa; border-radius: 6px; background: var(--warning-bg); color: var(--warning); padding: 10px 12px; }
      .login-alert { margin: 0 0 18px; border: 1px solid #fecaca; border-radius: 6px; background: var(--danger-bg); color: var(--danger); padding: 9px 10px; }
      .recovery-code-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px 14px; margin: 18px 0; padding: 0; list-style: none; }
      .recovery-code { display: block; border: 1px solid var(--line); border-radius: 6px; background: #f8fafc; font: 600 17px/1.4 ui-monospace, Consolas, monospace; letter-spacing: 0.04em; padding: 9px 10px; text-align: center; }
      .utility-actions { display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 20px; }
      .utility-button { border: 1px solid var(--line); border-radius: 6px; background: #eef6ff; color: #0b3f78; cursor: pointer; font: inherit; padding: 7px 12px; }
      .acknowledgement { display: grid; gap: 14px; border-top: 1px solid var(--line); padding-top: 18px; }
      .checkbox-field { display: grid; grid-template-columns: 22px 1fr; gap: 9px; align-items: start; }
      .checkbox-field input { width: 20px; height: 20px; margin-top: 3px; }
      .login-button { width: 100%; min-height: 44px; border: 0; border-radius: 6px; background: var(--accent); color: white; cursor: pointer; font: inherit; font-weight: 650; }
      .login-button:hover { background: var(--accent-dark); }

      @media (max-width: 560px) {
        .recovery-shell { align-items: start; padding: 14px; }
        .recovery-card { padding: 22px; }
        .recovery-code-list { grid-template-columns: 1fr; }
      }

      @media print {
        body { background: white; }
        .recovery-shell { display: block; padding: 0; }
        .recovery-card { width: 100%; border: 0; box-shadow: none; }
        .utility-actions, .acknowledgement { display: none; }
      }
    </style>
  </head>
  <body>
    <main class="recovery-shell">
      <section class="recovery-card" aria-label="<%= t('recoveryCodesTitle') %>">
        <img class="login-logo" src="/assets/sunkaier-logo-login.png" alt="SUNKAIER">
        <h1><%= t('recoveryCodesTitle') %></h1>
        <p class="introduction"><%= t('recoveryCodesIntroduction') %></p>
        <p class="warning"><strong><%= t('recoveryCodesWarning') %></strong></p>
        <% if (error) { %>
          <p class="login-alert" role="alert"><%= error %></p>
        <% } %>
        <% if (codes.length > 0) { %>
          <ol class="recovery-code-list" aria-label="<%= t('recoveryCodesTitle') %>">
            <% codes.forEach((code) => { %>
              <li><code class="recovery-code"><%= code %></code></li>
            <% }) %>
          </ol>
          <div class="utility-actions">
            <button class="utility-button" id="copy-codes" type="button"><%= t('copyRecoveryCodes') %></button>
            <button class="utility-button" id="download-codes" type="button"><%= t('downloadRecoveryCodes') %></button>
            <button class="utility-button" type="button" onclick="window.print()"><%= t('printRecoveryCodes') %></button>
          </div>
        <% } else { %>
          <p class="warning"><%= t('recoveryCodesNoRedisplay') %></p>
        <% } %>
        <form class="acknowledgement" method="post" action="/login/recovery-codes/acknowledge">
          <%- csrfField() %>
          <label class="checkbox-field">
            <input type="checkbox" name="recoveryCodesSaved" value="1" required>
            <span><%= t('recoveryCodesSavedLabel') %></span>
          </label>
          <button class="login-button" type="submit"><%= t('continueToBestcrm') %></button>
        </form>
      </section>
    </main>
    <% if (codes.length > 0) { %>
      <script>
        const recoveryCodeText = Array.from(document.querySelectorAll('.recovery-code'))
          .map((element) => element.textContent.trim())
          .join('\n');
        document.getElementById('copy-codes')?.addEventListener('click', async () => {
          await navigator.clipboard.writeText(recoveryCodeText);
        });
        document.getElementById('download-codes')?.addEventListener('click', () => {
          const blob = new Blob([`BESTCRM recovery codes\n\n${recoveryCodeText}\n`], { type: 'text/plain;charset=utf-8' });
          const link = document.createElement('a');
          link.href = URL.createObjectURL(blob);
          link.download = 'bestcrm-recovery-codes.txt';
          link.click();
          URL.revokeObjectURL(link.href);
        });
      </script>
    <% } %>
  </body>
</html>
