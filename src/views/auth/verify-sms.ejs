<!doctype html>
<html lang="<%= typeof language === 'undefined' ? 'en' : language %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>BESTCRM <%= t('smsVerificationTitle') %></title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f4f7fa;
        --panel: #ffffff;
        --line: #d8e1e8;
        --ink: #17212b;
        --muted: #647484;
        --accent: #0f766e;
        --accent-dark: #0b5f59;
        --danger-bg: #fef2f2;
        --danger: #991b1b;
      }

      * { box-sizing: border-box; }

      body {
        min-height: 100vh;
        margin: 0;
        background: linear-gradient(180deg, rgba(15, 118, 110, 0.08), rgba(15, 118, 110, 0)), var(--bg);
        color: var(--ink);
        font: 20px/1.5 system-ui, "Microsoft YaHei", sans-serif;
      }

      .login-shell {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
      }

      .login-card {
        width: min(100%, 390px);
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel);
        box-shadow: 0 18px 48px rgba(23, 33, 43, 0.12);
        padding: 28px;
      }

      .login-logo {
        display: block;
        height: auto;
        margin: 0 auto 22px;
        max-width: 100%;
        width: 224px;
      }

      h1 { margin: 0 0 8px; font-size: 26px; }
      .instruction { margin: 0 0 18px; color: var(--muted); }
      .login-form { display: grid; gap: 14px; }
      .form-field { display: grid; gap: 6px; font-weight: 700; }

      .form-field input {
        width: 100%;
        height: 48px;
        border: 1px solid var(--line);
        border-radius: 6px;
        color: var(--ink);
        font: 700 24px/1.2 ui-monospace, Consolas, monospace;
        letter-spacing: 0.28em;
        padding: 8px 10px;
        text-align: center;
      }

      .form-field input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
        outline: none;
      }

      .login-button, .secondary-button {
        width: 100%;
        min-height: 44px;
        border-radius: 6px;
        cursor: pointer;
        font: inherit;
        font-weight: 700;
      }

      .login-button { border: 0; background: var(--accent); color: white; }
      .login-button:hover { background: var(--accent-dark); }
      .secondary-button { border: 1px solid var(--line); background: #eef6ff; color: #0b3f78; }
      .login-alert { margin: 0 0 14px; border: 1px solid #fecaca; border-radius: 6px; background: var(--danger-bg); color: var(--danger); padding: 9px 10px; }
      .back-link { display: block; margin-top: 14px; color: var(--muted); text-align: center; }

      @media (max-width: 460px) {
        .login-shell { align-items: start; padding: 18px; }
        .login-card { padding: 22px; }
      }
    </style>
  </head>
  <body>
    <main class="login-shell">
      <section class="login-card" aria-label="<%= t('smsVerificationTitle') %>">
        <img class="login-logo" src="/assets/sunkaier-logo-login.png" alt="SUNKAIER">
        <h1><%= t('smsVerificationTitle') %></h1>
        <p class="instruction"><%= t('smsVerificationInstruction') %> <strong><%= phoneMasked %></strong></p>
        <% if (error) { %>
          <p class="login-alert" role="alert"><%= error %></p>
        <% } %>
        <form class="login-form" method="post" action="/login/verify-sms">
          <%- csrfField() %>
          <label class="form-field">
            <%= t('smsVerificationCode') %>
            <input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" autofocus required>
          </label>
          <button class="login-button" type="submit"><%= t('verify') %></button>
        </form>
        <form class="login-form" method="post" action="/login/verify-sms/resend" style="margin-top: 10px">
          <%- csrfField() %>
          <button class="secondary-button" type="submit"><%= t('resendCode') %></button>
        </form>
        <a class="back-link" href="/login"><%= t('backToLogin') %></a>
      </section>
    </main>
  </body>
</html>
