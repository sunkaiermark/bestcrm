<!doctype html>
<html lang="<%= typeof language === 'undefined' ? 'en' : language %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>BESTCRM <%= t('authenticatorVerificationTitle') %></title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f4f7fa;
        --panel: #ffffff;
        --line: #d8e1e8;
        --ink: #17212b;
        --muted: #647484;
        --accent: #0f766e;
        --accent-dark: #0b5f59;
        --danger-bg: #fef2f2;
        --danger: #991b1b;
      }

      * { box-sizing: border-box; }

      body {
        min-height: 100vh;
        margin: 0;
        background: linear-gradient(180deg, rgba(15, 118, 110, 0.08), rgba(15, 118, 110, 0)), var(--bg);
        color: var(--ink);
        font: 20px/1.5 system-ui, "Microsoft YaHei", sans-serif;
      }

      .login-shell {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
      }

      .login-card {
        width: min(100%, 420px);
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel);
        box-shadow: 0 18px 48px rgba(23, 33, 43, 0.12);
        padding: 28px;
      }

      .login-logo {
        display: block;
        height: auto;
        margin: 0 auto 22px;
        max-width: 100%;
        width: 224px;
      }

      h1 { margin: 0 0 8px; font-size: 26px; font-weight: 650; }
      .instruction { margin: 0 0 18px; color: var(--muted); }
      .login-form { display: grid; gap: 14px; }
      .form-field { display: grid; gap: 6px; font-weight: 600; }

      .form-field input {
        width: 100%;
        height: 48px;
        border: 1px solid var(--line);
        border-radius: 6px;
        color: var(--ink);
        font: 600 22px/1.2 ui-monospace, Consolas, monospace;
        letter-spacing: 0.08em;
        padding: 8px 10px;
        text-align: center;
        text-transform: uppercase;
      }

      .form-field input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
        outline: none;
      }

      .trust-device {
        display: grid;
        grid-template-columns: 22px 1fr;
        gap: 9px;
        align-items: start;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: #f8fafc;
        padding: 10px 12px;
      }

      .trust-device input { width: 20px; height: 20px; margin: 2px 0 0; }
      .trust-device-copy { font-weight: 600; }
      .trust-device-warning { display: block; margin-top: 3px; color: var(--muted); font-size: 14px; font-weight: 400; }

      .login-button {
        width: 100%;
        min-height: 44px;
        border: 0;
        border-radius: 6px;
        background: var(--accent);
        color: white;
        cursor: pointer;
        font: inherit;
        font-weight: 650;
      }

      .login-button:hover { background: var(--accent-dark); }
      .login-alert { margin: 0 0 14px; border: 1px solid #fecaca; border-radius: 6px; background: var(--danger-bg); color: var(--danger); padding: 9px 10px; }
      .back-link { display: block; margin-top: 14px; color: var(--muted); text-align: center; }

      @media (max-width: 460px) {
        .login-shell { align-items: start; padding: 18px; }
        .login-card { padding: 22px; }
      }
    </style>
  </head>
  <body>
    <main class="login-shell">
      <section class="login-card" aria-label="<%= t('authenticatorVerificationTitle') %>">
        <img class="login-logo" src="/assets/sunkaier-logo-login.png" alt="SUNKAIER">
        <h1><%= t('authenticatorVerificationTitle') %></h1>
        <p class="instruction"><%= t('authenticatorVerificationInstruction') %></p>
        <% if (error) { %>
          <p class="login-alert" role="alert"><%= error %></p>
        <% } %>
        <form class="login-form" method="post" action="/login/verify-totp">
          <%- csrfField() %>
          <label class="form-field">
            <%= t('authenticatorOrRecoveryCode') %>
            <input
              name="code"
              inputmode="text"
              maxlength="19"
              autocomplete="one-time-code"
              autocapitalize="characters"
              spellcheck="false"
              autofocus
              required
            >
          </label>
          <label class="trust-device">
            <input type="checkbox" name="trustDevice" value="1">
            <span class="trust-device-copy">
              <%= t('trustDeviceForTenDays') %>
              <small class="trust-device-warning"><%= t('trustDeviceWarning') %></small>
            </span>
          </label>
          <button class="login-button" type="submit"><%= t('verify') %></button>
        </form>
        <a class="back-link" href="/login"><%= t('backToLogin') %></a>
      </section>
    </main>
    <script src="/assets/form-submission-guard.js" defer></script>
  </body>
</html>
