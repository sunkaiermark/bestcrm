<%- include('../../partials/app-start', { title: `${template.templateCode} - ${language === 'zh' ? template.nameZh : template.nameEn} - BESTCRM`, activeNav: 'bid-center-commercial' }) %>
        <% const hasOpenRevision = template.revisions.some((revision) => ['draft', 'review_pending'].includes(revision.status)); %>
        <p class="breadcrumb"><a href="/bid-center/commercial-templates"><%= t('bidCommercialPackages') %></a> / <%= template.templateCode %></p>
        <header class="page-header">
          <div class="bid-library-title"><h1><%= template.templateCode %> · <%= language === 'zh' ? template.nameZh : template.nameEn %></h1><div class="muted"><%= t(`templateLanguage.${template.language}`) %></div></div>
          <% if (canAuthor) { %><a class="secondary-action" href="/bid-center/commercial-templates/<%= template.id %>/edit"><%= t('editCommercialTemplate') %></a><% } %>
        </header>
        <section class="detail-section"><h2><%= t('templateMetadata') %></h2><dl class="detail-grid">
          <div><dt><%= t('nameEn') %></dt><dd><%= template.nameEn %></dd></div><div><dt><%= t('nameZh') %></dt><dd><%= template.nameZh %></dd></div>
          <div><dt><%= t('applicableCountries') %></dt><dd><%= template.applicableCountries.join(', ') || t('allApplicability') %></dd></div><div><dt><%= t('applicableIndustries') %></dt><dd><%= template.applicableIndustries.join(', ') || t('allApplicability') %></dd></div>
          <div><dt><%= t('applicableCustomerTypes') %></dt><dd><%= template.applicableCustomerTypes.join(', ') || t('allApplicability') %></dd></div><div><dt><%= t('templateCurrentRevision') %></dt><dd><%= template.currentRevisionLabel || '-' %></dd></div>
        </dl></section>
        <% if (canAuthor && !hasOpenRevision && template.revisions.length) { %><section class="form-panel"><h2><%= t('createNextRevision') %></h2><form method="post" action="/bid-center/commercial-templates/<%= template.id %>/revisions"><%- csrfField() %><label><%= t('changeSummary') %><textarea name="changeSummary" maxlength="2000" required></textarea></label><button type="submit"><%= t('createNextRevision') %></button></form></section><% } %>
        <section class="detail-section"><h2><%= t('templateRevisions') %></h2><p class="muted"><%= t('immutableAfterSubmission') %></p>
          <% for (const revision of template.revisions) { %><article class="form-panel technical-template-revision">
            <header class="page-header"><div class="bid-library-title"><h3><%= revision.revisionLabel %> · <%= t(`templateStatus.${revision.status}`) %></h3><div class="muted"><%= revision.changeSummary %></div></div>
              <% if (canAuthor) { %><div class="inline-actions">
                <% if (revision.status === 'draft') { %><a class="secondary-action" href="/bid-center/commercial-templates/<%= template.id %>/revisions/<%= revision.id %>/editor"><%= t('openTemplateEditor') %></a><form method="post" action="/bid-center/commercial-templates/<%= template.id %>/revisions/<%= revision.id %>/submit"><%- csrfField() %><button type="submit"><%= t('submitForReview') %></button></form><% } %>
                <% if (revision.status === 'review_pending') { %><form method="post" action="/bid-center/commercial-templates/<%= template.id %>/revisions/<%= revision.id %>/publish"><%- csrfField() %><button type="submit"><%= t('publish') %></button></form><% } %>
                <% if (revision.status === 'published') { %><form method="post" action="/bid-center/commercial-templates/<%= template.id %>/revisions/<%= revision.id %>/retire"><%- csrfField() %><button class="danger-action" type="submit"><%= t('retire') %></button></form><% } %>
              </div><% } %>
            </header>
            <dl class="detail-grid"><div><dt><%= t('revisionCreatedBy') %></dt><dd><%= revision.createdByDisplayName || revision.createdBy %></dd></div><div><dt><%= t('submittedBy') %></dt><dd><%= revision.submittedByDisplayName || '-' %></dd></div><div><dt><%= t('publishedBy') %></dt><dd><%= revision.publishedByDisplayName || '-' %></dd></div><div><dt><%= t('retiredBy') %></dt><dd><%= revision.retiredByDisplayName || '-' %></dd></div></dl>
            <h4><%= t('standardSections') %></h4><ol><% for (const section of (revision.contentSchema.sections || [])) { %><li class="bid-library-title"><%= language === 'zh' ? section.labelZh : section.labelEn %> <span class="muted">(<%= section.key %>)</span></li><% } %></ol>
          </article><% } %>
          <% if (!template.revisions.length) { %><p class="empty"><%= t('noTemplateRevisions') %></p><% } %>
        </section>
<%- include('../../partials/app-end') %>
