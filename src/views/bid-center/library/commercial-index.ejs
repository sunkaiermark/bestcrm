<%- include('../../partials/app-start', { title: `${t('bidCommercialPackages')} - BESTCRM`, activeNav: 'bid-center-commercial' }) %>
        <header class="page-header">
          <div class="bid-library-title">
            <h1><%= t('bidCommercialPackages') %></h1>
            <div class="muted"><%= t('bidCommercialPackagesDescription') %></div>
          </div>
          <% if (canAuthor) { %><a class="quick-action" href="/bid-center/commercial-templates/new"><%= t('newCommercialTemplate') %></a><% } %>
        </header>
        <section class="form-panel"><strong><%= t('commercialManagerPublishingNotice') %></strong></section>
        <section class="list-section"><div class="list-body">
          <table class="list-table content-fit-table">
            <thead><tr><th><%= t('templateCode') %></th><th><%= t('templateName') %></th><th><%= t('outputLanguage') %></th><th><%= t('applicability') %></th><th><%= t('templateCurrentRevision') %></th><th><%= t('status') %></th><th><%= t('actions') %></th></tr></thead>
            <tbody>
              <% for (const template of templates) { %>
                <tr>
                  <td><strong><%= template.templateCode %></strong></td>
                  <td class="bid-library-title"><%= language === 'zh' ? template.nameZh : template.nameEn %></td>
                  <td><%= t(`templateLanguage.${template.language}`) %></td>
                  <td><%= [...template.applicableCountries, ...template.applicableIndustries, ...template.applicableCustomerTypes].join(', ') || t('allApplicability') %></td>
                  <td><%= template.currentRevisionLabel || '-' %></td>
                  <td><span class="status"><%= template.isActive ? t('activeForNewProjects') : t('inactiveForNewProjects') %></span></td>
                  <td><a class="secondary-action" href="/bid-center/commercial-templates/<%= template.id %>"><%= t('openTemplate') %></a></td>
                </tr>
              <% } %>
              <% if (!templates.length) { %><tr><td colspan="7" class="empty"><%= t('noCommercialTemplates') %></td></tr><% } %>
            </tbody>
          </table>
        </div></section>
<%- include('../../partials/app-end') %>
