<%- include('../../partials/app-start', { title: `${block.blockCode} - ${language === 'zh' ? block.nameZh : block.nameEn} - BESTCRM`, activeNav }) %>
        <% const hasOpenRevision = block.revisions.some((revision) => ['draft', 'review_pending'].includes(revision.status)); %>
        <p class="breadcrumb"><a href="<%= basePath %>"><%= t(titleKey) %></a> / <%= block.blockCode %></p>
        <header class="page-header"><div class="bid-library-title"><h1><%= block.blockCode %> · <%= language === 'zh' ? block.nameZh : block.nameEn %></h1><div class="muted"><%= t(`bidContentCategory.${block.category}`) %> · <%= t(`role.${block.ownerRoleCode}`) %></div></div></header>
        <section class="detail-section"><h2><%= t('contentMetadata') %></h2><dl class="detail-grid"><div><dt><%= t('nameEn') %></dt><dd><%= block.nameEn %></dd></div><div><dt><%= t('nameZh') %></dt><dd><%= block.nameZh %></dd></div><div><dt><%= t('applicableCountries') %></dt><dd><%= block.applicableCountries.join(', ') || t('allApplicability') %></dd></div><div><dt><%= t('applicableIndustries') %></dt><dd><%= block.applicableIndustries.join(', ') || t('allApplicability') %></dd></div><div><dt><%= t('applicableProductFamilies') %></dt><dd><%= block.applicableProductFamilies.join(', ') || t('allApplicability') %></dd></div><div><dt><%= t('applicableSections') %></dt><dd><%= block.applicableSections.join(', ') || t('allApplicability') %></dd></div></dl></section>
        <% if (canAuthor && !hasOpenRevision && block.revisions.length) { %><section class="form-panel"><h2><%= t('createNextRevision') %></h2><form method="post" action="<%= basePath %>/<%= block.id %>/revisions"><%- csrfField() %><label><%= t('changeSummary') %><textarea name="changeSummary" maxlength="2000" required></textarea></label><button type="submit"><%= t('createNextRevision') %></button></form></section><% } %>
        <section class="detail-section"><h2><%= t('contentRevisions') %></h2><p class="muted"><%= t('immutableAfterSubmission') %></p>
          <% for (const revision of block.revisions) { %><article class="form-panel technical-template-revision"><header class="page-header"><div class="bid-library-title"><h3><%= revision.revisionLabel %> · <%= t(`templateStatus.${revision.status}`) %></h3><div class="muted"><%= revision.changeSummary %></div></div><% if (canAuthor) { %><div class="inline-actions"><% if (revision.status === 'draft') { %><a class="secondary-action" href="<%= basePath %>/<%= block.id %>/revisions/<%= revision.id %>/edit"><%= t('edit') %></a><form method="post" action="<%= basePath %>/<%= block.id %>/revisions/<%= revision.id %>/submit"><%- csrfField() %><button><%= t('submitForReview') %></button></form><% } %><% if (revision.status === 'review_pending') { %><form method="post" action="<%= basePath %>/<%= block.id %>/revisions/<%= revision.id %>/publish"><%- csrfField() %><button><%= t('publish') %></button></form><% } %><% if (revision.status === 'published') { %><form method="post" action="<%= basePath %>/<%= block.id %>/revisions/<%= revision.id %>/retire"><%- csrfField() %><button class="danger-action"><%= t('retire') %></button></form><% } %></div><% } %></header>
            <dl class="detail-grid"><div><dt><%= t('contentType') %></dt><dd><%= t(`bidComponentType.${revision.componentType}`) %></dd></div><div><dt><%= t('sensitivity') %></dt><dd><%= t(`bidSensitivity.${revision.sensitivity}`) %></dd></div><div><dt><%= t('effectivePeriod') %></dt><dd><%= revision.effectiveDate || '-' %> — <%= revision.expiresAt || '-' %></dd></div><div><dt><%= t('sourceReference') %></dt><dd><%= revision.sourceMetadata.sourceReference || '-' %></dd></div></dl>
            <% if (revision.titleEn || revision.titleZh) { %><h4 class="bid-library-title"><%= language === 'zh' ? revision.titleZh : revision.titleEn %></h4><% } %><div class="bid-library-content"><%= language === 'zh' ? revision.bodyZh : revision.bodyEn %></div>
            <% if (revision.tableRows.length) { %><div class="list-body"><table class="list-table content-fit-table"><tbody><% for (const row of revision.tableRows) { %><tr><% for (const cell of row) { %><td><%= cell %></td><% } %></tr><% } %></tbody></table></div><% } %>
            <% if (revision.attachmentSha256) { %><p><a class="secondary-action" href="<%= basePath %>/<%= block.id %>/revisions/<%= revision.id %>/attachment"><%= t('downloadControlledAttachment') %>: <%= revision.attachmentOriginalName %></a><br><span class="muted">SHA-256: <%= revision.attachmentSha256 %></span></p><% } %>
          </article><% } %>
        </section>
<%- include('../../partials/app-end') %>
