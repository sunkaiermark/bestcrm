<%- include('../../partials/app-start', { title: `${mode === 'new' ? t('newContentRevision') : t('editContentRevision')} - BESTCRM`, activeNav }) %>
        <p class="breadcrumb"><a href="<%= basePath %>"><%= t(titleKey) %></a> / <%= mode === 'new' ? t('newContentRevision') : t('editContentRevision') %></p>
        <header class="page-header"><div class="bid-library-title"><h1><%= mode === 'new' ? t(libraryType === 'standard_clause' ? 'newBidStandardClause' : 'newBidPublicMaterial') : t('editContentRevision') %></h1><div class="muted"><%= t('controlledContentNotice') %></div></div></header>
        <form class="form-panel" method="post" action="<%= action %>" enctype="multipart/form-data"><%- csrfField() %>
          <div class="form-grid"><label><%= t('contentCode') %><input name="blockCode" maxlength="32" value="<%= content.blockCode %>" <%= mode === 'edit' ? 'readonly' : 'required' %>></label><label><%= t('contentCategory') %><select name="category" <%= mode === 'edit' ? 'disabled' : '' %> required><% for (const item of categories) { %><option value="<%= item %>" <%= content.category === item ? 'selected' : '' %>><%= t(`bidContentCategory.${item}`) %></option><% } %></select><% if (mode === 'edit') { %><input type="hidden" name="category" value="<%= content.category %>"><% } %></label><label><%= t('contentOwner') %><select name="ownerRoleCode" <%= mode === 'edit' ? 'disabled' : '' %> required><% for (const item of ownerRoles) { %><option value="<%= item %>" <%= content.ownerRoleCode === item ? 'selected' : '' %>><%= t(`role.${item}`) %></option><% } %></select><% if (mode === 'edit') { %><input type="hidden" name="ownerRoleCode" value="<%= content.ownerRoleCode %>"><% } %></label><label><%= t('outputLanguage') %><select name="language" required><% for (const item of languages) { %><option value="<%= item %>" <%= content.language === item ? 'selected' : '' %>><%= t(`templateLanguage.${item}`) %></option><% } %></select></label></div>
          <div class="form-grid"><label><%= t('nameEn') %><input name="nameEn" maxlength="200" value="<%= content.nameEn %>" required></label><label><%= t('nameZh') %><input name="nameZh" maxlength="200" value="<%= content.nameZh %>" required></label><label><%= t('titleEn') %><input name="titleEn" maxlength="300" value="<%= content.titleEn %>"></label><label><%= t('titleZh') %><input name="titleZh" maxlength="300" value="<%= content.titleZh %>"></label></div>
          <div class="form-grid"><label><%= t('contentType') %><select name="componentType" required><% for (const item of componentTypes) { %><option value="<%= item %>" <%= content.componentType === item ? 'selected' : '' %>><%= t(`bidComponentType.${item}`) %></option><% } %></select></label><label><%= t('sensitivity') %><select name="sensitivity" required><% for (const item of sensitivities) { %><option value="<%= item %>" <%= content.sensitivity === item ? 'selected' : '' %>><%= t(`bidSensitivity.${item}`) %></option><% } %></select></label><label><%= t('effectiveDate') %><input type="date" name="effectiveDate" value="<%= content.effectiveDate || '' %>"></label><label><%= t('expiresAt') %><input type="date" name="expiresAt" value="<%= content.expiresAt || '' %>"></label><label><%= t('reviewDueAt') %><input type="date" name="reviewDueAt" value="<%= content.reviewDueAt || '' %>"></label></div>
          <div class="form-grid"><label><%= t('applicableCountries') %><textarea name="applicableCountries"><%= formValue(content.applicableCountries) %></textarea></label><label><%= t('applicableIndustries') %><textarea name="applicableIndustries"><%= formValue(content.applicableIndustries) %></textarea></label><label><%= t('applicableProductFamilies') %><textarea name="applicableProductFamilies"><%= formValue(content.applicableProductFamilies) %></textarea></label><label><%= t('applicableCustomerTypes') %><textarea name="applicableCustomerTypes"><%= formValue(content.applicableCustomerTypes) %></textarea></label><label><%= t('applicableSections') %><textarea name="applicableSections"><%= formValue(content.applicableSections) %></textarea></label></div>
          <label><%= t('bodyEn') %><textarea name="bodyEn" maxlength="100000"><%= content.bodyEn || '' %></textarea></label><label><%= t('bodyZh') %><textarea name="bodyZh" maxlength="100000"><%= content.bodyZh || '' %></textarea></label><label><%= t('structuredTableRows') %><textarea name="tableRows" maxlength="100000"><%= (content.tableRows || []).map((row) => row.join(' | ')).join('\n') %></textarea></label>
          <div class="form-grid"><label><%= t('allowedVariables') %><textarea name="allowedVariables"><%= formValue(content.allowedVariables) %></textarea></label><label><%= t('sourceReference') %><textarea name="sourceReference" maxlength="1000"><%= content.sourceReference || '' %></textarea></label><label><%= t('controlledAttachment') %><input type="file" name="attachment"><span class="muted"><%= content.attachmentOriginalName || t('noControlledAttachment') %></span></label></div>
          <label><%= t('changeSummary') %><textarea name="changeSummary" maxlength="2000" required><%= mode === 'edit' ? content.changeSummary : '' %></textarea></label>
          <div class="inline-actions"><button type="submit"><%= t('save') %></button><a class="secondary-action" href="<%= mode === 'new' ? basePath : `${basePath}/${content.contentBlockId}` %>"><%= t('cancel') %></a></div>
        </form>
<%- include('../../partials/app-end') %>
