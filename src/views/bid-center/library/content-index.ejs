<%- include('../../partials/app-start', { title: `${t(titleKey)} - BESTCRM`, activeNav }) %>
        <header class="page-header"><div class="bid-library-title"><h1><%= t(titleKey) %></h1><div class="muted"><%= t(libraryType === 'standard_clause' ? 'bidStandardClausesDescription' : 'bidPublicMaterialsDescription') %></div></div><% if (canCreate) { %><a class="quick-action" href="<%= basePath %>/new"><%= t(libraryType === 'standard_clause' ? 'newBidStandardClause' : 'newBidPublicMaterial') %></a><% } %></header>
        <form class="form-panel" method="get" action="<%= basePath %>"><div class="form-grid"><label><%= t('contentCategory') %><select name="category"><option value=""><%= t('allCategories') %></option><% for (const category of categories) { %><option value="<%= category %>" <%= selectedCategory === category ? 'selected' : '' %>><%= t(`bidContentCategory.${category}`) %></option><% } %></select></label></div><button type="submit"><%= t('filter') %></button></form>
        <% if (libraryType === 'standard_clause') { %><section class="form-panel"><span><%= t('legacyTechnicalClauseNotice') %></span> <a href="/technical-clauses"><%= t('openLegacyTechnicalClauses') %></a></section><% } %>
        <section class="list-section"><div class="list-body"><table class="list-table content-fit-table"><thead><tr><th><%= t('contentCode') %></th><th><%= t('name') %></th><th><%= t('contentCategory') %></th><th><%= t('contentType') %></th><th><%= t('revision') %></th><th><%= t('sensitivity') %></th><th><%= t('effectivePeriod') %></th><th><%= t('actions') %></th></tr></thead><tbody>
          <% for (const block of blocks) { %><tr><td><strong><%= block.blockCode %></strong></td><td class="bid-library-title"><%= language === 'zh' ? block.nameZh : block.nameEn %></td><td><%= t(`bidContentCategory.${block.category}`) %></td><td><%= t(`bidComponentType.${block.componentType}`) %></td><td><%= block.latestRevisionLabel || '-' %> · <%= t(`templateStatus.${block.latestRevisionStatus}`) %></td><td><%= t(`bidSensitivity.${block.sensitivity}`) %></td><td><%= block.effectiveDate || '-' %> — <%= block.expiresAt || '-' %></td><td><a class="secondary-action" href="<%= basePath %>/<%= block.id %>"><%= t('open') %></a></td></tr><% } %>
          <% if (!blocks.length) { %><tr><td colspan="8" class="empty"><%= t('noBidLibraryContent') %></td></tr><% } %>
        </tbody></table></div></section>
<%- include('../../partials/app-end') %>
