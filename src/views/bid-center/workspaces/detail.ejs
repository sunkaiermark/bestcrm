<%- include('../../partials/app-start', { title: `${workspace.opportunity.opportunityNo} - ${t('bidWorkspace')} - BESTCRM`, activeNav: 'bid-center-workspaces' }) %>
        <p class="breadcrumb"><a href="/bid-center/workspaces"><%= t('bidProjects') %></a> / <a href="/opportunities/<%= workspace.opportunity.id %>"><%= workspace.opportunity.opportunityNo %></a></p>
        <header class="page-header"><div class="bid-library-title"><h1><%= workspace.opportunity.title %></h1><div class="muted"><%= [workspace.opportunity.customerName, workspace.opportunity.primaryContactId ? `${workspace.opportunity.primaryContactCode ? `${workspace.opportunity.primaryContactCode} · ` : ''}${workspace.opportunity.primaryContactName || ''}` : '', t(`templateLanguage.${workspace.language}`), t(`bidWorkspaceStatus.${workspace.status}`)].filter(Boolean).join(' · ') %></div></div></header>
        <section class="form-panel"><h2><%= t('snapshotSources') %></h2><dl class="detail-grid"><div><dt><%= t('technicalTemplate') %></dt><dd><%= workspace.technicalTemplate.templateCode %> · TPL-R<%= workspace.technicalTemplate.revisionNo %></dd></div><div><dt><%= t('commercialTemplate') %></dt><dd><%= workspace.commercialTemplate.restricted ? t('restrictedContent') : `${workspace.commercialTemplate.templateCode} · CTPL-R${workspace.commercialTemplate.revisionNo}` %></dd></div><div><dt><%= t('outputProfile') %></dt><dd><%= workspace.outputProfile.revisionLabel %></dd></div><div><dt><%= t('snapshotCreatedAt') %></dt><dd><%= workspace.createdAt ? new Date(workspace.createdAt).toLocaleString(language === 'zh' ? 'zh-CN' : 'en-GB') : '-' %></dd></div></dl></section>
        <div class="bid-package-grid">
          <section class="form-panel"><h2><%= t('technicalPackage') %></h2><% if (workspace.technicalDraft) { %><p><strong><%= workspace.technicalDraft.draftLabel %></strong> · <%= t(`technicalDraftStatus.${workspace.technicalDraft.status}`) %></p><p><%= t('validationIssuesFound') %>: <%= workspace.technicalDraft.validationIssueCount %></p><a class="secondary-action" href="/bid-center/workspaces/<%= workspace.id %>/packages/technical"><%= language === 'zh' ? '打开技术包编辑器' : 'Open Technical Package Editor' %></a><h3><%= language === 'zh' ? '版本记录' : 'Version history' %></h3><ol class="bid-audit-list"><% for (const version of approval.technicalVersions) { %><li><strong><%= version.formalVersionLabel || version.draftLabel %></strong><span><%= version.status %></span></li><% } %></ol><% } else { %><p class="empty"><%= t('packageSnapshotMissing') %></p><% } %></section>
          <section class="form-panel"><h2><%= t('commercialPackage') %></h2><% if (workspace.commercialDraft?.restricted) { %><p class="empty"><%= t('restrictedContent') %></p><% } else if (workspace.commercialDraft) { %><p><strong><%= workspace.commercialDraft.draftLabel %></strong> · <%= t(`commercialDraftStatus.${workspace.commercialDraft.status}`) %></p><p><%= t('validationIssuesFound') %>: <%= workspace.commercialDraft.validationIssueCount %></p><a class="secondary-action" href="/bid-center/workspaces/<%= workspace.id %>/packages/commercial"><%= language === 'zh' ? '打开商务包编辑器' : 'Open Commercial Package Editor' %></a><h3><%= language === 'zh' ? '版本记录' : 'Version history' %></h3><ol class="bid-audit-list"><% for (const version of approval.commercialVersions) { %><li><strong><%= version.formalVersionLabel || version.draftLabel %></strong><span><%= version.status %></span></li><% } %></ol><% } else { %><p class="empty"><%= t('packageSnapshotMissing') %></p><% } %></section>
        </div>
        <section class="form-panel">
          <h2><%= language === 'zh' ? '完整标书' : 'Complete Bid' %></h2>
          <% const complete = approval.completeVersions[0]; %>
          <% if (complete) { %>
            <p><strong><%= complete.label %></strong> · <%= complete.status %> · <%= complete.currency %> <%= complete.totalPrice.toLocaleString() %></p>
            <p class="muted">TS-V<%= complete.technicalSolutionVersionNo %> + CP-V<%= complete.commercialDraftVersionNo %> + CQ-V<%= complete.commercialQuoteVersionNo %></p>
            <% const completeCheck = approval.completeChecks[0]; %>
            <% if (completeCheck) { %><div class="<%= completeCheck.passed ? 'muted' : 'inline-error' %>"><%= completeCheck.passed ? (language === 'zh' ? '最近完整性检查：通过' : 'Latest completeness check: passed') : (language === 'zh' ? `最近完整性检查：${completeCheck.issues.length} 项未通过` : `Latest completeness check: ${completeCheck.issues.length} issue(s)`) %><% if (!completeCheck.passed) { %><ul><% for (const checkIssue of completeCheck.issues) { %><li><%= checkIssue.component ? `${checkIssue.component}: ` : '' %><%= checkIssue.message || checkIssue.code %></li><% } %></ul><% } %></div><% } %>
            <div class="inline-actions">
              <% if (approval.canCheckComplete) { %><form method="post" action="/bid-center/workspaces/<%= workspace.id %>/complete/<%= complete.id %>/completeness"><%- csrfField() %><button class="secondary-action" type="submit"><%= language === 'zh' ? '检查完整标书' : 'Check complete bid' %></button></form><% } %>
              <% if (approval.canSubmitComplete) { %><form method="post" action="/bid-center/workspaces/<%= workspace.id %>/complete/<%= complete.id %>/submit"><%- csrfField() %><input name="comment" maxlength="2000" placeholder="<%= language === 'zh' ? '提交说明' : 'Submission note' %>"><button type="submit"><%= language === 'zh' ? '提交销售经理审批' : 'Submit to Sales Manager' %></button></form><% } %>
            </div>
            <% if (approval.canReviewComplete) { %><form class="compact-form" method="post" action="/bid-center/workspaces/<%= workspace.id %>/complete/<%= complete.id %>/review"><%- csrfField() %><label><%= language === 'zh' ? '审批意见（驳回必填）' : 'Review comment (required to reject)' %><textarea name="comment" maxlength="2000"></textarea></label><div class="inline-actions"><button name="decision" value="approve" type="submit"><%= language === 'zh' ? '审批通过' : 'Approve' %></button><button class="danger-action" name="decision" value="reject" type="submit"><%= language === 'zh' ? '驳回并创建下一稿' : 'Reject and create next draft' %></button></div></form><% } %>
            <h3><%= language === 'zh' ? '完整标书版本记录' : 'Complete bid versions' %></h3><ol class="bid-audit-list"><% for (const version of approval.completeVersions) { %><li><strong><%= version.label %></strong><span><%= version.status %><% if (version.reviewSourcePackageId) { %> · review source #<%= version.reviewSourcePackageId %><% } %></span></li><% } %></ol>
            <% if (approval.completeComparison) { const completeFieldLabels = { technicalSolutionVersionId: ['技术包版本', 'Technical package version'], commercialDraftId: ['商务包版本', 'Commercial package version'], commercialQuoteId: ['报价版本', 'Commercial quote version'], currency: ['币种', 'Currency'], totalPrice: ['总价', 'Total price'], deliveryPeriod: ['交货期', 'Delivery period'], paymentTerms: ['付款条款', 'Payment terms'], validUntil: ['报价有效期', 'Validity'], revisionReason: ['内部修订原因', 'Internal revision reason'], changeSummary: ['客户可见变更摘要', 'Customer-readable change summary'] }; %><section class="bid-reference-card"><h3><%= language === 'zh' ? `与 ${approval.completeComparison.from} 的版本差异` : `Changes from ${approval.completeComparison.from}` %></h3><% if (approval.completeComparison.changedFields.length) { %><ul class="bid-audit-list"><% for (const field of approval.completeComparison.changedFields) { const labels = completeFieldLabels[field] || [field, field]; %><li><strong><%= language === 'zh' ? labels[0] : labels[1] %></strong><span><%= field %></span></li><% } %></ul><% } else { %><p class="muted"><%= language === 'zh' ? '冻结字段没有变化。' : 'No frozen fields changed.' %></p><% } %></section><% } %>
          <% } else { %><p class="empty"><%= language === 'zh' ? '技术包和商务包分别审批通过后，可冻结并组装完整标书草稿。' : 'Approve the technical and commercial packages independently before assembling a frozen complete bid draft.' %></p><% } %>
          <% if (approval.canCreateComplete) { %><form class="compact-form" method="post" action="/bid-center/workspaces/<%= workspace.id %>/complete"><%- csrfField() %><% if (approval.currentSentPackage) { %><input type="hidden" name="sourcePackageId" value="<%= approval.currentSentPackage.id %>"><label><%= language === 'zh' ? '交货期' : 'Delivery period' %><input name="deliveryPeriod" value="<%= approval.currentSentPackage.deliveryPeriod || '' %>" maxlength="300" required><span class="muted"><%= language === 'zh' ? '如批准的商务包已冻结交货期，此处必须与其保持一致。' : 'If the approved Commercial Package freezes a delivery period, this value must remain consistent.' %></span></label><label><%= language === 'zh' ? '内部修订原因' : 'Internal revision reason' %><textarea name="revisionReason" maxlength="2000" required></textarea></label><label><%= language === 'zh' ? '客户可见变更摘要' : 'Customer-readable change summary' %><textarea name="changeSummary" maxlength="2000" required></textarea></label><% } else { %><label><%= language === 'zh' ? '币种（ISO 三字母）' : 'Currency (3-letter ISO)' %><input name="currency" value="USD" pattern="[A-Za-z]{3}" maxlength="3" required></label><% } %><button type="submit"><%= approval.currentSentPackage ? (language === 'zh' ? '从当前已发送版本创建客户修订稿' : 'Create customer revision from current sent version') : (language === 'zh' ? '组装完整标书草稿' : 'Assemble complete bid draft') %></button></form><% } %>
        </section>
        <section class="form-panel">
          <h2><%= language === 'zh' ? '受控输出' : 'Controlled Outputs' %></h2>
          <% if (outputs.canGenerate && outputs.generationPackage) { %>
            <form method="post" action="/bid-center/workspaces/<%= workspace.id %>/complete/<%= outputs.generationPackage.id %>/generate">
              <%- csrfField() %>
              <button type="submit"><%= language === 'zh' ? `生成 ${outputs.generationPackage.label} 八件套文件` : `Generate the eight-file set for ${outputs.generationPackage.label}` %></button>
            </form>
          <% } %>
          <% if (outputs.documents.length) { %>
            <div class="bid-output-scroll"><table class="list-table content-fit-table">
              <thead><tr><th><%= language === 'zh' ? '类型' : 'Type' %></th><th><%= language === 'zh' ? '文件' : 'File' %></th><th><%= language === 'zh' ? '大小' : 'Size' %></th><th>SHA-256</th><th><%= t('actions') %></th></tr></thead>
              <tbody><% for (const document of outputs.documents) { %><tr>
                <td><%= document.documentType %></td>
                <td><%= document.originalName %></td>
                <td><%= document.byteSize.toLocaleString() %> B</td>
                <td class="bid-library-content"><%= document.sha256.slice(0, 16) %>…</td>
                <td><% if (document.mimeType === 'application/pdf') { %><a class="secondary-action" target="_blank" rel="noopener" href="/bid-center/workspaces/<%= workspace.id %>/outputs/<%= document.id %>/download?inline=1"><%= language === 'zh' ? '预览' : 'Preview' %></a> <% } %><a class="secondary-action" href="/bid-center/workspaces/<%= workspace.id %>/outputs/<%= document.id %>/download"><%= language === 'zh' ? '下载' : 'Download' %></a></td>
              </tr><% } %></tbody>
            </table></div>
          <% } else { %>
            <p class="empty"><%= language === 'zh' ? '完整标书审批通过后，由项目主责报价工程师生成受控文件。' : 'After approval, the assigned Project Lead QE generates the controlled files.' %></p>
          <% } %>
        </section>
        <% const contentReferences = workspace.sourceMetadata.contentComponentReferences || []; %>
        <section class="list-section"><h2 class="bid-workspace-section-title"><%= t('frozenContentComponents') %></h2><div class="list-body"><% if (contentReferences.length) { %><table class="list-table content-fit-table"><thead><tr><th><%= t('code') %></th><th><%= t('revision') %></th><th>SHA-256</th><th><%= t('actions') %></th></tr></thead><tbody><% for (const item of contentReferences) { %><tr><td><%= item.blockCode %></td><td><%= item.revisionLabel %></td><td class="bid-library-content"><%= item.attachmentSha256 || '-' %></td><td><% if (item.attachmentSha256) { %><a class="secondary-action" href="/bid-center/workspaces/<%= workspace.id %>/materials/<%= item.revisionId %>/attachment"><%= t('downloadControlledAttachment') %></a><% } else { %>-<% } %></td></tr><% } %></tbody></table><% } else { %><p class="empty"><%= t('noFrozenContentComponents') %></p><% } %></div></section>
<%- include('../../partials/app-end') %>
