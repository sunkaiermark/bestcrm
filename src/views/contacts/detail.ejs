<%- include('../partials/app-start', { title: contact.name + ' - BESTCRM', activeNav: 'contacts' }) %>
        <p class="breadcrumb"><a href="/contacts"><%= t('contacts') %></a></p>
        <header class="page-header">
          <h1><%= contact.name %></h1>
          <div class="page-actions">
            <a class="quick-action" href="/contacts/<%= contact.id %>/edit"><%= t('editContact') %></a>
            <% if (typeof canDeleteContact !== 'undefined' && canDeleteContact) { %>
              <form method="post" action="/contacts/<%= contact.id %>/delete" onsubmit="return confirm('<%= t('deleteContactConfirm') %>')">
                <%- csrfField() %>
                <button class="danger-action" type="submit"><%= t('deleteContact') %></button>
              </form>
            <% } %>
          </div>
        </header>

        <section class="content-section">
          <h2><%= t('contactDetail') %></h2>
          <div class="section-body">
            <div class="basic-info-grid">
              <table class="detail-table">
                <tbody>
                  <tr>
                    <th scope="row"><%= t('customer') %></th>
                    <td><a href="/customers/<%= contact.customerId %>"><%= contact.customerName %></a></td>
                  </tr>
                  <tr>
                    <th scope="row"><%= t('title') %></th>
                    <td><%= contact.title %></td>
                  </tr>
                  <tr>
                    <th scope="row"><%= t('phone') %></th>
                    <td><%= contact.phone %></td>
                  </tr>
                  <tr>
                    <th scope="row"><%= t('email') %></th>
                    <td><%= contact.email %></td>
                  </tr>
                  <tr>
                    <th scope="row"><%= t('wechat') %></th>
                    <td><%= contact.wechat %></td>
                  </tr>
                </tbody>
              </table>
              <table class="detail-table">
                <tbody>
                  <tr>
                    <th scope="row"><%= t('educationBackground') %></th>
                    <td><%= contact.educationBackground %></td>
                  </tr>
                  <tr>
                    <th scope="row"><%= t('workExperience') %></th>
                    <td><%= contact.workExperience %></td>
                  </tr>
                  <tr>
                    <th scope="row"><%= t('keyAchievements') %></th>
                    <td><%= contact.keyAchievements %></td>
                  </tr>
                  <tr>
                    <th scope="row"><%= t('notes') %></th>
                    <td><%= contact.notes %></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>
<%- include('../partials/app-end') %>
