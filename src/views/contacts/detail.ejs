<%- include('../partials/app-start', { title: [contact.contactCode, contact.name].filter(Boolean).join(' · ') + ' - BESTCRM', activeNav: 'contacts' }) %>
        <p class="breadcrumb"><a href="/contacts"><%= t('contacts') %></a></p>
        <header class="page-header">
          <h1><%= [contact.contactCode, contact.name].filter(Boolean).join(' · ') %></h1>
          <div class="page-actions">
            <a class="secondary-action" href="/contacts"><%= t('backToList') %></a>
            <% if (!contact.archivedAt) { %><a class="quick-action" href="/contacts/<%= contact.id %>/edit"><%= t('editContact') %></a><% } %>
            <% if (typeof canArchiveContact !== 'undefined' && canArchiveContact) { %>
              <form method="post" action="/contacts/<%= contact.id %>/archive">
                <%- csrfField() %>
                <input name="reason" required maxlength="500" placeholder="<%= t('archiveReason') %>" aria-label="<%= t('archiveReason') %>">
                <button class="danger-action" type="submit"><%= t('archiveContact') %></button>
              </form>
            <% } %>
            <% if (typeof canReopenContact !== 'undefined' && canReopenContact) { %>
              <form method="post" action="/contacts/<%= contact.id %>/reopen">
                <%- csrfField() %>
                <input name="reason" required maxlength="500" placeholder="<%= t('reopenReason') %>" aria-label="<%= t('reopenReason') %>">
                <button class="quick-action" type="submit"><%= t('reopen') %></button>
              </form>
            <% } %>
          </div>
        </header>
        <% if (contact.archivedAt) { %><p class="user-line"><%= t('archivedRecord') %><% if (contact.archiveReason) { %>: <%= contact.archiveReason %><% } %></p><% } %>

        <section class="content-section">
          <h2><%= t('contactDetail') %></h2>
          <div class="section-body">
            <div class="basic-info-grid">
              <table class="detail-table">
                <tbody>
                  <tr>
                    <th scope="row"><%= t('contactCode') %></th>
                    <td><%= contact.contactCode %></td>
                  </tr>
                  <tr>
                    <th scope="row"><%= t('customer') %></th>
                    <td><a href="/customers/<%= contact.customerId %>"><%= [contact.customerCode, contact.customerName].filter(Boolean).join(' · ') %></a></td>
                  </tr>
                  <tr>
                    <th scope="row"><%= t('title') %></th>
                    <td><%= contact.title %></td>
                  </tr>
                  <tr>
                    <th scope="row"><%= t('phone') %></th>
                    <td><%= contact.phone %></td>
                  </tr>
                  <tr>
                    <th scope="row"><%= t('email') %></th>
                    <td><%= contact.email %></td>
                  </tr>
                  <tr>
                    <th scope="row"><%= t('wechat') %></th>
                    <td><%= contact.wechat %></td>
                  </tr>
                </tbody>
              </table>
              <table class="detail-table">
                <tbody>
                  <tr>
                    <th scope="row"><%= t('educationBackground') %></th>
                    <td><%= contact.educationBackground %></td>
                  </tr>
                  <tr>
                    <th scope="row"><%= t('workExperience') %></th>
                    <td><%= contact.workExperience %></td>
                  </tr>
                  <tr>
                    <th scope="row"><%= t('keyAchievements') %></th>
                    <td><%= contact.keyAchievements %></td>
                  </tr>
                  <tr>
                    <th scope="row"><%= t('notes') %></th>
                    <td><%= contact.notes %></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>
<%- include('../partials/app-end') %>
