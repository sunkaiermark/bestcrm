<%- include('../partials/app-start', { title: contact.name + ' - BESTCRM', activeNav: 'contacts' }) %>
        <p class="breadcrumb"><a href="/contacts">Contacts</a></p>
        <header class="page-header">
          <h1><%= contact.name %></h1>
          <div class="page-actions">
            <a class="quick-action" href="/contacts/<%= contact.id %>/edit">Edit contact</a>
            <a class="quick-action" href="/opportunities/new?customerId=<%= contact.customerId %>&contactId=<%= contact.id %>">New opportunity</a>
            <% if (typeof canDeleteContact !== 'undefined' && canDeleteContact) { %>
              <form method="post" action="/contacts/<%= contact.id %>/delete" onsubmit="return confirm('Delete this contact?')">
                <button class="danger-action" type="submit">Delete contact</button>
              </form>
            <% } %>
          </div>
        </header>

        <section class="content-section">
          <h2>Contact detail</h2>
          <div class="section-body">
            <div class="basic-info-grid">
              <table class="detail-table">
                <tbody>
                  <tr>
                    <th scope="row">Customer</th>
                    <td><a href="/customers/<%= contact.customerId %>"><%= contact.customerName %></a></td>
                  </tr>
                  <tr>
                    <th scope="row">Title</th>
                    <td><%= contact.title %></td>
                  </tr>
                  <tr>
                    <th scope="row">Phone</th>
                    <td><%= contact.phone %></td>
                  </tr>
                  <tr>
                    <th scope="row">Email</th>
                    <td><%= contact.email %></td>
                  </tr>
                  <tr>
                    <th scope="row">WeChat</th>
                    <td><%= contact.wechat %></td>
                  </tr>
                </tbody>
              </table>
              <table class="detail-table">
                <tbody>
                  <tr>
                    <th scope="row">Education Background</th>
                    <td><%= contact.educationBackground %></td>
                  </tr>
                  <tr>
                    <th scope="row">Work Experience</th>
                    <td><%= contact.workExperience %></td>
                  </tr>
                  <tr>
                    <th scope="row">Key Achievements</th>
                    <td><%= contact.keyAchievements %></td>
                  </tr>
                  <tr>
                    <th scope="row">Notes</th>
                    <td><%= contact.notes %></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>
<%- include('../partials/app-end') %>
