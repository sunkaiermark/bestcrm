<%- include('../partials/app-start', { title: contact.name + ' - BESTCRM', activeNav: 'contacts' }) %>
        <p class="breadcrumb"><a href="/contacts">Contacts</a></p>
        <header class="page-header">
          <h1><%= contact.name %></h1>
          <div class="page-actions">
            <a class="quick-action" href="/contacts/<%= contact.id %>/edit">Edit contact</a>
            <a class="quick-action" href="/opportunities/new?customerId=<%= contact.customerId %>&contactId=<%= contact.id %>">New opportunity</a>
          </div>
        </header>

        <section class="content-section">
          <h2>Contact detail</h2>
          <div class="section-body">
            <dl class="detail-list">
              <dt>Customer</dt>
              <dd><a href="/customers/<%= contact.customerId %>"><%= contact.customerName %></a></dd>
              <dt>Title</dt>
              <dd><%= contact.title %></dd>
              <dt>Phone</dt>
              <dd><%= contact.phone %></dd>
              <dt>Email</dt>
              <dd><%= contact.email %></dd>
              <dt>WeChat</dt>
              <dd><%= contact.wechat %></dd>
              <dt>Notes</dt>
              <dd><%= contact.notes %></dd>
            </dl>
          </div>
        </section>
<%- include('../partials/app-end') %>
