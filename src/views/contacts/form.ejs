<%- include('../partials/app-start', { title: `${t('contactDetail')} - BESTCRM`, activeNav: 'contacts' }) %>
        <p class="breadcrumb"><a href="/contacts"><%= t('contacts') %></a></p>
        <header class="page-header">
          <h1><%= contact.id ? t('editContact') : t('newContact') %></h1>
        </header>

        <form class="form-panel" method="post" action="<%= action %>">
          <%- csrfField() %>
          <% if (typeof duplicateContacts !== 'undefined' && duplicateContacts.length) { %>
            <section class="duplicate-warning" role="alert">
              <strong><%= t('duplicateContactFound') %></strong>
              <p><%= t('duplicateContactCoordinationHint') %></p>
              <table class="duplicate-table">
                <thead>
                  <tr>
                    <th><%= t('contactCode') %></th>
                    <th><%= t('customer') %></th>
                    <th><%= t('name') %></th>
                    <th><%= t('phone') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% for (const duplicate of duplicateContacts) { %>
                    <tr>
                      <td><%= duplicate.contactCode %></td>
                      <td><%= [duplicate.customerCode, duplicate.customerName].filter(Boolean).join(' · ') %></td>
                      <td><%= duplicate.name %></td>
                      <td><%= duplicate.phone %></td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </section>
          <% } %>
          <% if (typeof returnTo !== 'undefined' && returnTo) { %>
            <input type="hidden" name="returnTo" value="<%= returnTo %>">
          <% } %>
          <% if (contact.id) { %>
            <label>
              <%= t('contactCode') %>
              <input value="<%= contact.contactCode || '' %>" readonly>
            </label>
          <% } else { %>
            <p class="muted"><%= t('contactCodeGeneratedAfterSave') %></p>
          <% } %>
          <label>
            <%= t('customer') %>
            <select name="customerId" required>
              <% for (const customer of customers) { %>
                <option value="<%= customer.id %>" <%= String(contact.customerId || '') === String(customer.id) ? 'selected' : '' %>><%= [customer.customerCode, customer.name].filter(Boolean).join(' · ') %></option>
              <% } %>
            </select>
          </label>
          <label>
            <%= t('name') %>
            <input name="name" value="<%= contact.name || '' %>" required>
          </label>
          <label>
            <%= t('title') %>
            <input name="title" value="<%= contact.title || '' %>">
          </label>
          <label>
            <%= t('phone') %>
            <input name="phone" value="<%= contact.phone || '' %>">
          </label>
          <label>
            <%= t('email') %>
            <input name="email" value="<%= contact.email || '' %>">
          </label>
          <label>
            <%= t('wechat') %>
            <input name="wechat" value="<%= contact.wechat || '' %>">
          </label>
          <label>
            <%= t('educationBackground') %>
            <textarea name="educationBackground"><%= contact.educationBackground || '' %></textarea>
          </label>
          <label>
            <%= t('workExperience') %>
            <textarea name="workExperience"><%= contact.workExperience || '' %></textarea>
          </label>
          <label>
            <%= t('keyAchievements') %>
            <textarea name="keyAchievements"><%= contact.keyAchievements || '' %></textarea>
          </label>
          <label>
            <%= t('notes') %>
            <textarea name="notes"><%= contact.notes || '' %></textarea>
          </label>
          <button type="submit"><%= contact.id ? t('saveContact') : t('createContact') %></button>
        </form>
<%- include('../partials/app-end') %>
