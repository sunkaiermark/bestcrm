<%- include('../partials/app-start', { title: 'Contacts - BESTCRM', activeNav: 'contacts' }) %>
        <header class="page-header">
          <h1><%= t('contacts') %></h1>
          <a class="quick-action" href="/contacts/new"><%= t('newContact') %></a>
        </header>

        <section class="list-section">
          <div class="list-body">
            <table class="list-table content-fit-table">
              <thead>
                <tr>
                  <th><%= t('name') %></th>
                  <th><%= t('customer') %></th>
                  <th>Title</th>
                  <th><%= t('phone') %></th>
                  <th><%= t('email') %></th>
                </tr>
              </thead>
              <tbody>
                <% for (const contact of contacts) { %>
                  <tr>
                    <td><a href="/contacts/<%= contact.id %>"><%= contact.name %></a></td>
                    <td><a href="/customers/<%= contact.customerId %>"><%= contact.customerName %></a></td>
                    <td><%= contact.title %></td>
                    <td><%= contact.phone %></td>
                    <td><%= contact.email %></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
<%- include('../partials/app-end') %>
