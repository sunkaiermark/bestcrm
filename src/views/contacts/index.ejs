<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Contacts - BESTCRM</title>
  </head>
  <body>
    <main>
      <h1>Contacts</h1>
      <p><a href="/contacts/new">New contact</a></p>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Customer</th>
            <th>Title</th>
            <th>Phone</th>
            <th>Email</th>
          </tr>
        </thead>
        <tbody>
          <% for (const contact of contacts) { %>
            <tr>
              <td><a href="/contacts/<%= contact.id %>"><%= contact.name %></a></td>
              <td><a href="/customers/<%= contact.customerId %>"><%= contact.customerName %></a></td>
              <td><%= contact.title %></td>
              <td><%= contact.phone %></td>
              <td><%= contact.email %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </main>
  </body>
</html>
