<%- include('../partials/app-start', { title: `${t('contacts')} - BESTCRM`, activeNav: 'contacts' }) %>
        <header class="page-header">
          <h1><%= t('contacts') %></h1>
          <a class="quick-action" href="/contacts/new"><%= t('newContact') %></a>
        </header>

        <section class="list-section">
          <form class="form-panel opportunity-filter-panel" method="get" action="/contacts">
            <label class="opportunity-search-field">
              <%= t('keyword') %>
              <input name="q" type="search" value="<%= filters.searchTerm %>" placeholder="<%= t('contactSearchPlaceholder') %>">
            </label>
            <label>
              <%= t('archive') %>
              <select name="archiveScope">
                <option value="active"<%= filters.archiveScope === 'active' ? ' selected' : '' %>><%= t('activeRecords') %></option>
                <option value="archived"<%= filters.archiveScope === 'archived' ? ' selected' : '' %>><%= t('archivedRecords') %></option>
                <option value="all"<%= filters.archiveScope === 'all' ? ' selected' : '' %>><%= t('allRecords') %></option>
              </select>
            </label>
            <button type="submit"><%= t('search') %></button>
            <a class="secondary-action" href="/contacts"><%= t('clearFilters') %></a>
          </form>
          <div class="list-body record-list-body contact-list-body" tabindex="0" aria-label="<%= t('contacts') %>">
            <table class="list-table record-list-table contact-list-table">
              <thead>
                <tr>
                  <th scope="col"><%= t('contactCode') %></th>
                  <th scope="col"><%= t('name') %></th>
                  <th scope="col"><%= t('customer') %></th>
                  <th scope="col"><%= t('title') %></th>
                  <th scope="col"><%= t('phone') %></th>
                  <th scope="col"><%= t('email') %></th>
                </tr>
              </thead>
              <tbody>
                <% for (const contact of contacts) { %>
                  <tr>
                    <td data-label="<%= t('contactCode') %>"><a href="/contacts/<%= contact.id %>"><%= contact.contactCode %></a></td>
                    <td data-label="<%= t('name') %>"><a href="/contacts/<%= contact.id %>"><%= contact.name %></a></td>
                    <td data-label="<%= t('customer') %>"><a href="/customers/<%= contact.customerId %>" title="<%= [contact.customerCode, contact.customerName].filter(Boolean).join(' · ') %>"><%= [contact.customerCode, contact.customerName].filter(Boolean).join(' · ') %></a></td>
                    <td data-label="<%= t('title') %>"><%= contact.title %></td>
                    <td data-label="<%= t('phone') %>"><%= contact.phone %></td>
                    <td data-label="<%= t('email') %>"><%= contact.email %></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
<%- include('../partials/app-end') %>
