<%- include('../partials/app-start', { title: customer.name + ' - BESTCRM', activeNav: 'customers' }) %>
        <p class="breadcrumb"><a href="/customers">Customers</a></p>
        <header class="page-header">
          <h1><%= customer.name %></h1>
          <div class="page-actions">
            <a class="quick-action" href="/customers/<%= customer.id %>/edit">Edit customer</a>
            <% if (typeof canDeleteCustomer !== 'undefined' && canDeleteCustomer) { %>
              <form method="post" action="/customers/<%= customer.id %>/delete" onsubmit="return confirm('Delete this customer and its contacts?')">
                <button class="danger-action" type="submit">Delete customer</button>
              </form>
            <% } %>
          </div>
        </header>

        <section class="content-section">
          <h2>Customer detail</h2>
          <div class="section-body">
            <div class="basic-info-grid">
              <table class="detail-table">
                <tbody>
                  <tr>
                    <th scope="row">Industry</th>
                    <td><%= customer.industry %></td>
                  </tr>
                  <tr>
                    <th scope="row">Country</th>
                    <td><%= customer.country %></td>
                  </tr>
                </tbody>
              </table>
              <table class="detail-table">
                <tbody>
                  <tr>
                    <th scope="row">Region</th>
                    <td><%= customer.region %></td>
                  </tr>
                  <tr>
                    <th scope="row">Address</th>
                    <td><%= customer.address %></td>
                  </tr>
                  <tr>
                    <th scope="row">Notes</th>
                    <td><%= customer.notes %></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section class="content-section">
          <h2>Contacts</h2>
          <div class="section-body">
            <p><a href="/contacts/new?customerId=<%= customer.id %>">New contact</a></p>
            <ul class="inline-list">
              <% for (const contact of customer.contacts || []) { %>
                <li>
                  <a href="/contacts/<%= contact.id %>"><%= contact.name %></a>
                  <span class="muted"><%= contact.title %></span>
                  <span><%= contact.phone %></span>
                  <span><%= contact.email %></span>
                  <a href="/opportunities/new?customerId=<%= customer.id %>&contactId=<%= contact.id %>">New opportunity</a>
                </li>
              <% } %>
            </ul>
          </div>
        </section>
<%- include('../partials/app-end') %>
