<%- include('../partials/app-start', { title: customer.name + ' - BESTCRM', activeNav: 'customers' }) %>
        <p class="breadcrumb"><a href="/customers"><%= t('customers') %></a></p>
        <header class="page-header">
          <h1><%= customer.name %></h1>
          <div class="page-actions">
            <a class="quick-action" href="/customers/<%= customer.id %>/edit"><%= t('editCustomer') %></a>
            <% if (typeof canDeleteCustomer !== 'undefined' && canDeleteCustomer) { %>
              <form method="post" action="/customers/<%= customer.id %>/delete" onsubmit="return confirm('Delete this customer and its contacts?')">
                <button class="danger-action" type="submit"><%= t('deleteCustomer') %></button>
              </form>
            <% } %>
          </div>
        </header>

        <section class="content-section">
          <h2><%= t('customerDetail') %></h2>
          <div class="section-body">
            <div class="basic-info-grid">
              <table class="detail-table">
                <tbody>
                  <tr>
                    <th scope="row">Industry</th>
                    <td><%= customer.industry %></td>
                  </tr>
                  <tr>
                    <th scope="row"><%= t('country') %></th>
                    <td><%= customer.country %></td>
                  </tr>
                  <tr>
                    <th scope="row">Parent Company</th>
                    <td><%= customer.parentCompany %></td>
                  </tr>
                </tbody>
              </table>
              <table class="detail-table">
                <tbody>
                  <tr>
                    <th scope="row"><%= t('region') %></th>
                    <td><%= customer.region %></td>
                  </tr>
                  <tr>
                    <th scope="row">Address</th>
                    <td><%= customer.address %></td>
                  </tr>
                </tbody>
              </table>
              <table class="detail-table detail-table-wide">
                <tbody>
                  <tr>
                    <th scope="row">Enterprise Nature</th>
                    <td><%= customer.enterpriseNature %></td>
                  </tr>
                </tbody>
              </table>
              <table class="detail-table detail-table-wide">
                <tbody>
                  <tr>
                    <th scope="row"><%= t('companyHighlights') %></th>
                    <td><%= customer.companyHighlights %></td>
                  </tr>
                </tbody>
              </table>
              <table class="detail-table detail-table-wide">
                <tbody>
                  <tr>
                    <th scope="row">Notes</th>
                    <td><%= customer.notes %></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section class="content-section">
          <h2><%= t('contacts') %></h2>
          <div class="section-body">
            <p><a href="/contacts/new?customerId=<%= customer.id %>"><%= t('newContact') %></a></p>
            <% if ((customer.contacts || []).length > 0) { %>
              <table class="list-table content-fit-table">
                <thead>
                  <tr>
                    <th><%= t('name') %></th>
                    <th>Title</th>
                    <th><%= t('phone') %></th>
                    <th><%= t('email') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% for (const contact of customer.contacts || []) { %>
                    <tr>
                      <td><a href="/contacts/<%= contact.id %>"><%= contact.name %></a></td>
                      <td><%= contact.title %></td>
                      <td><%= contact.phone %></td>
                      <td><%= contact.email %></td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            <% } else { %>
              <p class="empty">No contacts.</p>
            <% } %>
          </div>
        </section>
<%- include('../partials/app-end') %>
