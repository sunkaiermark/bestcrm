<%- include('../partials/app-start', { title: customer.name + ' - BESTCRM', activeNav: 'customers' }) %>
        <p class="breadcrumb"><a href="/customers">Customers</a></p>
        <header class="page-header">
          <h1><%= customer.name %></h1>
          <div class="page-actions">
            <a class="quick-action" href="/customers/<%= customer.id %>/edit">Edit customer</a>
            <a class="quick-action" href="/opportunities/new?customerId=<%= customer.id %>">New opportunity</a>
          </div>
        </header>

        <section class="content-section">
          <h2>Customer detail</h2>
          <div class="section-body">
            <dl class="detail-list">
              <dt>Industry</dt>
              <dd><%= customer.industry %></dd>
              <dt>Region</dt>
              <dd><%= customer.region %></dd>
              <dt>Address</dt>
              <dd><%= customer.address %></dd>
              <dt>Notes</dt>
              <dd><%= customer.notes %></dd>
            </dl>
          </div>
        </section>

        <section class="content-section">
          <h2>Contacts</h2>
          <div class="section-body">
            <p><a href="/contacts/new?customerId=<%= customer.id %>">New contact</a></p>
            <ul class="inline-list">
              <% for (const contact of customer.contacts || []) { %>
                <li>
                  <a href="/contacts/<%= contact.id %>"><%= contact.name %></a>
                  <span class="muted"><%= contact.title %></span>
                  <span><%= contact.phone %></span>
                  <span><%= contact.email %></span>
                  <a href="/opportunities/new?customerId=<%= customer.id %>&contactId=<%= contact.id %>">New opportunity</a>
                </li>
              <% } %>
            </ul>
          </div>
        </section>
<%- include('../partials/app-end') %>
