<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Customer - BESTCRM</title>
  </head>
  <body>
    <main>
      <p><a href="/customers">Customers</a></p>
      <h1>Customer</h1>
      <form method="post" action="<%= action %>">
        <label>
          Name
          <input name="name" value="<%= customer.name || '' %>" required>
        </label>
        <label>
          Industry
          <input name="industry" value="<%= customer.industry || '' %>">
        </label>
        <label>
          Region
          <input name="region" value="<%= customer.region || '' %>">
        </label>
        <label>
          Address
          <input name="address" value="<%= customer.address || '' %>">
        </label>
        <label>
          Notes
          <textarea name="notes"><%= customer.notes || '' %></textarea>
        </label>
        <button type="submit">Save</button>
      </form>
    </main>
  </body>
</html>
