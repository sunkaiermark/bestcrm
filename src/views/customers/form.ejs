<%- include('../partials/app-start', { title: `${t('customerDetail')} - BESTCRM`, activeNav: 'customers' }) %>
        <p class="breadcrumb"><a href="/customers"><%= t('customers') %></a></p>
        <header class="page-header">
          <h1><%= customer.id ? t('editCustomer') : t('newCustomer') %></h1>
        </header>

        <form class="form-panel" method="post" action="<%= action %>">
          <%- csrfField() %>
          <label>
            <%= t('name') %>
            <input name="name" value="<%= customer.name || '' %>" required>
          </label>
          <label>
            <%= t('website') %>
            <input name="website" type="text" inputmode="url" placeholder="https://www.example.com" value="<%= customer.website || '' %>">
          </label>
          <label>
            <%= t('industry') %>
            <select name="industry">
              <% const currentIndustry = customer.industry || ''; %>
              <% const availableIndustries = typeof industryOptions !== 'undefined' ? industryOptions : []; %>
              <option value=""><%= t('selectIndustry') %></option>
              <% if (currentIndustry && !availableIndustries.includes(currentIndustry)) { %>
                <option value="<%= currentIndustry %>" selected><%= currentIndustry %></option>
              <% } %>
              <% for (const industry of availableIndustries) { %>
                <option value="<%= industry %>"<%= currentIndustry === industry ? ' selected' : '' %>><%= industry %></option>
              <% } %>
            </select>
          </label>
          <label>
            <%= t('parentCompany') %>
            <input name="parentCompany" value="<%= customer.parentCompany || '' %>">
          </label>
          <label>
            <%= t('enterpriseNature') %>
            <select name="enterpriseNature">
              <% const currentEnterpriseNature = customer.enterpriseNature || ''; %>
              <% const availableEnterpriseNatures = typeof enterpriseNatureOptions !== 'undefined' ? enterpriseNatureOptions : []; %>
              <option value=""><%= t('selectEnterpriseNature') %></option>
              <% if (currentEnterpriseNature && !availableEnterpriseNatures.includes(currentEnterpriseNature)) { %>
                <option value="<%= currentEnterpriseNature %>" selected><%= currentEnterpriseNature %></option>
              <% } %>
              <% for (const enterpriseNature of availableEnterpriseNatures) { %>
                <option value="<%= enterpriseNature %>"<%= currentEnterpriseNature === enterpriseNature ? ' selected' : '' %>><%= enterpriseNature %></option>
              <% } %>
            </select>
          </label>
          <label>
            <%= t('country') %>
            <select name="country">
              <% const currentCountry = customer.country || ''; %>
              <% const availableCountries = typeof countryOptions !== 'undefined' ? countryOptions : []; %>
              <option value=""><%= t('selectCountry') %></option>
              <% if (currentCountry && !availableCountries.includes(currentCountry)) { %>
                <option value="<%= currentCountry %>" selected><%= currentCountry %></option>
              <% } %>
              <% for (const country of availableCountries) { %>
                <option value="<%= country %>"<%= currentCountry === country ? ' selected' : '' %>><%= country %></option>
              <% } %>
            </select>
          </label>
          <label>
            <%= t('region') %>
            <select name="region">
              <% const currentRegion = customer.region || ''; %>
              <% const availableRegions = typeof regionOptions !== 'undefined' ? regionOptions : []; %>
              <option value=""><%= t('selectRegion') %></option>
              <% if (currentRegion && !availableRegions.includes(currentRegion)) { %>
                <option value="<%= currentRegion %>" selected><%= currentRegion %></option>
              <% } %>
              <% for (const region of availableRegions) { %>
                <option value="<%= region %>"<%= currentRegion === region ? ' selected' : '' %>><%= region %></option>
              <% } %>
            </select>
          </label>
          <label>
            <%= t('address') %>
            <input name="address" value="<%= customer.address || '' %>">
          </label>
          <label>
            <%= t('companyHighlights') %>
            <textarea name="companyHighlights"><%= customer.companyHighlights || '' %></textarea>
          </label>
          <label>
            <%= t('customerOutline') %>
            <textarea name="notes"><%= customer.notes || '' %></textarea>
          </label>
          <button type="submit"><%= t('save') %></button>
        </form>
<%- include('../partials/app-end') %>
