<%- include('../partials/app-start', { title: 'Customer - BESTCRM', activeNav: 'customers' }) %>
        <p class="breadcrumb"><a href="/customers">Customers</a></p>
        <header class="page-header">
          <h1><%= customer.id ? 'Edit Customer' : 'New Customer' %></h1>
        </header>

        <form class="form-panel" method="post" action="<%= action %>">
          <label>
            Name
            <input name="name" value="<%= customer.name || '' %>" required>
          </label>
          <label>
            Industry
            <input name="industry" value="<%= customer.industry || '' %>">
          </label>
          <label>
            Country
            <select name="country">
              <option value="">Select country</option>
              <% for (const country of (typeof countryOptions !== 'undefined' ? countryOptions : [])) { %>
                <option value="<%= country %>" <%= (customer.country || '') === country ? 'selected' : '' %>><%= country %></option>
              <% } %>
            </select>
          </label>
          <label>
            Region
            <select name="region">
              <% const currentRegion = customer.region || ''; %>
              <% const availableRegions = typeof regionOptions !== 'undefined' ? regionOptions : []; %>
              <option value="">Select region</option>
              <% if (currentRegion && !availableRegions.includes(currentRegion)) { %>
                <option value="<%= currentRegion %>" selected><%= currentRegion %></option>
              <% } %>
              <% for (const region of availableRegions) { %>
                <option value="<%= region %>"<%= currentRegion === region ? ' selected' : '' %>><%= region %></option>
              <% } %>
            </select>
          </label>
          <label>
            Address
            <input name="address" value="<%= customer.address || '' %>">
          </label>
          <label>
            Notes
            <textarea name="notes"><%= customer.notes || '' %></textarea>
          </label>
          <button type="submit">Save</button>
        </form>
<%- include('../partials/app-end') %>
