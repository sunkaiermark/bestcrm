<%- include('../partials/app-start', { title: `${t('customers')} - BESTCRM`, activeNav: 'customers' }) %>
        <header class="page-header">
          <h1><%= t('customers') %></h1>
          <a class="quick-action" href="/customers/new"><%= t('newCustomer') %></a>
        </header>

        <section class="list-section">
          <form class="form-panel opportunity-filter-panel" method="get" action="/customers">
            <label class="opportunity-search-field">
              <%= t('keyword') %>
              <input name="q" type="search" value="<%= filters.searchTerm %>" placeholder="<%= t('customerSearchPlaceholder') %>">
            </label>
            <label>
              <%= t('archive') %>
              <select name="archiveScope">
                <option value="active"<%= filters.archiveScope === 'active' ? ' selected' : '' %>><%= t('activeRecords') %></option>
                <option value="archived"<%= filters.archiveScope === 'archived' ? ' selected' : '' %>><%= t('archivedRecords') %></option>
                <option value="all"<%= filters.archiveScope === 'all' ? ' selected' : '' %>><%= t('allRecords') %></option>
              </select>
            </label>
            <button type="submit"><%= t('search') %></button>
            <a class="secondary-action" href="/customers"><%= t('clearFilters') %></a>
          </form>
          <div class="list-body">
            <table class="list-table content-fit-table">
              <thead>
                <tr>
                  <th><%= t('customerCode') %></th>
                  <th><%= t('name') %></th>
                  <th><%= t('industry') %></th>
                  <th><%= t('country') %></th>
                  <th><%= t('region') %></th>
                  <th><%= t('contacts') %></th>
                </tr>
              </thead>
              <tbody>
                <% for (const customer of customers) { %>
                  <tr>
                    <td><a href="/customers/<%= customer.id %>"><%= customer.customerCode %></a></td>
                    <td><a href="/customers/<%= customer.id %>"><%= customer.name %></a></td>
                    <td><%= customer.industry %></td>
                    <td><%= customer.country %></td>
                    <td><%= customer.region %></td>
                    <td><%= customer.contactCount %></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
<%- include('../partials/app-end') %>
