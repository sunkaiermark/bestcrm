<%- include('../partials/app-start', { title: 'New Development Project - BESTCRM', activeNav: 'development' }) %>
<% const zh = language === 'zh'; %>
<style>
  .development-project-new { width: 100%; margin: 0; }
  .development-project-new form { display: grid; gap: 15px; padding: 20px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; }
  .development-project-new label { display: grid; gap: 6px; }
  .development-project-new .date-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .development-project-new button { justify-self: start; }
  @media (max-width: 600px) { .development-project-new .date-row { grid-template-columns: 1fr; } }
</style>
<section class="development-project-new">
  <p class="breadcrumb"><a href="/development/projects"><%= zh ? '返回项目总览' : 'Back to projects' %></a></p>
  <header class="page-header"><h1><%= zh ? '新建研发项目' : 'New R&D project' %></h1></header>
  <% if (error) { %><p role="alert" class="error"><%= error %></p><% } %>
  <form method="post" action="/development/projects">
    <%- csrfField() %>
    <label><%= zh ? '项目名称' : 'Project title' %><input name="title" maxlength="200" value="<%= form?.title || '' %>" required></label>
    <label><%= zh ? '目标与范围' : 'Objective and scope' %><textarea name="objective" maxlength="10000" rows="5"><%= form?.objective || '' %></textarea></label>
    <div class="date-row">
      <label><%= zh ? '计划开始' : 'Planned start' %><input type="date" name="plannedStartOn" value="<%= form?.plannedStartOn || '' %>" required></label>
      <label><%= zh ? '计划结束' : 'Planned finish' %><input type="date" name="plannedEndOn" value="<%= form?.plannedEndOn || '' %>" required></label>
    </div>
    <p class="muted"><%= zh ? '创建者自动成为项目负责人；项目只对已邀请的在职成员可见。' : 'The creator becomes project owner. Only invited active members can view it.' %></p>
    <button type="submit"><%= zh ? '建立项目' : 'Create project' %></button>
  </form>
</section>
<%- include('../partials/app-end') %>
