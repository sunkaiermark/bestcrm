  } : {
    back: 'Back to topic overview', source: 'Source', phase: 'Phase', result: 'Result', owner: 'Owner',
    directions: 'Industrial directions', problem: 'Problem and objective', noProblem: 'No problem summary yet',
    overview: 'Topic overview', foundation: 'Foundation research', development: 'Development and validation',
    collaboration: 'Collaboration and decisions', outcomes: 'Outcomes and versions', business: 'Business links',
    internalOnly: 'Internal development workspace; concept approval is not customer or engineering-drawing approval.',
    researchNote: 'Research, competitor and patent analysis, and raw experiments stay within topic access; a business link does not disclose them.',
    conceptGate: 'Concept gate', conceptUnavailable: 'Concept gate information is not loaded.',
    noConcept: 'No concept revision yet. Explore options and record evidence first.',
    conceptDraft: 'Concept revision draft, not submitted', conceptSubmitted: 'Submitted for technical-manager decision',
    conceptApproved: 'Concept approved', conceptRevise: 'Revision required before resubmission',
    conceptRevision: 'Current revision', conceptPreview: 'View immutable concept snapshot',
    conceptDecision: 'Technical-manager decision', handoffReady: 'Formal design handoff can be requested; none is recorded yet.',
    handoffRecorded: 'Formal design handoff is recorded in CRM; product engineering owns the authoritative design.',
    noHandoff: 'Not qualified for formal design handoff; exploration is not formal design.',
    noOutcome: 'No independently reviewed outcome has been published. Exploration is not a mature technical asset.',
    noBusiness: 'Opportunity links and customer-facing reuse are not enabled; research originals are never copied automatically.',
    members: 'Open memberships', memberNote: 'Only the topic owner may invite or end memberships. An inactive account cannot read files; ending its membership also prevents access after reactivation. Audit history is retained.',
    addMember: 'Invite a member', chooseMember: 'Choose an active employee', invite: 'Add to topic',
    noCandidates: 'No active employees are available to invite', remove: 'End membership',
    ownerRole: 'Topic owner', memberRole: 'Member', inactive: 'Account inactive',
    pending: 'Undetermined',
    research: 'Research materials', noDirections: 'Not selected',
    discussion: 'Team discussion', discussionNote: 'Only current topic members can read and post. Internal comments are retained without editing or deletion; discussion is not a technical approval.',
