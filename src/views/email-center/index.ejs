<%- include('../partials/app-start', { title: `${t('emailCenter')} - BESTCRM`, activeNav: 'email-center' }) %>
        <header class="page-header">
          <div>
            <p class="breadcrumb"><%= t('emailCenter') %></p>
            <h1><%= t('emailCenter') %></h1>
          </div>
        </header>

        <% if (mailboxes.length) { %>
          <form class="email-mailbox-picker" method="get" action="/email-center">
            <label for="email-mailbox"><%= t('mailbox') %></label>
            <select id="email-mailbox" name="mailbox" onchange="this.form.submit()">
              <% for (const item of mailboxes) { %>
                <option value="<%= item.key %>"<%= mailbox && mailbox.key === item.key ? ' selected' : '' %>><%= item.type === 'shared' ? t('emailMailboxShared') : t('emailMailboxPersonal') %> · <%= item.label %><%= item.ownerDisplayName ? ` · ${item.ownerDisplayName}` : '' %></option>
              <% } %>
            </select>
            <input type="hidden" name="folder" value="pending">
            <% if (category) { %><input type="hidden" name="category" value="<%= category %>"><% } %>
          </form>

          <nav class="email-folder-tabs" aria-label="<%= t('emailArchiveFolders') %>">
            <% for (const item of ['pending', 'inbox', 'sent', 'spam', 'non_business']) { %>
              <a class="email-folder-tab<%= folder === item ? ' is-active' : '' %>" href="/email-center?mailbox=<%= encodeURIComponent(mailbox.key) %>&folder=<%= item %><%= category && ['pending', 'sent'].includes(item) ? `&category=${encodeURIComponent(category)}` : '' %><%= searchTerm && item === 'inbox' ? `&q=${encodeURIComponent(searchTerm)}` : '' %>"<% if (folder === item) { %> aria-current="page"<% } %>><%= t(`emailTriageFolder.${item}`) %></a>
            <% } %>
          </nav>

          <% if (folder === 'inbox') { %>
            <form class="email-search-filter" method="get" action="/email-center">
              <input type="hidden" name="mailbox" value="<%= mailbox.key %>">
              <input type="hidden" name="folder" value="inbox">
              <label for="email-search"><%= t('emailSearchLabel') %></label>
              <input id="email-search" name="q" type="search" value="<%= searchTerm %>" maxlength="200" placeholder="<%= t('emailSearchPlaceholder') %>">
              <button type="submit"><%= t('search') %></button>
              <% if (searchTerm) { %><a class="secondary-action" href="/email-center?mailbox=<%= encodeURIComponent(mailbox.key) %>&folder=inbox"><%= t('clearFilters') %></a><% } %>
            </form>
          <% } else if (!['spam', 'non_business'].includes(folder)) { %>
            <form class="email-category-filter" method="get" action="/email-center">
              <input type="hidden" name="mailbox" value="<%= mailbox.key %>">
              <input type="hidden" name="folder" value="<%= folder %>">
              <label for="email-category"><%= t('emailRuleCategory') %></label>
              <select id="email-category" name="category" onchange="this.form.submit()">
                <option value=""><%= t('emailCategory.all') %></option>
                <% for (const item of classificationCategories) { %><option value="<%= item %>"<%= category === item ? ' selected' : '' %>><%= t(`emailCategory.${item}`) %></option><% } %>
              </select>
            </form>
          <% } %>

          <% if (folder === 'pending') { %><p class="email-pending-definition"><%= t('emailPendingDefinition') %></p><% } %>
          <% if (cleanup) { const isSpamCleanup = folder === 'spam'; %>
            <section class="form-panel email-spam-cleanup is-compact" aria-label="<%= t(isSpamCleanup ? 'emailSpamCleanup' : 'emailNonBusinessCleanup') %>">
              <form class="inline-form" method="post" action="/email-center/<%= folder %>/purge" onsubmit="return confirm('<%= t(isSpamCleanup ? 'emailSpamCleanupConfirm' : 'emailNonBusinessCleanupConfirm') %>')">
                <%- csrfField() %>
                <input type="hidden" name="mailbox" value="<%= mailbox.key %>">
                <label><span><%= t('emailSpamCleanupTypeDelete') %></span><input name="confirmation" autocomplete="off" required pattern="DELETE" placeholder="DELETE"<%= cleanup.eligibleThreads ? '' : ' disabled' %>></label>
                <button class="danger-action" type="submit"<%= cleanup.eligibleThreads ? '' : ' disabled' %>><%= t(isSpamCleanup ? 'emailSpamCleanupAction' : 'emailNonBusinessCleanupAction') %></button>
              </form>
            </section>
          <% } %>
        <% } %>

        <section class="email-inbox-list" aria-label="<%= t('emailCenter') %>">
          <% for (const thread of threads) { %>
            <div class="email-inbox-row-shell">
              <a class="email-inbox-row" href="/email-center/threads/<%= thread.id %>?mailbox=<%= encodeURIComponent(mailbox.key) %>&from=<%= folder %><%= category ? `&category=${encodeURIComponent(category)}` : '' %><%= searchTerm ? `&q=${encodeURIComponent(searchTerm)}` : '' %>" title="<%= t('openEmailThread') %>">
                <span class="email-inbox-sender" title="<%= thread.lastFromAddress %>"><%= thread.lastFromAddress || '-' %></span>
                <span class="email-inbox-main">
                  <span class="email-inbox-summary">
                    <strong class="email-inbox-subject"><%= thread.subject || t('noSubject') %></strong>
                    <% if (thread.messageCount > 1) { %><span class="email-inbox-message-count" title="<%= t('messageCount') %>">(<%= thread.messageCount %>)</span><% } %>
                    <span class="email-inbox-separator" aria-hidden="true">—</span>
                    <span class="email-inbox-preview" title="<%= thread.lastTextPreview %>"><%= thread.lastTextPreview %></span>
                  </span>
                  <span class="email-inbox-triage"><span class="email-category-badge"><%= t(`emailCategory.${thread.classificationCategory}`) %></span> · <%= t(`emailTriageStatus.${thread.triageStatus}`) %><% if (thread.triageAssignedDisplayName) { %> · <%= thread.triageAssignedDisplayName %><% } %></span>
                </span>
                <span class="email-inbox-attachment<%= thread.attachmentCount ? '' : ' is-empty' %>" title="<%= t('attachmentCount') %>"><% if (thread.attachmentCount) { %><span aria-hidden="true">📎</span> <%= thread.attachmentCount %><% } %></span>
                <time class="email-inbox-time" datetime="<%= thread.lastMessageAt || '' %>"><%= formatEmailListDate(thread.lastMessageAt) %></time>
              </a>
              <% if (['spam', 'non_business'].includes(folder) && cleanup) { const blockedReason = thread.purgeBlockedReason || 'protected_business_history'; %>
                <span class="email-row-delete-control">
                  <% if (thread.purgeEligible) { %>
                    <a class="danger-action email-spam-row-delete" href="/email-center/threads/<%= thread.id %>?mailbox=<%= encodeURIComponent(mailbox.key) %>&from=<%= folder %><%= category ? `&category=${encodeURIComponent(category)}` : '' %>#email-delete"><%= t('emailSpamDeleteOneAction') %></a>
                  <% } else { %>
                    <button class="danger-action email-spam-row-delete" type="button" disabled><%= t('emailSpamDeleteOneAction') %></button>
                    <small class="email-delete-blocked-reason"><%= t('emailDeleteBlockedLabel') %>：<%= t(`emailDeleteBlockedReason.${blockedReason}`) %></small>
                  <% } %>
                </span>
              <% } %>
            </div>
          <% } %>
          <% if (!threads.length) { %><p class="empty"><%= t('noEmailThreads') %></p><% } %>
        </section>
<%- include('../partials/app-end') %>
