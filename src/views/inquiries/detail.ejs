<%- include('../partials/app-start', { title: `${inquiry.subject || t('inquiry')} - BESTCRM`, activeNav: 'inquiries' }) %>
        <p class="breadcrumb"><a href="/inquiries"><%= t('inquiries') %></a></p>
        <header class="page-header">
          <div>
            <p class="breadcrumb"><%= t(`inquirySource.${inquiry.source}`) %></p>
            <h1><%= inquiry.subject || inquiry.companyName || `${t('inquiry')} #${inquiry.id}` %></h1>
          </div>
          <div class="inline-actions">
            <% if (inquiry.convertedOpportunityId) { %>
              <a class="quick-action" href="/opportunities/<%= inquiry.convertedOpportunityId %>"><%= t('viewOpportunity') %></a>
            <% } %>
            <% if (inquiry.matchedCustomerId) { %>
              <a class="secondary-action" href="/customers/<%= inquiry.matchedCustomerId %>"><%= t('viewCustomer') %></a>
            <% } %>
            <% if (inquiry.matchedContactId) { %>
              <a class="secondary-action" href="/contacts/<%= inquiry.matchedContactId %>"><%= t('viewContact') %></a>
            <% } %>
            <% if (canDeleteInquiry) { %>
              <form method="post" action="/inquiries/<%= inquiry.id %>/delete" onsubmit="return confirm('<%= t('deleteInquiryConfirm') %>')">
                <%- csrfField() %>
                <button class="danger-action" type="submit"><%= t('delete') %></button>
              </form>
            <% } %>
          </div>
        </header>

        <section class="content-section">
          <h2><%= t('inquiryDetail') %></h2>
          <div class="basic-info-grid">
            <table class="detail-table">
              <tbody>
                <tr><th scope="row"><%= t('source') %></th><td><%= t(`inquirySource.${inquiry.source}`) %></td></tr>
                <tr><th scope="row"><%= t('sourceReference') %></th><td><%= inquiry.sourceReference || '' %></td></tr>
                <tr><th scope="row"><%= t('receivedAt') %></th><td><%= inquiry.sourceReceivedAt || inquiry.createdAt || '' %></td></tr>
                <tr><th scope="row"><%= t('status') %></th><td><span class="status"><%= t(`inquiryStatus.${inquiry.status}`) %></span></td></tr>
                <tr><th scope="row"><%= t('priority') %></th><td><%= t(`inquiryPriority.${inquiry.priority}`) %></td></tr>
              </tbody>
            </table>
            <table class="detail-table">
              <tbody>
                <tr><th scope="row"><%= t('companyName') %></th><td><%= inquiry.companyName || '' %></td></tr>
                <tr><th scope="row"><%= t('contactName') %></th><td><%= inquiry.contactName || '' %></td></tr>
                <tr><th scope="row"><%= t('email') %></th><td><%= inquiry.contactEmail || '' %></td></tr>
                <tr><th scope="row"><%= t('phone') %></th><td><%= inquiry.contactPhone || '' %></td></tr>
                <tr><th scope="row"><%= t('country') %></th><td><%= inquiry.country || '' %></td></tr>
              </tbody>
            </table>
            <table class="detail-table detail-table-wide">
              <tbody>
                <tr><th scope="row"><%= t('productInterest') %></th><td><%= inquiry.productInterest || '' %></td></tr>
                <tr><th scope="row"><%= t('opportunityType') %></th><td><%= inquiry.opportunityType || '' %></td></tr>
                <tr><th scope="row"><%= t('requirement') %></th><td class="detail-text-cell"><%= inquiry.requirementText || '' %></td></tr>
                <tr><th scope="row"><%= t('reviewNote') %></th><td class="detail-text-cell"><%= inquiry.reviewNote || '' %></td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <% if ((duplicateCustomers || []).length) { %>
          <section class="duplicate-warning" role="alert">
            <strong><%= t('duplicateCustomerFound') %></strong>
            <p><%= t('duplicateCustomerCoordinationHint') %></p>
            <table class="duplicate-table">
              <thead><tr><th><%= t('customer') %></th><th><%= t('owner') %></th><th><%= t('contacts') %></th></tr></thead>
              <tbody>
                <% for (const duplicate of duplicateCustomers) { %>
                  <tr>
                    <td><a href="/customers/<%= duplicate.id %>"><%= duplicate.name %></a></td>
                    <td><%= duplicate.ownerDisplayName || duplicate.ownerUsername || '-' %></td>
                    <td><%= duplicate.contactCount %></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </section>
        <% } %>

        <section class="content-section">
          <h2><%= t('inquiryAttachments') %></h2>
          <% if ((inquiryAttachments || []).length > 0) { %>
            <div class="table-scroll">
              <table class="data-table">
                <thead>
                  <tr>
                    <th scope="col"><%= t('fileName') %></th>
                    <th scope="col"><%= t('fileSize') %></th>
                    <th scope="col"><%= t('receivedAt') %></th>
                    <th scope="col"><%= t('actions') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% for (const attachment of inquiryAttachments) { %>
                    <tr>
                      <td><%= attachment.originalName %></td>
                      <td><%= attachment.fileSize %></td>
                      <td><%= attachment.uploadedAt || '' %></td>
                      <td>
                        <div class="inline-actions">
                          <a href="/inquiries/<%= inquiry.id %>/attachments/<%= attachment.id %>/preview"><%= t('preview') %></a>
                          <a href="/inquiries/<%= inquiry.id %>/attachments/<%= attachment.id %>/download"><%= t('download') %></a>
                        </div>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p class="muted"><%= t('noInquiryAttachments') %></p>
          <% } %>
        </section>

        <% if (canProcessInquiry) { %>
        <section class="content-section">
          <h2><%= t('reviewInquiry') %></h2>
          <form class="form-panel" method="post" action="/inquiries/<%= inquiry.id %>/review">
            <%- csrfField() %>
            <label>
              <%= t('status') %>
              <select name="status">
                <% for (const status of reviewStatuses) { %>
                  <option value="<%= status %>"<%= inquiry.status === status ? ' selected' : '' %>><%= t(`inquiryStatus.${status}`) %></option>
                <% } %>
              </select>
            </label>
            <label>
              <%= t('subject') %>
              <input name="subject" value="<%= inquiry.subject || '' %>">
            </label>
            <label>
              <%= t('companyName') %>
              <input name="companyName" value="<%= inquiry.companyName || '' %>">
            </label>
            <label>
              <%= t('contactName') %>
              <input name="contactName" value="<%= inquiry.contactName || '' %>">
            </label>
            <label>
              <%= t('email') %>
              <input type="email" name="contactEmail" value="<%= inquiry.contactEmail || '' %>">
            </label>
            <label>
              <%= t('phone') %>
              <input name="contactPhone" value="<%= inquiry.contactPhone || '' %>">
            </label>
            <label>
              <%= t('country') %>
              <select name="country">
                <option value=""><%= t('selectCountry') %></option>
                <% for (const country of countryOptions) { %>
                  <option value="<%= country %>"<%= inquiry.country === country ? ' selected' : '' %>><%= country %></option>
                <% } %>
              </select>
            </label>
            <label>
              <%= t('productInterest') %>
              <input name="productInterest" value="<%= inquiry.productInterest || '' %>">
            </label>
            <label>
              <%= t('opportunityType') %>
              <input name="opportunityType" value="<%= inquiry.opportunityType || '' %>">
            </label>
            <label>
              <%= t('requirement') %>
              <textarea name="requirementText" required><%= inquiry.requirementText || '' %></textarea>
            </label>
            <label>
              <%= t('priority') %>
              <select name="priority">
                <% for (const priority of priorities) { %>
                  <option value="<%= priority %>"<%= inquiry.priority === priority ? ' selected' : '' %>><%= t(`inquiryPriority.${priority}`) %></option>
                <% } %>
              </select>
            </label>
            <label>
              <%= t('assignedTo') %>
              <select name="assignedUserId">
                <% for (const user of assignableUsers) { %>
                  <option value="<%= user.id %>"<%= Number(inquiry.assignedUserId) === Number(user.id) ? ' selected' : '' %>><%= user.displayName || user.username %></option>
                <% } %>
              </select>
            </label>
            <label>
              <%= t('matchedCustomer') %>
              <select name="matchedCustomerId">
                <option value=""><%= t('selectCustomer') %></option>
                <% for (const customer of customers) { %>
                  <option value="<%= customer.id %>"<%= Number(inquiry.matchedCustomerId) === Number(customer.id) ? ' selected' : '' %>><%= customer.name %></option>
                <% } %>
              </select>
            </label>
            <label>
              <%= t('matchedContact') %>
              <select name="matchedContactId">
                <option value=""><%= t('selectContact') %></option>
                <% for (const contact of contacts) { %>
                  <option value="<%= contact.id %>"<%= Number(inquiry.matchedContactId) === Number(contact.id) ? ' selected' : '' %>><%= contact.name %><%= contact.customerName ? ` - ${contact.customerName}` : '' %></option>
                <% } %>
              </select>
            </label>
            <label>
              <%= t('reviewNote') %>
              <textarea name="reviewNote"><%= inquiry.reviewNote || '' %></textarea>
            </label>
            <button type="submit"><%= t('save') %></button>
          </form>
        </section>

          <section class="content-section">
            <h2><%= t('saveAsCustomer') %></h2>
            <p class="muted"><%= t('saveAsCustomerHint') %></p>
            <form class="form-panel" method="post" action="/inquiries/<%= inquiry.id %>/save-customer">
              <%- csrfField() %>
              <label>
                <%= t('matchedCustomer') %>
                <select name="customerId">
                  <option value=""><%= t('createNewCustomerFromInquiry') %></option>
                  <% for (const customer of customers) { %>
                    <option value="<%= customer.id %>"<%= Number(inquiry.matchedCustomerId) === Number(customer.id) ? ' selected' : '' %>><%= customer.name %></option>
                  <% } %>
                </select>
              </label>
              <label>
                <%= t('customerName') %>
                <input name="name" value="<%= inquiry.companyName || '' %>">
              </label>
              <label>
                <%= t('country') %>
                <input name="country" value="<%= inquiry.country || '' %>">
              </label>
              <button type="submit"><%= t('saveAsCustomer') %></button>
            </form>
          </section>

          <section class="content-section">
            <h2><%= t('saveAsContact') %></h2>
            <p class="muted"><%= t('saveAsContactHint') %></p>
            <form class="form-panel" method="post" action="/inquiries/<%= inquiry.id %>/save-contact">
              <%- csrfField() %>
              <label>
                <%= t('matchedContact') %>
                <select name="contactId">
                  <option value=""><%= t('createNewContactFromInquiry') %></option>
                  <% for (const contact of contacts) { %>
                    <option value="<%= contact.id %>"<%= Number(inquiry.matchedContactId) === Number(contact.id) ? ' selected' : '' %>><%= contact.name %><%= contact.customerName ? ` - ${contact.customerName}` : '' %></option>
                  <% } %>
                </select>
              </label>
              <label>
                <%= t('customer') %>
                <select name="customerId">
                  <option value=""><%= t('createNewCustomerFromInquiry') %></option>
                  <% for (const customer of customers) { %>
                    <option value="<%= customer.id %>"<%= Number(inquiry.matchedCustomerId) === Number(customer.id) ? ' selected' : '' %>><%= customer.name %></option>
                  <% } %>
                </select>
              </label>
              <label><%= t('customerName') %><input name="newCustomerName" value="<%= inquiry.companyName || '' %>"></label>
              <label><%= t('contactName') %><input name="name" value="<%= inquiry.contactName || '' %>"></label>
              <label><%= t('email') %><input type="email" name="email" value="<%= inquiry.contactEmail || '' %>"></label>
              <label><%= t('phone') %><input name="phone" value="<%= inquiry.contactPhone || '' %>"></label>
              <button type="submit"><%= t('saveAsContact') %></button>
            </form>
          </section>

          <section class="content-section">
            <h2><%= t('convertToOpportunity') %></h2>
            <form class="form-panel" method="post" action="/inquiries/<%= inquiry.id %>/convert">
              <%- csrfField() %>
              <label>
                <%= t('customer') %>
                <select name="customerId">
                  <option value=""><%= t('createNewCustomerFromInquiry') %></option>
                  <% for (const customer of customers) { %>
                    <option value="<%= customer.id %>"<%= Number(inquiry.matchedCustomerId) === Number(customer.id) ? ' selected' : '' %>><%= customer.name %></option>
                  <% } %>
                </select>
              </label>
              <label><%= t('customerName') %><input name="newCustomerName" value="<%= inquiry.companyName || '' %>"></label>
              <label><%= t('country') %><input name="newCustomerCountry" value="<%= inquiry.country || '' %>"></label>
              <label>
                <%= t('primaryContact') %>
                <select name="primaryContactId">
                  <option value=""><%= t('selectContact') %></option>
                  <% for (const contact of contacts) { %>
                    <option value="<%= contact.id %>"<%= Number(inquiry.matchedContactId) === Number(contact.id) ? ' selected' : '' %>><%= contact.name %><%= contact.customerName ? ` - ${contact.customerName}` : '' %></option>
                  <% } %>
                </select>
              </label>
              <label><%= t('contactName') %><input name="newContactName" value="<%= inquiry.contactName || '' %>"></label>
              <label><%= t('email') %><input type="email" name="newContactEmail" value="<%= inquiry.contactEmail || '' %>"></label>
              <label><%= t('phone') %><input name="newContactPhone" value="<%= inquiry.contactPhone || '' %>"></label>
              <label>
                <input type="checkbox" name="createMissingRecords" value="1" checked>
                <%= t('createMissingCustomerAndContact') %>
              </label>
              <label>
                <%= t('opportunityName') %>
                <input name="title" value="<%= inquiry.subject || inquiry.productInterest || inquiry.companyName || '' %>" required>
              </label>
              <label>
                <%= t('requirement') %>
                <textarea name="requirement" required><%= inquiry.requirementText || '' %></textarea>
              </label>
              <label>
                <%= t('estimatedAmount') %>
                <input type="number" step="0.01" name="estimatedAmount">
              </label>
              <label>
                <%= t('productInterest') %>
                <input name="productInterest" value="<%= inquiry.productInterest || '' %>">
              </label>
              <label>
                <%= t('opportunityType') %>
                <input name="projectType" value="<%= inquiry.opportunityType || '' %>">
              </label>
              <label>
                <%= t('deliveryPeriod') %>
                <input name="deliveryCycle">
              </label>
              <label>
                <%= t('expectedBidDate') %>
                <input type="date" name="expectedBidDate">
              </label>
              <button type="submit"><%= t('convertToOpportunity') %></button>
            </form>
          </section>

          <section class="content-section">
            <h2><%= t('markAsSpam') %></h2>
            <form method="post" action="/inquiries/<%= inquiry.id %>/spam" onsubmit="return confirm('<%= t('markInquirySpamConfirm') %>')">
              <%- csrfField() %>
              <button class="danger-action" type="submit"><%= t('markAsSpam') %></button>
            </form>
          </section>
        <% } else { %>
          <section class="content-section">
            <h2><%= t('inquiryProcessed') %></h2>
            <p><%= t(`inquiryStatus.${inquiry.status}`) %></p>
          </section>
        <% } %>

        <section class="content-section">
          <h2><%= t('rawPayload') %></h2>
          <pre><%= JSON.stringify(inquiry.rawPayload || {}, null, 2) %></pre>
        </section>
<%- include('../partials/app-end') %>
