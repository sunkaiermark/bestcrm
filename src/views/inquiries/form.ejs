<%- include('../partials/app-start', { title: `${t('newInquiry')} - BESTCRM`, activeNav: 'inquiries' }) %>
        <p class="breadcrumb"><a href="/inquiries"><%= t('inquiries') %></a></p>
        <header class="page-header">
          <h1><%= t('newInquiry') %></h1>
        </header>

        <form class="form-panel" method="post" action="<%= action %>">
          <%- csrfField() %>
          <label>
            <%= t('source') %>
            <select name="source" required>
              <% for (const source of sources) { %>
                <option value="<%= source %>"<%= inquiry.source === source ? ' selected' : '' %>><%= t(`inquirySource.${source}`) %></option>
              <% } %>
            </select>
          </label>
          <label>
            <%= t('subject') %>
            <input name="subject" value="<%= inquiry.subject || '' %>">
          </label>
          <label>
            <%= t('companyName') %>
            <input name="companyName" value="<%= inquiry.companyName || '' %>">
          </label>
          <label>
            <%= t('contactName') %>
            <input name="contactName" value="<%= inquiry.contactName || '' %>">
          </label>
          <label>
            <%= t('email') %>
            <input type="email" name="contactEmail" value="<%= inquiry.contactEmail || '' %>">
          </label>
          <label>
            <%= t('phone') %>
            <input name="contactPhone" value="<%= inquiry.contactPhone || '' %>">
          </label>
          <label>
            <%= t('country') %>
            <select name="country">
              <option value=""><%= t('selectCountry') %></option>
              <% for (const country of countryOptions) { %>
                <option value="<%= country %>"<%= inquiry.country === country ? ' selected' : '' %>><%= country %></option>
              <% } %>
            </select>
          </label>
          <label>
            <%= t('productInterest') %>
            <input name="productInterest" value="<%= inquiry.productInterest || '' %>">
          </label>
          <label>
            <%= t('opportunityType') %>
            <input name="opportunityType" value="<%= inquiry.opportunityType || '' %>">
          </label>
          <label>
            <%= t('priority') %>
            <select name="priority" required>
              <% for (const priority of priorities) { %>
                <option value="<%= priority %>"<%= inquiry.priority === priority ? ' selected' : '' %>><%= t(`inquiryPriority.${priority}`) %></option>
              <% } %>
            </select>
          </label>
          <label>
            <%= t('assignedTo') %>
            <select name="assignedUserId">
              <% for (const user of assignableUsers) { %>
                <option value="<%= user.id %>"<%= Number(inquiry.assignedUserId) === Number(user.id) ? ' selected' : '' %>><%= user.displayName || user.username %></option>
              <% } %>
            </select>
          </label>
          <label>
            <%= t('requirement') %>
            <textarea name="requirementText" required><%= inquiry.requirementText || '' %></textarea>
          </label>
          <label>
            <%= t('reviewNote') %>
            <textarea name="reviewNote"><%= inquiry.reviewNote || '' %></textarea>
          </label>
          <button type="submit"><%= t('save') %></button>
        </form>
<%- include('../partials/app-end') %>
