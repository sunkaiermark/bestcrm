<%- include('../partials/app-start', { title: `${t('websiteForms')} - BESTCRM`, activeNav: 'inquiries' }) %>
        <header class="page-header">
          <div>
            <p class="breadcrumb"><%= t('websiteFormInbox') %></p>
            <h1><%= t('websiteForms') %></h1>
            <p class="muted"><%= t('websiteFormNotice') %></p>
          </div>
          <div class="page-actions">
            <a class="secondary-action" href="/lead-submissions/new"><%= t('submitNewLead') %></a>
            <a class="quick-action" href="/opportunities/new"><%= t('newOpportunity') %></a>
          </div>
        </header>

        <section class="list-section">
          <form class="form-panel inquiry-filter-panel" method="get" action="/inquiries">
            <% if (viewMode === 'all') { %><input name="view" type="hidden" value="all"><% } %>
            <label class="inquiry-search-field">
              <%= t('keyword') %>
              <input name="query" type="search" maxlength="200" value="<%= filters.query %>" placeholder="<%= t('websiteFormSearchPlaceholder') %>">
            </label>
            <label>
              <%= t('status') %>
              <select name="status">
                <option value=""><%= t('activeWebsiteFormStatuses') %></option>
                <% for (const status of statuses) { %>
                  <option value="<%= status %>"<%= filters.status === status ? ' selected' : '' %>><%= t(`websiteFormStatus.${status}`) %></option>
                <% } %>
              </select>
            </label>
            <label>
              <%= t('fromDate') %>
              <% if (language === 'en') { %>
                <input name="dateFrom" type="text" inputmode="numeric" pattern="[0-9]{4}-[0-9]{2}-[0-9]{2}" placeholder="YYYY-MM-DD" title="YYYY-MM-DD" value="<%= filters.dateFrom %>">
              <% } else { %>
                <input name="dateFrom" type="date" value="<%= filters.dateFrom %>">
              <% } %>
            </label>
            <label>
              <%= t('toDate') %>
              <% if (language === 'en') { %>
                <input name="dateTo" type="text" inputmode="numeric" pattern="[0-9]{4}-[0-9]{2}-[0-9]{2}" placeholder="YYYY-MM-DD" title="YYYY-MM-DD" value="<%= filters.dateTo %>">
              <% } else { %>
                <input name="dateTo" type="date" value="<%= filters.dateTo %>">
              <% } %>
            </label>
            <label>
              <%= t('assignedTo') %>
              <select name="assignedUserId">
                <option value=""><%= t('allAssignees') %></option>
                <% for (const assignee of assignees) { %>
                  <option value="<%= assignee.id %>"<%= String(filters.assignedUserId || '') === String(assignee.id) ? ' selected' : '' %>><%= assignee.displayName || assignee.username %></option>
                <% } %>
              </select>
            </label>
            <div class="inquiry-filter-actions">
              <button type="submit"><%= t('filter') %></button>
              <a class="secondary-action" href="<%= clearFiltersUrl %>"><%= t('clearFilters') %></a>
            </div>
          </form>

          <div class="list-body inquiry-list-body" tabindex="0" aria-label="<%= t('websiteForms') %>">
            <table class="list-table content-fit-table inquiry-list-table">
              <thead>
                <tr>
                  <th><%= t('inquiryListDate') %></th>
                  <th><%= t('inquiryListStatus') %></th>
                  <th><%= t('inquiryListPriority') %></th>
                  <th><%= t('inquiryListSubject') %></th>
                  <th><%= t('inquiryListCompany') %></th>
                  <th><%= t('inquiryListContact') %></th>
                  <th><%= t('inquiryListProducts') %></th>
                  <th><%= t('inquiryListType') %></th>
                  <th><%= t('inquiryListAssignedTo') %></th>
                  <th><%= t('inquiryListActions') %></th>
                </tr>
              </thead>
              <tbody>
                <% for (const inquiry of inquiries) { %>
                  <tr>
                    <td data-label="<%= t('inquiryListDate') %>" title="<%= inquiry.sourceDateInvalid ? t('invalidSourceDateIgnored') : inquiry.listReceivedAt %>"><%= inquiry.listReceivedAt %></td>
                    <td data-label="<%= t('inquiryListStatus') %>"><span class="status"><%= t(`websiteFormStatus.${inquiry.status}`) %></span></td>
                    <td data-label="<%= t('inquiryListPriority') %>"><%= t(`inquiryPriority.${inquiry.priority}`) %></td>
                    <td class="clickable-cell" data-label="<%= t('inquiryListSubject') %>" title="<%= inquiry.subject || `#${inquiry.id}` %>"><a class="cell-link" href="/inquiries/<%= inquiry.id %>"><%= inquiry.subject || `#${inquiry.id}` %></a></td>
                    <td data-label="<%= t('inquiryListCompany') %>" title="<%= inquiry.companyName || '' %>"><%= inquiry.companyName || '' %></td>
                    <td data-label="<%= t('inquiryListContact') %>"><% if (inquiry.matchedContactId) { %><%= inquiry.matchedContactCode ? `${inquiry.matchedContactCode} · ` : '' %><%= inquiry.matchedContactName || inquiry.contactName || inquiry.contactEmail || '' %><% } else { %><%= inquiry.contactName || inquiry.contactEmail || '' %><% } %></td>
                    <td data-label="<%= t('inquiryListProducts') %>" title="<%= inquiry.productInterest || '' %>"><%= inquiry.productInterest || '' %></td>
                    <td data-label="<%= t('inquiryListType') %>"><%= inquiry.opportunityType || '' %></td>
                    <td data-label="<%= t('inquiryListAssignedTo') %>"><%= inquiry.assignedDisplayName || '' %></td>
                    <td data-label="<%= t('inquiryListActions') %>"><a class="secondary-action" href="/inquiries/<%= inquiry.id %>"><%= t('view') %></a></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
            <% if (!inquiries.length) { %>
              <p class="empty"><%= t('noInquiries') %></p>
            <% } %>
          </div>
          <nav class="inquiry-pagination" aria-label="<%= t('pagination') %>">
            <span><%= t('showing') %> <strong><%= pagination.firstItem %>–<%= pagination.lastItem %></strong> / <strong><%= pagination.totalItems %></strong></span>
            <form class="inquiry-view-mode-form" method="get" action="/inquiries">
              <% for (const [key, value] of Object.entries(filters)) { %>
                <% if (value !== '' && value !== null && value !== undefined) { %><input name="<%= key %>" type="hidden" value="<%= value %>"><% } %>
              <% } %>
              <select name="view" aria-label="<%= t('viewMode') %>" onchange="this.form.submit()">
                <option value="page"<%= viewMode === 'page' ? ' selected' : '' %>><%= t('paginatedView') %></option>
                <option value="all"<%= viewMode === 'all' ? ' selected' : '' %>><%= t('showAll') %></option>
              </select>
            </form>
            <% if (viewMode === 'page') { %>
              <span><%= t('page') %> <strong><%= pagination.page %></strong> / <strong><%= pagination.totalPages %></strong></span>
              <div class="inquiry-pagination-actions">
                <% if (pagination.previousUrl) { %>
                  <a class="secondary-action" href="<%= pagination.previousUrl %>"><%= t('previousPage') %></a>
                <% } else { %>
                  <span class="secondary-action is-disabled" aria-disabled="true"><%= t('previousPage') %></span>
                <% } %>
                <% if (pagination.nextUrl) { %>
                  <a class="secondary-action" href="<%= pagination.nextUrl %>"><%= t('nextPage') %></a>
                <% } else { %>
                  <span class="secondary-action is-disabled" aria-disabled="true"><%= t('nextPage') %></span>
                <% } %>
              </div>
            <% } %>
          </nav>
        </section>
<%- include('../partials/app-end') %>
