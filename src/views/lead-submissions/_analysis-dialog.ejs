<dialog id="lead-ai-dialog" data-lead-id="<%= submission.id || '' %>" data-email-thread-id="<%= (typeof emailThreadId !== 'undefined' && emailThreadId) || submission.rawPayload?.emailThreadId || '' %>">
<h2>AI整理线索</h2>
<% if ((typeof emailThreadId !== 'undefined' && emailThreadId) || submission.rawPayload?.emailThreadId) { %>
<p>将读取你有权查看的来源邮件，整理结果填入当前表单，提交前请人工审阅。</p>
<% } else { %>
<label>来源邮件<textarea id="lead-ai-email" rows="7" maxlength="20000" placeholder="粘贴邮件正文"></textarea></label>
<% } %>
<label><input type="checkbox" id="lead-ai-consent">允许将邮件提交至豆包进行整理</label>
<label><input type="checkbox" id="lead-ai-search-consent">允许将询价方、最终用户及项目地区信息用于联网调查</label>
<div class="lead-ai-dialog-actions"><% if (typeof leadAiEnabled !== 'undefined' && leadAiEnabled) { %><button type="button" id="lead-ai-analyze">整理并填充</button><% } %><button type="button" id="lead-ai-close">完成</button></div>
<p id="lead-ai-dialog-status" role="status"></p>
</dialog>
<p id="lead-ai-status" role="status"></p>
<script src="/assets/lead-analysis.js" defer></script>