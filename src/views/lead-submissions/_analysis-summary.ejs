<% const savedAnalysis = (typeof analysis !== 'undefined' && analysis) || {}; const roleNames={unknown:'待确认',end_user:'最终用户',agent:'代理商／经销商',epc:'工程公司／EPC',procurement:'采购服务商'}; %>
<% if (savedAnalysis.transactionRole || savedAnalysis.endUserName || savedAnalysis.customerAnalysisReport) { %>
<div class="lead-analysis-summary<%= savedAnalysis.customerAnalysisReport ? ' has-report' : '' %>">
<dl class="lead-summary-narrative lead-analysis-facts">
<div><dt>本次交易角色</dt><dd title="<%= roleNames[savedAnalysis.transactionRole] || '待确认' %>"><%= roleNames[savedAnalysis.transactionRole] || '待确认' %></dd></div>
<div><dt>最终用户</dt><dd title="<%= savedAnalysis.endUserName || '未披露／待确认' %>"><%= savedAnalysis.endUserName || '未披露／待确认' %></dd></div>
<% if (savedAnalysis.endUserWebsite) { %><div><dt>最终用户官网</dt><dd><%= savedAnalysis.endUserWebsite %></dd></div><% } %>
<% if (savedAnalysis.projectLocation) { %><div><dt>项目地点</dt><dd><%= savedAnalysis.projectLocation %></dd></div><% } %>
</dl>
<% if (savedAnalysis.customerAnalysisReport) { %>
<details class="lead-analysis-saved"><summary>客户分析报告</summary>
<article class="lead-analysis-saved-report">
<% const headings=['执行摘要','交易角色与采购关系','最终用户分析','项目关联判断','待核实事项','建议行动','信息来源']; %>
<% for (const line of savedAnalysis.customerAnalysisReport.split('\n').filter(value=>value.trim())) { const clean=line.trim().replace(/^#+\s*/,'').replace(/^(?:[一二三四五六七]+、|\d+[.、)]\s*)/,''); const index=headings.indexOf(clean); %>
<% if (index >= 0) { %><h3><%= ['一、','二、','三、','四、','五、','六、','七、'][index]+clean %></h3><% } else { %><p><%= line %></p><% } %>
<% } %>
</article>
</details>
<% } %>
</div>
<% } %>
<%- include('_project-contacts-summary', { savedAnalysis }) %>
