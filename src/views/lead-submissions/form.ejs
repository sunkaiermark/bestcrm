<%
  const resubmissionMode = typeof isResubmission !== 'undefined' && isResubmission;
  const pendingEditMode = typeof isPendingEdit !== 'undefined' && isPendingEdit;
  const editingMode = resubmissionMode || pendingEditMode;
  const pageTitleKey = resubmissionMode ? 'resubmitLead' : pendingEditMode ? 'editLead' : 'submitNewLead';
  const noticeKey = resubmissionMode ? 'leadResubmissionNotice' : 'leadPendingEditNotice';
  const submitLabelKey = resubmissionMode
    ? 'resubmitForReview'
    : pendingEditMode ? 'saveLeadChanges' : 'submitForReview';
%>
<%- include('../partials/app-start', { title: `${t(pageTitleKey)} - BESTCRM`, activeNav: 'lead-submissions' }) %>
        <p class="breadcrumb"><a href="/lead-submissions"><%= t('myLeadSubmissions') %></a></p>
        <header class="page-header">
          <div>
            <h1><%= t(pageTitleKey) %></h1>
            <% if (editingMode) { %><p class="muted"><%= t(noticeKey) %></p><% } %>
          </div>
        </header>

        <form class="form-panel lead-submission-form<%= editingMode ? '' : ' lead-submission-form-new' %>" method="post" action="<%= formAction || '/lead-submissions' %>" id="lead-submission-form">
          <%- csrfField() %>
          <% if (submissionToken) { %><input type="hidden" name="submissionToken" value="<%= submissionToken %>"><% } %>
          <input type="hidden" name="attachmentDraftToken" value="<%= attachmentDraftToken %>">
          <% if (emailThreadId) { %><input type="hidden" name="emailThreadId" value="<%= emailThreadId %>"><% } %>
          <label class="lead-submission-subject"><span><%= t('subject') %></span><input name="subject" value="<%= submission.subject || '' %>"></label>
          <label>
            <%= t('leadSourceChannel') %>
            <select name="sourceChannel" required>
              <% for (const channel of sourceChannels) { %>
                <option value="<%= channel %>"<%= submission.sourceChannel === channel ? ' selected' : '' %>><%= t(`leadSourceChannel.${channel}`) %></option>
              <% } %>
            </select>
          </label>
          <label><span><%= t('companyName') %><span class="lead-required-mark" aria-hidden="true">*</span></span><input name="companyName" value="<%= submission.companyName || '' %>" required></label>
          <label><%= t('website') %><input name="companyWebsite" type="text" inputmode="url" placeholder="https://www.example.com" value="<%= submission.companyWebsite || '' %>"></label>
          <label><span><%= t('contactName') %><span class="lead-required-mark" aria-hidden="true">*</span></span><input name="contactName" value="<%= submission.contactName || '' %>" required></label>
          <label><span><%= t('email') %><span class="lead-required-mark" aria-hidden="true">*</span></span><input type="email" name="contactEmail" value="<%= submission.contactEmail || '' %>" required></label>
          <label><span><%= t('phone') %><span class="lead-required-mark" aria-hidden="true">*</span></span><input type="tel" name="contactPhone" value="<%= submission.contactPhone || '' %>" required></label>
          <label>
            <%= t('country') %>
            <select name="country">
              <option value=""><%= t('selectCountry') %></option>
              <% for (const country of countryOptions) { %>
                <option value="<%= country %>"<%= submission.country === country ? ' selected' : '' %>><%= country %></option>
              <% } %>
            </select>
          </label>
          <label><%= t('productInterest') %><input name="productInterest" value="<%= submission.productInterest || '' %>"></label>
          <%- include('../partials/product-category-picker', { record: submission, subjectInput: 'subject', requirementInput: 'requirementText', formId: '', className: '' }) %>
          <label><%= t('opportunityType') %><input name="opportunityType" value="<%= submission.opportunityType || '' %>"></label>
          <label>
            <%= t('priority') %>
            <select name="priority" required>
              <% for (const priority of ['low', 'normal', 'high', 'urgent']) { %>
                <option value="<%= priority %>"<%= submission.priority === priority ? ' selected' : '' %>><%= t(`inquiryPriority.${priority}`) %></option>
              <% } %>
            </select>
          </label>
          <% if (showSalesOwnerField) { %>
            <label>
              <%= t('recommendedSalesOwner') %>
              <select name="recommendedSalespersonId" required>
                <option value=""><%= t('selectSalesOwner') %></option>
                <% for (const salesperson of salespeople) { %>
                  <option value="<%= salesperson.id %>"<%= String(submission.recommendedSalespersonId || '') === String(salesperson.id) ? ' selected' : '' %>><%= salesperson.displayName || salesperson.username %></option>
                <% } %>
              </select>
            </label>
          <% } %>
          <label>
            <%= t('reviewSalesManager') %>
            <select name="assignedUserId" required>
              <option value=""><%= t('selectSalesManager') %></option>
              <% for (const manager of reviewManagers) { %>
                <option value="<%= manager.id %>"<%= Number(submission.assignedUserId) === Number(manager.id) ? ' selected' : '' %>><%= manager.displayName || manager.username %></option>
              <% } %>
            </select>
          </label>
          <label class="lead-submission-form-wide"><%= t('requirement') %><textarea name="requirementText" required><%= submission.requirementText || '' %></textarea></label>
          <% if (editingMode && (attachments || []).length) { %>
            <div class="lead-submission-form-wide">
              <strong><%= t('existingSupportingFiles') %></strong>
              <div class="inquiry-attachment-list lead-attachment-list">
                <% for (const attachment of attachments) { %>
                  <div class="inquiry-attachment-row">
                    <span><%= attachment.originalName %></span>
                    <span class="inline-actions">
                      <a href="/lead-submissions/<%= submission.id %>/attachments/<%= attachment.id %>/preview" target="_blank" rel="noopener"><%= t('preview') %></a>
                      <a href="/lead-submissions/<%= submission.id %>/attachments/<%= attachment.id %>/download"><%= t('download') %></a>
                    </span>
                  </div>
                <% } %>
              </div>
            </div>
          <% } %>
          <div
            class="lead-submission-form-wide lead-attachment-draft"
            id="lead-attachment-draft"
            data-upload-url="/lead-submissions/attachment-drafts/<%= attachmentDraftToken %>"
            data-preview-label="<%= t('preview') %>"
            data-download-label="<%= t('download') %>"
            data-remove-label="<%= t('withdrawLeadAttachment') %>"
            data-no-files-label="<%= t('noUploadedSupportingFiles') %>"
            data-select-files-label="<%= t('selectFilesToUpload') %>"
            data-uploading-label="<%= t('uploadingFiles') %>"
            data-uploaded-label="<%= t('filesUploaded') %>"
            data-removed-label="<%= t('fileRemoved') %>"
            data-upload-first-label="<%= t('uploadFilesBeforeSubmit') %>"
            data-upload-error-label="<%= t('fileUploadFailed') %>"
          >
            <strong><%= t('uploadedSupportingFiles') %></strong>
            <div class="inquiry-attachment-list lead-attachment-list lead-staged-attachment-list" id="lead-staged-attachment-list"></div>
            <div class="lead-attachment-picker">
              <label for="lead-attachment-input"><%= t('supportingFiles') %></label>
              <input type="file" id="lead-attachment-input" multiple>
              <button type="button" class="secondary-action" id="lead-attachment-upload-button"><%= t('uploadSelectedFiles') %></button>
            </div>
            <p class="muted lead-attachment-hint"><%= t('supportingFilesHint') %> <%= maxAttachmentCount %> · <%= t('maximumPerFile') %> <%= maxUploadMb %> MB</p>
            <p class="lead-attachment-status" id="lead-attachment-status" role="status" aria-live="polite"></p>
          </div>
          <% if (resubmissionMode) { %>
            <label><%= t('resubmissionNote') %><input name="resubmissionNote" maxlength="1000"></label>
          <% } %>
          <button type="submit" id="lead-submit-button"><%= t(submitLabelKey) %></button>
        </form>

        <script>
          (() => {
            const form = document.getElementById('lead-submission-form');
            const draft = document.getElementById('lead-attachment-draft');
            const fileInput = document.getElementById('lead-attachment-input');
            const uploadButton = document.getElementById('lead-attachment-upload-button');
            const submitButton = document.getElementById('lead-submit-button');
            const list = document.getElementById('lead-staged-attachment-list');
            const status = document.getElementById('lead-attachment-status');
            if (!form || !draft || !fileInput || !uploadButton || !submitButton || !list || !status) return;

            const labels = {
              preview: draft.dataset.previewLabel,
              download: draft.dataset.downloadLabel,
              remove: draft.dataset.removeLabel,
              noFiles: draft.dataset.noFilesLabel,
              selectFiles: draft.dataset.selectFilesLabel,
              uploading: draft.dataset.uploadingLabel,
              uploaded: draft.dataset.uploadedLabel,
              removed: draft.dataset.removedLabel,
              uploadFirst: draft.dataset.uploadFirstLabel,
              uploadError: draft.dataset.uploadErrorLabel
            };
            const csrfToken = form.querySelector('input[name="_csrf"]')?.value || '';
            let attachments = <%- JSON.stringify(stagedAttachments || []).replaceAll('<', '\\u003c') %>;
            let busy = false;

            const formatFileSize = (bytes) => {
              const value = Number(bytes || 0);
              if (value >= 1024 * 1024) return `${(value / 1024 / 1024).toFixed(1)} MB`;
              if (value >= 1024) return `${(value / 1024).toFixed(1)} KB`;
              return `${value} B`;
            };

            const setBusy = (value) => {
              busy = value;
              uploadButton.disabled = value;
              submitButton.disabled = value;
              fileInput.disabled = value;
            };

            const setStatus = (message, isError = false) => {
              status.textContent = message || '';
              status.classList.toggle('error-text', isError);
            };

            const requestHeaders = () => csrfToken ? { 'x-csrf-token': csrfToken } : {};

            const renderAttachments = () => {
              list.replaceChildren();
              if (!attachments.length) {
                const empty = document.createElement('p');
                empty.className = 'empty-state';
                empty.textContent = labels.noFiles;
                list.append(empty);
                return;
              }
              for (const attachment of attachments) {
                const row = document.createElement('div');
                row.className = 'inquiry-attachment-row';
                const name = document.createElement('span');
                name.textContent = attachment.originalName;
                const size = document.createElement('span');
                size.className = 'muted';
                size.textContent = formatFileSize(attachment.fileSize);
                const actions = document.createElement('span');
                actions.className = 'inline-actions';
                const preview = document.createElement('a');
                preview.href = attachment.previewUrl;
                preview.target = '_blank';
                preview.rel = 'noopener';
                preview.textContent = labels.preview;
                const download = document.createElement('a');
                download.href = attachment.downloadUrl;
                download.textContent = labels.download;
                const remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 'link-button danger-link lead-staged-withdraw';
                remove.textContent = labels.remove;
                remove.addEventListener('click', async () => {
                  setBusy(true);
                  try {
                    const response = await fetch(attachment.removeUrl, {
                      method: 'POST',
                      headers: requestHeaders()
                    });
                    if (!response.ok) throw new Error((await response.text()) || labels.uploadError);
                    const payload = await response.json();
                    attachments = payload.attachments || [];
                    renderAttachments();
                    setStatus(labels.removed);
                  } catch (error) {
                    setStatus(error.message || labels.uploadError, true);
                  } finally {
                    setBusy(false);
                  }
                });
                actions.append(preview, download, remove);
                row.append(name, size, actions);
                list.append(row);
              }
            };

            uploadButton.addEventListener('click', async () => {
              if (!fileInput.files.length) {
                setStatus(labels.selectFiles, true);
                fileInput.focus();
                return;
              }
              const payload = new FormData();
              for (const file of fileInput.files) payload.append('attachments', file);
              setBusy(true);
              setStatus(labels.uploading);
              try {
                const response = await fetch(draft.dataset.uploadUrl, {
                  method: 'POST',
                  headers: requestHeaders(),
                  body: payload
                });
                if (!response.ok) throw new Error((await response.text()) || labels.uploadError);
                const result = await response.json();
                attachments = result.attachments || [];
                fileInput.value = '';
                renderAttachments();
                setStatus(labels.uploaded);
              } catch (error) {
                setStatus(error.message || labels.uploadError, true);
              } finally {
                setBusy(false);
              }
            });

            form.addEventListener('submit', (event) => {
              if (busy || fileInput.files.length) {
                event.preventDefault();
                setStatus(labels.uploadFirst, true);
                fileInput.focus();
              }
            });

            renderAttachments();
          })();
        </script>
<%- include('../partials/app-end') %>
