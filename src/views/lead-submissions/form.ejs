<%- include('../partials/app-start', { title: `${t('submitNewLead')} - BESTCRM`, activeNav: 'lead-submissions' }) %>
        <p class="breadcrumb"><a href="/lead-submissions"><%= t('myLeadSubmissions') %></a></p>
        <header class="page-header">
          <div>
            <h1><%= t('submitNewLead') %></h1>
            <p class="muted"><%= t('leadSubmissionNotice') %></p>
          </div>
        </header>

        <form class="form-panel" method="post" action="/lead-submissions" enctype="multipart/form-data">
          <%- csrfField() %>
          <input type="hidden" name="submissionToken" value="<%= submissionToken %>">
          <label>
            <%= t('leadSourceChannel') %>
            <select name="sourceChannel" required>
              <% for (const channel of sourceChannels) { %>
                <option value="<%= channel %>"<%= submission.sourceChannel === channel ? ' selected' : '' %>><%= t(`leadSourceChannel.${channel}`) %></option>
              <% } %>
            </select>
          </label>
          <label><%= t('subject') %><input name="subject" value="<%= submission.subject || '' %>"></label>
          <label><%= t('companyName') %><input name="companyName" value="<%= submission.companyName || '' %>"></label>
          <label><%= t('contactName') %><input name="contactName" value="<%= submission.contactName || '' %>"></label>
          <label><%= t('email') %><input type="email" name="contactEmail" value="<%= submission.contactEmail || '' %>"></label>
          <label><%= t('phone') %><input name="contactPhone" value="<%= submission.contactPhone || '' %>"></label>
          <label>
            <%= t('country') %>
            <select name="country">
              <option value=""><%= t('selectCountry') %></option>
              <% for (const country of countryOptions) { %>
                <option value="<%= country %>"<%= submission.country === country ? ' selected' : '' %>><%= country %></option>
              <% } %>
            </select>
          </label>
          <label><%= t('productInterest') %><input name="productInterest" value="<%= submission.productInterest || '' %>"></label>
          <label><%= t('opportunityType') %><input name="opportunityType" value="<%= submission.opportunityType || '' %>"></label>
          <label>
            <%= t('priority') %>
            <select name="priority" required>
              <% for (const priority of ['low', 'normal', 'high', 'urgent']) { %>
                <option value="<%= priority %>"<%= submission.priority === priority ? ' selected' : '' %>><%= t(`inquiryPriority.${priority}`) %></option>
              <% } %>
            </select>
          </label>
          <label>
            <%= t('reviewSalesManager') %>
            <select name="assignedUserId" required>
              <option value=""><%= t('selectSalesManager') %></option>
              <% for (const manager of reviewManagers) { %>
                <option value="<%= manager.id %>"><%= manager.displayName || manager.username %></option>
              <% } %>
            </select>
          </label>
          <label><%= t('requirement') %><textarea name="requirementText" required><%= submission.requirementText || '' %></textarea></label>
          <label>
            <%= t('supportingFile') %>
            <input type="file" name="attachment">
            <span class="muted"><%= t('supportingFileHint') %> <%= maxUploadMb %> MB</span>
          </label>
          <button type="submit"><%= t('submitForReview') %></button>
        </form>
<%- include('../partials/app-end') %>
