<%- include('../partials/app-start', { title: `${t('myLeadSubmissions')} - BESTCRM`, activeNav: 'lead-submissions' }) %>
        <%
          const leadDateTimeFormatter = new Intl.DateTimeFormat('en-CA', {
            timeZone: 'Asia/Singapore',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
            hourCycle: 'h23'
          });
          const formatLeadDateTime = (value) => {
            if (!value) return '-';
            const date = value instanceof Date ? value : new Date(value);
            if (Number.isNaN(date.getTime())) return String(value);
            const parts = Object.fromEntries(
              leadDateTimeFormatter.formatToParts(date).map((part) => [part.type, part.value])
            );
            return `${parts.year}-${parts.month}-${parts.day} ${parts.hour}:${parts.minute}`;
          };
        %>
        <header class="page-header">
          <h1><%= t('myLeadSubmissions') %></h1>
          <a class="quick-action" href="/lead-submissions/new"><%= t('submitNewLead') %></a>
        </header>

        <div class="inline-actions">
          <a class="<%= view === 'active' ? 'quick-action' : 'secondary-action' %>" href="/lead-submissions"><%= t('leadActiveQueue') %></a>
          <a class="<%= view === 'processed' ? 'quick-action' : 'secondary-action' %>" href="/lead-submissions?view=processed"><%= t('leadProcessedRecords') %></a>
        </div>

        <section class="list-section">
          <% if (submissions.length === 0) { %>
            <p class="empty-state"><%= t('noLeadSubmissions') %></p>
          <% } else { %>
            <table class="list-table record-list-table lead-submission-list-table">
              <thead><tr><th><%= t('submittedAt') %></th><th><%= t('companyName') %></th><th><%= t('requirement') %></th><th><%= t('productInterest') %></th><th><%= t('reviewSalesManager') %></th><th><%= t('status') %></th><th><%= t('actions') %></th></tr></thead>
              <tbody>
                <% for (const submission of submissions) { %>
                  <tr>
                    <td class="clickable-cell" data-label="<%= t('submittedAt') %>"><a class="cell-link lead-submission-time" href="/lead-submissions/<%= submission.id %>"><%= formatLeadDateTime(submission.createdAt) %></a></td>
                    <td class="clickable-cell" data-label="<%= t('companyName') %>"><a class="cell-link" href="/lead-submissions/<%= submission.id %>"><%= submission.companyName || '-' %></a></td>
                    <td class="clickable-cell lead-requirement-cell" data-label="<%= t('requirement') %>"><a class="cell-link" href="/lead-submissions/<%= submission.id %>" title="<%= submission.requirementText || '' %>"><span class="lead-requirement-preview"><%= submission.requirementText || '-' %></span></a></td>
                    <td class="clickable-cell" data-label="<%= t('productInterest') %>"><a class="cell-link" href="/lead-submissions/<%= submission.id %>"><%= submission.productInterest || '-' %></a></td>
                    <td class="clickable-cell" data-label="<%= t('reviewSalesManager') %>"><a class="cell-link" href="/lead-submissions/<%= submission.id %>"><%= submission.assignedDisplayName || '-' %></a></td>
                    <td class="clickable-cell" data-label="<%= t('status') %>"><a class="cell-link" href="/lead-submissions/<%= submission.id %>"><span class="status"><%= t(`leadStatus.${submission.status}`) %></span></a></td>
                    <td class="clickable-cell" data-label="<%= t('actions') %>">
                      <a class="cell-link" href="/lead-submissions/<%= submission.id %>"><%= submission.canReview ? t('processLead') : t('view') %></a>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          <% } %>
        </section>
<%- include('../partials/app-end') %>
