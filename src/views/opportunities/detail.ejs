<%- include('../partials/app-start', { title: opportunity.title + ' - BESTCRM', activeNav: 'opportunities' }) %>
<%
  const attachmentUploadedAtSortValue = (value) => value instanceof Date ? value.toISOString() : String(value || '');
  const orderedAttachments = [...(attachments || [])].sort((left, right) => {
    const leftAt = attachmentUploadedAtSortValue(left.uploadedAt);
    const rightAt = attachmentUploadedAtSortValue(right.uploadedAt);
    if (leftAt !== rightAt) {
      return leftAt.localeCompare(rightAt);
    }
    return Number(left.id || 0) - Number(right.id || 0);
  });
  const requirementAttachments = orderedAttachments.filter((attachment) => attachment.category === 'requirement' || attachment.category === 'other');
  const technicalSolutionAttachments = orderedAttachments.filter((attachment) => attachment.category === 'technical_solution');
  const commercialQuoteAttachments = orderedAttachments.filter((attachment) => attachment.category === 'commercial_quote');
  const contractAttachments = orderedAttachments.filter((attachment) => attachment.category === 'contract');
  const canDeleteRequirementMaterials = ['draft', 'initiation_rejected'].includes(opportunity.status);
  const supplementalRequirementUpdates = typeof requirementUpdates === 'undefined' ? [] : requirementUpdates;
  const technicalSolutionDeleteStatuses = ['technical_solution_in_progress', 'technical_solution_rejected'];
  const formatShortDate = (value) => {
    if (!value) {
      return '';
    }
    const date = value instanceof Date ? value : new Date(value);
    if (Number.isNaN(date.getTime())) {
      return String(value);
    }
    const pad = (part) => String(part).padStart(2, '0');
    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`;
  };
  const requirementTimelineSortValue = (value) => {
    if (!value) {
      return '';
    }
    return value instanceof Date ? value.toISOString() : String(value);
  };
  const requirementTimeline = [
    {
      key: 'initial',
      type: 'Text',
      timeLabel: 'Initial Requirement',
      text: opportunity.requirement,
      at: '',
      sortAt: ''
    },
    ...supplementalRequirementUpdates.map((update) => ({
      key: `text-${update.id}`,
      type: 'Text',
      text: update.requirementText,
      at: update.createdAt,
      sortAt: requirementTimelineSortValue(update.createdAt)
    })),
    ...requirementAttachments.map((attachment) => ({
      key: `file-${attachment.id}`,
      type: 'File',
      attachment,
      text: attachment.originalName,
      at: attachment.uploadedAt,
      sortAt: requirementTimelineSortValue(attachment.uploadedAt)
    }))
  ].filter((item) => item.text || item.attachment).sort((left, right) => {
    if (left.sortAt !== right.sortAt) {
      return left.sortAt.localeCompare(right.sortAt);
    }
    return String(left.key).localeCompare(String(right.key));
  });
  const technicalSolutionVersions = typeof technicalSolutions === 'undefined' ? [] : technicalSolutions;
  const technicalSolutionTimeline = [
    ...technicalSolutionVersions.map((solution) => ({
      key: `solution-${solution.id}`,
      type: 'Text',
      text: solution.summary,
      at: solution.submittedAt,
      sortAt: requirementTimelineSortValue(solution.submittedAt)
    })),
    ...technicalSolutionVersions
      .filter((solution) => solution.reviewComment)
      .map((solution) => ({
        key: `solution-review-${solution.id}`,
        type: 'Text',
        text: solution.reviewComment,
        at: solution.reviewedAt,
        sortAt: requirementTimelineSortValue(solution.reviewedAt)
      })),
    ...technicalSolutionAttachments.map((attachment) => ({
      key: `technical-file-${attachment.id}`,
      type: 'File',
      attachment,
      text: attachment.originalName,
      at: attachment.uploadedAt,
      sortAt: requirementTimelineSortValue(attachment.uploadedAt)
    }))
  ].filter((item) => item.text || item.attachment).sort((left, right) => {
    if (left.sortAt !== right.sortAt) {
      return left.sortAt.localeCompare(right.sortAt);
    }
    return String(left.key).localeCompare(String(right.key));
  });
  const commercialQuoteVersions = typeof commercialQuotes === 'undefined' ? [] : commercialQuotes;
  const commercialQuoteTimeline = [
    ...commercialQuoteAttachments.map((attachment) => ({
      key: `commercial-quote-file-${attachment.id}`,
      type: 'File',
      attachment,
      text: attachment.originalName,
      at: attachment.uploadedAt,
      sortAt: requirementTimelineSortValue(attachment.uploadedAt)
    }))
  ].filter((item) => item.text || item.attachment).sort((left, right) => {
    if (left.sortAt !== right.sortAt) {
      return left.sortAt.localeCompare(right.sortAt);
    }
    return String(left.key).localeCompare(String(right.key));
  });
  const contractTimeline = [
    ...contractAttachments.map((attachment) => ({
      key: `contract-file-${attachment.id}`,
      type: 'File',
      attachment,
      text: attachment.originalName,
      at: attachment.uploadedAt,
      sortAt: requirementTimelineSortValue(attachment.uploadedAt)
    }))
  ].filter((item) => item.text || item.attachment).sort((left, right) => {
    if (left.sortAt !== right.sortAt) {
      return left.sortAt.localeCompare(right.sortAt);
    }
    return String(left.key).localeCompare(String(right.key));
  });
  const materialApprovalVersions = typeof materialVersions === 'undefined' ? [] : materialVersions;
  const materialVersionsFor = (materialType) => materialApprovalVersions
    .filter((version) => version.materialType === materialType)
    .sort((left, right) => Number(left.versionNo || 0) - Number(right.versionNo || 0));
  const technicalMaterialVersions = materialVersionsFor('technical_solution');
  const commercialQuoteMaterialVersions = materialVersionsFor('commercial_quote');
  const contractMaterialVersions = materialVersionsFor('contract');
  const materialVersionStatusClass = (status) => String(status || 'draft').replace(/[^a-z0-9_-]/gi, '-').toLowerCase();
  const opportunityTeamMembers = typeof teamMembers === 'undefined' ? [] : teamMembers;
  const opportunityOwnerTransfers = typeof ownerTransfers === 'undefined' ? [] : ownerTransfers;
  const canManageOpportunityResponsibility = typeof canManageResponsibility === 'undefined' ? false : canManageResponsibility;
  const activeResponsibilityUsers = typeof responsibilityUsers === 'undefined' ? [] : responsibilityUsers;
  const activeSalesOwnerOptions = typeof salesOwnerOptions === 'undefined' ? [] : salesOwnerOptions;
  const activeResponsibilityRoleOptions = typeof responsibilityRoleOptions === 'undefined' ? [] : responsibilityRoleOptions;
  const ownerName = opportunity.salespersonDisplayName || opportunity.salespersonUsername || opportunity.salespersonId || '';
  const canAddRequirementUpdate = typeof canCreateRequirementUpdate === 'undefined' ? false : canCreateRequirementUpdate;
  const uploadPermissions = typeof canUploadAttachments === 'undefined' ? {} : canUploadAttachments;
  const allWorkflowForms = Array.isArray(workflowForms) ? workflowForms : [];
  const initiationWorkflowForm = allWorkflowForms.find((workflowForm) => workflowForm.action === 'submit_initiation');
  const technicalSubmitWorkflowForm = allWorkflowForms.find((workflowForm) => workflowForm.action === 'submit_technical_solution');
  const commercialQuoteWorkflowForm = allWorkflowForms.find((workflowForm) => workflowForm.action === 'submit_commercial_quote');
  const contractApprovalWorkflowForm = allWorkflowForms.find((workflowForm) => workflowForm.action === 'submit_contract_approval');
  const remainingWorkflowForms = allWorkflowForms.filter((workflowForm) => workflowForm.action !== 'submit_initiation' && workflowForm.action !== 'submit_technical_solution' && workflowForm.action !== 'submit_commercial_quote' && workflowForm.action !== 'submit_contract_approval');
  const canDeleteTechnicalSolutionAttachments = technicalSolutionDeleteStatuses.includes(opportunity.status);
  const canDeleteCommercialQuoteAttachments = ['commercial_quote_in_progress', 'commercial_quote_rejected'].includes(opportunity.status);
  const canDeleteContractAttachments = ['customer_negotiation', 'won_contract_pending', 'contract_rejected'].includes(opportunity.status);
  const contractSubmitUnavailableMessage = (() => {
    if (contractApprovalWorkflowForm || !uploadPermissions.contract || contractAttachments.length === 0) {
      return '';
    }
    if (opportunity.status === 'contract_approval_in_progress') {
      return 'Contract approval has already been submitted.';
    }
    if (opportunity.status === 'contract_archived') {
      return 'Contract approval is archived.';
    }
    return 'Finish the technical solution and commercial quote approval before submitting contract approval.';
  })();
%>
        <p class="breadcrumb"><a href="/opportunities"><%= t('opportunities') %></a></p>
        <header class="page-header">
          <div>
            <h1><%= opportunity.title %></h1>
            <div class="user-line"><%= opportunity.opportunityNo %> - <%= opportunity.customerName %></div>
          </div>
          <div class="page-actions">
            <a class="secondary-action" href="/opportunities"><%= t('backToList') %></a>
            <% if (typeof canEditOpportunity !== 'undefined' && canEditOpportunity) { %>
              <a class="quick-action" href="/opportunities/<%= opportunity.id %>/edit"><%= t('edit') %></a>
            <% } %>
            <% if (typeof canDeleteOpportunity !== 'undefined' && canDeleteOpportunity) { %>
              <form method="post" action="/opportunities/<%= opportunity.id %>/delete" onsubmit="return confirm('Delete this opportunity and all uploaded files?')">
                <button class="danger-action" type="submit"><%= t('delete') %></button>
              </form>
            <% } %>
          </div>
        </header>

        <div class="section-stack">
          <section class="content-section business-section business-section-basic">
            <h2><%= t('basicInfo') %></h2>
            <div class="section-body">
              <div class="basic-info-grid">
                <table class="detail-table">
                  <tbody>
                    <tr>
                      <th scope="row">No.</th>
                      <td><%= opportunity.opportunityNo %></td>
                    </tr>
                    <tr>
                      <th scope="row"><%= t('owner') %></th>
                      <td><%= ownerName %></td>
                    </tr>
                    <tr>
                      <th scope="row"><%= t('customer') %></th>
                      <td><a href="/customers/<%= opportunity.customerId %>"><%= opportunity.customerName %></a></td>
                    </tr>
                    <tr>
                      <th scope="row">Primary Contact</th>
                      <td>
                        <% if (opportunity.primaryContactId) { %>
                          <a href="/contacts/<%= opportunity.primaryContactId %>"><%= opportunity.primaryContactName %></a>
                        <% } %>
                      </td>
                    </tr>
                  </tbody>
                </table>
                <table class="detail-table">
                  <tbody>
                    <tr>
                      <th scope="row"><%= t('status') %></th>
                      <td><%= statusLabel(opportunity.status) %></td>
                    </tr>
                    <tr>
                      <th scope="row">Estimated Amount</th>
                      <td><%= opportunity.estimatedAmount ?? '' %></td>
                    </tr>
                    <tr>
                      <th scope="row">Project Type</th>
                      <td><%= opportunity.projectType %></td>
                    </tr>
                    <tr>
                      <th scope="row">Delivery Period</th>
                      <td><%= opportunity.deliveryCycle %></td>
                    </tr>
                    <tr>
                      <th scope="row">Expected Bid Date</th>
                      <td><%= opportunity.expectedBidDate || '' %></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          <section class="content-section">
            <h2>Responsibility</h2>
            <div class="section-body">
              <div class="responsibility-grid">
                <div class="responsibility-column">
                  <div class="responsibility-block">
                    <h3>Team Members</h3>
                    <div class="responsibility-content">
                      <% if (opportunityTeamMembers.length > 0) { %>
                        <table class="list-table content-fit-table">
                          <thead>
                            <tr>
                              <th>Member</th>
                              <th>Role</th>
                              <th>Permission</th>
                              <th>Added By</th>
                              <th>Added At</th>
                              <% if (canManageOpportunityResponsibility) { %>
                                <th>Actions</th>
                              <% } %>
                            </tr>
                          </thead>
                          <tbody>
                            <% for (const member of opportunityTeamMembers) { %>
                              <tr>
                                <td><%= member.userDisplayName || member.username %></td>
                                <td><%= member.roleName || member.roleCode %></td>
                                <td><%= member.permissionLevel %></td>
                                <td><%= member.addedByDisplayName || '' %></td>
                                <td><%= member.addedAt || '' %></td>
                                <% if (canManageOpportunityResponsibility) { %>
                                  <td>
                                    <form method="post" action="/opportunities/<%= opportunity.id %>/team-members/<%= member.id %>/remove">
                                      <button class="danger-action" type="submit">Remove</button>
                                    </form>
                                  </td>
                                <% } %>
                              </tr>
                            <% } %>
                          </tbody>
                        </table>
                      <% } else { %>
                        <p class="empty">No team members.</p>
                      <% } %>
                      <% if (canManageOpportunityResponsibility) { %>
                        <details class="responsibility-disclosure">
                          <summary>Add Team Member</summary>
                          <form class="form-panel responsibility-form" method="post" action="/opportunities/<%= opportunity.id %>/team-members" data-team-member-form>
                            <label>
                              User
                              <select name="userId" required>
                                <option value=""></option>
                                <% for (const user of activeResponsibilityUsers) { %>
                                  <option value="<%= user.id %>" data-role-codes="<%= (user.roles || []).join(',') %>"><%= user.displayName %> (<%= user.username %>)</option>
                                <% } %>
                              </select>
                            </label>
                            <label>
                              Role
                              <select name="roleCode" required>
                                <% for (const role of activeResponsibilityRoleOptions) { %>
                                  <option value="<%= role.code %>" data-role-code="<%= role.code %>"><%= role.name %></option>
                                <% } %>
                              </select>
                            </label>
                            <label>
                              Permission
                              <select name="permissionLevel" required>
                                <option value="view">View</option>
                                <option value="edit">Edit</option>
                              </select>
                            </label>
                            <button type="submit">Add Team Member</button>
                          </form>
                        </details>
                      <% } %>
                    </div>
                  </div>
                </div>

                <div class="responsibility-column">
                  <div class="responsibility-block">
                    <h3>Owner Transfer History</h3>
                    <div class="responsibility-content">
                      <% if (canManageOpportunityResponsibility) { %>
                        <details class="responsibility-disclosure">
                          <summary>Transfer Owner</summary>
                          <form class="form-panel responsibility-form" method="post" action="/opportunities/<%= opportunity.id %>/owner-transfer">
                            <label>
                              New Owner
                              <select name="toOwnerUserId" required>
                                <option value=""></option>
                                <% for (const user of activeSalesOwnerOptions) { %>
                                  <option value="<%= user.id %>"><%= user.displayName %> (<%= user.username %>)</option>
                                <% } %>
                              </select>
                            </label>
                            <label>
                              Reason
                              <textarea name="reason" required></textarea>
                            </label>
                            <label class="checkbox-label">
                              <input type="checkbox" name="keepPreviousOwnerAsMember">
                              Keep previous owner as team member
                            </label>
                            <button type="submit">Transfer Owner</button>
                          </form>
                        </details>
                      <% } %>
                      <% if (opportunityOwnerTransfers.length > 0) { %>
                        <table class="list-table content-fit-table">
                          <thead>
                            <tr>
                              <th>From Owner</th>
                              <th>To Owner</th>
                              <th>Changed By</th>
                              <th>Reason</th>
                              <th>Transferred At</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% for (const transfer of opportunityOwnerTransfers) { %>
                              <tr>
                                <td><%= transfer.fromOwnerDisplayName %></td>
                                <td><%= transfer.toOwnerDisplayName %></td>
                                <td><%= transfer.changedByDisplayName %></td>
                                <td><%= transfer.reason %></td>
                                <td><%= transfer.transferredAt || '' %></td>
                              </tr>
                            <% } %>
                          </tbody>
                        </table>
                      <% } else { %>
                        <p class="empty">No owner transfer history.</p>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="content-section business-section business-section-requirement">
            <h2>Requirement Materials</h2>
            <div class="section-body">
              <% if (canAddRequirementUpdate) { %>
                <form class="form-panel requirement-input-panel" method="post" action="/opportunities/<%= opportunity.id %>/requirement-updates">
                  <label>
                    Requirement Description
                    <textarea name="requirementText" required></textarea>
                  </label>
                  <input type="hidden" name="reason" value="Customer requirement update">
                  <div class="requirement-input-actions">
                    <button type="submit"><%= t('save') %></button>
                  </div>
                </form>
              <% } %>
              <% if (uploadPermissions.requirement) { %>
                <form class="form-panel attachment-upload-panel" method="post" action="/opportunities/<%= opportunity.id %>/attachments" enctype="multipart/form-data">
                  <input type="hidden" name="category" value="requirement">
                  <input type="file" name="attachment" required>
                  <button type="submit"><%= t('upload') %></button>
                </form>
              <% } %>
              <% if (initiationWorkflowForm) { %>
                <div class="requirement-initiation-actions">
                  <% if (initiationWorkflowForm.missingRequirements && initiationWorkflowForm.missingRequirements.length > 0) { %>
                    <ul class="inline-list">
                      <% for (const requirement of initiationWorkflowForm.missingRequirements) { %>
                        <li><%= requirement %></li>
                      <% } %>
                    </ul>
                  <% } %>
                  <form method="post" action="/opportunities/<%= opportunity.id %>/workflow">
                    <input type="hidden" name="action" value="<%= initiationWorkflowForm.action %>">
                    <button type="submit" <%= initiationWorkflowForm.blocked ? 'disabled' : '' %>><%= initiationWorkflowForm.button %></button>
                  </form>
                </div>
              <% } %>
              <% if (requirementTimeline.length > 0) { %>
                <div class="requirement-timeline">
                  <% for (const item of requirementTimeline) { %>
                    <article class="requirement-row <%= item.attachment ? 'requirement-row-file' : 'requirement-row-text' %>">
                      <span class="requirement-row-time"><%= item.at ? formatShortDate(item.at) : item.timeLabel %></span>
                      <span class="requirement-row-content"><%= item.text %></span>
                      <% if (item.attachment) { %>
                        <div class="inline-actions requirement-row-actions">
                          <a class="requirement-action-preview" href="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/preview"><%= t('preview') %></a>
                          <a class="requirement-action-download" href="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/download" download="<%= item.attachment.originalName %>" target="_blank" rel="noopener"><%= t('download') %></a>
                          <% if (canDeleteRequirementMaterials) { %>
                            <form method="post" action="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/delete" onsubmit="return confirm('Delete this requirement file?')">
                              <button class="danger-action requirement-action-delete" type="submit"><%= t('delete') %></button>
                            </form>
                          <% } %>
                        </div>
                      <% } %>
                    </article>
                  <% } %>
                </div>
              <% } else { %>
                <p class="empty">No requirement records.</p>
              <% } %>
            </div>
          </section>

          <section class="content-section business-section business-section-technical">
            <h2>Technical Solution</h2>
            <div class="section-body">
              <% if (uploadPermissions.technical_solution) { %>
                <form class="form-panel attachment-upload-panel" method="post" action="/opportunities/<%= opportunity.id %>/attachments" enctype="multipart/form-data">
                  <input type="hidden" name="category" value="technical_solution">
                  <input type="file" name="attachment" required>
                  <button type="submit"><%= t('upload') %></button>
                </form>
              <% } %>
              <% if (technicalSubmitWorkflowForm) { %>
                <form class="form-panel requirement-input-panel technical-solution-submit-panel" method="post" action="/opportunities/<%= opportunity.id %>/workflow">
                  <input type="hidden" name="action" value="<%= technicalSubmitWorkflowForm.action %>">
                  <label>
                    Technical Solution Description
                    <textarea name="solutionSummary" required></textarea>
                  </label>
                  <% if (technicalSubmitWorkflowForm.missingRequirements && technicalSubmitWorkflowForm.missingRequirements.length > 0) { %>
                    <ul class="inline-list">
                      <% for (const requirement of technicalSubmitWorkflowForm.missingRequirements) { %>
                        <li><%= requirement %></li>
                      <% } %>
                    </ul>
                  <% } %>
                  <div class="requirement-input-actions">
                    <button type="submit" <%= technicalSubmitWorkflowForm.blocked ? 'disabled' : '' %>><%= technicalSubmitWorkflowForm.button %></button>
                  </div>
                </form>
              <% } %>
              <% if (technicalMaterialVersions.length > 0) { %>
                <div class="material-version-strip">
                  <% for (const version of technicalMaterialVersions) { %>
                    <article class="material-version-card">
                      <span class="material-version-badge">V<%= version.versionNo %></span>
                      <span class="material-version-status material-version-status-<%= materialVersionStatusClass(version.status) %>"><%= version.status %></span>
                      <% if (version.submittedAt || version.submitterDisplayName) { %>
                        <span>Submitted <%= formatShortDate(version.submittedAt) %><%= version.submitterDisplayName ? ` by ${version.submitterDisplayName}` : '' %></span>
                      <% } %>
                      <% if (version.reviewedAt || version.reviewerDisplayName) { %>
                        <span>Reviewed <%= formatShortDate(version.reviewedAt) %><%= version.reviewerDisplayName ? ` by ${version.reviewerDisplayName}` : '' %></span>
                      <% } %>
                      <% if (version.reviewComment) { %>
                        <span class="material-version-comment"><%= version.reviewComment %></span>
                      <% } %>
                    </article>
                  <% } %>
                </div>
              <% } %>
              <% if (technicalSolutionTimeline.length > 0) { %>
                <div class="requirement-timeline">
                  <% for (const item of technicalSolutionTimeline) { %>
                    <article class="requirement-row <%= item.attachment ? 'requirement-row-file' : 'requirement-row-text' %>">
                      <span class="requirement-row-time"><%= item.at ? formatShortDate(item.at) : '' %></span>
                      <span class="requirement-row-content"><%= item.text %></span>
                      <% if (item.attachment) { %>
                        <div class="inline-actions requirement-row-actions">
                          <a class="requirement-action-preview" href="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/preview"><%= t('preview') %></a>
                          <a class="requirement-action-download" href="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/download" download="<%= item.attachment.originalName %>" target="_blank" rel="noopener"><%= t('download') %></a>
                          <% if (canDeleteTechnicalSolutionAttachments) { %>
                            <form method="post" action="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/delete" onsubmit="return confirm('Delete this technical solution file?')">
                              <button class="danger-action requirement-action-delete" type="submit"><%= t('delete') %></button>
                            </form>
                          <% } %>
                        </div>
                      <% } %>
                    </article>
                  <% } %>
                </div>
              <% } else { %>
                <p class="empty">No technical solution records.</p>
              <% } %>
            </div>
          </section>

          <section class="content-section business-section business-section-quote">
            <h2>Commercial Quote</h2>
            <div class="section-body">
              <% if (uploadPermissions.commercial_quote) { %>
                <form class="form-panel attachment-upload-panel" method="post" action="/opportunities/<%= opportunity.id %>/attachments" enctype="multipart/form-data">
                  <input type="hidden" name="category" value="commercial_quote">
                  <input type="file" name="attachment" required>
                  <button type="submit"><%= t('upload') %></button>
                </form>
              <% } %>
              <% if (commercialQuoteWorkflowForm) { %>
                <form class="form-panel requirement-input-panel commercial-quote-submit-panel" method="post" action="/opportunities/<%= opportunity.id %>/workflow">
                  <input type="hidden" name="action" value="<%= commercialQuoteWorkflowForm.action %>">
                  <% if (commercialQuoteWorkflowForm.missingRequirements && commercialQuoteWorkflowForm.missingRequirements.length > 0) { %>
                    <ul class="inline-list">
                      <% for (const requirement of commercialQuoteWorkflowForm.missingRequirements) { %>
                        <li><%= requirement %></li>
                      <% } %>
                    </ul>
                  <% } %>
                  <% for (const field of commercialQuoteWorkflowForm.fields) { %>
                    <label>
                      <%= field.label %>
                      <% if (field.type === 'userSelect') { %>
                        <select name="<%= field.name %>" required>
                          <option value=""></option>
                          <% for (const user of field.users) { %>
                            <option value="<%= user.id %>"><%= user.displayName %></option>
                          <% } %>
                        </select>
                      <% } else if (field.type === 'textarea') { %>
                        <textarea name="<%= field.name %>" <%= field.required ? 'required' : '' %>></textarea>
                      <% } else { %>
                        <input name="<%= field.name %>" type="<%= field.inputType %>" <%= field.required ? 'required' : '' %>>
                      <% } %>
                    </label>
                  <% } %>
                  <button type="submit" <%= commercialQuoteWorkflowForm.blocked ? 'disabled' : '' %>><%= commercialQuoteWorkflowForm.button %></button>
                </form>
              <% } %>
              <% if (commercialQuoteMaterialVersions.length > 0) { %>
                <div class="material-version-strip">
                  <% for (const version of commercialQuoteMaterialVersions) { %>
                    <article class="material-version-card">
                      <span class="material-version-badge">V<%= version.versionNo %></span>
                      <span class="material-version-status material-version-status-<%= materialVersionStatusClass(version.status) %>"><%= version.status %></span>
                      <% if (version.submittedAt || version.submitterDisplayName) { %>
                        <span>Submitted <%= formatShortDate(version.submittedAt) %><%= version.submitterDisplayName ? ` by ${version.submitterDisplayName}` : '' %></span>
                      <% } %>
                      <% if (version.reviewedAt || version.reviewerDisplayName) { %>
                        <span>Reviewed <%= formatShortDate(version.reviewedAt) %><%= version.reviewerDisplayName ? ` by ${version.reviewerDisplayName}` : '' %></span>
                      <% } %>
                      <% if (version.reviewComment) { %>
                        <span class="material-version-comment"><%= version.reviewComment %></span>
                      <% } %>
                    </article>
                  <% } %>
                </div>
              <% } %>
              <% if (commercialQuoteTimeline.length > 0) { %>
                <div class="requirement-timeline">
                  <% for (const item of commercialQuoteTimeline) { %>
                    <article class="requirement-row requirement-row-file">
                      <div class="requirement-row-time"><%= formatShortDate(item.at) %></div>
                      <div class="requirement-row-content"><%= item.text %></div>
                      <div class="inline-actions requirement-row-actions">
                        <a class="requirement-action-preview" href="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/preview"><%= t('preview') %></a>
                        <a class="requirement-action-download" href="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/download" download="<%= item.attachment.originalName %>" target="_blank" rel="noopener"><%= t('download') %></a>
                        <% if (canDeleteCommercialQuoteAttachments) { %>
                          <form method="post" action="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/delete" onsubmit="return confirm('Delete this commercial quote file?')">
                            <button class="danger-action requirement-action-delete" type="submit"><%= t('delete') %></button>
                          </form>
                        <% } %>
                      </div>
                    </article>
                  <% } %>
                </div>
              <% } else { %>
                <p class="empty">No commercial quote files.</p>
              <% } %>
            </div>
          </section>

          <section class="content-section business-section business-section-contract">
            <h2>Commercial Contract</h2>
            <div class="section-body">
              <% if (uploadPermissions.contract) { %>
                <form class="form-panel attachment-upload-panel" method="post" action="/opportunities/<%= opportunity.id %>/attachments" enctype="multipart/form-data">
                  <input type="hidden" name="category" value="contract">
                  <input type="file" name="attachment" required>
                  <button type="submit"><%= t('upload') %></button>
                </form>
              <% } %>
              <% if (contractApprovalWorkflowForm) { %>
                <form class="form-panel requirement-input-panel commercial-quote-submit-panel" method="post" action="/opportunities/<%= opportunity.id %>/workflow">
                  <input type="hidden" name="action" value="<%= contractApprovalWorkflowForm.action %>">
                  <% if (contractApprovalWorkflowForm.missingRequirements && contractApprovalWorkflowForm.missingRequirements.length > 0) { %>
                    <ul class="inline-list">
                      <% for (const requirement of contractApprovalWorkflowForm.missingRequirements) { %>
                        <li><%= requirement %></li>
                      <% } %>
                    </ul>
                  <% } %>
                  <% for (const field of contractApprovalWorkflowForm.fields) { %>
                    <label>
                      <%= field.label %>
                      <% if (field.type === 'userSelect') { %>
                        <select name="<%= field.name %>" required>
                          <option value=""></option>
                          <% for (const user of field.users) { %>
                            <option value="<%= user.id %>"><%= user.displayName %></option>
                          <% } %>
                        </select>
                      <% } else if (field.type === 'textarea') { %>
                        <textarea name="<%= field.name %>" <%= field.required ? 'required' : '' %>></textarea>
                      <% } else { %>
                        <input name="<%= field.name %>" type="<%= field.inputType %>" <%= field.required ? 'required' : '' %>>
                      <% } %>
                    </label>
                  <% } %>
                  <button type="submit" <%= contractApprovalWorkflowForm.blocked ? 'disabled' : '' %>><%= contractApprovalWorkflowForm.button %></button>
                </form>
              <% } else if (contractSubmitUnavailableMessage) { %>
                <div class="form-panel requirement-input-panel commercial-quote-submit-panel">
                  <p class="empty"><%= contractSubmitUnavailableMessage %></p>
                  <button type="button" disabled><%= t('workflowButton.submit_contract_approval') %></button>
                </div>
              <% } %>
              <% if (contractMaterialVersions.length > 0) { %>
                <div class="material-version-strip">
                  <% for (const version of contractMaterialVersions) { %>
                    <article class="material-version-card">
                      <span class="material-version-badge">V<%= version.versionNo %></span>
                      <span class="material-version-status material-version-status-<%= materialVersionStatusClass(version.status) %>"><%= version.status %></span>
                      <% if (version.submittedAt || version.submitterDisplayName) { %>
                        <span>Submitted <%= formatShortDate(version.submittedAt) %><%= version.submitterDisplayName ? ` by ${version.submitterDisplayName}` : '' %></span>
                      <% } %>
                      <% if (version.reviewedAt || version.reviewerDisplayName) { %>
                        <span>Reviewed <%= formatShortDate(version.reviewedAt) %><%= version.reviewerDisplayName ? ` by ${version.reviewerDisplayName}` : '' %></span>
                      <% } %>
                      <% if (version.reviewComment) { %>
                        <span class="material-version-comment"><%= version.reviewComment %></span>
                      <% } %>
                    </article>
                  <% } %>
                </div>
              <% } %>
              <% if (contractTimeline.length > 0) { %>
                <div class="requirement-timeline">
                  <% for (const item of contractTimeline) { %>
                    <article class="requirement-row requirement-row-file">
                      <div class="requirement-row-time"><%= formatShortDate(item.at) %></div>
                      <div class="requirement-row-content"><%= item.text %></div>
                      <div class="inline-actions requirement-row-actions">
                        <a class="requirement-action-preview" href="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/preview"><%= t('preview') %></a>
                        <a class="requirement-action-download" href="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/download" download="<%= item.attachment.originalName %>" target="_blank" rel="noopener"><%= t('download') %></a>
                        <% if (canDeleteContractAttachments) { %>
                          <form method="post" action="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/delete" onsubmit="return confirm('Delete this contract file?')">
                            <button class="danger-action requirement-action-delete" type="submit"><%= t('delete') %></button>
                          </form>
                        <% } %>
                      </div>
                    </article>
                  <% } %>
                </div>
              <% } else { %>
                <p class="empty">No contract files.</p>
              <% } %>
            </div>
          </section>

          <section class="content-section">
            <h2>Timeline</h2>
            <div class="section-body">
              <% if (timelineEvents && timelineEvents.length > 0) { %>
                <ol class="inline-list">
                  <% for (const event of timelineEvents) { %>
                    <li>
                      <strong><%= event.eventType %></strong>
                      <span><%= event.fromStatus || '' %></span>
                      <span><%= event.toStatus || '' %></span>
                      <span><%= event.actorDisplayName %></span>
                      <% if (event.targetDisplayName) { %>
                        <span><%= event.targetDisplayName %></span>
                      <% } %>
                      <% if (event.comment) { %>
                        <p><%= event.comment %></p>
                      <% } %>
                      <span class="muted"><%= event.createdAt || '' %></span>
                    </li>
                  <% } %>
                </ol>
              <% } else { %>
                <p class="empty">No timeline events.</p>
              <% } %>
            </div>
          </section>

          <% if (remainingWorkflowForms.length > 0) { %>
            <section>
              <h2>Workflow Actions</h2>
              <div class="section-stack">
                <% for (const workflowForm of remainingWorkflowForms) { %>
                  <section class="action-section">
                    <h3><%= workflowForm.title %></h3>
                    <div class="section-body">
                      <% if (workflowForm.missingRequirements && workflowForm.missingRequirements.length > 0) { %>
                        <ul class="inline-list">
                          <% for (const requirement of workflowForm.missingRequirements) { %>
                            <li><%= requirement %></li>
                          <% } %>
                        </ul>
                      <% } %>
                      <form class="form-panel" method="post" action="/opportunities/<%= opportunity.id %>/workflow">
                        <input type="hidden" name="action" value="<%= workflowForm.action %>">
                        <% for (const field of workflowForm.fields) { %>
                          <label>
                            <%= field.label %>
                            <% if (field.type === 'userSelect') { %>
                              <select name="<%= field.name %>" required>
                                <option value=""></option>
                                <% for (const user of field.users) { %>
                                  <option value="<%= user.id %>"><%= user.displayName %></option>
                                <% } %>
                              </select>
                            <% } else if (field.type === 'textarea') { %>
                              <textarea name="<%= field.name %>" <%= field.required ? 'required' : '' %>></textarea>
                            <% } else { %>
                              <input name="<%= field.name %>" type="<%= field.inputType %>" <%= field.required ? 'required' : '' %>>
                            <% } %>
                          </label>
                        <% } %>
                        <button type="submit" <%= workflowForm.blocked ? 'disabled' : '' %>><%= workflowForm.button %></button>
                      </form>
                    </div>
                  </section>
                <% } %>
              </div>
            </section>
          <% } %>
        </div>
<% if (canManageOpportunityResponsibility) { %>
        <script>
          (function () {
            function syncTeamMemberRoleOptions(form) {
              const userSelect = form.querySelector('select[name="userId"]');
              const roleSelect = form.querySelector('select[name="roleCode"]');
              if (!userSelect || !roleSelect) {
                return;
              }
              const selectedUser = userSelect.selectedOptions[0];
              const roleCodes = new Set(String(selectedUser?.dataset.roleCodes || '').split(',').filter(Boolean));
              let firstAllowedValue = '';
              for (const option of roleSelect.options) {
                const roleCode = option.dataset.roleCode || option.value;
                const isAllowed = roleCodes.has(roleCode);
                option.hidden = roleCodes.size > 0 && !isAllowed;
                option.disabled = roleCodes.size > 0 && !isAllowed;
                if (isAllowed && !firstAllowedValue) {
                  firstAllowedValue = option.value;
                }
              }
              roleSelect.disabled = roleCodes.size === 0;
              if (!roleCodes.has(roleSelect.value)) {
                roleSelect.value = firstAllowedValue;
              }
            }

            for (const form of document.querySelectorAll('[data-team-member-form]')) {
              const userSelect = form.querySelector('select[name="userId"]');
              userSelect?.addEventListener('change', () => syncTeamMemberRoleOptions(form));
              syncTeamMemberRoleOptions(form);
            }
          })();
        </script>
<% } %>
<%- include('../partials/app-end') %>
