<%- include('../partials/app-start', { title: opportunity.title + ' - BESTCRM', activeNav: 'opportunities' }) %>
<%
  const attachmentUploadedAtSortValue = (value) => value instanceof Date ? value.toISOString() : String(value || '');
  const orderedAttachments = [...(attachments || [])].sort((left, right) => {
    const leftAt = attachmentUploadedAtSortValue(left.uploadedAt);
    const rightAt = attachmentUploadedAtSortValue(right.uploadedAt);
    if (leftAt !== rightAt) {
      return leftAt.localeCompare(rightAt);
    }
    return Number(left.id || 0) - Number(right.id || 0);
  });
  const requirementAttachments = orderedAttachments.filter((attachment) => attachment.category === 'requirement' || attachment.category === 'other');
  const technicalSolutionAttachments = orderedAttachments.filter((attachment) => attachment.category === 'technical_solution');
  const commercialQuoteAttachments = orderedAttachments.filter((attachment) => attachment.category === 'commercial_quote');
  const contractAttachments = orderedAttachments.filter((attachment) => attachment.category === 'contract');
  const canDeleteRequirementMaterials = ['draft', 'initiation_rejected'].includes(opportunity.status);
  const supplementalRequirementUpdates = typeof requirementUpdates === 'undefined' ? [] : requirementUpdates;
  const technicalSolutionDeleteStatuses = ['technical_solution_in_progress', 'technical_solution_rejected'];
  const shortDateFormatter = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Asia/Singapore',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hourCycle: 'h23'
  });
  const formatShortDate = (value) => {
    if (!value) {
      return '';
    }
    const date = value instanceof Date ? value : new Date(value);
    if (Number.isNaN(date.getTime())) {
      return String(value);
    }
    const parts = Object.fromEntries(
      shortDateFormatter.formatToParts(date).map((part) => [part.type, part.value])
    );
    return `${parts.year}-${parts.month}-${parts.day} ${parts.hour}:${parts.minute}`;
  };
  const requirementTimelineSortValue = (value) => {
    if (!value) {
      return '';
    }
    return value instanceof Date ? value.toISOString() : String(value);
  };
  const requirementTimeline = [
    {
      key: 'initial',
      type: 'Text',
      timeLabel: t('initialRequirement'),
      text: opportunity.requirement,
      at: '',
      sortAt: ''
    },
    ...supplementalRequirementUpdates.map((update) => ({
      key: `text-${update.id}`,
      type: 'Text',
      text: update.requirementText,
      at: update.createdAt,
      sortAt: requirementTimelineSortValue(update.createdAt)
    })),
    ...requirementAttachments.map((attachment) => ({
      key: `file-${attachment.id}`,
      type: 'File',
      attachment,
      text: attachment.originalName,
      at: attachment.uploadedAt,
      sortAt: requirementTimelineSortValue(attachment.uploadedAt)
    }))
  ].filter((item) => item.text || item.attachment).sort((left, right) => {
    if (left.sortAt !== right.sortAt) {
      return left.sortAt.localeCompare(right.sortAt);
    }
    return String(left.key).localeCompare(String(right.key));
  });
  const technicalSolutionTimeline = technicalSolutionAttachments.map((attachment) => ({
      key: `technical-file-${attachment.id}`,
      type: 'File',
      attachment,
      text: attachment.originalName,
      at: attachment.uploadedAt,
      sortAt: requirementTimelineSortValue(attachment.uploadedAt)
    })).sort((left, right) => {
    if (left.sortAt !== right.sortAt) {
      return left.sortAt.localeCompare(right.sortAt);
    }
    return String(left.key).localeCompare(String(right.key));
  });
  const commercialQuoteTimeline = [
    ...commercialQuoteAttachments.map((attachment) => ({
      key: `commercial-quote-file-${attachment.id}`,
      type: 'File',
      attachment,
      text: attachment.originalName,
      at: attachment.uploadedAt,
      sortAt: requirementTimelineSortValue(attachment.uploadedAt)
    }))
  ].filter((item) => item.text || item.attachment).sort((left, right) => {
    if (left.sortAt !== right.sortAt) {
      return left.sortAt.localeCompare(right.sortAt);
    }
    return String(left.key).localeCompare(String(right.key));
  });
  const contractTimeline = [
    ...contractAttachments.map((attachment) => ({
      key: `contract-file-${attachment.id}`,
      type: 'File',
      attachment,
      text: attachment.originalName,
      at: attachment.uploadedAt,
      sortAt: requirementTimelineSortValue(attachment.uploadedAt)
    }))
  ].filter((item) => item.text || item.attachment).sort((left, right) => {
    if (left.sortAt !== right.sortAt) {
      return left.sortAt.localeCompare(right.sortAt);
    }
    return String(left.key).localeCompare(String(right.key));
  });
  const materialApprovalVersions = typeof materialVersions === 'undefined' ? [] : materialVersions;
  const materialVersionById = new Map(materialApprovalVersions.map((version) => [Number(version.id), version]));
  const ownerName = opportunity.salespersonDisplayName || opportunity.salespersonUsername || opportunity.salespersonId || '';
  const signedInUserId = typeof currentUserId === 'undefined' ? null : currentUserId;
  const signedInUserIsSupportingEngineer = typeof currentUserIsSupportingEngineer === 'undefined' ? false : currentUserIsSupportingEngineer;
  const canAddRequirementUpdate = typeof canCreateRequirementUpdate === 'undefined' ? false : canCreateRequirementUpdate;
  const uploadPermissions = typeof canUploadAttachments === 'undefined' ? {} : canUploadAttachments;
  const allWorkflowForms = Array.isArray(workflowForms) ? workflowForms : [];
  const usesVersionedTechnicalDrafts = typeof versionedTechnicalDraftsEnabled === 'undefined' ? false : versionedTechnicalDraftsEnabled;
  const initiationWorkflowForm = allWorkflowForms.find((workflowForm) => workflowForm.action === 'submit_initiation');
  const technicalSubmitWorkflowForm = allWorkflowForms.find((workflowForm) => workflowForm.action === 'submit_technical_solution');
  const commercialQuoteWorkflowForm = allWorkflowForms.find((workflowForm) => workflowForm.action === 'submit_commercial_quote');
  const contractApprovalWorkflowForm = allWorkflowForms.find((workflowForm) => workflowForm.action === 'submit_contract_approval');
  const projectApprovalForms = allWorkflowForms.filter((workflowForm) => ['approve_initiation', 'reject_initiation'].includes(workflowForm.action));
  const requirementWorkflowForms = allWorkflowForms.filter((workflowForm) => workflowForm.action === 'withdraw_initiation');
  const technicalWorkflowForms = allWorkflowForms.filter((workflowForm) => ['change_quotation_engineer', 'withdraw_technical_solution', 'approve_technical_solution', 'reject_technical_solution'].includes(workflowForm.action));
  const commercialWorkflowForms = allWorkflowForms.filter((workflowForm) => ['withdraw_commercial_quote', 'approve_commercial_quote', 'reject_commercial_quote', 'mark_won', 'mark_lost'].includes(workflowForm.action));
  const contractWorkflowForms = allWorkflowForms.filter((workflowForm) => ['withdraw_contract_approval', 'approve_contract', 'reject_contract'].includes(workflowForm.action));
  const technicalStageWorkflowForms = [
    ...(!usesVersionedTechnicalDrafts && technicalSubmitWorkflowForm ? [technicalSubmitWorkflowForm] : []),
    ...technicalWorkflowForms
  ];
  const commercialStageWorkflowForms = [
    ...(commercialQuoteWorkflowForm ? [commercialQuoteWorkflowForm] : []),
    ...commercialWorkflowForms
  ];
  const contractStageWorkflowForms = [
    ...(contractApprovalWorkflowForm ? [contractApprovalWorkflowForm] : []),
    ...contractWorkflowForms
  ];
  const technicalStartedStatuses = new Set([
    'technical_solution_in_progress', 'technical_solution_pending', 'technical_solution_rejected',
    'commercial_quote_in_progress', 'commercial_quote_pending', 'commercial_quote_rejected',
    'customer_negotiation', 'lost_archived', 'won_contract_pending',
    'contract_approval_in_progress', 'contract_rejected', 'contract_archived'
  ]);
  const commercialStartedStatuses = new Set([
    'commercial_quote_in_progress', 'commercial_quote_pending', 'commercial_quote_rejected',
    'customer_negotiation', 'lost_archived', 'won_contract_pending',
    'contract_approval_in_progress', 'contract_rejected', 'contract_archived'
  ]);
  const contractStartedStatuses = new Set(['won_contract_pending', 'contract_approval_in_progress', 'contract_rejected', 'contract_archived']);
  const technicalStarted = technicalStartedStatuses.has(opportunity.status);
  const commercialStarted = commercialStartedStatuses.has(opportunity.status);
  const contractStarted = contractStartedStatuses.has(opportunity.status);
  const canDeleteTechnicalSolutionAttachments = technicalSolutionDeleteStatuses.includes(opportunity.status);
  const canDeleteCommercialQuoteAttachments = ['commercial_quote_in_progress', 'commercial_quote_rejected'].includes(opportunity.status);
  const canDeleteContractAttachments = ['customer_negotiation', 'won_contract_pending', 'contract_rejected'].includes(opportunity.status);
  const contractSubmitUnavailableMessage = (() => {
    if (contractApprovalWorkflowForm || !uploadPermissions.contract || contractAttachments.length === 0) {
      return '';
    }
    if (opportunity.status === 'contract_approval_in_progress') {
      return t('contractApprovalAlreadySubmitted');
    }
    if (opportunity.status === 'contract_archived') {
      return t('contractApprovalArchived');
    }
    return t('contractApprovalPrerequisite');
  })();
  const correspondence = (typeof correspondenceThreads === 'undefined' ? [] : correspondenceThreads)
    .flatMap((thread) => (thread.messages || []).map((message) => ({
      ...message,
      threadId: thread.id,
      threadSubject: thread.subject,
      occurredAt: message.receivedAt || message.sentAt || message.createdAt
    })))
    .sort((left, right) => requirementTimelineSortValue(right.occurredAt).localeCompare(requirementTimelineSortValue(left.occurredAt)));
%>
        <p class="breadcrumb"><a href="/opportunities"><%= t('opportunities') %></a></p>
        <header class="page-header opportunity-detail-header">
          <div class="opportunity-detail-heading">
            <h1><%= opportunity.title %></h1>
            <div class="user-line"><%= opportunity.opportunityNo %></div>
          </div>
          <div class="page-actions opportunity-detail-actions">
            <a class="secondary-action" href="/opportunities" title="<%= t('backToList') %>" aria-label="<%= t('backToList') %>"><span aria-hidden="true">←</span> <%= t('backShort') %></a>
            <% if (customerEmailSendingEnabled) { %><a class="secondary-action" href="/email-center/compose?opportunityId=<%= opportunity.id %>" title="<%= t('composeCustomerEmail') %>" aria-label="<%= t('composeCustomerEmail') %>"><span aria-hidden="true">✉</span> <%= t('emailShort') %></a><% } %>
            <% if (typeof bidCenterEnabled !== 'undefined' && bidCenterEnabled) { %><a class="secondary-action" href="/opportunities/<%= opportunity.id %>/bid-workspace" title="<%= t('createOrOpenBidWorkspace') %>" aria-label="<%= t('createOrOpenBidWorkspace') %>"><%= t('biddingShort') %></a><% } %>
            <a class="secondary-action" href="/opportunities/<%= opportunity.id %>/technical-drafts" title="<%= t('projectTechnicalDrafts') %>" aria-label="<%= t('projectTechnicalDrafts') %>"><%= t('technicalShort') %></a>
            <% if (typeof canEditOpportunity !== 'undefined' && canEditOpportunity) { %>
              <a class="quick-action" href="/opportunities/<%= opportunity.id %>/edit"><%= t('edit') %></a>
            <% } %>
            <% if (typeof canArchiveOpportunity !== 'undefined' && canArchiveOpportunity) { %>
              <form method="post" action="/opportunities/<%= opportunity.id %>/archive">
                <%- csrfField() %>
                <input name="reason" required maxlength="500" placeholder="<%= t('archiveReason') %>" aria-label="<%= t('archiveReason') %>">
                <button class="danger-action" type="submit"><%= t('archive') %></button>
              </form>
            <% } %>
            <% if (typeof canReopenOpportunity !== 'undefined' && canReopenOpportunity) { %>
              <form method="post" action="/opportunities/<%= opportunity.id %>/reopen">
                <%- csrfField() %>
                <input name="reason" required maxlength="500" placeholder="<%= t('reopenReason') %>" aria-label="<%= t('reopenReason') %>">
                <button class="quick-action" type="submit"><%= t('reopen') %></button>
              </form>
            <% } %>
          </div>
        </header>
        <% if (opportunity.archivedAt) { %><p class="user-line"><%= t('archivedRecord') %><% if (opportunity.archiveReason) { %>: <%= opportunity.archiveReason %><% } %></p><% } %>

        <div class="section-stack">
          <section class="content-section business-section business-section-basic">
            <h2><%= t('basicInfo') %></h2>
            <div class="section-body">
              <div class="basic-info-grid">
                <table class="detail-table basic-info-table">
                  <colgroup>
                    <col class="basic-info-label-column">
                    <col>
                    <col class="basic-info-label-column">
                    <col>
                  </colgroup>
                  <tbody>
                    <tr>
                      <th scope="row"><%= t('no') %></th>
                      <td><%= opportunity.opportunityNo %></td>
                      <th scope="row"><%= t('status') %></th>
                      <td><%= statusLabel(opportunity.status) %></td>
                    </tr>
                    <tr>
                      <th scope="row"><%= t('owner') %></th>
                      <td><%= ownerName %></td>
                      <th scope="row"><%= t('estimatedAmount') %></th>
                      <td><%= opportunity.estimatedAmount ?? '' %></td>
                    </tr>
                    <tr>
                      <th scope="row"><%= t('customer') %></th>
                      <td><a href="/customers/<%= opportunity.customerId %>"><%= opportunity.customerCode ? `${opportunity.customerCode} · ` : '' %><%= opportunity.customerName %></a></td>
                      <th scope="row"><%= t('productInterest') %></th>
                      <td><%= opportunity.productInterest || '' %></td>
                    </tr>
                    <tr>
                      <th scope="row"><%= t('primaryContact') %></th>
                      <td>
                        <% if (opportunity.primaryContactId) { %>
                          <a href="/contacts/<%= opportunity.primaryContactId %>"><%= opportunity.primaryContactCode ? `${opportunity.primaryContactCode} · ` : '' %><%= opportunity.primaryContactName %></a>
                        <% } %>
                      </td>
                      <th scope="row"><%= t('opportunityType') %></th>
                      <td><%= opportunity.projectType %></td>
                    </tr>
                    <tr>
                      <th scope="row"><%= t('deliveryPeriod') %></th>
                      <td><%= opportunity.deliveryCycle %></td>
                      <th scope="row"><%= t('expectedBidDate') %></th>
                      <td><%= opportunity.expectedBidDate || '' %></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          <% if (correspondence.length > 0) { %>
            <section class="content-section business-section business-section-correspondence">
              <h2><span><%= t('correspondence') %></span><span class="section-heading-meta"><%= correspondence.length %> <%= t('messages') %></span></h2>
              <div class="section-body correspondence-timeline">
                <% for (const message of correspondence) { const recipients = (message.toRecipients || []).map((recipient) => recipient.name ? `${recipient.name} <${recipient.address}>` : recipient.address).join(', '); %>
                  <details class="correspondence-item">
                    <summary>
                      <time><%= formatShortDate(message.occurredAt) %></time>
                      <span class="correspondence-marker" aria-hidden="true"></span>
                      <span class="correspondence-summary-main">
                        <strong><%= message.subject || message.threadSubject || t('noSubject') %></strong>
                        <span class="muted"><%= message.fromAddress %><% if (recipients) { %> → <%= recipients %><% } %></span>
                      </span>
                      <span class="correspondence-direction"><%= message.direction === 'outbound' ? `→ ${t('outgoing')}` : `← ${t('incoming')}` %></span>
                    </summary>
                    <div class="correspondence-content">
                      <pre><%= message.textBody %></pre>
                      <% if (message.attachments && message.attachments.length > 0) { %>
                        <div class="correspondence-attachments">
                          <% for (const attachment of message.attachments) { %>
                            <a href="/email-center/attachments/<%= attachment.id %>/download"><%= attachment.originalName %></a>
                          <% } %>
                        </div>
                      <% } %>
                      <div class="inline-actions correspondence-actions">
                        <a href="/email-center/threads/<%= message.threadId %>"><%= t('openEmailThread') %></a>
                        <% if (customerEmailSendingEnabled) { %><a href="/email-center/compose?threadId=<%= message.threadId %>"><%= t('reply') %></a><% } %>
                      </div>
                    </div>
                  </details>
                <% } %>
              </div>
            </section>
          <% } %>

          <section class="content-section business-section opportunity-workflow-section business-section-requirement" id="requirement-materials">
            <h2><%= t('customerRequirement') %></h2>
            <div class="section-body">
              <div class="requirement-source-stack">
                <section class="requirement-source-block">
                  <h3>1 · <%= t('requirementText') %></h3>
                  <% if (canAddRequirementUpdate) { %>
                    <form class="requirement-input-panel" method="post" action="/opportunities/<%= opportunity.id %>/requirement-updates">
                      <%- csrfField() %>
                      <label class="visually-hidden" for="requirement-text-<%= opportunity.id %>"><%= t('requirementText') %></label>
                      <textarea id="requirement-text-<%= opportunity.id %>" name="requirementText" required></textarea>
                      <input type="hidden" name="reason" value="<%= t('customerRequirementUpdateReason') %>">
                      <div class="requirement-input-actions">
                        <button type="submit"><%= t('save') %></button>
                      </div>
                      <% if (typeof requirementSaveState !== 'undefined' && requirementSaveState === 'duplicate') { %><p class="duplicate-save-note"><%= t('duplicateRequirementBlocked') %></p><% } %>
                    </form>
                  <% } %>
                  <% for (const item of requirementTimeline.filter((entry) => !entry.attachment)) { %>
                    <article class="requirement-row requirement-row-text">
                      <span class="requirement-row-time"><%= item.at ? formatShortDate(item.at) : item.timeLabel %></span>
                      <span class="requirement-row-content"><%= item.text %></span>
                    </article>
                  <% } %>
                </section>

                <section class="requirement-source-block">
                  <h3>2 · <%= t('linkedEmail') %></h3>
                  <% if (typeof correspondenceThreads !== 'undefined' && correspondenceThreads.length > 0) { %>
                    <% for (const thread of correspondenceThreads) { %>
                      <article class="requirement-row requirement-row-email">
                        <span class="requirement-row-time"><%= formatShortDate(thread.lastMessageAt) %></span>
                        <span class="requirement-row-content"><%= thread.subject || t('noSubject') %></span>
                        <a class="requirement-action-preview" href="/email-center/threads/<%= thread.id %>"><%= t('openEmailThread') %></a>
                      </article>
                    <% } %>
                  <% } else { %>
                    <p class="empty"><%= t('noLinkedEmail') %></p>
                  <% } %>
                </section>

                <section class="requirement-source-block">
                  <h3>3 · <%= t('uploadedFiles') %></h3>
                  <% for (const item of requirementTimeline.filter((entry) => entry.attachment)) { %>
                    <article class="requirement-row requirement-row-file">
                      <span class="requirement-row-time"><%= formatShortDate(item.at) %></span>
                      <span class="requirement-row-content"><%= item.text %></span>
                      <div class="inline-actions requirement-row-actions">
                        <a class="requirement-action-preview" href="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/preview"><%= t('preview') %></a>
                        <a class="requirement-action-download" href="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/download"><%= t('download') %></a>
                        <% if (canDeleteRequirementMaterials) { %>
                          <form method="post" action="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/delete" onsubmit="return confirm('<%= t('deleteRequirementFileConfirm') %>')">
                            <%- csrfField() %>
                            <button class="danger-action requirement-action-delete" type="submit"><%= t('delete') %></button>
                          </form>
                        <% } %>
                      </div>
                    </article>
                  <% } %>
                  <% if (uploadPermissions.requirement) { %>
                    <form class="attachment-upload-panel requirement-file-upload" method="post" action="/opportunities/<%= opportunity.id %>/attachments" enctype="multipart/form-data">
                      <%- csrfField() %>
                      <input type="hidden" name="category" value="requirement">
                      <span class="attachment-upload-label"><%= t('uploadFile') %></span>
                      <input type="file" name="attachment" required>
                      <button type="submit"><%= t('upload') %></button>
                    </form>
                  <% } %>
                </section>
              </div>
              <% if (initiationWorkflowForm) { %>
                <div class="requirement-initiation-actions">
                  <% if (initiationWorkflowForm.missingRequirements && initiationWorkflowForm.missingRequirements.length > 0) { %>
                    <ul class="inline-list">
                      <% for (const requirement of initiationWorkflowForm.missingRequirements) { %>
                        <li><%= requirement %></li>
                      <% } %>
                    </ul>
                  <% } %>
                  <form method="post" action="/opportunities/<%= opportunity.id %>/workflow">
                    <%- csrfField() %>
                    <input type="hidden" name="action" value="<%= initiationWorkflowForm.action %>">
                    <button type="submit" <%= initiationWorkflowForm.blocked ? 'disabled' : '' %>><%= initiationWorkflowForm.button %></button>
                  </form>
                </div>
              <% } %>
              <%- include('_workflow-actions', { forms: requirementWorkflowForms }) %>
            </div>
          </section>

          <% if (projectApprovalForms.length > 0) { %>
            <section class="content-section business-section opportunity-workflow-section business-section-project-approval">
              <h2><%= t('projectApproval') %></h2>
              <div class="section-body">
                <%- include('_workflow-actions', { forms: projectApprovalForms }) %>
              </div>
            </section>
          <% } %>

          <% if (technicalStarted) { %>
          <section class="content-section business-section opportunity-workflow-section business-section-technical">
            <h2><%= t('technicalProposal') %></h2>
            <div class="section-body">
              <% if (uploadPermissions.technical_solution) { %>
                <form class="form-panel attachment-upload-panel" method="post" action="/opportunities/<%= opportunity.id %>/attachments" enctype="multipart/form-data">
                  <%- csrfField() %>
                  <input type="hidden" name="category" value="technical_solution">
                  <span class="attachment-upload-label"><%= t('uploadProposal') %></span>
                  <input type="file" name="attachment" required>
                  <button type="submit"><%= t('upload') %></button>
                </form>
              <% } %>
              <% if (technicalSolutionTimeline.length > 0) { %>
                <div class="requirement-timeline">
                  <% for (const item of technicalSolutionTimeline) { const linkedVersion = materialVersionById.get(Number(item.attachment.opportunityMaterialVersionId)); %>
                    <article class="requirement-row requirement-row-file">
                      <span class="requirement-row-time"><%= formatShortDate(item.at) %></span>
                      <span class="requirement-row-content"><%= item.text %><% if (linkedVersion?.versionNo) { %> <span class="file-version">V<%= linkedVersion.versionNo %></span><% } %></span>
                      <div class="inline-actions requirement-row-actions">
                        <a class="requirement-action-preview" href="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/preview"><%= t('preview') %></a>
                        <a class="requirement-action-download" href="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/download"><%= t('download') %></a>
                        <% if (canDeleteTechnicalSolutionAttachments && uploadPermissions.technical_solution && (!signedInUserIsSupportingEngineer || Number(item.attachment.uploadedBy) === Number(signedInUserId))) { %>
                          <form method="post" action="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/delete" onsubmit="return confirm('<%= t('deleteTechnicalSolutionFileConfirm') %>')">
                            <%- csrfField() %>
                            <button class="danger-action requirement-action-delete" type="submit"><%= t('delete') %></button>
                          </form>
                        <% } %>
                      </div>
                    </article>
                  <% } %>
                </div>
              <% } else { %>
                <p class="empty"><%= t('noTechnicalSolutionRecords') %></p>
              <% } %>
              <%- include('_workflow-actions', { forms: technicalStageWorkflowForms }) %>
            </div>
          </section>
          <% } else { %>
            <section class="content-section business-section opportunity-workflow-section business-section-technical business-section-future">
              <h2><span><%= t('technicalProposal') %></span><span class="section-heading-meta"><%= t('notStarted') %></span></h2>
            </section>
          <% } %>

          <% if (commercialStarted) { %>
          <section class="content-section business-section opportunity-workflow-section business-section-quote">
            <h2><%= t('commercialProposal') %></h2>
            <div class="section-body">
              <% if (uploadPermissions.commercial_quote) { %>
                <form class="form-panel attachment-upload-panel" method="post" action="/opportunities/<%= opportunity.id %>/attachments" enctype="multipart/form-data">
                  <%- csrfField() %>
                  <input type="hidden" name="category" value="commercial_quote">
                  <span class="attachment-upload-label"><%= t('uploadProposal') %></span>
                  <input type="file" name="attachment" required>
                  <button type="submit"><%= t('upload') %></button>
                </form>
              <% } %>
              <% if (commercialQuoteTimeline.length > 0) { %>
                <div class="requirement-timeline">
                  <% for (const item of commercialQuoteTimeline) { const linkedVersion = materialVersionById.get(Number(item.attachment.opportunityMaterialVersionId)); %>
                    <article class="requirement-row requirement-row-file">
                      <div class="requirement-row-time"><%= formatShortDate(item.at) %></div>
                      <div class="requirement-row-content"><%= item.text %><% if (linkedVersion?.versionNo) { %> <span class="file-version">V<%= linkedVersion.versionNo %></span><% } %></div>
                      <div class="inline-actions requirement-row-actions">
                        <a class="requirement-action-preview" href="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/preview"><%= t('preview') %></a>
                        <a class="requirement-action-download" href="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/download"><%= t('download') %></a>
                        <% if (canDeleteCommercialQuoteAttachments) { %>
                          <form method="post" action="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/delete" onsubmit="return confirm('<%= t('deleteCommercialQuoteFileConfirm') %>')">
                            <%- csrfField() %>
                            <button class="danger-action requirement-action-delete" type="submit"><%= t('delete') %></button>
                          </form>
                        <% } %>
                      </div>
                    </article>
                  <% } %>
                </div>
              <% } else { %>
                <p class="empty"><%= t('noCommercialQuoteFiles') %></p>
              <% } %>
              <%- include('_workflow-actions', { forms: commercialStageWorkflowForms }) %>
            </div>
          </section>
          <% } else { %>
            <section class="content-section business-section opportunity-workflow-section business-section-quote business-section-future">
              <h2><span><%= t('commercialProposal') %></span><span class="section-heading-meta"><%= t('notStarted') %></span></h2>
            </section>
          <% } %>

          <% if (contractStarted) { %>
          <section class="content-section business-section opportunity-workflow-section business-section-contract">
            <h2><%= t('contract') %></h2>
            <div class="section-body">
              <% if (uploadPermissions.contract) { %>
                <form class="form-panel attachment-upload-panel" method="post" action="/opportunities/<%= opportunity.id %>/attachments" enctype="multipart/form-data">
                  <%- csrfField() %>
                  <input type="hidden" name="category" value="contract">
                  <span class="attachment-upload-label"><%= t('uploadContract') %></span>
                  <input type="file" name="attachment" required>
                  <button type="submit"><%= t('upload') %></button>
                </form>
              <% } %>
              <% if (!contractApprovalWorkflowForm && contractSubmitUnavailableMessage) { %>
                <div class="form-panel requirement-input-panel commercial-quote-submit-panel">
                  <p class="empty"><%= contractSubmitUnavailableMessage %></p>
                  <button type="button" disabled><%= t('workflowButton.submit_contract_approval') %></button>
                </div>
              <% } %>
              <% if (contractTimeline.length > 0) { %>
                <div class="requirement-timeline">
                  <% for (const item of contractTimeline) { const linkedVersion = materialVersionById.get(Number(item.attachment.opportunityMaterialVersionId)); %>
                    <article class="requirement-row requirement-row-file">
                      <div class="requirement-row-time"><%= formatShortDate(item.at) %></div>
                      <div class="requirement-row-content"><%= item.text %><% if (linkedVersion?.versionNo) { %> <span class="file-version">V<%= linkedVersion.versionNo %></span><% } %></div>
                      <div class="inline-actions requirement-row-actions">
                        <a class="requirement-action-preview" href="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/preview"><%= t('preview') %></a>
                        <a class="requirement-action-download" href="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/download"><%= t('download') %></a>
                        <% if (canDeleteContractAttachments) { %>
                          <form method="post" action="/opportunities/<%= opportunity.id %>/attachments/<%= item.attachment.id %>/delete" onsubmit="return confirm('<%= t('deleteContractFileConfirm') %>')">
                            <%- csrfField() %>
                            <button class="danger-action requirement-action-delete" type="submit"><%= t('delete') %></button>
                          </form>
                        <% } %>
                      </div>
                    </article>
                  <% } %>
                </div>
              <% } else { %>
                <p class="empty"><%= t('noContractFiles') %></p>
              <% } %>
              <%- include('_workflow-actions', { forms: contractStageWorkflowForms }) %>
            </div>
          </section>
          <% } else { %>
            <section class="content-section business-section opportunity-workflow-section business-section-contract business-section-future">
              <h2><span><%= t('contract') %></span><span class="section-heading-meta"><%= t('notStarted') %></span></h2>
            </section>
          <% } %>

          <section class="content-section business-section-audit">
            <h2><%= t('timeline') %></h2>
            <div class="section-body">
              <% if (timelineEvents && timelineEvents.length > 0) { %>
                <ol class="inline-list">
                  <% for (const event of timelineEvents) { %>
                    <li>
                      <strong><%= workflowEventLabel(event.eventType) %></strong>
                      <span><%= statusLabel(event.fromStatus) %></span>
                      <span><%= statusLabel(event.toStatus) %></span>
                      <span><%= event.actorDisplayName %></span>
                      <% if (event.targetDisplayName) { %>
                        <span><%= event.targetDisplayName %></span>
                      <% } %>
                      <% if (event.comment) { %>
                        <p><%= event.comment %></p>
                      <% } %>
                      <span class="muted"><%= event.createdAt || '' %></span>
                    </li>
                  <% } %>
                </ol>
              <% } else { %>
                <p class="empty"><%= t('noTimelineEvents') %></p>
              <% } %>
            </div>
          </section>

        </div>
<script>
  document.querySelectorAll('[data-engineer-picker]').forEach((picker) => {
    const options = [...picker.querySelectorAll('[data-engineer-option]')];
    const summary = picker.querySelector('[data-engineer-summary]');
    const leadInput = picker.querySelector('[data-engineer-lead]');
    let selectionOrder = String(picker.dataset.selectedOrder || '')
      .split(',')
      .filter(Boolean);

    const refresh = () => {
      const selected = options.filter((option) => option.checked);
      const selectedIds = new Set(selected.map((option) => option.value));
      selectionOrder = selectionOrder.filter((id) => selectedIds.has(id));
      for (const option of selected) {
        if (!selectionOrder.includes(option.value)) {
          selectionOrder.push(option.value);
        }
      }
      leadInput.value = selectionOrder[0] || '';
      summary.textContent = selectionOrder
        .map((id) => options.find((option) => option.value === id)?.dataset.engineerName)
        .filter(Boolean)
        .join(', ') || <%- JSON.stringify(t('workflowField.quotationEngineerIds')) %>;
    };

    for (const option of options) {
      option.addEventListener('change', refresh);
    }
    picker.closest('form').addEventListener('submit', (event) => {
      refresh();
      if (!leadInput.value) {
        event.preventDefault();
        picker.open = true;
        options[0]?.focus();
      }
    });
    refresh();
  });
</script>
<%- include('../partials/app-end') %>
