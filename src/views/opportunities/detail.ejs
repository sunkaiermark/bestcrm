<%- include('../partials/app-start', { title: opportunity.title + ' - BESTCRM', activeNav: 'opportunities' }) %>
<%
  const orderedAttachments = [...(attachments || [])].sort((left, right) => {
    const leftAt = left.uploadedAt || '';
    const rightAt = right.uploadedAt || '';
    if (leftAt !== rightAt) {
      return leftAt.localeCompare(rightAt);
    }
    return Number(left.id || 0) - Number(right.id || 0);
  });
  const requirementAttachments = orderedAttachments.filter((attachment) => attachment.category === 'requirement' || attachment.category === 'other');
  const technicalSolutionAttachments = orderedAttachments.filter((attachment) => attachment.category === 'technical_solution');
  const commercialQuoteAttachments = orderedAttachments.filter((attachment) => attachment.category === 'commercial_quote');
  const contractAttachments = orderedAttachments.filter((attachment) => attachment.category === 'contract');
  const canDeleteRequirementMaterials = ['draft', 'initiation_rejected'].includes(opportunity.status);
  const supplementalRequirementUpdates = typeof requirementUpdates === 'undefined' ? [] : requirementUpdates;
  const technicalSolutionVersions = typeof technicalSolutions === 'undefined' ? [] : technicalSolutions;
  const commercialQuoteVersions = typeof commercialQuotes === 'undefined' ? [] : commercialQuotes;
  const opportunityTeamMembers = typeof teamMembers === 'undefined' ? [] : teamMembers;
  const opportunityOwnerTransfers = typeof ownerTransfers === 'undefined' ? [] : ownerTransfers;
  const opportunityCurrentResponsibles = typeof currentResponsibles === 'undefined' ? [] : currentResponsibles;
  const ownerName = opportunity.salespersonDisplayName || opportunity.salespersonUsername || opportunity.salespersonId || '';
  const canAddRequirementUpdate = typeof canCreateRequirementUpdate === 'undefined' ? false : canCreateRequirementUpdate;
%>
        <p class="breadcrumb"><a href="/opportunities">Opportunities</a></p>
        <header class="page-header">
          <div>
            <h1><%= opportunity.title %></h1>
            <div class="user-line"><%= opportunity.opportunityNo %> - <%= opportunity.customerName %></div>
          </div>
          <div class="page-actions">
            <a class="secondary-action" href="/opportunities">Back to list</a>
            <% if (typeof canEditOpportunity !== 'undefined' && canEditOpportunity) { %>
              <a class="quick-action" href="/opportunities/<%= opportunity.id %>/edit">Edit</a>
            <% } %>
            <% if (typeof canDeleteOpportunity !== 'undefined' && canDeleteOpportunity) { %>
              <form method="post" action="/opportunities/<%= opportunity.id %>/delete" onsubmit="return confirm('Delete this opportunity and all uploaded files?')">
                <button class="danger-action" type="submit">Delete</button>
              </form>
            <% } %>
          </div>
        </header>

        <div class="section-stack">
          <section class="content-section business-section business-section-basic">
            <h2>Basic Info</h2>
            <div class="section-body">
              <div class="basic-info-grid">
                <table class="detail-table">
                  <tbody>
                    <tr>
                      <th scope="row">No.</th>
                      <td><%= opportunity.opportunityNo %></td>
                    </tr>
                    <tr>
                      <th scope="row">Owner</th>
                      <td><%= ownerName %></td>
                    </tr>
                    <tr>
                      <th scope="row">Customer</th>
                      <td><a href="/customers/<%= opportunity.customerId %>"><%= opportunity.customerName %></a></td>
                    </tr>
                    <tr>
                      <th scope="row">Primary Contact</th>
                      <td>
                        <% if (opportunity.primaryContactId) { %>
                          <a href="/contacts/<%= opportunity.primaryContactId %>"><%= opportunity.primaryContactName %></a>
                        <% } %>
                      </td>
                    </tr>
                  </tbody>
                </table>
                <table class="detail-table">
                  <tbody>
                    <tr>
                      <th scope="row">Status</th>
                      <td><%= opportunity.status %></td>
                    </tr>
                    <tr>
                      <th scope="row">Estimated Amount</th>
                      <td><%= opportunity.estimatedAmount ?? '' %></td>
                    </tr>
                    <tr>
                      <th scope="row">Project Type</th>
                      <td><%= opportunity.projectType %></td>
                    </tr>
                    <tr>
                      <th scope="row">Delivery Cycle</th>
                      <td><%= opportunity.deliveryCycle %></td>
                    </tr>
                    <tr>
                      <th scope="row">Expected Bid Date</th>
                      <td><%= opportunity.expectedBidDate || '' %></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          <section class="content-section">
            <h2>Responsibility</h2>
            <div class="section-body">
              <div class="responsibility-grid">
                <div class="responsibility-column">
                  <div class="responsibility-block">
                    <h3>Current Responsible</h3>
                    <div class="responsibility-content">
                      <% if (opportunityCurrentResponsibles.length > 0) { %>
                        <table class="list-table content-fit-table">
                          <thead>
                            <tr>
                              <th>Task</th>
                              <th>Responsible</th>
                              <th>Status</th>
                              <th>Created At</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% for (const responsible of opportunityCurrentResponsibles) { %>
                              <tr>
                                <td><%= responsible.title %></td>
                                <td><%= responsible.assigneeDisplayName || responsible.assigneeUsername %></td>
                                <td><span class="status"><%= responsible.status %></span></td>
                                <td><%= responsible.createdAt || '' %></td>
                              </tr>
                            <% } %>
                          </tbody>
                        </table>
                      <% } else { %>
                        <p class="empty">No current responsible.</p>
                      <% } %>
                    </div>
                  </div>
                </div>

                <div class="responsibility-column">
                  <div class="responsibility-block">
                    <h3>Team Members</h3>
                    <div class="responsibility-content">
                      <% if (opportunityTeamMembers.length > 0) { %>
                        <table class="list-table content-fit-table">
                          <thead>
                            <tr>
                              <th>Member</th>
                              <th>Role</th>
                              <th>Permission</th>
                              <th>Added By</th>
                              <th>Added At</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% for (const member of opportunityTeamMembers) { %>
                              <tr>
                                <td><%= member.userDisplayName || member.username %></td>
                                <td><%= member.roleName || member.roleCode %></td>
                                <td><%= member.permissionLevel %></td>
                                <td><%= member.addedByDisplayName || '' %></td>
                                <td><%= member.addedAt || '' %></td>
                              </tr>
                            <% } %>
                          </tbody>
                        </table>
                      <% } else { %>
                        <p class="empty">No team members.</p>
                      <% } %>
                    </div>
                  </div>

                  <div class="responsibility-block">
                    <h3>Owner Transfer History</h3>
                    <div class="responsibility-content">
                      <% if (opportunityOwnerTransfers.length > 0) { %>
                        <table class="list-table content-fit-table">
                          <thead>
                            <tr>
                              <th>From Owner</th>
                              <th>To Owner</th>
                              <th>Changed By</th>
                              <th>Reason</th>
                              <th>Transferred At</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% for (const transfer of opportunityOwnerTransfers) { %>
                              <tr>
                                <td><%= transfer.fromOwnerDisplayName %></td>
                                <td><%= transfer.toOwnerDisplayName %></td>
                                <td><%= transfer.changedByDisplayName %></td>
                                <td><%= transfer.reason %></td>
                                <td><%= transfer.transferredAt || '' %></td>
                              </tr>
                            <% } %>
                          </tbody>
                        </table>
                      <% } else { %>
                        <p class="empty">No owner transfer history.</p>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="content-section business-section business-section-requirement">
            <h2>Requirement Materials</h2>
            <div class="section-body">
              <dl class="detail-list">
                <dt>Initial Requirement</dt>
                <dd><%= opportunity.requirement %></dd>
              </dl>
              <form class="form-panel attachment-upload-panel" method="post" action="/opportunities/<%= opportunity.id %>/attachments" enctype="multipart/form-data">
                <input type="hidden" name="category" value="requirement">
                <label>
                  File
                  <input type="file" name="attachment" required>
                </label>
                <button type="submit">Upload attachment</button>
              </form>
              <% if (requirementAttachments.length > 0) { %>
                <table class="list-table">
                  <thead>
                    <tr>
                      <th>File</th>
                      <th>Category</th>
                      <th>Uploaded By</th>
                      <th>Uploaded At</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (const attachment of requirementAttachments) { %>
                      <tr>
                        <td><%= attachment.originalName %></td>
                        <td><%= attachment.category %></td>
                        <td><%= attachment.uploaderDisplayName %></td>
                        <td><%= attachment.uploadedAt || '' %></td>
                        <td>
                          <div class="inline-actions">
                            <a href="/opportunities/<%= opportunity.id %>/attachments/<%= attachment.id %>/preview">Preview</a>
                            <a href="/opportunities/<%= opportunity.id %>/attachments/<%= attachment.id %>/download">Download</a>
                            <% if (canDeleteRequirementMaterials) { %>
                              <form method="post" action="/opportunities/<%= opportunity.id %>/attachments/<%= attachment.id %>/delete">
                                <button class="danger-action" type="submit">Delete</button>
                              </form>
                            <% } %>
                          </div>
                        </td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              <% } else { %>
                <p class="empty">No requirement materials.</p>
              <% } %>

              <h3>Supplemental Requirements</h3>
              <% if (canAddRequirementUpdate) { %>
                <form class="form-panel" method="post" action="/opportunities/<%= opportunity.id %>/requirement-updates">
                  <label>
                    Requirement Update
                    <textarea name="requirementText" required></textarea>
                  </label>
                  <label>
                    Reason
                    <textarea name="reason" required></textarea>
                  </label>
                  <button type="submit">Add requirement update</button>
                </form>
              <% } %>
              <% if (supplementalRequirementUpdates.length > 0) { %>
                <table class="list-table">
                  <thead>
                    <tr>
                      <th>Requirement</th>
                      <th>Reason</th>
                      <th>Created By</th>
                      <th>Created At</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (const update of supplementalRequirementUpdates) { %>
                      <tr>
                        <td><%= update.requirementText %></td>
                        <td><%= update.reason %></td>
                        <td><%= update.creatorDisplayName || '' %></td>
                        <td><%= update.createdAt || '' %></td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              <% } else { %>
                <p class="empty">No supplemental requirements.</p>
              <% } %>
            </div>
          </section>

          <section class="content-section business-section business-section-technical">
            <h2>Technical Solution</h2>
            <div class="section-body">
              <form class="form-panel attachment-upload-panel" method="post" action="/opportunities/<%= opportunity.id %>/attachments" enctype="multipart/form-data">
                <input type="hidden" name="category" value="technical_solution">
                <label>
                  File
                  <input type="file" name="attachment" required>
                </label>
                <button type="submit">Upload technical solution</button>
              </form>
              <% if (technicalSolutionAttachments.length > 0) { %>
                <table class="list-table">
                  <thead>
                    <tr>
                      <th>File</th>
                      <th>Category</th>
                      <th>Uploaded By</th>
                      <th>Uploaded At</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (const attachment of technicalSolutionAttachments) { %>
                      <tr>
                        <td><%= attachment.originalName %></td>
                        <td><%= attachment.category %></td>
                        <td><%= attachment.uploaderDisplayName %></td>
                        <td><%= attachment.uploadedAt || '' %></td>
                        <td>
                          <a href="/opportunities/<%= opportunity.id %>/attachments/<%= attachment.id %>/preview">Preview</a>
                          <a href="/opportunities/<%= opportunity.id %>/attachments/<%= attachment.id %>/download">Download</a>
                        </td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              <% } else { %>
                <p class="empty">No technical solution files.</p>
              <% } %>

              <h3>Version History</h3>
              <% if (technicalSolutionVersions.length > 0) { %>
                <table class="list-table">
                  <thead>
                    <tr>
                      <th>Version</th>
                      <th>Status</th>
                      <th>Summary</th>
                      <th>Parameters</th>
                      <th>Implementation Plan</th>
                      <th>Submitted By</th>
                      <th>Submitted At</th>
                      <th>Reviewed By</th>
                      <th>Reviewed At</th>
                      <th>Review Comment</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (const solution of technicalSolutionVersions) { %>
                      <tr>
                        <td>V<%= solution.versionNo %></td>
                        <td><%= solution.status %></td>
                        <td><%= solution.summary %></td>
                        <td><%= solution.parameters || '' %></td>
                        <td><%= solution.implementationPlan || '' %></td>
                        <td><%= solution.submitterDisplayName || '' %></td>
                        <td><%= solution.submittedAt || '' %></td>
                        <td><%= solution.reviewerDisplayName || '' %></td>
                        <td><%= solution.reviewedAt || '' %></td>
                        <td><%= solution.reviewComment || '' %></td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              <% } else { %>
                <p class="empty">No technical solution versions.</p>
              <% } %>
            </div>
          </section>

          <section class="content-section business-section business-section-quote">
            <h2>Commercial Quote</h2>
            <div class="section-body">
              <form class="form-panel attachment-upload-panel" method="post" action="/opportunities/<%= opportunity.id %>/attachments" enctype="multipart/form-data">
                <input type="hidden" name="category" value="commercial_quote">
                <label>
                  File
                  <input type="file" name="attachment" required>
                </label>
                <button type="submit">Upload commercial quote</button>
              </form>
              <% if (commercialQuoteAttachments.length > 0) { %>
                <table class="list-table">
                  <thead>
                    <tr>
                      <th>File</th>
                      <th>Category</th>
                      <th>Uploaded By</th>
                      <th>Uploaded At</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (const attachment of commercialQuoteAttachments) { %>
                      <tr>
                        <td><%= attachment.originalName %></td>
                        <td><%= attachment.category %></td>
                        <td><%= attachment.uploaderDisplayName %></td>
                        <td><%= attachment.uploadedAt || '' %></td>
                        <td>
                          <a href="/opportunities/<%= opportunity.id %>/attachments/<%= attachment.id %>/preview">Preview</a>
                          <a href="/opportunities/<%= opportunity.id %>/attachments/<%= attachment.id %>/download">Download</a>
                        </td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              <% } else { %>
                <p class="empty">No commercial quote files.</p>
              <% } %>

              <h3>Version History</h3>
              <% if (commercialQuoteVersions.length > 0) { %>
                <table class="list-table">
                  <thead>
                    <tr>
                      <th>Version</th>
                      <th>Status</th>
                      <th>Total Price</th>
                      <th>Payment Terms</th>
                      <th>Validity Date</th>
                      <th>Items</th>
                      <th>Submitted By</th>
                      <th>Submitted At</th>
                      <th>Reviewed By</th>
                      <th>Reviewed At</th>
                      <th>Review Comment</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (const quote of commercialQuoteVersions) { %>
                      <tr>
                        <td>V<%= quote.versionNo %></td>
                        <td><%= quote.status %></td>
                        <td><%= quote.totalPrice %></td>
                        <td><%= quote.paymentTerms || '' %></td>
                        <td><%= quote.validityDate || '' %></td>
                        <td>
                          <% for (const item of quote.items || []) { %>
                            <div>
                              <strong><%= item.itemName %></strong>
                              <span><%= item.specification || '' %></span>
                              <span><%= item.quantity %> x <%= item.unitPrice %> = <%= item.subtotal %></span>
                            </div>
                          <% } %>
                        </td>
                        <td><%= quote.submitterDisplayName || '' %></td>
                        <td><%= quote.submittedAt || '' %></td>
                        <td><%= quote.reviewerDisplayName || '' %></td>
                        <td><%= quote.reviewedAt || '' %></td>
                        <td><%= quote.reviewComment || '' %></td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              <% } else { %>
                <p class="empty">No commercial quote versions.</p>
              <% } %>
            </div>
          </section>

          <section class="content-section business-section business-section-contract">
            <h2>Commercial Contract</h2>
            <div class="section-body">
              <form class="form-panel attachment-upload-panel" method="post" action="/opportunities/<%= opportunity.id %>/attachments" enctype="multipart/form-data">
                <input type="hidden" name="category" value="contract">
                <label>
                  File
                  <input type="file" name="attachment" required>
                </label>
                <button type="submit">Upload contract</button>
              </form>
              <% if (contractAttachments.length > 0) { %>
                <table class="list-table">
                  <thead>
                    <tr>
                      <th>File</th>
                      <th>Category</th>
                      <th>Uploaded By</th>
                      <th>Uploaded At</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (const attachment of contractAttachments) { %>
                      <tr>
                        <td><%= attachment.originalName %></td>
                        <td><%= attachment.category %></td>
                        <td><%= attachment.uploaderDisplayName %></td>
                        <td><%= attachment.uploadedAt || '' %></td>
                        <td>
                          <a href="/opportunities/<%= opportunity.id %>/attachments/<%= attachment.id %>/preview">Preview</a>
                          <a href="/opportunities/<%= opportunity.id %>/attachments/<%= attachment.id %>/download">Download</a>
                        </td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              <% } else { %>
                <p class="empty">No contract files.</p>
              <% } %>

              <h3>Contract Approvals / Version History</h3>
              <% if (contractApprovals && contractApprovals.length > 0) { %>
                <table class="list-table">
                  <thead>
                    <tr>
                      <th>Version</th>
                      <th>Status</th>
                      <th>Reviewer</th>
                      <th>Action</th>
                      <th>Comment</th>
                      <th>Submitted At</th>
                      <th>Completed At</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (const approval of contractApprovals) { %>
                      <tr>
                        <td><%= approval.versionNo ? `V${approval.versionNo}` : '' %></td>
                        <td><%= approval.status %></td>
                        <td><%= approval.reviewerDisplayName %></td>
                        <td><%= approval.stepAction %></td>
                        <td><%= approval.stepComment || '' %></td>
                        <td><%= approval.submittedAt || '' %></td>
                        <td><%= approval.completedAt || '' %></td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              <% } else { %>
                <p class="empty">No contract approvals.</p>
              <% } %>
            </div>
          </section>

          <section class="content-section">
            <h2>Pending Todos</h2>
            <div class="section-body">
              <% if (todos && todos.length > 0) { %>
                <ul class="inline-list">
                  <% for (const todo of todos) { %>
                    <li>
                      <strong><%= todo.title %></strong>
                      <span class="status"><%= todo.status %></span>
                      <span><%= todo.assigneeDisplayName %></span>
                      <span class="muted"><%= todo.createdAt || '' %></span>
                    </li>
                  <% } %>
                </ul>
              <% } else { %>
                <p class="empty">No todos.</p>
              <% } %>
            </div>
          </section>

          <section class="content-section">
            <h2>Timeline</h2>
            <div class="section-body">
              <% if (timelineEvents && timelineEvents.length > 0) { %>
                <ol class="inline-list">
                  <% for (const event of timelineEvents) { %>
                    <li>
                      <strong><%= event.eventType %></strong>
                      <span><%= event.fromStatus || '' %></span>
                      <span><%= event.toStatus || '' %></span>
                      <span><%= event.actorDisplayName %></span>
                      <% if (event.targetDisplayName) { %>
                        <span><%= event.targetDisplayName %></span>
                      <% } %>
                      <% if (event.comment) { %>
                        <p><%= event.comment %></p>
                      <% } %>
                      <span class="muted"><%= event.createdAt || '' %></span>
                    </li>
                  <% } %>
                </ol>
              <% } else { %>
                <p class="empty">No timeline events.</p>
              <% } %>
            </div>
          </section>

          <% if (workflowForms && workflowForms.length > 0) { %>
            <section>
              <h2>Workflow Actions</h2>
              <div class="section-stack">
                <% for (const workflowForm of workflowForms) { %>
                  <section class="action-section">
                    <h3><%= workflowForm.title %></h3>
                    <div class="section-body">
                      <% if (workflowForm.missingRequirements && workflowForm.missingRequirements.length > 0) { %>
                        <ul class="inline-list">
                          <% for (const requirement of workflowForm.missingRequirements) { %>
                            <li><%= requirement %></li>
                          <% } %>
                        </ul>
                      <% } %>
                      <form class="form-panel" method="post" action="/opportunities/<%= opportunity.id %>/workflow">
                        <input type="hidden" name="action" value="<%= workflowForm.action %>">
                        <% for (const field of workflowForm.fields) { %>
                          <label>
                            <%= field.label %>
                            <% if (field.type === 'userSelect') { %>
                              <select name="<%= field.name %>" required>
                                <option value=""></option>
                                <% for (const user of field.users) { %>
                                  <option value="<%= user.id %>"><%= user.displayName %></option>
                                <% } %>
                              </select>
                            <% } else if (field.type === 'textarea') { %>
                              <textarea name="<%= field.name %>" <%= field.required ? 'required' : '' %>></textarea>
                            <% } else { %>
                              <input name="<%= field.name %>" type="<%= field.inputType %>" <%= field.required ? 'required' : '' %>>
                            <% } %>
                          </label>
                        <% } %>
                        <button type="submit" <%= workflowForm.blocked ? 'disabled' : '' %>><%= workflowForm.button %></button>
                      </form>
                    </div>
                  </section>
                <% } %>
              </div>
            </section>
          <% } %>
        </div>
<%- include('../partials/app-end') %>
