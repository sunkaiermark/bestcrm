<%- include('../partials/app-start', { title: 'Opportunity - BESTCRM', activeNav: 'opportunities' }) %>
        <p class="breadcrumb"><a href="/opportunities"><%= t('opportunities') %></a></p>
        <header class="page-header">
          <h1><%= typeof pageTitle === 'undefined' ? 'Opportunity Initiation' : pageTitle %></h1>
        </header>

        <form id="opportunity-form" method="post" action="<%= action %>"></form>
        <section class="form-panel">
          <label>
            <%= t('customer') %>
            <select name="customerId" form="opportunity-form" required>
              <% for (const customer of customers) { %>
                <option value="<%= customer.id %>" <%= String(opportunity.customerId || '') === String(customer.id) ? 'selected' : '' %>><%= customer.name %></option>
              <% } %>
            </select>
          </label>
          <% if (typeof allowInlineCreate === 'undefined' || allowInlineCreate) { %>
            <details class="inline-create-panel">
              <summary>Add new customer here</summary>
              <form method="post" action="/opportunities/customers">
                <label>
                  Customer Name
                  <input name="name" required>
                </label>
                <label>
                  Industry
                  <select name="industry">
                    <option value="">Select industry</option>
                    <% for (const industry of (typeof industryOptions !== 'undefined' ? industryOptions : [])) { %>
                      <option value="<%= industry %>"><%= industry %></option>
                    <% } %>
                  </select>
                </label>
                <label>
                  Country
                  <select name="country">
                    <option value="">Select country</option>
                    <% for (const country of (typeof countryOptions !== 'undefined' ? countryOptions : [])) { %>
                      <option value="<%= country %>"><%= country %></option>
                    <% } %>
                  </select>
                </label>
                <label>
                  Region
                  <select name="region">
                    <option value="">Select region</option>
                    <% for (const region of (typeof regionOptions !== 'undefined' ? regionOptions : [])) { %>
                      <option value="<%= region %>"><%= region %></option>
                    <% } %>
                  </select>
                </label>
                <label>
                  Address
                  <input name="address">
                </label>
                <label>
                  Notes
                  <textarea name="notes"></textarea>
                </label>
                <button type="submit"><%= t('createCustomer') %></button>
              </form>
            </details>
          <% } %>
          <label>
            <%= t('contacts') %>
            <select name="primaryContactId" form="opportunity-form">
              <option value=""></option>
              <% for (const contact of contacts) { %>
                <option value="<%= contact.id %>" data-customer-id="<%= contact.customerId %>" <%= String(opportunity.primaryContactId || '') === String(contact.id) ? 'selected' : '' %>><%= contact.name %> - <%= contact.customerName %></option>
              <% } %>
            </select>
          </label>
          <% if (typeof allowInlineCreate === 'undefined' || allowInlineCreate) { %>
            <% if (customers.length) { %>
              <p><a class="secondary-action" href="<%= typeof newContactUrl !== 'undefined' ? newContactUrl : '/contacts/new?returnTo=opportunity-initiation' %>">Add new contact here</a></p>
            <% } else { %>
              <p class="empty">Add a customer before creating a contact.</p>
            <% } %>
          <% } %>
          <label>
            <%= t('opportunityName') %>
            <input name="title" form="opportunity-form" value="<%= opportunity.title || '' %>" required>
          </label>
          <label>
            Requirement
            <textarea name="requirement" form="opportunity-form" required><%= opportunity.requirement || '' %></textarea>
          </label>
          <label>
            Estimated Amount
            <input name="estimatedAmount" form="opportunity-form" value="<%= opportunity.estimatedAmount || '' %>">
          </label>
          <label>
            Project Type
            <select name="projectType" form="opportunity-form">
              <option value="">Select project type</option>
              <% for (const projectType of ['新增', '扩建', '改造', '维修']) { %>
                <option value="<%= projectType %>" <%= opportunity.projectType === projectType ? 'selected' : '' %>><%= projectType %></option>
              <% } %>
            </select>
          </label>
          <label>
            Delivery Period
            <input name="deliveryCycle" form="opportunity-form" value="<%= opportunity.deliveryCycle || '' %>">
          </label>
          <label>
            Expected Bid Date
            <input name="expectedBidDate" form="opportunity-form" type="date" value="<%= opportunity.expectedBidDate || '' %>">
          </label>
          <button type="submit" form="opportunity-form"><%= typeof submitLabel === 'undefined' ? t('saveDraft') : submitLabel %></button>
        </section>
<%- include('../partials/app-end') %>
