<%- include('../partials/app-start', { title: `${t('opportunity')} - BESTCRM`, activeNav: 'opportunities' }) %>
        <p class="breadcrumb"><a href="/opportunities"><%= t('opportunities') %></a></p>
        <header class="page-header">
          <h1><%= typeof pageTitle === 'undefined' ? t('opportunityInitiation') : pageTitle %></h1>
        </header>

        <form id="opportunity-form" method="post" action="<%= action %>">
          <%- csrfField() %>
        </form>
        <section class="form-panel">
          <label>
            <%= t('customer') %>
            <select name="customerId" form="opportunity-form" required>
              <% for (const customer of customers) { %>
                <option value="<%= customer.id %>" <%= String(opportunity.customerId || '') === String(customer.id) ? 'selected' : '' %>><%= customer.name %></option>
              <% } %>
            </select>
          </label>
          <% if (typeof allowInlineCreate === 'undefined' || allowInlineCreate) { %>
            <details class="inline-create-panel" <%= (typeof inlineCustomerOpen !== 'undefined' && inlineCustomerOpen) ? 'open' : '' %>>
              <summary><%= t('addNewCustomerHere') %></summary>
              <form method="post" action="/opportunities/customers">
                <%- csrfField() %>
                <% const inlineCustomer = typeof newCustomer !== 'undefined' ? newCustomer : {}; %>
                <% if (typeof duplicateCustomers !== 'undefined' && duplicateCustomers.length) { %>
                  <section class="duplicate-warning" role="alert">
                    <strong><%= t('duplicateCustomerFound') %></strong>
                    <p><%= t('duplicateCustomerCoordinationHint') %></p>
                    <table class="duplicate-table">
                      <thead>
                        <tr>
                          <th><%= t('customerName') %></th>
                          <th><%= t('responsiblePerson') %></th>
                          <th><%= t('contacts') %></th>
                        </tr>
                      </thead>
                      <tbody>
                        <% for (const duplicate of duplicateCustomers) { %>
                          <tr>
                            <td><%= duplicate.name %></td>
                            <td><%= duplicate.ownerDisplayName || duplicate.ownerUsername || '-' %></td>
                            <td><%= duplicate.contactCount %></td>
                          </tr>
                        <% } %>
                      </tbody>
                    </table>
                  </section>
                <% } %>
                <label>
                  <%= t('customerName') %>
                  <input name="name" value="<%= inlineCustomer.name || '' %>" required>
                </label>
                <label>
                  <%= t('website') %>
                  <input name="website" type="text" inputmode="url" placeholder="https://www.example.com" value="<%= inlineCustomer.website || '' %>">
                </label>
                <label>
                  <%= t('industry') %>
                  <select name="industry">
                    <option value=""><%= t('selectIndustry') %></option>
                    <% for (const industry of (typeof industryOptions !== 'undefined' ? industryOptions : [])) { %>
                      <option value="<%= industry %>"<%= inlineCustomer.industry === industry ? ' selected' : '' %>><%= industry %></option>
                    <% } %>
                  </select>
                </label>
                <label>
                  <%= t('country') %>
                  <select name="country">
                    <% const inlineCountry = inlineCustomer.country || ''; %>
                    <% const inlineCountryOptions = typeof countryOptions !== 'undefined' ? countryOptions : []; %>
                    <option value=""><%= t('selectCountry') %></option>
                    <% if (inlineCountry && !inlineCountryOptions.includes(inlineCountry)) { %>
                      <option value="<%= inlineCountry %>" selected><%= inlineCountry %></option>
                    <% } %>
                    <% for (const country of inlineCountryOptions) { %>
                      <option value="<%= country %>"<%= inlineCountry === country ? ' selected' : '' %>><%= country %></option>
                    <% } %>
                  </select>
                </label>
                <label>
                  <%= t('region') %>
                  <select name="region">
                    <option value=""><%= t('selectRegion') %></option>
                    <% for (const region of (typeof regionOptions !== 'undefined' ? regionOptions : [])) { %>
                      <option value="<%= region %>"<%= inlineCustomer.region === region ? ' selected' : '' %>><%= region %></option>
                    <% } %>
                  </select>
                </label>
                <label>
                  <%= t('address') %>
                  <input name="address" value="<%= inlineCustomer.address || '' %>">
                </label>
                <label>
                  <%= t('customerOutline') %>
                  <textarea name="notes"><%= inlineCustomer.notes || '' %></textarea>
                </label>
                <button type="submit"><%= t('createCustomer') %></button>
              </form>
            </details>
          <% } %>
          <label>
            <%= t('contacts') %>
            <select name="primaryContactId" form="opportunity-form">
              <option value=""></option>
              <% for (const contact of contacts) { %>
                <option value="<%= contact.id %>" data-customer-id="<%= contact.customerId %>" <%= String(opportunity.primaryContactId || '') === String(contact.id) ? 'selected' : '' %>><%= contact.name %> - <%= contact.customerName %></option>
              <% } %>
            </select>
          </label>
          <% if (typeof allowInlineCreate === 'undefined' || allowInlineCreate) { %>
            <% if (customers.length) { %>
              <p><a class="secondary-action" href="<%= typeof newContactUrl !== 'undefined' ? newContactUrl : '/contacts/new?returnTo=opportunity-initiation' %>"><%= t('addNewContactHere') %></a></p>
            <% } else { %>
              <p class="empty"><%= t('addCustomerBeforeContact') %></p>
            <% } %>
          <% } %>
          <label>
            <%= t('opportunityName') %>
            <input name="title" form="opportunity-form" value="<%= opportunity.title || '' %>" required>
          </label>
          <label>
            <%= t('requirement') %>
            <textarea name="requirement" form="opportunity-form" required><%= opportunity.requirement || '' %></textarea>
          </label>
          <label>
            <%= t('estimatedAmount') %>
            <input name="estimatedAmount" form="opportunity-form" value="<%= opportunity.estimatedAmount || '' %>">
          </label>
          <label>
            <%= t('projectType') %>
            <select name="projectType" form="opportunity-form">
              <option value=""><%= t('selectProjectType') %></option>
              <% for (const projectType of ['新增', '扩建', '改造', '维修']) { %>
                <option value="<%= projectType %>" <%= opportunity.projectType === projectType ? 'selected' : '' %>><%= projectType %></option>
              <% } %>
            </select>
          </label>
          <label>
            <%= t('deliveryPeriod') %>
            <input name="deliveryCycle" form="opportunity-form" value="<%= opportunity.deliveryCycle || '' %>">
          </label>
          <label>
            <%= t('expectedBidDate') %>
            <input name="expectedBidDate" form="opportunity-form" type="date" value="<%= opportunity.expectedBidDate || '' %>">
          </label>
          <button type="submit" form="opportunity-form"><%= typeof submitLabel === 'undefined' ? t('saveDraft') : submitLabel %></button>
        </section>
<%- include('../partials/app-end') %>
