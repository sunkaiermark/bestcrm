<%- include('../partials/app-start', { title: `${t('opportunities')} - BESTCRM`, activeNav: 'opportunities' }) %>
        <header class="page-header">
          <h1><%= t('opportunities') %></h1>
          <a class="quick-action" href="/opportunities/new"><%= t('newOpportunity') %></a>
        </header>

        <section class="list-section">
          <form class="form-panel opportunity-filter-panel" method="get" action="/opportunities">
            <label>
              <%= t('opportunityScope') %>
              <select name="archiveScope">
                <option value="active"<%= archiveScope === 'active' ? ' selected' : '' %>><%= t('currentOpportunities') %></option>
                <option value="archived"<%= archiveScope === 'archived' ? ' selected' : '' %>><%= t('archivedOpportunities') %></option>
                <option value="all"<%= archiveScope === 'all' ? ' selected' : '' %>><%= t('allOpportunities') %></option>
              </select>
            </label>
            <label>
              <%= t('salesOwner') %>
              <select name="salespersonId">
                <option value=""><%= t('allSalesOwners') %></option>
                <% for (const salesperson of salespeople) { %>
                  <option value="<%= salesperson.id %>"<%= String(filters.salespersonId || '') === String(salesperson.id) ? ' selected' : '' %>><%= salesperson.displayName || salesperson.username %></option>
                <% } %>
              </select>
            </label>
            <label>
              <%= t('customer') %>
              <select name="customerId">
                <option value=""><%= t('allCustomers') %></option>
                <% for (const customer of customers) { %>
                  <option value="<%= customer.id %>"<%= String(filters.customerId || '') === String(customer.id) ? ' selected' : '' %>><%= customer.name %></option>
                <% } %>
              </select>
            </label>
            <label>
              <%= t('contact') %>
              <select name="contactId">
                <option value=""><%= t('allContacts') %></option>
                <% for (const contact of contacts) { %>
                  <option value="<%= contact.id %>"<%= String(filters.contactId || '') === String(contact.id) ? ' selected' : '' %>><%= contact.name %><%= contact.customerName ? ` (${contact.customerName})` : '' %></option>
                <% } %>
              </select>
            </label>
            <label class="opportunity-search-field">
              <%= t('keyword') %>
              <input name="query" type="search" value="<%= filters.query %>" placeholder="<%= t('opportunitySearchPlaceholder') %>">
            </label>
            <button type="submit"><%= t('search') %></button>
            <a class="secondary-action" href="/opportunities?archiveScope=<%= archiveScope %>"><%= t('clearFilters') %></a>
          </form>

          <div class="list-body">
            <table class="list-table opportunity-list-table">
              <thead>
                <tr>
                  <th><%= t('no') %></th>
                  <th><%= t('opportunityName') %></th>
                  <th><%= t('customer') %></th>
                  <th><%= t('owner') %></th>
                  <th><%= t('contacts') %></th>
                  <th><%= t('status') %></th>
                  <th><%= t('estimatedAmount') %></th>
                </tr>
              </thead>
              <tbody>
                <% for (const opportunity of opportunities) { %>
                  <tr>
                    <td class="clickable-cell"><a class="cell-link" href="/opportunities/<%= opportunity.id %>"><%= opportunity.opportunityNo %></a></td>
                    <td class="clickable-cell"><a class="cell-link" href="/opportunities/<%= opportunity.id %>"><%= opportunity.title %></a></td>
                    <td class="clickable-cell"><a class="cell-link" href="/opportunities/<%= opportunity.id %>"><%= opportunity.customerName %></a></td>
                    <td class="clickable-cell"><a class="cell-link" href="/opportunities/<%= opportunity.id %>"><%= opportunity.salespersonDisplayName || opportunity.salespersonUsername || '' %></a></td>
                    <td class="clickable-cell">
                      <a class="cell-link" href="/opportunities/<%= opportunity.id %>"><%= opportunity.primaryContactName || '' %></a>
                    </td>
                    <td class="clickable-cell"><a class="cell-link" href="/opportunities/<%= opportunity.id %>"><span class="status"><%= statusLabel(opportunity.status) %></span></a></td>
                    <td class="clickable-cell"><a class="cell-link" href="/opportunities/<%= opportunity.id %>"><%= opportunity.estimatedAmount ?? '' %></a></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
            <% if (!opportunities.length) { %>
              <p class="empty"><%= t('noVisibleOpportunities') %></p>
            <% } %>
          </div>
        </section>
<%- include('../partials/app-end') %>
