<%
const version=workPackage.latestVersion;
const modern=typeof revisionPresentation!=='undefined'&&revisionPresentation;
const isHistoricalView=Boolean(modern?.historical);
const colCount=modern?8:9;
const files=(version?.files||[]).filter(f=>!f.supersededByAttachmentId&&f.status!=='withdrawn');
const preparationStage=!isHistoricalView&&!opportunity.archivedAt && ['technical_solution_in_progress','technical_solution_rejected','technical_solution_pending','commercial_quote_in_progress','commercial_quote_rejected'].includes(opportunity.status);
const reviewStage=preparationStage || (!isHistoricalView&&!opportunity.archivedAt && opportunity.status==='commercial_quote_pending' && workPackage.planKind==='internal_quote');
const reviewer=reviewStage && currentUser.roles?.includes('technical_manager')&&Number(currentUser.id)===Number(opportunity.technicalManagerId);
const base='/opportunities/'+opportunity.id+'/collaboration-files/'+workPackage.id+'/';
const canRemoveEmptyPackage=canManageCollaborationWorkPackages && !opportunity.archivedAt
  && ['technical_solution_in_progress','technical_solution_rejected','commercial_quote_in_progress','commercial_quote_rejected'].includes(opportunity.status)
  && !version && !(workPackage.versionHistory||[]).length;
%>
<% if(!files.length){ %><tr><% if(modern){ %><td><%= workPackage.title %></td><td>—</td><td><%= modern.label %></td><td>—</td><td><%= workPackage.assigneeDisplayName %></td><td>未上传</td><td>未上传</td><% }else{ %><td><strong><%= workPackage.title %></strong></td><td><%= workPackage.assigneeDisplayName %></td><td><%= dateValue(workPackage.plannedStartDate)||'—' %></td><td><%= dateValue(workPackage.plannedSubmitDate)||'—' %></td><td>—</td><td>—</td><td>—</td><td><%= language==='zh'?'未上传':'No file' %></td><% } %><td><% if(canRemoveEmptyPackage){ %><form method="post" action="/opportunities/<%= opportunity.id %>/technical-work-packages/<%= workPackage.id %>/delete" onsubmit="return confirm('<%= language==='zh'?'确认移除此未上传文件的工作包？':'Remove this empty work package?' %>')"><%- csrfField() %><input type="hidden" name="emptyOnly" value="yes"><button type="submit"><%= language==='zh'?'移除':'Remove' %></button></form><% }else{ %>—<% } %></td></tr><% } %>
<% for(const file of files){const status=file.status||version.status;const url=base+file.id+'/';const canAct=canManageCollaborationWorkPackages||Number(file.addedByUserId||version.submittedByUserId)===Number(currentUser.id); %>
<tr>
<% if(modern){ %><td title="<%= workPackage.title %>"><%= workPackage.title %></td><td title="<%= file.originalName %>"><%= file.originalName %></td><td><%= workPackage.requirementRef?.label||modern.label %></td><td>V<%= version.versionNo %></td><td><%= workPackage.assigneeDisplayName %></td><td title="<%= file.requirementRef?.description||workPackage.requirementRef?.description||'' %>"><%= file.requirementRef?.description||workPackage.requirementRef?.description||'本轮修订' %></td><% }else{ %><td title="<%= workPackage.title %>"><strong><%= workPackage.title %></strong></td><td><%= workPackage.assigneeDisplayName %></td>
<td><%= dateValue(workPackage.plannedStartDate)||'—' %></td><td><%= dateValue(workPackage.plannedSubmitDate)||'—' %></td>
<td title="<%= file.originalName %>"><%= file.originalName %></td><td><%= file.submittedAt?formatShortDate(file.submittedAt):'—' %></td><td><%= version.approvedVersionNo?'V'+version.approvedVersionNo:'—' %></td>
<% } %><td><span class="status"><%= status==='uploaded'?(language==='zh'?'已上传 / 未提交':'Not submitted'):status==='returned'?(language==='zh'?'已驳回':'Returned'):status==='submitted'?(language==='zh'?(reviewer?'待审核':'已提交'):'Submitted'):packageStatusLabel(status) %></span></td>
<td><div class="collaboration-file-actions">
<a href="/opportunities/<%= opportunity.id %>/attachments/<%= file.id %>/preview"><%= t('preview') %></a>
<a href="/opportunities/<%= opportunity.id %>/attachments/<%= file.id %>/download"><%= t('download') %></a>
<% if(status==='uploaded'&&canAct&&!reviewer&&preparationStage){for(const action of ['withdraw','submit']){ %><form method="post" action="<%= url+action %>"><%- csrfField() %><% if(modern){ %><input type="hidden" name="expectedRevisionRoundId" value="<%= modern.current?.id||0 %>"><% } %><button type="submit"><%= action==='withdraw'?(language==='zh'?'撤回':'Withdraw'):(language==='zh'?'提交':'Submit') %></button></form><% }} %>
<% if(status==='submitted'&&reviewer){ %><form method="post" action="<%= url+'accepted' %>"><%- csrfField() %><% if(modern){ %><input type="hidden" name="expectedRevisionRoundId" value="<%= modern.current?.id||0 %>"><% } %><button type="submit"><%= language==='zh'?'同意':'Approve' %></button></form><button type="button" data-file-reject="reject-<%= file.id %>"><%= language==='zh'?'驳回':'Reject' %></button><% } %>
</div></td></tr>
<% if(status==='returned'){ %><tr class="collaboration-file-feedback"><td colspan="<%= colCount %>"><strong>驳回意见：</strong><%= file.reviewNote||version.reviewNote %> · <%= file.reviewedByDisplayName||'' %> · <%= file.reviewedAt?formatShortDate(file.reviewedAt):'' %></td></tr><% } %>
<% if(status==='submitted'&&reviewer){ %><tr id="reject-<%= file.id %>" class="collaboration-file-rejection" hidden><td colspan="<%= colCount %>"><form method="post" action="<%= url+'returned' %>" data-file-rejection-form><%- csrfField() %><% if(modern){ %><input type="hidden" name="expectedRevisionRoundId" value="<%= modern.current?.id||0 %>"><% } %><label>驳回意见 <textarea name="note" required maxlength="2000" rows="2"></textarea></label><input name="confirmRejection" type="hidden" value=""><button type="button" data-save-rejection>保存</button><button type="submit" disabled>确认</button><button type="button" data-cancel-rejection>取消</button></form></td></tr><% } %>
<% } %>
<% const historical=(workPackage.versionHistory||[]).flatMap(v=>(v.files||[]).filter(f=>v.id!==version?.id||f.supersededByAttachmentId||f.status==='withdrawn').map(f=>({v,f})));if(historical.length){ %><tr><td colspan="<%= colCount %>"><details><summary>历史文件</summary><% for(const {v,f} of historical){ %><p><%= f.originalName %> · <%= packageStatusLabel(f.status||v.status) %> <a href="/opportunities/<%= opportunity.id %>/attachments/<%= f.id %>/preview"><%= t('preview') %></a> <a href="/opportunities/<%= opportunity.id %>/attachments/<%= f.id %>/download"><%= t('download') %></a><% if(f.reviewNote){ %> · 驳回意见：<%= f.reviewNote %><% } %></p><% } %></details></td></tr><% } %>
