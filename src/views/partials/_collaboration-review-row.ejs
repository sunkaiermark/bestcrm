<% const reviewZh=language==='zh'; const canApprove=currentUser.roles?.includes('technical_manager')&&Number(currentUser.id)===Number(opportunity.technicalManagerId); const approvedHistory=workPackage.versionHistory.filter(v=>v.status==='accepted'&&v.id!==latest?.id); %>
<% if(latest?.status==='returned'){ %><tr class="collaboration-review-row"><td colspan="9"><strong><%= reviewZh?'修改意见：':'Revision required: ' %></strong><%= latest.reviewNote %> · <%= latest.reviewedByDisplayName %> · <%= formatShortDate(latest.reviewedAt) %></td></tr><% } %>
<% if(latest?.status==='submitted'&&canApprove){ %><tr class="collaboration-review-row"><td colspan="9"><div class="collaboration-review-controls">
  <form method="post" action="/opportunities/<%= opportunity.id %>/collaboration-work-packages/<%= workPackage.id %>/versions/<%= latest.id %>/review"><%- csrfField() %><input type="hidden" name="status" value="returned"><textarea name="note" rows="1" data-auto-grow required maxlength="2000" placeholder="<%= reviewZh?'填写修改意见':'Revision comments' %>" aria-label="<%= reviewZh?'修改意见':'Revision comments' %>"></textarea><button type="submit"><%= reviewZh?'退回修改':'Return' %></button></form>
</div></td></tr><% } %>
<% if(approvedHistory.length){ %><tr class="collaboration-review-row"><td colspan="9"><%= reviewZh?'已批准版本：':'Approved versions: ' %><% for(const previous of approvedHistory){const previousFile=previous.files?.[0];if(previousFile){ %><a href="/opportunities/<%= opportunity.id %>/attachments/<%= previousFile.id %>/preview">V<%= previous.approvedVersionNo %> · <%= previousFile.originalName %></a> <a href="/opportunities/<%= opportunity.id %>/attachments/<%= previousFile.id %>/download"><%= t('download') %></a>　<% }} %></td></tr><% } %>
