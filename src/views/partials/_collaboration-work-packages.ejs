<%
  const isTechnicalPlan = planKind === 'technical_solution';
  const displayTitle = isTechnicalPlan
    ? (language === 'zh' ? '技术方案' : 'Technical solution')
    : (language === 'zh' ? '内部报价方案' : 'Internal quotation plan');
  const category = isTechnicalPlan ? 'technical_solution' : 'internal_quote';
  const planPackages = (workPackages || []).filter((workPackage) => workPackage.planKind === planKind);
  const packageStatusLabel = (status) => ({
    not_started: language === 'zh' ? '未开始' : 'Not started',
    in_progress: language === 'zh' ? '进行中' : 'In progress',
    submitted: language === 'zh' ? '已提交' : 'Submitted',
    returned: language === 'zh' ? '已拆回' : 'Returned',
    accepted: language === 'zh' ? '已确认' : 'Accepted'
  }[status] || status);
  const assignedUsers = [
    { id: opportunity.quotationEngineerId, name: opportunity.quotationEngineerDisplayName || opportunity.quotationEngineerUsername },
    ...(teamMembers || []).filter((member) => member.roleCode === 'quotation_engineer' && member.isActive !== false)
      .map((member) => ({ id: member.userId, name: member.userDisplayName || member.username }))
  ].filter((user, index, list) => user.id && user.name && list.findIndex((item) => Number(item.id) === Number(user.id)) === index);
%>
<section class="content-section business-section opportunity-workflow-section business-section-<%= isTechnicalPlan ? 'technical' : 'quote' %> collaboration-plan-section">
  <h2><%= displayTitle %></h2>
  <div class="section-body">
    <div class="collaboration-work-package-scroll">
      <table class="collaboration-work-package-table">
        <colgroup><col class="collaboration-package-title"><col class="collaboration-package-owner"><col class="collaboration-package-date"><col class="collaboration-package-date"><col><col class="collaboration-package-version"><col class="collaboration-package-status"><col class="collaboration-package-actions"></colgroup>
        <thead><tr>
          <th><%= language === 'zh' ? '工作包' : 'Work package' %></th>
          <th><%= language === 'zh' ? '负责人' : 'Owner' %></th>
          <th><%= language === 'zh' ? '开始时间' : 'Start' %></th>
          <th><%= language === 'zh' ? '目标时间' : 'Target' %></th>
          <th><%= language === 'zh' ? '提交文件' : 'Submitted file' %></th>
          <th><%= language === 'zh' ? '时间 · 版本' : 'Time · version' %></th>
          <th><%= language === 'zh' ? '状态' : 'Status' %></th>
          <th><%= language === 'zh' ? '操作' : 'Actions' %></th>
        </tr></thead>
        <tbody>
          <% if (!planPackages.length) { %>
            <tr><td class="empty" colspan="8"><%= language === 'zh' ? '暂无工作包。由项目工程师或销售经理按已分配团队建立。' : 'No work packages yet.' %></td></tr>
          <% } %>
          <% for (const workPackage of planPackages) { const latest = workPackage.latestVersion; const latestFile = latest?.files?.[0]; %>
            <tr>
              <td><strong><%= workPackage.title %></strong><% if (workPackage.versionHistory.length > 1) { %><span class="muted"> · <%= language === 'zh' ? `${workPackage.versionHistory.length} 个版本` : `${workPackage.versionHistory.length} versions` %></span><% } %></td>
              <td><%= workPackage.assigneeDisplayName %></td>
              <td><%= workPackage.plannedStartDate || '—' %></td>
              <td><%= workPackage.plannedSubmitDate || '—' %></td>
              <td><%= latestFile ? latestFile.originalName : '—' %></td>
              <td><%= latest ? `${formatShortDate(latest.submittedAt)} · V${latest.versionNo}` : '—' %></td>
              <td><span class="status"><%= packageStatusLabel(workPackage.status) %></span><% if (latest?.reviewNote) { %><span class="muted"> · <%= latest.reviewNote %></span><% } %></td>
              <td><div class="collaboration-package-actions">
                <% if (latestFile) { %>
                  <a class="technical-file-action technical-file-preview-action" href="/opportunities/<%= opportunity.id %>/attachments/<%= latestFile.id %>/preview"><%= t('preview') %></a>
                  <a class="technical-file-action technical-file-download-action" href="/opportunities/<%= opportunity.id %>/attachments/<%= latestFile.id %>/download"><%= t('download') %></a>
                <% } else { %>
                  <span class="technical-file-action collaboration-action-disabled"><%= t('preview') %></span>
                  <span class="technical-file-action collaboration-action-disabled"><%= t('download') %></span>
                <% } %>
                <% if (latest?.status === 'submitted' && canManageCollaborationWorkPackages) { %>
                  <form method="post" action="/opportunities/<%= opportunity.id %>/collaboration-work-packages/<%= workPackage.id %>/versions/<%= latest.id %>/review"><%- csrfField() %><input type="hidden" name="status" value="returned"><input type="hidden" name="note" value="<%= language === 'zh' ? '需要修订' : 'Revision required' %>"><button class="technical-file-action technical-file-withdraw-action" type="submit"><%= language === 'zh' ? '拆回' : 'Return' %></button></form>
                  <form method="post" action="/opportunities/<%= opportunity.id %>/collaboration-work-packages/<%= workPackage.id %>/versions/<%= latest.id %>/review"><%- csrfField() %><input type="hidden" name="status" value="accepted"><button class="technical-file-action collaboration-action-accept" type="submit"><%= language === 'zh' ? '确认' : 'Accept' %></button></form>
                <% } %>
              </div></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (canManageCollaborationWorkPackages) { %>
      <form class="collaboration-work-package-form" method="post" action="/opportunities/<%= opportunity.id %>/collaboration-work-packages">
        <%- csrfField() %><input type="hidden" name="planKind" value="<%= planKind %>">
        <label><%= language === 'zh' ? '新增工作包' : 'New work package' %><input name="title" required maxlength="200"></label>
        <label><%= language === 'zh' ? '负责人' : 'Owner' %><select name="assigneeUserId" required><option value=""><%= language === 'zh' ? '选择负责人' : 'Select owner' %></option><% for (const engineer of assignedUsers) { %><option value="<%= engineer.id %>"><%= engineer.name %></option><% } %></select></label>
        <label><%= language === 'zh' ? '开始时间' : 'Start' %><input type="date" name="plannedStartDate"></label>
        <label><%= language === 'zh' ? '目标时间' : 'Target' %><input type="date" name="plannedSubmitDate"></label>
        <button type="submit"><%= language === 'zh' ? '添加工作包' : 'Add work package' %></button>
      </form>
    <% } %>

    <% if (canContributeCollaborationWorkPackages && uploadPermissions[category] && planPackages.length) { %>
      <form class="collaboration-work-package-form collaboration-upload-form" method="post" action="/opportunities/<%= opportunity.id %>/collaboration-work-packages/0/versions" enctype="multipart/form-data" data-work-package-upload-form>
        <%- csrfField() %>
        <label><%= language === 'zh' ? '上传方案' : 'Upload submission' %><select name="workPackageId" required data-work-package-selector><option value=""><%= language === 'zh' ? '选择工作包' : 'Select work package' %></option><% for (const workPackage of planPackages) { %><option value="<%= workPackage.id %>"><%= workPackage.title %></option><% } %></select></label>
        <%- include('_localized-file-picker', { pickerId: `collaboration-${planKind}-file-${opportunity.id}`, inputName: 'attachment', labelText: language === 'zh' ? '选择文件' : 'Select file' }) %>
        <span class="muted"><%= language === 'zh' ? '系统按工作包自动递增版本。' : 'Version increases automatically per work package.' %></span>
        <button type="submit"><%= language === 'zh' ? '提交文件' : 'Submit file' %></button>
      </form>
    <% } %>
  </div>
</section>
