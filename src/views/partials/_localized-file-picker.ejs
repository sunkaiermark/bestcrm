<% const allowsMultipleFiles = typeof multiple !== 'undefined' && multiple === true; %>
<div class="localized-file-picker" data-localized-file-picker data-empty-label="<%= t(allowsMultipleFiles ? 'noFilesSelected' : 'noFileSelected') %>">
  <input class="localized-file-input" id="<%= pickerId %>" type="file" name="<%= inputName %>" required<%= allowsMultipleFiles ? ' multiple' : '' %> aria-label="<%= labelText %>" aria-describedby="<%= pickerId %>-status">
  <span class="localized-file-button" aria-hidden="true"><%= t('chooseFile') %></span>
  <span class="localized-file-status" id="<%= pickerId %>-status" data-localized-file-status aria-hidden="true"><%= t(allowsMultipleFiles ? 'noFilesSelected' : 'noFileSelected') %></span>
</div>
