<%
const zh=language==='zh';
const canAssignTeam=typeof canAssignEngineeringTeam!=='undefined'?canAssignEngineeringTeam:canManageCollaborationWorkPackages;
const assignments=typeof technicalTeamAssignments!=='undefined'?technicalTeamAssignments:[];
const draft=typeof technicalTeamForm!=='undefined'?technicalTeamForm:null;
const teamEvents=typeof technicalTeamEvents!=='undefined'?technicalTeamEvents:[];
const teamTime=value=>new Intl.DateTimeFormat(zh?'zh-CN':'en-GB',{timeZone:'Asia/Shanghai',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'}).format(new Date(value));
const editorIds=draft?new Set(draft.assignments.map(a=>Number(a.userId))):null;
const editorAssignment=id=>draft?.assignments.find(a=>Number(a.userId)===Number(id));
const optionUsers=typeof technicalEngineerOptions!=='undefined'?technicalEngineerOptions:[];
const activeMembers=(teamMembers||[]).filter(m=>m.roleCode==='quotation_engineer'&&m.isActive!==false);
const selectedIds=new Set([Number(opportunity.quotationEngineerId),...activeMembers.map(m=>Number(m.userId))].filter(Boolean));
const users=[...optionUsers,{id:opportunity.quotationEngineerId,displayName:opportunity.quotationEngineerDisplayName||opportunity.quotationEngineerUsername},...activeMembers.map(m=>({id:m.userId,displayName:m.userDisplayName||m.username}))].filter((u,i,a)=>u.id&&u.displayName&&a.findIndex(x=>Number(x.id)===Number(u.id))===i);
const assignment=id=>assignments.find(a=>Number(a.user_id)===Number(id));
const position=id=>assignment(id)?.position||(Number(id)===Number(opportunity.quotationEngineerId)?'lead':'support');
const specialty=id=>assignment(id)?.specialty||activeMembers.find(m=>Number(m.userId)===Number(id))?.taskDescription||'';
%>
<% if(!canAssignTeam && selectedIds.size){ %>
<table class="collaboration-control-table technical-team-table"><colgroup><col style="width:20%"><col style="width:25%"><col style="width:55%"></colgroup><thead><tr><th><%= zh?'项目职位':'Project position' %></th><th><%= zh?'工程师':'Engineer' %></th><th><%= zh?'专业内容 / 分工':'Specialty / responsibility' %></th></tr></thead><tbody>
<% for(const user of users.filter(u=>selectedIds.has(Number(u.id)))){ %><tr><td><%= position(user.id)==='lead'?(zh?'主任工程师':'Lead engineer'):(zh?'工程师':'Engineer') %></td><td><%= user.displayName %></td><td><%= specialty(user.id)||(zh?'待填写':'Not specified') %></td></tr><% } %>
</tbody></table>
<% } %>
<% if(canAssignTeam){ %><div class="technical-team-editor"><form method="post" action="/opportunities/<%= opportunity.id %>/technical-team"><%- csrfField() %>
<% if(draft){ %><p role="alert" style="color:#a12622;white-space:normal"><%= draft.message %></p><% } %>
<% const workOptions=['容器设计','搅拌机','干燥机','工艺系统','电气','非标设备'];
const visibleUsers=users.filter(u=>(editorIds||selectedIds).has(Number(u.id)));
const renderRows=visibleUsers.length?visibleUsers:[{id:'',displayName:''}]; %>
<div class="technical-team-selection" data-team-selection><table class="collaboration-control-table"><colgroup><col style="width:20%"><col style="width:25%"><col style="width:45%"><col style="width:10%"></colgroup><thead><tr><th><%= zh?'项目职位':'Project position' %></th><th><%= zh?'工程师':'Engineer' %></th><th><%= zh?'工作内容':'Responsibilities' %></th><th></th></tr></thead><tbody data-team-rows>
<% for(const user of renderRows){ const currentPosition=editorAssignment(user.id)?.position||(user.id?position(user.id):'lead'); const currentWork=editorAssignment(user.id)?.specialty??specialty(user.id); %>
<tr data-team-row><td><select data-team-position name="position_<%= user.id %>" aria-label="<%= zh?'项目职位':'Project position' %>"><option value="lead" <%= currentPosition==='lead'?'selected':'' %>><%= zh?'主任工程师':'Lead engineer' %></option><option value="support" <%= currentPosition==='support'?'selected':'' %>><%= zh?'工程师':'Engineer' %></option></select></td><td><select name="engineerIds" data-team-person aria-label="<%= zh?'工程师':'Engineer' %>"><option value=""><%= zh?'选择工程师':'Select engineer' %></option><% for(const candidate of users){ %><option value="<%= candidate.id %>" <%= Number(candidate.id)===Number(user.id)?'selected':'' %>><%= candidate.displayName %></option><% } %></select></td><td><select data-team-work name="specialty_<%= user.id %>" aria-label="<%= zh?'工作内容':'Responsibilities' %>"><option value=""><%= zh?'选择工作内容':'Select responsibilities' %></option><% if(currentWork&&!workOptions.includes(currentWork)){ %><option data-team-legacy-work value="<%= currentWork %>" selected><%= currentWork %></option><% } %><% for(const work of workOptions){ %><option value="<%= work %>" <%= currentWork===work?'selected':'' %>><%= work %></option><% } %></select></td><td><button type="button" data-team-remove><%= zh?'移除':'Remove' %></button></td></tr>
<% } %></tbody></table><button type="button" data-team-add><%= zh?'添加工程师':'Add engineer' %></button></div><script src="/assets/technical-team-selection.js" defer></script>
<% if(selectedIds.size){ %><label class="technical-team-change-reason"><span><%= zh?'变更原因':'Reason for change' %></span><input name="reason" maxlength="1000" value="<%= draft?.reason||'' %>" placeholder="<%= zh?'中途调整人员、职位或分工时必填':'Required when changing people, positions or responsibilities' %>"></label><% } %><button type="submit"><%= zh?'保存工程师分工':'Save engineering assignments' %></button>
</form></div><% } %>

<% if(teamEvents.length){ %><details class="technical-team-history"><summary><%= zh?'人员变更记录':'Team change history' %>（<%= teamEvents.length %>）</summary>
<div class="technical-team-history-scroll"><table class="collaboration-control-table"><colgroup><col style="width:16%"><col style="width:12%"><col style="width:26%"><col style="width:26%"><col style="width:20%"></colgroup><thead><tr><% for(const label of (zh?['时间','操作人','变更前','变更后','原因']:['Time','Changed by','Before','After','Reason'])){ %><th><%= label %></th><% } %></tr></thead><tbody>
<% for(const event of teamEvents){ %><tr><td><%= teamTime(event.createdAt) %></td><td><%= event.actorDisplayName %></td><% for(const state of [event.before,event.after]){ %><td><% if(!state.length){ %>—<% } %><% for(const row of state){ %><div><strong><%= row.userDisplayName %></strong> · <%= row.position==='lead'?(zh?'主任工程师':'Lead engineer'):(zh?'工程师':'Engineer') %><% if(row.specialty){ %> · <%= row.specialty %><% } %></div><% } %></td><% } %><td><%= event.reason||(event.before.length?(zh?'未记录':'Not recorded'):(zh?'首次分配':'Initial assignment')) %></td></tr><% } %>
</tbody></table></div></details><% } %>
