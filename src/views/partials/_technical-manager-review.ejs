<section class="detail-section form-panel technical-manager-review">
  <h2><%= t('technicalManagerReview') %></h2>
  <% if (draft.sourceKind !== 'uploaded_file') { %><p class="muted"><%= t('technicalManagerReviewNotice') %></p><% } %>
  <% if (isTestSelfApproval) { %><p class="status"><%= t('technicalTestSelfApprovalNotice') %></p><% } %>
  <form method="post" action="/opportunities/<%= opportunity.id %>/technical-drafts/<%= draft.id %>/review"<% if (draft.sourceKind === 'uploaded_file') { %> enctype="multipart/form-data"<% } %>>
    <%- csrfField() %>
    <% if (returnTo === 'opportunity') { %><input type="hidden" name="returnTo" value="opportunity"><% } %>
    <% if (isTestSelfApproval) { %><label><input type="checkbox" name="testSelfApprovalConfirmed" value="on" required> <%= t('technicalTestSelfApprovalConfirm') %></label><% } %>
    <% if (draft.sourceKind === 'uploaded_file') { %>
      <% if (isTestSelfApproval) { %>
        <strong><%= t('technicalTestSelfApprovalReason') %></strong>
        <label for="technical-review-reason-<%= draft.id %>"><%= t('technicalReviewTextReason') %></label>
        <textarea id="technical-review-reason-<%= draft.id %>" name="comment" maxlength="2000" required></textarea>
      <% } else { %>
        <strong><%= t('technicalReviewRejectReason') %></strong>
        <div class="technical-review-input-grid">
          <label class="technical-review-input-cell" for="technical-review-reason-<%= draft.id %>">
            <span><%= t('technicalReviewTextReason') %></span>
            <textarea id="technical-review-reason-<%= draft.id %>" name="comment" maxlength="2000"></textarea>
          </label>
          <label class="technical-review-input-cell" for="technical-review-files-<%= draft.id %>">
            <span><%= t('technicalReviewUploadFiles') %></span>
            <div class="localized-file-picker technical-review-file-picker" data-localized-file-picker data-empty-label="<%= t('noFilesSelected') %>">
              <input class="localized-file-input" id="technical-review-files-<%= draft.id %>" type="file" name="reviewFiles" multiple aria-label="<%= t('technicalReviewUploadFiles') %>" aria-describedby="technical-review-files-<%= draft.id %>-status">
              <span class="localized-file-button" aria-hidden="true"><%= t('chooseFiles') %></span>
              <span class="localized-file-status" id="technical-review-files-<%= draft.id %>-status" data-localized-file-status aria-hidden="true"><%= t('noFilesSelected') %></span>
            </div>
          </label>
        </div>
      <% } %>
      <div class="inline-actions technical-review-actions">
        <% if (typeof canWithdraw !== 'undefined' && canWithdraw) { %><button class="secondary-action" type="submit" formaction="/opportunities/<%= opportunity.id %>/technical-drafts/<%= draft.id %>/withdraw" formmethod="post" formenctype="application/x-www-form-urlencoded" formnovalidate><%= t('withdrawTechnicalSubmission') %></button><% } %>
        <button type="submit" name="decision" value="approve"><%= t('technicalReviewApprove') %></button>
        <% if (!isTestSelfApproval) { %><button class="danger-action" type="submit" name="decision" value="reject"><%= t('technicalReviewReject') %></button><% } %>
      </div>
    <% } else { %>
      <label><%= isTestSelfApproval ? t('technicalTestSelfApprovalReason') : t('reviewComment') %><textarea name="comment" maxlength="2000" <%= isTestSelfApproval ? 'required' : '' %> placeholder="<%= isTestSelfApproval ? '' : t('returnReasonRequired') %>"></textarea></label>
      <div class="inline-actions technical-review-actions">
        <button type="submit" name="decision" value="approve"><%= t('approveTechnicalVersion') %></button>
        <% if (!isTestSelfApproval) { %><button class="danger-action" type="submit" name="decision" value="reject"><%= t('returnTechnicalVersion') %></button><% } %>
      </div>
    <% } %>
  </form>
</section>
