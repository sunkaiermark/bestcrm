<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f5f7f9;
        --panel: #ffffff;
        --line: #d9e1e7;
        --ink: #16202a;
        --muted: #62717f;
        --accent: #0f766e;
        --accent-soft: #edf7f6;
        --rail: #0B0F6E;
        --rail-ink: #ffffff;
        --rail-muted: #c7d2fe;
        --rail-active: #1e40af;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 14px/1.4 Arial, "Microsoft YaHei", Helvetica, sans-serif;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th,
      td {
        padding: 8px 10px;
        border-bottom: 1px solid var(--line);
        text-align: left;
        vertical-align: top;
      }

      th {
        color: var(--muted);
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
      }

      label {
        display: grid;
        gap: 5px;
        margin-bottom: 12px;
        color: var(--muted);
        font-weight: 600;
      }

      input,
      select,
      textarea {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: white;
        color: var(--ink);
        font: inherit;
        padding: 8px 9px;
      }

      textarea {
        min-height: 82px;
        resize: vertical;
      }

      button,
      .quick-action {
        border: 0;
        border-radius: 6px;
        background: var(--accent);
        color: white;
        cursor: pointer;
        display: inline-block;
        font: inherit;
        font-weight: 700;
        padding: 9px 12px;
      }

      .secondary-action,
      .danger-action {
        border-radius: 6px;
        display: inline-block;
        font-weight: 700;
        padding: 7px 9px;
      }

      .secondary-action {
        background: #e8eef3;
        color: var(--ink);
      }

      .danger-action {
        background: #fee2e2;
        color: #991b1b;
      }

      button:disabled {
        cursor: not-allowed;
        opacity: 0.55;
      }

      .app-shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 220px minmax(0, 1fr);
      }

      .left-nav {
        position: sticky;
        top: 0;
        height: 100vh;
        background: var(--rail);
        color: var(--rail-ink);
        padding: 18px 14px;
      }

      .brand {
        display: block;
        margin: 0;
      }

      .brand-logo {
        display: block;
        height: auto;
        max-width: 100%;
        width: 178px;
      }

      .nav-account {
        border-bottom: 1px solid rgba(255, 255, 255, 0.18);
        border-top: 1px solid rgba(255, 255, 255, 0.18);
        margin-top: 16px;
        padding: 10px 8px;
      }

      .nav-account-name {
        color: var(--rail-ink);
        font-size: 14px;
        font-weight: 700;
        overflow-wrap: anywhere;
      }

      .nav-account-roles {
        color: var(--rail-muted);
        font-size: 12px;
        margin-top: 3px;
        overflow-wrap: anywhere;
      }

      .nav-group {
        display: grid;
        gap: 4px;
        margin-top: 18px;
      }

      .nav-link {
        display: block;
        padding: 9px 10px;
        border-radius: 6px;
        color: var(--rail-muted);
        font-weight: 600;
      }

      .nav-parent {
        margin: 14px 0 2px;
        padding: 9px 10px;
        border-radius: 6px;
        color: var(--rail-ink);
        font-weight: 700;
      }

      .nav-subgroup {
        display: grid;
        gap: 2px;
        margin-left: 10px;
        padding-left: 10px;
        border-left: 1px solid rgba(255, 255, 255, 0.18);
      }

      .nav-subgroup .nav-link {
        padding: 7px 10px;
        font-size: 13px;
      }

      .nav-link:hover,
      .nav-link.active {
        background: var(--rail-active);
        color: var(--rail-ink);
      }

      .logout-form {
        margin-top: 18px;
      }

      .logout-button {
        width: 100%;
        border: 1px solid rgba(255, 255, 255, 0.18);
        background: transparent;
        color: var(--rail-muted);
        text-align: left;
      }

      .app-main {
        min-width: 0;
        padding: 18px 22px 28px;
      }

      .page-header,
      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 14px;
      }

      .page-actions {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .page-actions form {
        margin: 0;
      }

      h1 {
        margin: 0;
        font-size: 22px;
      }

      h2 {
        margin: 18px 0 10px;
        font-size: 16px;
      }

      h3 {
        margin: 0 0 10px;
        font-size: 14px;
      }

      .user-line,
      .state-label,
      .empty,
      .muted,
      .breadcrumb {
        color: var(--muted);
      }

      .breadcrumb {
        margin: 0 0 8px;
        font-weight: 600;
      }

      .state-strip {
        display: flex;
        gap: 10px;
        margin-bottom: 12px;
        overflow-x: auto;
        padding-bottom: 2px;
      }

      .state-item,
      .list-section,
      .content-section,
      .action-section {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 8px;
      }

      .state-item {
        flex: 0 0 190px;
        padding: 10px 12px;
      }

      .state-count {
        float: right;
        font-size: 20px;
        font-weight: 700;
      }

      .workbench-list,
      .section-stack {
        display: grid;
        gap: 10px;
      }

      .list-section h2,
      .content-section h2,
      .action-section h3 {
        margin: 0;
        padding: 9px 12px;
        border-bottom: 1px solid var(--line);
        font-size: 15px;
      }

      .todo-alert-heading {
        background: #fee2e2;
        border-bottom-color: #fecaca;
        color: #991b1b;
      }

      .business-section > h2 {
        color: #ffffff;
      }

      .business-section-basic {
        background: #f4f7fb;
        border-color: #bfdbfe;
      }

      .business-section-basic > h2 {
        background: #1e3a5f;
        border-bottom-color: #1e3a5f;
      }

      .business-section-requirement {
        background: #fffbeb;
        border-color: #fde68a;
      }

      .business-section-requirement > h2 {
        background: #92400e;
        border-bottom-color: #92400e;
      }

      .business-section-technical {
        background: #eff6ff;
        border-color: #bfdbfe;
      }

      .business-section-technical > h2 {
        background: #1d4ed8;
        border-bottom-color: #1d4ed8;
      }

      .business-section-quote {
        background: #ecfdf5;
        border-color: #a7f3d0;
      }

      .business-section-quote > h2 {
        background: #047857;
        border-bottom-color: #047857;
      }

      .business-section-contract {
        background: #f5f3ff;
        border-color: #ddd6fe;
      }

      .business-section-contract > h2 {
        background: #6d28d9;
        border-bottom-color: #6d28d9;
      }

      .list-body,
      .section-body {
        padding: 0 12px 10px;
      }

      .list-body {
        overflow-x: auto;
      }

      .list-table th,
      .list-table td {
        padding: 7px 8px;
      }

      .opportunity-list-table {
        min-width: 100%;
        table-layout: auto;
        width: auto;
      }

      .opportunity-list-table thead th {
        background: #1e3a5f;
        border-bottom-color: #1e3a5f;
        color: #ffffff;
      }

      .opportunity-list-table th,
      .opportunity-list-table td {
        white-space: nowrap;
        width: 1%;
      }

      .opportunity-list-table th:nth-child(3),
      .opportunity-list-table td:nth-child(3) {
        width: auto;
      }

      .content-fit-table {
        min-width: 100%;
        table-layout: auto;
        width: auto;
      }

      .content-fit-table thead th {
        background: #1e3a5f;
        border-bottom-color: #1e3a5f;
        color: #ffffff;
      }

      .content-fit-table th,
      .content-fit-table td {
        white-space: nowrap;
        width: 1%;
      }

      .role-list {
        display: grid;
        gap: 3px;
        white-space: normal;
      }

      .role-list-item {
        line-height: 1.35;
        white-space: nowrap;
      }

      .list-table td.clickable-cell {
        padding: 0;
      }

      .cell-link {
        display: block;
        min-height: 100%;
        padding: 7px 8px;
      }

      .cell-link:hover {
        background: #f8fbfc;
      }

      .basic-info-grid {
        display: grid;
        gap: 12px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .detail-table {
        background: rgba(255, 255, 255, 0.38);
        border: 1px solid var(--line);
        width: 100%;
      }

      .detail-table th,
      .detail-table td {
        border-bottom: 1px solid var(--line);
        padding: 8px 10px;
      }

      .detail-table tr:last-child th,
      .detail-table tr:last-child td {
        border-bottom: 0;
      }

      .detail-table th {
        background: rgba(255, 255, 255, 0.34);
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
        text-transform: none;
        width: 160px;
      }

      .detail-table-wide {
        grid-column: 1 / -1;
      }

      @media (max-width: 900px) {
        .basic-info-grid {
          grid-template-columns: 1fr;
        }
      }

      .responsibility-grid {
        align-items: start;
        display: grid;
        gap: 8px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .responsibility-column {
        display: grid;
        gap: 8px;
        min-width: 0;
      }

      .responsibility-block {
        background: rgba(255, 255, 255, 0.22);
        border: 1px solid var(--line);
      }

      .responsibility-block h3 {
        background: rgba(255, 255, 255, 0.24);
        border-bottom: 1px solid var(--line);
        color: var(--ink);
        font-size: 13px;
        margin: 0;
        padding: 6px 8px;
      }

      .responsibility-content {
        overflow-x: auto;
        padding: 6px 8px;
      }

      .responsibility-content .empty {
        margin: 0;
      }

      .responsibility-content .list-table th,
      .responsibility-content .list-table td {
        padding: 5px 6px;
      }

      .responsibility-disclosure {
        background: rgba(255, 255, 255, 0.28);
        border: 1px solid var(--line);
        margin-top: 6px;
      }

      .responsibility-disclosure summary {
        color: var(--ink);
        cursor: pointer;
        font-weight: 700;
        padding: 6px 8px;
      }

      .responsibility-disclosure[open] summary {
        border-bottom: 1px solid var(--line);
      }

      .responsibility-form {
        background: transparent;
        border: 0;
        border-radius: 0;
        margin-top: 0;
        max-width: none;
        padding: 8px;
      }

      .responsibility-form label {
        gap: 4px;
        margin-bottom: 8px;
      }

      .responsibility-form input,
      .responsibility-form select,
      .responsibility-form textarea {
        padding: 6px 8px;
      }

      .responsibility-form textarea {
        min-height: 58px;
      }

      .responsibility-form button {
        padding: 7px 10px;
      }

      .checkbox-label {
        align-items: center;
        display: flex;
        gap: 8px;
      }

      .checkbox-label input {
        width: auto;
      }

      @media (max-width: 900px) {
        .responsibility-grid {
          grid-template-columns: 1fr;
        }
      }

      .detail-list {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        gap: 8px 18px;
        margin: 0;
      }

      .detail-list dt {
        color: var(--muted);
        font-weight: 700;
      }

      .detail-list dd {
        margin: 0;
      }

      .inline-list {
        display: grid;
        gap: 8px;
        margin: 0;
        padding-left: 18px;
      }

      .inline-actions {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .inline-actions form {
        margin: 0;
      }

      .actions-cell {
        min-width: 140px;
      }

      .system-actions {
        flex-wrap: nowrap;
        justify-content: space-between;
        min-width: 126px;
      }

      .system-actions .secondary-action,
      .system-actions .danger-action {
        text-align: center;
        white-space: nowrap;
      }

      .checkbox-list {
        display: grid;
        gap: 7px;
        margin-bottom: 12px;
      }

      .checkbox-row {
        align-items: center;
        display: flex;
        gap: 8px;
        margin: 0;
      }

      .checkbox-row input {
        width: auto;
      }

      .status {
        display: inline-block;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent);
        font-size: 12px;
        font-weight: 700;
        padding: 2px 8px;
      }

      .form-panel {
        max-width: 760px;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 14px;
      }

      .attachment-upload-panel {
        align-items: center;
        display: flex;
        gap: 10px;
        max-width: none;
        width: 100%;
        background: rgba(255, 255, 255, 0.35);
      }

      .attachment-upload-panel input[type="file"] {
        flex: 1;
        min-width: 0;
      }

      .attachment-upload-panel button {
        width: 96px;
        text-align: center;
        white-space: nowrap;
        letter-spacing: 0px;
        background: #dbeafe;
        color: #0B0F6E;
      }

      .requirement-input-panel {
        background: rgba(255, 255, 255, 0.35);
        display: grid;
        gap: 10px;
        margin-bottom: 8px;
        max-width: none;
      }

      .requirement-input-panel label {
        margin-bottom: 0;
      }

      .requirement-input-panel textarea {
        min-height: 74px;
      }

      .requirement-input-actions {
        display: flex;
        justify-content: flex-start;
      }

      .requirement-input-actions button {
        min-width: 110px;
      }

      .commercial-quote-submit-panel {
        display: flex;
        justify-content: flex-end;
      }

      .commercial-quote-submit-panel button {
        flex: 0 0 auto;
        width: auto;
        min-width: 220px;
        padding-left: 18px;
        padding-right: 18px;
        white-space: nowrap;
      }

      .material-version-strip {
        display: grid;
        gap: 6px;
        margin: 8px 0 10px;
      }

      .material-version-card {
        align-items: center;
        background: rgba(255, 255, 255, 0.42);
        border: 1px solid rgba(217, 225, 231, 0.9);
        border-radius: 6px;
        color: var(--muted);
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 7px 9px;
      }

      .material-version-badge,
      .material-version-status {
        border-radius: 999px;
        display: inline-flex;
        font-size: 12px;
        font-weight: 800;
        line-height: 1;
        padding: 4px 7px;
      }

      .material-version-badge {
        background: #dbeafe;
        color: #1e40af;
      }

      .material-version-status {
        background: #e8eef3;
        color: #334155;
      }

      .material-version-status-approved {
        background: #dcfce7;
        color: #166534;
      }

      .material-version-status-pending {
        background: #fef3c7;
        color: #92400e;
      }

      .material-version-status-rejected {
        background: #fee2e2;
        color: #991b1b;
      }

      .material-version-comment {
        color: var(--ink);
        font-weight: 600;
      }

      .requirement-timeline {
        display: grid;
        gap: 0;
        margin-top: 10px;
      }

      .requirement-row {
        align-items: center;
        background: rgba(255, 255, 255, 0.32);
        border-bottom: 1px solid rgba(217, 225, 231, 0.85);
        display: grid;
        gap: 10px;
        grid-template-columns: 150px minmax(0, 1fr) auto;
        padding: 7px 8px;
      }

      .requirement-row:first-child {
        border-top: 1px solid rgba(217, 225, 231, 0.85);
      }

      .requirement-row-time {
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
      }

      .requirement-row-content {
        overflow-wrap: anywhere;
        white-space: pre-wrap;
      }

      .requirement-row-text {
        grid-template-columns: 150px minmax(0, 1fr);
      }

      .requirement-row-actions {
        justify-content: flex-end;
        white-space: nowrap;
      }

      .requirement-row-actions a,
      .requirement-row-actions button {
        font-weight: 700;
      }

      .requirement-action-preview {
        color: #1d4ed8;
      }

      .requirement-action-download {
        color: #047857;
      }

      .requirement-action-delete {
        color: #991b1b;
      }

      .requirement-initiation-actions {
        align-items: center;
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin: 8px 0 10px;
      }

      .requirement-initiation-actions form {
        margin: 0;
      }

      .requirement-initiation-actions button {
        background: #0f766e;
        color: #ffffff;
        white-space: nowrap;
      }

      @media (max-width: 900px) {
        .requirement-row,
        .requirement-row-text {
          align-items: start;
          grid-template-columns: 1fr;
        }

        .requirement-row-actions {
          justify-content: flex-start;
        }

        .requirement-initiation-actions {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      .inline-create-panel {
        background: #eef6ff;
        border: 1px solid #bfdbfe;
        border-radius: 6px;
        margin: -4px 0 12px;
        overflow: hidden;
        padding: 0;
      }

      .inline-create-panel summary {
        background: #dbeafe;
        color: var(--ink);
        cursor: pointer;
        font-weight: 700;
        padding: 9px 10px;
      }

      .inline-create-panel form {
        display: grid;
        gap: 2px;
        padding: 10px;
      }

      @media (max-width: 860px) {
        .app-shell {
          grid-template-columns: 1fr;
        }

        .left-nav {
          position: static;
          height: auto;
        }

        .page-header,
        .topbar {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <% const navClass = (nav) => `nav-link${activeNav === nav ? ' active' : ''}`; %>
    <% const canSeeSystemNav = Array.isArray(currentUser?.roles) && currentUser.roles.includes('administrator'); %>
    <div class="app-shell">
      <aside class="left-nav" aria-label="Primary navigation">
        <a class="brand" href="/workbench" aria-label="Sunkaier workbench">
          <img class="brand-logo" src="/assets/sunkaier-logo.png" alt="SUNKAIER">
        </a>
        <% if (currentUser) { %>
          <div class="nav-account" aria-label="Current login account">
            <div class="nav-account-name"><%= currentUser.displayName %></div>
            <div class="nav-account-roles"><%= currentUser.roles.join(', ') %></div>
          </div>
        <% } %>
        <nav class="nav-group">
          <a class="<%= navClass('workbench') %>" href="/workbench">Workbench</a>
          <a class="<%= navClass('opportunities') %>" href="/opportunities">Opportunities</a>
          <a class="<%= navClass('customers') %>" href="/customers">Customers</a>
          <a class="<%= navClass('contacts') %>" href="/contacts">Contacts</a>
          <% if (canSeeSystemNav) { %>
            <div class="nav-parent">System</div>
            <div class="nav-subgroup">
              <a class="<%= navClass('system-users') %>" href="/system/users">Users</a>
              <a class="<%= navClass('system-roles') %>" href="/system/roles">Roles</a>
              <a class="<%= navClass('system-approval-settings') %>" href="/system/approval-settings">Approval Settings</a>
            </div>
          <% } %>
        </nav>
        <form class="logout-form" method="post" action="/logout">
          <button class="logout-button" type="submit">Logout</button>
        </form>
      </aside>

      <main class="app-main">
