<!doctype html>
<html lang="<%= typeof language === 'undefined' ? 'en' : language %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta name="web-push-public-key" content="<%= typeof webPushPublicKey === 'undefined' ? '' : webPushPublicKey %>">
    <title><%= title %></title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f5f7f9;
        --panel: #ffffff;
        --line: #d9e1e7;
        --ink: #16202a;
        --muted: #62717f;
        --accent: #0f766e;
        --accent-soft: #edf7f6;
        --rail: #0B0F6E;
        --rail-ink: #ffffff;
        --rail-muted: #c7d2fe;
        --rail-active: #1e40af;
        --page-inline-gutter: clamp(16px, 2vw, 40px);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 20px/1.45 Arial, "Microsoft YaHei", Helvetica, sans-serif;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th,
      td {
        padding: 8px 10px;
        border-bottom: 1px solid var(--line);
        text-align: left;
        vertical-align: top;
      }

      th {
        color: var(--muted);
        font-size: 20px;
        font-weight: 600;
        text-transform: uppercase;
      }

      label {
        display: grid;
        gap: 5px;
        margin-bottom: 12px;
        color: var(--muted);
        font-weight: 600;
      }

      input,
      select,
      textarea {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: white;
        color: var(--ink);
        font: inherit;
        padding: 8px 9px;
      }

      textarea {
        min-height: 82px;
        resize: vertical;
      }

      button,
      .quick-action {
        border: 0;
        border-radius: 6px;
        background: var(--accent);
        color: white;
        cursor: pointer;
        display: inline-block;
        font: inherit;
        font-weight: 700;
        padding: 9px 12px;
      }

      .secondary-action,
      .danger-action {
        border-radius: 6px;
        display: inline-block;
        font-weight: 700;
        padding: 7px 9px;
      }

      .secondary-action {
        background: #e8eef3;
        color: var(--ink);
      }

      .danger-action {
        background: #fee2e2;
        color: #991b1b;
      }

      .account-security-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 18px;
      }

      .account-security-grid .form-panel { margin: 0; }
      .account-security-grid h2,
      .account-trusted-devices h2 { margin: 0 0 6px; }
      .account-trusted-devices .list-heading { padding: 18px; }
      .account-recovery-panel { max-width: 760px; }
      .account-recovery-code-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px 16px;
        list-style: none;
        margin: 18px 0;
        padding: 0;
      }
      .account-recovery-code {
        display: block;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: #f8fafc;
        font: 600 18px/1.4 Consolas, monospace;
        letter-spacing: 0.04em;
        padding: 10px;
        text-align: center;
      }
      .warning-text { color: #9a3412; }
      .error-text,
      .success-text {
        border-radius: 6px;
        margin: 0 0 18px;
        padding: 10px 12px;
      }
      .error-text { background: #fef2f2; color: #991b1b; }
      .success-text { background: #ecfdf5; color: #166534; }

      button:disabled {
        cursor: not-allowed;
        opacity: 0.55;
      }

      .app-shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 220px minmax(0, 1fr);
      }

      .left-nav {
        position: sticky;
        top: 0;
        height: 100vh;
        background: var(--rail);
        color: var(--rail-ink);
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        padding: 18px 14px;
      }

      .brand {
        display: block;
        margin: 0;
      }

      .brand-logo {
        display: block;
        height: auto;
        max-width: 100%;
        width: 178px;
      }

      .nav-account {
        border-bottom: 1px solid rgba(255, 255, 255, 0.18);
        border-top: 1px solid rgba(255, 255, 255, 0.18);
        margin-top: 16px;
        padding: 10px 8px;
      }

      .nav-account-name {
        color: var(--rail-ink);
        font-size: 20px;
        font-weight: 700;
        overflow-wrap: anywhere;
      }

      .nav-group {
        display: grid;
        gap: 4px;
        margin-top: 18px;
      }

      .nav-link {
        display: block;
        padding: 9px 10px;
        border-radius: 6px;
        color: var(--rail-muted);
        font-weight: 600;
      }

      .nav-parent {
        margin: 14px 0 2px;
        padding: 9px 10px;
        border-radius: 6px;
        color: var(--rail-ink);
        font-weight: 700;
      }

      .nav-subgroup {
        display: grid;
        gap: 2px;
        margin-left: 10px;
        padding-left: 10px;
        border-left: 1px solid rgba(255, 255, 255, 0.18);
      }

      .nav-subgroup .nav-link {
        padding: 7px 10px;
        font-size: 20px;
      }

      .nav-link:hover,
      .nav-link.active {
        background: var(--rail-active);
        color: var(--rail-ink);
      }

      .nav-link[aria-disabled="true"] {
        cursor: not-allowed;
        opacity: 0.52;
      }

      .bid-library-title,
      .bid-library-title h1,
      .bid-library-title h3,
      .bid-library-content {
        min-width: 0;
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .bid-library-content {
        white-space: pre-wrap;
      }

      .bid-package-grid {
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-bottom: 14px;
        max-width: 980px;
      }

      .bid-package-grid .form-panel {
        max-width: none;
      }

      .bid-workspace-section-title {
        margin: 0;
        padding: 14px 14px 4px;
      }

      .bid-output-scroll {
        max-width: 100%;
        overflow-x: auto;
      }

      .bid-editor-header {
        align-items: center;
        display: flex;
        gap: 16px;
        justify-content: space-between;
      }

      .bid-editor-layout {
        align-items: start;
        display: grid;
        gap: 14px;
        grid-template-columns: minmax(220px, 280px) minmax(420px, 1fr) minmax(300px, 380px);
      }

      .bid-editor-tree,
      .bid-editor-document,
      .bid-editor-reference {
        min-width: 0;
      }

      .bid-editor-tree,
      .bid-editor-document,
      .bid-reference-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 8px;
      }

      .bid-editor-tree,
      .bid-editor-reference {
        max-height: calc(100vh - 100px);
        overflow: auto;
        position: sticky;
        top: 18px;
      }

      .bid-editor-document {
        padding: 16px;
      }

      .bid-editor-reference {
        display: grid;
        gap: 12px;
      }

      .bid-reference-card {
        padding: 14px;
      }

      .bid-reference-card h2,
      .bid-editor-subsection h2 {
        font-size: 18px;
        margin: 0 0 10px;
      }

      .bid-reference-card h3 {
        font-size: 14px;
        margin: 12px 0 5px;
      }

      .bid-editor-pane-title {
        align-items: center;
        border-bottom: 1px solid var(--line);
        display: flex;
        gap: 10px;
        justify-content: space-between;
        padding: 12px 14px;
      }

      .bid-editor-pane-title code {
        display: block;
        font-size: 12px;
        margin-top: 3px;
      }

      .bid-section-nav {
        display: grid;
        gap: 3px;
        padding: 7px;
      }

      .bid-section-node {
        border: 1px solid transparent;
        border-radius: 6px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
      }

      .bid-section-node.active {
        background: #ecfdf5;
        border-color: #a7f3d0;
      }

      .bid-section-node.omitted {
        opacity: 0.68;
      }

      .bid-section-node > a {
        color: var(--ink);
        display: grid;
        gap: 4px;
        min-width: 0;
        padding: 9px;
        text-decoration: none;
      }

      .bid-section-name,
      .bid-section-node small {
        overflow-wrap: anywhere;
      }

      .bid-section-node small {
        color: var(--muted);
      }

      .bid-node-actions {
        align-items: center;
        display: flex;
        padding-right: 5px;
      }

      .bid-node-actions form {
        margin: 0;
      }

      .bid-node-actions .link-button {
        min-width: 28px;
        padding: 4px;
      }

      .bid-status-pill {
        border-radius: 999px;
        display: inline-flex;
        font-size: 12px;
        font-weight: 700;
        padding: 3px 8px;
        width: fit-content;
      }

      .status-standard { background: #e2e8f0; color: #334155; }
      .status-customized { background: #dbeafe; color: #1d4ed8; }
      .status-project_added { background: #dcfce7; color: #166534; }
      .status-omitted { background: #f1f5f9; color: #64748b; }
      .status-needs_review { background: #fef3c7; color: #92400e; }

      .bid-editor-details {
        border-top: 1px solid var(--line);
        padding: 12px;
      }

      .bid-editor-details summary {
        cursor: pointer;
        font-weight: 700;
      }

      .bid-section-form,
      .bid-editor-subsection {
        display: grid;
        gap: 12px;
        margin-top: 14px;
      }

      .bid-editor-subsection {
        border-top: 1px solid var(--line);
        padding-top: 16px;
      }

      .bid-editor-save-row {
        align-items: end;
        display: grid;
        gap: 10px;
        grid-template-columns: minmax(130px, 180px) minmax(220px, 1fr) auto;
      }

      .bid-reason-field {
        min-width: 0;
      }

      .bid-standard-copy {
        background: #f8fafc;
        border: 1px solid var(--line);
        border-left: 4px solid #cbd5e1;
        border-radius: 5px;
        font: inherit;
        margin: 0;
        max-height: 180px;
        overflow: auto;
        padding: 9px;
        white-space: pre-wrap;
      }

      .bid-standard-copy.changed {
        border-left-color: #f59e0b;
      }

      .bid-library-picker {
        display: grid;
        gap: 6px;
        max-height: 260px;
        overflow: auto;
      }

      .bid-library-picker > label {
        align-items: start;
        border: 1px solid var(--line);
        border-radius: 5px;
        display: grid;
        gap: 7px;
        grid-template-columns: auto minmax(0, 1fr);
        padding: 8px;
      }

      .bid-library-picker input {
        margin-top: 3px;
        width: auto;
      }

      .bid-library-picker span,
      .bid-library-picker small {
        display: block;
        overflow-wrap: anywhere;
      }

      .bid-project-image {
        background: #f8fafc;
        border: 1px solid var(--line);
        border-radius: 6px;
        display: block;
        margin-bottom: 8px;
        max-height: 280px;
        max-width: 100%;
        object-fit: contain;
      }

      .bid-source-list {
        display: grid;
        gap: 8px;
        margin: 0;
      }

      .bid-source-list > div {
        border-bottom: 1px solid var(--line);
        padding-bottom: 7px;
      }

      .bid-source-list dt {
        font-weight: 700;
      }

      .bid-source-list dd {
        color: var(--muted);
        margin: 2px 0 0;
        overflow-wrap: anywhere;
      }

      .bid-audit-list {
        display: grid;
        gap: 9px;
        margin: 0;
        padding-left: 20px;
      }

      .bid-audit-list span {
        color: var(--muted);
        display: block;
        font-size: 12px;
      }

      @media (max-width: 1280px) {
        .bid-editor-layout {
          grid-template-columns: minmax(210px, 260px) minmax(0, 1fr);
        }

        .bid-editor-reference {
          grid-column: 1 / -1;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          max-height: none;
          position: static;
        }
      }

      .inline-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 6px;
        color: #991b1b;
        margin: 8px 0;
        padding: 8px 10px;
      }

      @media (max-width: 760px) {
        .bid-package-grid {
          grid-template-columns: 1fr;
        }

        .bid-editor-header,
        .bid-editor-save-row {
          align-items: stretch;
          display: grid;
          grid-template-columns: 1fr;
        }

        .bid-editor-layout,
        .bid-editor-reference {
          display: grid;
          grid-template-columns: 1fr;
        }

        .bid-editor-tree {
          max-height: none;
          position: static;
        }
      }

      .nav-footer {
        display: grid;
        gap: 8px;
        margin-top: auto;
        padding-top: 18px;
      }

      .nav-footer .nav-link {
        border: 1px solid rgba(255, 255, 255, 0.18);
      }

      .logout-form {
        margin: 0;
      }

      .logout-button {
        width: 100%;
        border: 1px solid rgba(255, 255, 255, 0.18);
        background: transparent;
        color: var(--rail-muted);
        text-align: left;
      }

      .app-main {
        min-width: 0;
        padding: 18px var(--page-inline-gutter) 28px;
      }

      .app-main.opportunity-email-page {
        padding-left: 0;
        padding-right: 0;
      }

      .opportunity-email-heading {
        padding-left: var(--page-inline-gutter);
        padding-right: var(--page-inline-gutter);
      }

      .page-header,
      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 14px;
      }

      .page-actions {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .page-actions form {
        margin: 0;
      }

      h1 {
        margin: 0;
        font-size: 24px;
      }

      .notification-nav-link {
        align-items: center;
        display: flex;
        gap: 8px;
        justify-content: space-between;
      }

      .notification-badge {
        align-items: center;
        background: #dc2626;
        border-radius: 999px;
        color: #ffffff;
        display: inline-flex;
        font-size: 14px;
        font-weight: 700;
        height: 24px;
        justify-content: center;
        min-width: 24px;
        padding: 0 6px;
      }

      h2 {
        margin: 18px 0 10px;
        font-size: 20px;
      }

      h3 {
        margin: 0 0 10px;
        font-size: 20px;
      }

      .user-line,
      .state-label,
      .empty,
      .muted,
      .breadcrumb {
        color: var(--muted);
      }

      .breadcrumb {
        margin: 0 0 8px;
        font-weight: 600;
      }

      .duplicate-warning {
        background: #fff7ed;
        border: 1px solid #fdba74;
        border-radius: 8px;
        color: #7c2d12;
        display: grid;
        gap: 8px;
        padding: 12px;
      }

      .duplicate-warning p {
        margin: 0;
      }

      .duplicate-table {
        border-collapse: collapse;
        color: var(--ink);
        font-size: 14px;
        width: 100%;
      }

      .duplicate-table th,
      .duplicate-table td {
        border-top: 1px solid #fed7aa;
        padding: 6px 8px;
        text-align: left;
      }

      .duplicate-table th {
        color: #9a3412;
        font-size: 13px;
        text-transform: uppercase;
      }

      .state-strip {
        display: flex;
        gap: 10px;
        margin-bottom: 12px;
        overflow-x: auto;
        padding-bottom: 2px;
      }

      .state-item,
      .list-section,
      .content-section,
      .action-section {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 8px;
      }

      .state-item {
        flex: 0 0 190px;
        padding: 10px 12px;
      }

      .state-count {
        float: right;
        font-size: 24px;
        font-weight: 700;
      }

      .workbench-list,
      .section-stack {
        display: grid;
        gap: 10px;
      }

      .list-section h2,
      .content-section h2,
      .action-section h3 {
        margin: 0;
        padding: 9px 12px;
        border-bottom: 1px solid var(--line);
        font-size: 20px;
      }

      .todo-alert-heading {
        background: #fee2e2;
        border-bottom-color: #fecaca;
        color: #991b1b;
      }

      .business-section > h2 {
        color: #ffffff;
      }

      .business-section-basic {
        background: #f4f7fb;
        border-color: #bfdbfe;
      }

      .business-section-basic > h2 {
        background: #1e3a5f;
        border-bottom-color: #1e3a5f;
      }

      .business-section-requirement {
        background: #fffbeb;
        border-color: #fde68a;
      }

      .business-section-requirement > h2 {
        background: #92400e;
        border-bottom-color: #92400e;
      }

      .business-section-technical {
        background: #eff6ff;
        border-color: #bfdbfe;
      }

      .business-section-technical > h2 {
        background: #1d4ed8;
        border-bottom-color: #1d4ed8;
      }

      .business-section-quote {
        background: #ecfdf5;
        border-color: #a7f3d0;
      }

      .business-section-quote > h2 {
        background: #047857;
        border-bottom-color: #047857;
      }

      .business-section-contract {
        background: #f5f3ff;
        border-color: #ddd6fe;
      }

      .business-section-contract > h2 {
        background: #6d28d9;
        border-bottom-color: #6d28d9;
      }

      .list-body,
      .section-body {
        padding: 0 12px 10px;
      }

      .list-body {
        overflow-x: auto;
      }

      .opportunity-filter-panel {
        align-items: flex-end;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 12px;
        max-width: none;
      }

      .opportunity-filter-panel label {
        min-width: 220px;
      }

      .opportunity-filter-panel .opportunity-search-field {
        flex: 1 1 280px;
      }

      .opportunity-filter-panel .opportunity-search-field input {
        width: 100%;
      }

      .cad-preview-frame {
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 6px;
        min-height: 420px;
        overflow: auto;
        padding: 12px;
      }

      .cad-preview-frame svg {
        display: block;
        height: 68vh;
        min-height: 380px;
        width: 100%;
      }

      .document-preview {
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 6px;
        max-width: 920px;
        padding: 18px 22px;
      }

      .document-preview p {
        margin: 0 0 12px;
        white-space: pre-wrap;
      }

      .list-table th,
      .list-table td {
        padding: 7px 8px;
      }

      .opportunity-list-table {
        min-width: 100%;
        table-layout: fixed;
        width: 100%;
      }

      .opportunity-list-table thead th {
        background: #1e3a5f;
        border-bottom-color: #1e3a5f;
        color: #ffffff;
      }

      .opportunity-list-table th,
      .opportunity-list-table td {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .opportunity-list-table th:nth-child(1),
      .opportunity-list-table td:nth-child(1) {
        width: 9%;
      }

      .opportunity-list-table th:nth-child(2),
      .opportunity-list-table td:nth-child(2) {
        width: 28%;
      }

      .opportunity-list-table th:nth-child(3),
      .opportunity-list-table td:nth-child(3) {
        width: 20%;
      }

      .opportunity-list-table th:nth-child(4),
      .opportunity-list-table td:nth-child(4),
      .opportunity-list-table th:nth-child(5),
      .opportunity-list-table td:nth-child(5) {
        width: 11%;
      }

      .opportunity-list-table th:nth-child(6),
      .opportunity-list-table td:nth-child(6) {
        width: 9%;
      }

      .opportunity-list-table th:nth-child(7),
      .opportunity-list-table td:nth-child(7) {
        text-align: right;
        width: 12%;
      }

      .content-fit-table {
        min-width: 100%;
        table-layout: auto;
        width: auto;
      }

      .content-fit-table thead th {
        background: #1e3a5f;
        border-bottom-color: #1e3a5f;
        color: #ffffff;
      }

      .content-fit-table th,
      .content-fit-table td {
        white-space: nowrap;
        width: 1%;
      }

      .role-list {
        display: grid;
        gap: 3px;
        white-space: normal;
      }

      .role-list-item {
        line-height: 1.35;
        white-space: nowrap;
      }

      .list-table td.clickable-cell {
        padding: 0;
      }

      .cell-link {
        display: block;
        min-height: 100%;
        padding: 7px 8px;
      }

      .cell-link:hover {
        background: #f8fbfc;
      }

      .basic-info-grid {
        display: grid;
        gap: 12px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .detail-table {
        background: rgba(255, 255, 255, 0.38);
        border: 1px solid var(--line);
        table-layout: fixed;
        width: 100%;
      }

      .detail-table th,
      .detail-table td {
        border-bottom: 1px solid var(--line);
        padding: 8px 10px;
      }

      .detail-table tr:last-child th,
      .detail-table tr:last-child td {
        border-bottom: 0;
      }

      .detail-table td {
        min-width: 0;
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .detail-text-cell {
