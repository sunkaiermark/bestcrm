      }

      .email-inbox-attachment {
        justify-self: center;
        white-space: nowrap;
      }

      .email-inbox-attachment.is-empty {
        min-height: 1px;
      }

      .email-inbox-time {
        font-weight: 600;
        justify-self: end;
        white-space: nowrap;
      }

      .email-message-outbound {
        border-left-color: var(--accent);
      }

      .email-plain-body {
        background: #fff;
        border: 0;
        font: inherit;
        line-height: 1.65;
        margin: 0 0 16px;
        overflow-wrap: anywhere;
        padding: 0;
        white-space: pre-wrap;
      }

      .email-attachment-list {
        border-top: 1px solid var(--line);
        margin-top: 18px;
        padding-top: 14px;
      }

      .email-attachment-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
      }

      .email-attachment-chip {
        align-items: center;
        background: #f8fafc;
        border: 1px solid var(--line);
        border-radius: 8px;
        color: var(--ink);
        display: inline-flex;
        gap: 7px;
        max-width: 100%;
        padding: 9px 11px;
      }

      .email-attachment-chip span:nth-child(2) {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .email-attachment-chip small {
        color: var(--muted);
        white-space: nowrap;
      }

      .email-attachment-integrity {
        color: var(--muted);
        font-size: 11px;
        margin-top: 8px;
      }

      .email-attachment-list code {
        overflow-wrap: anywhere;
      }

      .opportunity-email-workspace {
        background: var(--panel);
        border-bottom: 1px solid var(--line);
        border-top: 1px solid var(--line);
        width: 100%;
      }

      .opportunity-email-conversation,
      .opportunity-email-compose {
        min-width: 0;
        padding: 16px;
      }

      .opportunity-email-conversation {
        border-bottom: 1px solid var(--line);
        max-height: 60vh;
        overflow-y: auto;
      }

      .opportunity-email-conversation.is-empty {
        max-height: none;
      }

      .opportunity-email-compose .form-panel {
        max-width: none;
      }

      .opportunity-email-compose > .form-panel + .form-panel {
        margin-top: 12px;
      }

      .customer-email-actions {
        gap: 14px;
      }

      .opportunity-email-thread-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 8px;
        margin-bottom: 16px;
      }

      .opportunity-email-thread {
        background: #f8fafc;
        border: 1px solid var(--line);
        border-radius: 7px;
        display: grid;
        gap: 3px;
        padding: 10px 12px;
      }

      .opportunity-email-thread[aria-current="true"] {
        background: var(--accent-soft);
        border-color: var(--accent);
      }

      .opportunity-email-thread-meta,
      .opportunity-email-message-meta {
        color: var(--muted);
        font-size: 16px;
      }

      .opportunity-email-empty-state {
        margin: 0;
        padding: 10px 12px;
        text-align: left;
      }

      .opportunity-email-timeline {
        display: grid;
        gap: 14px;
        padding: 6px 8px;
      }

      .opportunity-email-message {
        background: #f8fafc;
        border: 1px solid var(--line);
        border-left: 5px solid #2563eb;
        border-radius: 8px;
        justify-self: stretch;
        padding: 12px 14px;
        position: relative;
        width: 100%;
      }

      .opportunity-email-message-outbound {
        background: #ecfdf5;
        border-color: #99d5ca;
        border-left-color: var(--accent);
      }

      .opportunity-email-message-header {
        align-items: flex-start;
        display: flex;
        flex-wrap: wrap;
        gap: 6px 12px;
        justify-content: space-between;
      }

      .opportunity-email-message h3 {
        margin-bottom: 8px;
        margin-top: 8px;
      }

      .opportunity-email-message .email-plain-body {
        margin-bottom: 0;
        max-height: 320px;
        overflow: auto;
      }

      .customer-email-header-fields {
        display: grid;
        gap: 10px;
        margin-bottom: 10px;
      }

      .customer-email-header-field {
        align-items: center;
        display: grid;
        gap: 12px;
        grid-template-columns: clamp(220px, 18vw, 260px) minmax(0, 1fr);
        margin-bottom: 0;
      }

      .customer-email-field-label {
        font-weight: 700;
      }

      .customer-email-header-field input {
        min-width: 0;
      }

      .customer-email-signature-field {
        align-items: start;
        display: grid;
        gap: 12px;
        grid-template-columns: clamp(220px, 18vw, 260px) minmax(0, 1fr);
        margin-bottom: 12px;
      }

      .customer-email-signature-preview {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 6px;
        color: var(--text);
        font: inherit;
        line-height: 1.5;
        margin: 0;
        min-height: 184px;
        overflow-wrap: anywhere;
        padding: 18px 20px;
      }

      .customer-email-signature-preview.is-empty {
        color: var(--muted);
        font-style: italic;
        min-height: auto;
        white-space: normal;
      }

      .customer-email-attachment-field {
        align-items: center;
        display: grid;
        gap: 12px;
        grid-template-columns: clamp(220px, 18vw, 260px) minmax(0, 1fr);
        margin-bottom: 12px;
      }

      .customer-email-file-picker {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 8px 12px;
        min-width: 0;
      }

      .customer-email-file-input {
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        height: 1px;
        overflow: hidden;
        position: absolute;
        white-space: nowrap;
        width: 1px;
      }

      .customer-email-file-button {
        cursor: pointer;
        display: inline-block;
        margin: 0;
        white-space: nowrap;
      }

      .customer-email-file-status {
        flex: 1 1 220px;
        min-width: 0;
        overflow-wrap: anywhere;
      }

      .customer-email-file-limit {
        white-space: nowrap;
      }

      @media (max-width: 1280px) {
        .email-inbox-row {
          gap: 5px 12px;
          grid-template-columns: minmax(0, 1fr) auto;
          padding: 10px 12px;
        }

        .email-inbox-sender {
          grid-column: 1;
          grid-row: 1;
        }

        .email-inbox-time {
          grid-column: 2;
          grid-row: 1;
        }

        .email-inbox-main {
          grid-column: 1;
          grid-row: 2;
        }

        .email-inbox-attachment {
          grid-column: 2;
          grid-row: 2;
        }

        .email-inbox-subject {
          max-width: 52%;
        }
      }

      @media (max-width: 860px) {
        .app-shell {
          grid-template-columns: 1fr;
        }

        .left-nav {
          align-items: center;
          display: grid;
          gap: 10px;
          grid-template-columns: auto minmax(0, 1fr) auto;
          position: static;
          height: auto;
          padding: 12px 14px;
        }

        .brand-logo {
          width: 120px;
        }

        .nav-account {
          border: 0;
          margin: 0;
          min-width: 0;
          padding: 4px 8px;
        }

        .nav-account-name {
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .nav-group {
          display: flex;
          gap: 4px;
          grid-column: 1 / -1;
          margin-top: 0;
          overflow-x: auto;
          padding-bottom: 4px;
        }

        .nav-link,
        .nav-subgroup .nav-link {
          flex: 0 0 auto;
          padding: 7px 9px;
        }

        .nav-parent {
          display: none;
        }

        .nav-subgroup {
          display: contents;
        }

        .nav-footer {
          align-items: center;
          display: flex;
          gap: 6px;
          grid-column: 1 / -1;
          justify-content: flex-end;
          margin: 0;
          padding: 0;
        }

        .logout-form {
          grid-column: auto;
          grid-row: auto;
          margin: 0;
        }

        .logout-button {
          padding: 7px 9px;
          white-space: nowrap;
        }

        .app-main {
          padding: 16px;
        }

        .email-conversation-summary {
          gap: 8px 10px;
          grid-template-columns: 38px minmax(0, 1fr);
          padding: 10px 12px;
        }

        .email-conversation-heading {
          display: block;
        }

        .email-conversation-heading strong,
        .email-conversation-preview {
          display: block;
        }

        .email-conversation-item[open] .email-conversation-preview {
          display: none;
        }

        .email-conversation-meta {
          align-items: center;
          display: flex;
          grid-column: 2;
          justify-content: space-between;
        }

        .email-conversation-body {
          padding: 14px 14px 18px 60px;
        }

        .email-opportunity-link {
          grid-template-columns: 1fr;
        }

        .email-mailbox-picker {
          align-items: stretch;
          display: grid;
        }

        .email-mailbox-picker select {
          min-width: 0;
          width: 100%;
        }

        .email-triage-grid-row,
        .email-triage-final-actions,
        .email-triage-archive-form {
          grid-template-columns: 1fr;
        }

        .email-triage-spam-action {
          grid-column: 1;
        }

        .app-main.opportunity-email-page {
          padding: 16px;
        }

        .email-folder-tabs {
          align-items: stretch;
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .email-folder-tab {
          min-width: 0;
          white-space: normal;
          width: 100%;
        }

        .opportunity-email-heading {
          padding-left: 0;
          padding-right: 0;
        }

        .opportunity-email-workspace {
          border: 1px solid var(--line);
          border-radius: 8px;
          min-height: auto;
        }

        .opportunity-email-conversation {
          max-height: 520px;
        }

        .customer-email-header-field,
        .customer-email-signature-field,
        .customer-email-attachment-field {
          align-items: stretch;
          gap: 5px;
          grid-template-columns: 1fr;
        }

        .page-header,
        .topbar {
          align-items: flex-start;
          flex-direction: column;
        }

        .page-header .quick-action {
          justify-content: center;
          width: 100%;
        }

        .form-panel.inquiry-filter-panel {
          display: grid;
          gap: 10px;
          grid-template-columns: minmax(0, 1fr);
          margin: 12px 0;
        }

        .opportunity-filter-panel {
          align-items: stretch;
          display: grid;
          grid-template-columns: minmax(0, 1fr);
          margin: 12px 0;
        }

        .opportunity-filter-panel label,
        .opportunity-filter-panel .opportunity-search-field {
          min-width: 0;
          width: 100%;
        }

        .opportunity-filter-panel button,
        .opportunity-filter-panel .secondary-action {
          justify-content: center;
          width: 100%;
        }

        .record-list-body {
          max-height: none;
          overflow: visible;
          padding-left: 0;
          padding-right: 0;
          scrollbar-gutter: auto;
        }

        .record-list-table {
          display: block;
          min-width: 0;
          width: 100%;
        }

        .record-list-table thead {
          clip: rect(0 0 0 0);
          clip-path: inset(50%);
          height: 1px;
          overflow: hidden;
          position: absolute;
          white-space: nowrap;
          width: 1px;
        }

        .record-list-table tbody {
          display: grid;
          gap: 12px;
        }

        .record-list-table tbody tr {
          background: #ffffff;
          border: 1px solid var(--line);
          border-radius: 8px;
          display: grid;
          overflow: hidden;
        }

        .record-list-table tbody td {
          align-items: start;
          border-bottom: 1px solid var(--line);
          border-right: 0;
          display: grid;
          gap: 10px;
          grid-template-columns: minmax(110px, 34%) minmax(0, 1fr);
          min-width: 0;
          padding: 9px 10px;
          text-align: left;
          white-space: normal;
          width: auto;
        }

        .record-list-table tbody td::before {
          color: var(--muted);
          content: attr(data-label);
          font-size: 13px;
          font-weight: 500;
          line-height: 1.35;
        }

        .record-list-table tbody td:last-child {
          border-bottom: 0;
        }

        .record-list-table tbody td.clickable-cell {
          padding: 9px 10px;
        }

        .record-list-table tbody td.clickable-cell .cell-link {
          display: block;
          min-width: 0;
          padding: 0;
          text-align: left;
          white-space: normal;
        }

        .record-list-table tbody td > a:not(.cell-link) {
          min-width: 0;
          overflow-wrap: anywhere;
          white-space: normal;
        }

        .inquiry-filter-panel label,
        .inquiry-filter-panel .inquiry-search-field {
          min-width: 0;
          width: 100%;
        }

        .inquiry-filter-actions {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          width: 100%;
        }

        .inquiry-filter-actions button,
        .inquiry-filter-actions .secondary-action {
          justify-content: center;
          width: 100%;
        }

        .inquiry-list-body {
          max-height: none;
          overflow: visible;
          padding-left: 0;
          padding-right: 0;
          scrollbar-gutter: auto;
        }

        .inquiry-list-table {
          display: block;
          min-width: 0;
          width: 100%;
        }

        .inquiry-list-table thead {
          clip: rect(0 0 0 0);
          clip-path: inset(50%);
          height: 1px;
          overflow: hidden;
          position: absolute;
          white-space: nowrap;
          width: 1px;
        }

        .inquiry-list-table tbody {
          display: grid;
          gap: 12px;
        }

        .inquiry-list-table tbody tr {
          background: #ffffff;
          border: 1px solid var(--line);
          border-radius: 8px;
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          overflow: hidden;
        }

        .content-fit-table.inquiry-list-table tbody td {
          border-bottom: 1px solid var(--line);
          border-right: 0;
          display: block;
          min-width: 0;
          padding: 9px 10px;
          text-align: left;
          width: auto;
        }

        .content-fit-table.inquiry-list-table tbody td:nth-child(odd) {
          border-right: 1px solid var(--line);
        }

        .content-fit-table.inquiry-list-table tbody td::before {
          color: var(--muted);
          content: attr(data-label);
          display: block;
          font-size: 12px;
          font-weight: 500;
          line-height: 1.25;
          margin-bottom: 4px;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .content-fit-table.inquiry-list-table tbody td:nth-child(5),
        .content-fit-table.inquiry-list-table tbody td:nth-child(6),
        .content-fit-table.inquiry-list-table tbody td:nth-child(7),
        .content-fit-table.inquiry-list-table tbody td:nth-child(8),
        .content-fit-table.inquiry-list-table tbody td:nth-child(11) {
          border-right: 0;
          grid-column: 1 / -1;
        }

        .content-fit-table.inquiry-list-table tbody td:nth-child(5),
        .content-fit-table.inquiry-list-table tbody td:nth-child(6),
        .content-fit-table.inquiry-list-table tbody td:nth-child(8),
        .content-fit-table.inquiry-list-table tbody td:nth-child(5) .cell-link {
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .content-fit-table.inquiry-list-table tbody td.clickable-cell {
          padding: 9px 10px;
        }

        .content-fit-table.inquiry-list-table tbody td.clickable-cell .cell-link {
          padding: 0;
        }

        .content-fit-table.inquiry-list-table tbody td:nth-child(11) {
          border-bottom: 0;
        }

        .content-fit-table.inquiry-list-table tbody td:nth-child(11) .secondary-action {
          justify-content: center;
          width: 100%;
        }

        .inquiry-pagination {
          align-items: stretch;
          display: grid;
          grid-template-columns: minmax(0, 1fr);
          justify-content: stretch;
          padding: 10px 0;
        }

        .inquiry-pagination > span,
        .inquiry-pagination > span:first-child {
          margin-right: 0;
          text-align: center;
        }

        .inquiry-view-mode-form select {
          width: 100%;
        }

        .inquiry-pagination-actions {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .inquiry-pagination-actions .secondary-action {
          justify-content: center;
          width: 100%;
        }

        .notification-row,
        .section-heading-row {
          align-items: flex-start;
          flex-direction: column;
        }

        .inquiry-form-grid,
        .inquiry-summary-grid,
        .approval-decision-grid,
        .customer-match-card,
        .inquiry-attachment-row {
          grid-template-columns: 1fr;
        }

        .account-security-grid,
        .account-recovery-code-list {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <% const navClass = (nav) => `nav-link${activeNav === nav ? ' active' : ''}`; %>
    <% const canSeeSystemNav = Array.isArray(currentUser?.roles) && currentUser.roles.includes('administrator'); %>
    <% const canSeeInquiryNav = Array.isArray(currentUser?.roles) && currentUser.roles.some((role) => ['administrator', 'sales_manager'].includes(role)); %>
    <% const canSubmitLead = Array.isArray(currentUser?.roles) && currentUser.roles.includes('salesperson'); %>
    <% const canSeeTechnicalStandardsNav = Array.isArray(currentUser?.roles) && currentUser.roles.some((role) => ['administrator', 'technical_manager', 'quotation_engineer'].includes(role)); %>
    <% const canSeeEmailCenterNav = Boolean(typeof emailCenterEnabled !== 'undefined' && emailCenterEnabled); %>
    <% const canSeeBidCenter = Boolean(typeof bidCenterEnabled !== 'undefined' && bidCenterEnabled && Array.isArray(currentUser?.roles) && currentUser.roles.length); %>
    <% const canSeeBidCommercialPackages = Array.isArray(currentUser?.roles) && currentUser.roles.some((role) => ['administrator', 'commercial_manager', 'sales_manager', 'salesperson', 'quotation_engineer', 'legal_reviewer', 'finance_reviewer', 'general_manager'].includes(role)); %>
    <div class="app-shell">
      <aside class="left-nav" aria-label="<%= t('primaryNavigation') %>">
        <a class="brand" href="/workbench" aria-label="Sunkaier workbench">
          <img class="brand-logo" src="/assets/sunkaier-logo.png" alt="SUNKAIER">
        </a>
        <% if (currentUser) { %>
          <div class="nav-account" aria-label="<%= t('currentLoginAccount') %>">
            <div class="nav-account-name"><%= currentUser.displayName %></div>
          </div>
        <% } %>
        <nav class="nav-group">
          <a class="<%= navClass('workbench') %>" href="/workbench"><%= t('workbench') %></a>
          <a class="<%= navClass('notifications') %> notification-nav-link" href="/notifications">
            <span><%= t('notifications') %></span>
            <span class="notification-badge" data-notification-badge hidden>0</span>
          </a>
          <% if (canSeeInquiryNav) { %>
            <a class="<%= navClass('inquiries') %>" href="/inquiries"><%= t('inquiries') %></a>
          <% } %>
          <% if (canSeeEmailCenterNav) { %>
            <a class="<%= navClass('email-center') %>" href="/email-center"><%= t('emailCenter') %></a>
          <% } %>
          <% if (canSubmitLead) { %>
            <a class="<%= navClass('lead-submissions') %>" href="/lead-submissions"><%= t('navLeadSubmissions') %></a>
          <% } %>
          <a class="<%= navClass('sales-work') %>" href="/sales-work/plans"><%= t('navSalesWork') %></a>
          <a class="<%= navClass('opportunities') %>" href="/opportunities"><%= t('opportunities') %></a>
          <a class="<%= navClass('customers') %>" href="/customers"><%= t('customers') %></a>
          <a class="<%= navClass('contacts') %>" href="/contacts"><%= t('contacts') %></a>
          <% if (canSeeBidCenter) { %>
            <div class="nav-parent"><%= t('bidCenter') %></div>
            <div class="nav-subgroup">
              <a class="<%= navClass('bid-center-workspaces') %>" href="/bid-center/workspaces"><%= t('bidProjects') %></a>
              <% if (canSeeTechnicalStandardsNav) { %><a class="<%= navClass('technical-templates') %>" href="/technical-templates"><%= t('bidTechnicalPackages') %></a><% } %>
              <% if (canSeeBidCommercialPackages) { %><a class="<%= navClass('bid-center-commercial') %>" href="/bid-center/commercial-templates"><%= t('bidCommercialPackages') %></a><% } %>
              <a class="<%= navClass('bid-center-clauses') %>" href="/bid-center/clauses"><%= t('bidStandardClauses') %></a>
              <a class="<%= navClass('bid-center-public-materials') %>" href="/bid-center/public-materials"><%= t('navBidPublicMaterials') %></a>
              <span class="nav-link" aria-disabled="true" title="<%= t('availableInLaterBidCenterStep') %>"><%= t('bidOutputRecords') %></span>
            </div>
          <% } else if (canSeeTechnicalStandardsNav) { %>
            <div class="nav-parent"><%= t('technicalStandards') %></div>
            <div class="nav-subgroup">
              <a class="<%= navClass('technical-templates') %>" href="/technical-templates"><%= t('technicalTemplateLibrary') %></a>
              <a class="<%= navClass('technical-clauses') %>" href="/technical-clauses"><%= t('standardClauseLibrary') %></a>
            </div>
          <% } %>
          <% if (canSeeSystemNav) { %>
            <div class="nav-parent"><%= t('system') %></div>
            <div class="nav-subgroup">
              <a class="<%= navClass('system-users') %>" href="/system/users"><%= t('users') %></a>
              <a class="<%= navClass('system-roles') %>" href="/system/roles"><%= t('roles') %></a>
              <a class="<%= navClass('system-approval-settings') %>" href="/system/approval-settings"><%= t('navApprovalSettings') %></a>
            </div>
          <% } %>
        </nav>
        <div class="nav-footer">
          <a class="<%= navClass('account-security') %>" href="/account/security"><%= t('accountSecurity') %></a>
          <a class="<%= navClass('account-password') %>" href="/account/password"><%= t('changePassword') %></a>
          <form class="logout-form" method="post" action="/logout">
            <%- csrfField() %>
            <button class="logout-button" type="submit"><%= t('logout') %></button>
          </form>
        </div>
      </aside>

      <main class="app-main<%= typeof mainClass !== 'undefined' && mainClass ? ` ${mainClass}` : '' %>">
