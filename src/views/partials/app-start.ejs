<!doctype html>
<html lang="<%= typeof language === 'undefined' ? 'en' : language %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta name="web-push-public-key" content="<%= typeof webPushPublicKey === 'undefined' ? '' : webPushPublicKey %>">
    <title><%= title %></title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f5f7f9;
        --panel: #ffffff;
        --line: #d9e1e7;
        --ink: #16202a;
        --muted: #62717f;
        --accent: #0f766e;
        --accent-soft: #edf7f6;
        --rail: #0d1850;
        --rail-ink: #ffffff;
        --rail-muted: #c5d3ee;
        --rail-active: #24489c;
        --page-inline-gutter: clamp(16px, 2vw, 40px);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 20px/1.45 Arial, "Microsoft YaHei", Helvetica, sans-serif;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th,
      td {
        padding: 8px 10px;
        border-bottom: 1px solid var(--line);
        text-align: left;
        vertical-align: top;
      }

      th {
        color: var(--muted);
        font-size: 20px;
        font-weight: 600;
        text-transform: uppercase;
      }

      label {
        display: grid;
        gap: 5px;
        margin-bottom: 12px;
        color: var(--muted);
        font-weight: 600;
      }

      input,
      select,
      textarea {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: white;
        color: var(--ink);
        font: inherit;
        padding: 8px 9px;
      }

      textarea {
        min-height: 82px;
        resize: vertical;
      }

      button,
      .quick-action {
        border: 0;
        border-radius: 6px;
        background: var(--accent);
        color: white;
        cursor: pointer;
        display: inline-block;
        font: inherit;
        font-weight: 700;
        padding: 9px 12px;
      }

      .secondary-action,
      .danger-action {
        border-radius: 6px;
        display: inline-block;
        font-weight: 700;
        padding: 7px 9px;
      }

      .secondary-action {
        background: #e8eef3;
        color: var(--ink);
      }

      .danger-action {
        background: #fee2e2;
        color: #991b1b;
      }

      .write-maintenance-banner {
        background: #fff7ed;
        border: 1px solid #fdba74;
        border-radius: 8px;
        color: #9a3412;
        font-weight: 700;
        margin: 0 0 16px;
        padding: 10px 14px;
      }

      .account-security-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 18px;
      }

      .account-security-grid .form-panel { margin: 0; }
      .account-security-grid h2,
      .account-trusted-devices h2 { margin: 0 0 6px; }
      .account-trusted-devices .list-heading { padding: 18px; }
      .account-recovery-panel { max-width: 760px; }
      .account-recovery-code-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px 16px;
        list-style: none;
        margin: 18px 0;
        padding: 0;
      }
      .account-recovery-code {
        display: block;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: #f8fafc;
        font: 600 18px/1.4 Consolas, monospace;
        letter-spacing: 0.04em;
        padding: 10px;
        text-align: center;
      }
      .warning-text { color: #9a3412; }
      .error-text,
      .success-text {
        border-radius: 6px;
        margin: 0 0 18px;
        padding: 10px 12px;
      }
      .error-text { background: #fef2f2; color: #991b1b; }
      .success-text { background: #ecfdf5; color: #166534; }

      button:disabled {
        cursor: not-allowed;
        opacity: 0.55;
      }

      .app-shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 280px minmax(0, 1fr);
      }

      .left-nav {
        position: sticky;
        top: 0;
        height: 100vh;
        background: linear-gradient(180deg, #101d58 0%, var(--rail) 54%, #0a143f 100%);
        color: var(--rail-ink);
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        padding: 18px 14px;
      }

      .nav-symbols {
        height: 0;
        overflow: hidden;
        position: absolute;
        width: 0;
      }

      .brand {
        display: block;
        margin: 0;
        padding: 2px 8px 6px;
      }

      .brand-logo {
        display: block;
        height: auto;
        max-width: 100%;
        width: 178px;
      }

      .nav-account {
        align-items: center;
        background: rgba(255, 255, 255, 0.055);
        border: 1px solid rgba(255, 255, 255, 0.11);
        border-radius: 10px;
        display: flex;
        gap: 10px;
        margin-top: 12px;
        min-width: 0;
        padding: 9px 10px;
      }

      .nav-avatar {
        align-items: center;
        background: linear-gradient(135deg, #168d95, #22b7a0);
        border-radius: 9px;
        color: #fff;
        display: inline-flex;
        flex: 0 0 32px;
        font-size: 15px;
        font-weight: 700;
        height: 32px;
        justify-content: center;
      }

      .nav-account-name {
        color: var(--rail-ink);
        font-size: 15px;
        font-weight: 600;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .nav-group {
        display: grid;
        gap: 2px;
        margin-top: 12px;
      }

      .nav-section-label,
      .nav-parent {
        align-items: center;
        color: #91a8d6;
        display: flex;
        font-size: 11px;
        font-weight: 700;
        gap: 10px;
        letter-spacing: 0.1em;
        line-height: 1.2;
        margin: 12px 10px 7px;
        padding: 0;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .nav-section-label::after,
      .nav-parent::after {
        background: rgba(255, 255, 255, 0.14);
        content: '';
        flex: 1;
        height: 1px;
      }

      .nav-link {
        align-items: center;
        display: flex;
        gap: 11px;
        min-height: 40px;
        padding: 8px 11px;
        border: 1px solid transparent;
        border-radius: 8px;
        color: var(--rail-muted);
        font-size: 16px;
        font-weight: 400;
        line-height: 1.2;
        transition: background-color 0.15s ease, color 0.15s ease;
        white-space: nowrap;
      }

      .nav-icon {
        flex: 0 0 18px;
        height: 18px;
        opacity: 0.85;
        width: 18px;
      }

      .nav-subgroup {
        display: grid;
        gap: 2px;
        margin-left: 17px;
        padding-left: 7px;
        border-left: 1px solid rgba(255, 255, 255, 0.16);
      }

      .nav-subgroup .nav-link {
        min-height: 36px;
        padding: 7px 9px;
        font-size: 15px;
      }

      .nav-subgroup .nav-icon {
        flex-basis: 16px;
        height: 16px;
        width: 16px;
      }

      .nav-link:hover {
        background: rgba(255, 255, 255, 0.09);
        color: var(--rail-ink);
      }

      .nav-link.active {
        background: var(--rail-active);
        border-color: rgba(170, 202, 255, 0.14);
        box-shadow: inset 3px 0 0 #55d5c7;
        color: var(--rail-ink);
        font-weight: 600;
      }

      .nav-link.active .nav-icon {
        color: #8ff0dc;
        opacity: 1;
      }

      .nav-link:focus-visible,
      .logout-button:focus-visible {
        outline: 2px solid #8ff0dc;
        outline-offset: 2px;
      }

      .nav-link[aria-disabled="true"] {
        cursor: not-allowed;
        opacity: 0.52;
      }

      .inline-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 6px;
        color: #991b1b;
        margin: 8px 0;
        padding: 8px 10px;
      }

      .nav-footer {
        display: grid;
        border-top: 1px solid rgba(255, 255, 255, 0.14);
        gap: 2px;
        margin-top: auto;
        padding-top: 12px;
      }

      .nav-footer .nav-link {
        border: 0;
      }

      .logout-form {
        margin: 0;
      }

      .logout-button {
        align-items: center;
        display: flex;
        gap: 11px;
        min-height: 40px;
        width: 100%;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: var(--rail-muted);
        font-size: 16px;
        font-weight: 400;
        padding: 8px 12px;
        text-align: left;
        transition: background-color 0.15s ease, color 0.15s ease;
      }

      .logout-button:hover {
        background: rgba(255, 255, 255, 0.09);
        color: var(--rail-ink);
      }

      .app-main {
        min-width: 0;
        padding: 18px var(--page-inline-gutter) 28px;
      }

      .app-main.opportunity-email-page {
        padding-left: 0;
        padding-right: 0;
      }

      .opportunity-email-heading {
        padding-left: var(--page-inline-gutter);
        padding-right: var(--page-inline-gutter);
      }

      .page-header,
      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 14px;
      }

      .page-actions {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .page-actions form {
        margin: 0;
      }

      .opportunity-detail-header {
        align-items: stretch;
        display: flex;
        flex-direction: column;
        gap: 0;
      }

      .opportunity-detail-toolbar {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: space-between;
        margin-bottom: 22px;
        width: 100%;
      }

      .opportunity-detail-back {
        color: var(--muted);
        font-size: 14px;
        font-weight: 600;
      }

      .opportunity-detail-heading {
        min-width: 0;
        width: 100%;
      }

      .opportunity-detail-heading .user-line {
        margin-bottom: 8px;
      }

      .opportunity-detail-heading h1 {
        font-weight: 700;
        overflow-wrap: anywhere;
        white-space: normal;
      }

      .opportunity-detail-actions {
        justify-content: flex-end;
        min-width: 0;
      }

      .opportunity-detail-archive-toggle {
        background: transparent;
        border: 1px solid var(--line);
        color: #991b1b;
      }

      .opportunity-detail-archive-panel {
        border-top: 1px solid var(--line);
        margin-top: 22px;
        padding-top: 16px;
        width: 100%;
      }

      .opportunity-detail-archive-panel[hidden] {
        display: none;
      }

      .opportunity-detail-archive-panel form {
        align-items: end;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .opportunity-detail-archive-panel label {
        flex: 1 1 320px;
        margin-bottom: 0;
      }

      @media (max-width: 600px) {
        .opportunity-detail-actions {
          justify-content: flex-start;
        }

        .opportunity-detail-header .opportunity-detail-actions .quick-action {
          width: auto;
        }
      }

      h1 {
        margin: 0;
        font-size: 24px;
      }

      .notification-nav-link {
        align-items: center;
        display: flex;
        gap: 8px;
      }

      .notification-badge {
        align-items: center;
        background: #dc2626;
        border-radius: 999px;
        color: #ffffff;
        display: inline-flex;
        font-size: 14px;
        font-weight: 700;
        height: 24px;
        justify-content: center;
        margin-left: auto;
        min-width: 24px;
        padding: 0 6px;
      }

      .notification-badge[hidden] {
        display: none;
      }

      h2 {
        margin: 18px 0 10px;
        font-size: 20px;
      }

      h3 {
        margin: 0 0 10px;
        font-size: 20px;
      }

      .user-line,
      .state-label,
      .empty,
      .muted,
      .breadcrumb {
        color: var(--muted);
      }

      .breadcrumb {
        margin: 0 0 8px;
        font-weight: 600;
      }

      .duplicate-warning {
        background: #fff7ed;
        border: 1px solid #fdba74;
        border-radius: 8px;
        color: #7c2d12;
        display: grid;
        gap: 8px;
        padding: 12px;
      }

      .duplicate-warning p {
        margin: 0;
      }

      .duplicate-table {
        border-collapse: collapse;
        color: var(--ink);
        font-size: 14px;
        width: 100%;
      }

      .duplicate-table th,
      .duplicate-table td {
        border-top: 1px solid #fed7aa;
        padding: 6px 8px;
        text-align: left;
      }

      .duplicate-table th {
        color: #9a3412;
        font-size: 13px;
        text-transform: uppercase;
      }

      .state-strip {
        display: flex;
        background: var(--panel);
        border: 1px solid var(--line);
        gap: 0;
        margin-bottom: 18px;
        overflow-x: auto;
        padding: 0;
      }

      .state-item,
      .list-section,
      .content-section,
      .action-section {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 8px;
      }

      .state-item {
        align-items: center;
        background: #f6f9fc;
        border: 0;
        border-radius: 0;
        border-right: 1px solid var(--line);
        display: flex;
        flex: 1 0 225px;
        gap: 18px;
        justify-content: space-between;
        min-width: max-content;
        padding: 13px 16px;
        white-space: nowrap;
      }

      .state-item:nth-child(5n + 2) {
        background: #eef6ff;
      }

      .state-item:nth-child(5n + 3) {
        background: #f5f3ff;
      }

      .state-item:nth-child(5n + 4) {
        background: #eefaf7;
      }

      .state-item:nth-child(5n + 5) {
        background: #fff7ed;
      }

      .state-item:last-child {
        border-right: 0;
      }

      .state-label {
        white-space: nowrap;
      }

      .state-count {
        color: #0f3f70;
        flex: 0 0 auto;
        float: none;
        font-size: 24px;
        font-weight: 700;
      }

      .section-stack {
        display: grid;
        gap: 10px;
      }

      .workbench-reference {
        white-space: nowrap;
      }

      .workbench-shortcuts {
        background: var(--bg);
        display: grid;
        gap: 12px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-bottom: 22px;
        padding: 6px 0 12px;
        position: sticky;
        top: 0;
        z-index: 30;
      }

      .workbench-shortcut {
        align-items: center;
        background: #fff;
        border: 1px solid var(--line);
        border-left: 4px solid var(--workbench-accent);
        border-radius: 10px;
        box-shadow: 0 3px 12px rgba(25, 48, 78, 0.08);
        color: var(--ink);
        display: flex;
        gap: 14px;
        justify-content: space-between;
        min-height: 76px;
        padding: 16px 20px;
        text-decoration: none;
      }

      .workbench-shortcut:hover,
      .workbench-shortcut:focus-visible {
        border-color: var(--workbench-accent);
        box-shadow: 0 5px 18px rgba(25, 48, 78, 0.14);
      }

      .workbench-shortcut[aria-current="page"] {
        background: #f7fafc;
        border-color: var(--workbench-accent);
      }

      .workbench-shortcut:only-child { grid-column: 1 / -1; }
      .workbench-shortcut--action { --workbench-accent: #b42318; }
      .workbench-shortcut--plan { --workbench-accent: #245b8a; }
      .workbench-shortcut-label { font-size: 20px; font-weight: 700; }
      .workbench-shortcut-link { color: var(--workbench-accent); font-weight: 700; white-space: nowrap; }

      .workbench-task-list,
      .work-plan-list { display: grid; gap: 10px; }

      .workbench-task-row,
      .work-plan-row {
        align-items: center;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 9px;
        display: grid;
        gap: 22px;
        grid-template-columns: minmax(0, 1fr) auto;
        padding: 17px 20px;
      }

      .workbench-task-row { grid-template-columns: minmax(0, 1fr) minmax(250px, 340px) auto; }
      .workbench-task-row h2,
      .work-plan-row h2 { font-size: 18px; margin: 6px 0; }
      .workbench-task-row p,
      .work-plan-row p { margin: 4px 0 0; overflow-wrap: anywhere; }
      .workbench-task-row a,
      .work-plan-row a { overflow-wrap: anywhere; }
      .workbench-task-dates { display: grid; gap: 9px; }
      .workbench-task-dates > div { display: grid; gap: 2px; }
      .workbench-task-dates span { color: var(--muted); font-size: 13px; }
      .workbench-task-dates strong { font-size: 14px; font-weight: 600; }
      .workbench-task-open,
      .work-plan-row-open { white-space: nowrap; }
      .work-plan-row-eyebrow { align-items: center; display: flex; flex-wrap: wrap; gap: 10px; }
      .work-plan-row-eyebrow time { color: var(--muted); font-size: 14px; font-weight: 600; }
      .work-plan-row-eyebrow .status { font-size: 12px; }
      .work-plan-detail-actions { display: grid; gap: 14px; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 18px; }
      .work-plan-detail-actions .form-panel { margin: 0; }

      @media (max-width: 980px) {
        .workbench-task-row { grid-template-columns: minmax(0, 1fr) auto; }
        .workbench-task-dates { grid-column: 1 / -1; grid-row: 2; grid-template-columns: repeat(2, minmax(0, 1fr)); }
      }

      @media (max-width: 760px) {
        .workbench-shortcuts,
        .work-plan-detail-actions { grid-template-columns: minmax(0, 1fr); }
        .workbench-shortcut { min-height: 62px; padding: 12px 14px; }
        .workbench-shortcut-label { font-size: 17px; }
        .workbench-task-row,
        .work-plan-row { align-items: start; grid-template-columns: minmax(0, 1fr); padding: 14px; }
        .workbench-task-dates { grid-column: auto; grid-row: auto; grid-template-columns: minmax(0, 1fr); }
        .workbench-task-open,
        .work-plan-row-open { justify-self: start; }
      }

      .list-section h2,
      .content-section h2,
      .action-section h3 {
        margin: 0;
        padding: 9px 12px;
        border-bottom: 1px solid var(--line);
        font-size: 20px;
      }

      .workflow-action-list {
        display: grid;
      }

      .workflow-compact-row {
        align-items: center;
        border-bottom: 1px solid var(--line);
        display: flex;
        flex-wrap: wrap;
        gap: 10px 14px;
        min-width: 0;
        padding: 10px 0;
      }

      .workflow-compact-row:last-child {
        border-bottom: 0;
      }

      .workflow-action-button {
        flex: 0 0 190px;
        font-weight: 700;
        min-height: 38px;
        white-space: nowrap;
        width: 190px;
      }

      .workflow-approve-button {
        background: #d9efd2;
        border-color: #67a55d;
        color: #184b1f;
      }

      .workflow-reject-button {
        background: #ffe19b;
        border-color: #d8a10c;
        color: #6a4600;
      }

      .workflow-inline-field {
        align-items: center;
        display: grid;
        flex: 1 1 310px;
        gap: 10px;
        grid-template-columns: max-content minmax(0, 1fr);
        margin: 0;
        min-width: 240px;
      }

      .workflow-inline-field > span {
        font-weight: 700;
        white-space: nowrap;
      }

      .workflow-inline-field input,
      .workflow-inline-field select {
        min-width: 0;
        width: 100%;
      }

      .workflow-engineer-field {
        flex-grow: 1.5;
      }

      .workflow-engineer-picker {
        min-width: 0;
        position: relative;
      }

      .workflow-engineer-picker > summary {
        align-items: center;
        background: #fff;
        border: 1px solid #b9c6d3;
        border-radius: 4px;
        cursor: pointer;
        display: flex;
        height: 38px;
        list-style: none;
        min-width: 0;
        overflow: hidden;
        padding: 6px 30px 6px 10px;
        position: relative;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .workflow-engineer-picker > summary::after {
        content: '▾';
        position: absolute;
        right: 10px;
      }

      .workflow-engineer-picker > summary::-webkit-details-marker {
        display: none;
      }

      .workflow-engineer-options {
        background: #fff;
        border: 1px solid #b9c6d3;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.14);
        display: flex;
        flex-wrap: wrap;
        gap: 6px 14px;
        left: 0;
        max-height: 220px;
        overflow: auto;
        padding: 10px;
        position: absolute;
        right: 0;
        top: calc(100% + 4px);
        z-index: 20;
      }

      .workflow-engineer-options label {
        align-items: center;
        display: inline-flex;
        gap: 5px;
        margin: 0;
        white-space: nowrap;
      }

      .workflow-engineer-options input {
        width: auto;
      }

      .workflow-missing-requirements {
        flex-basis: 100%;
        margin-left: 204px;
      }

      @media (max-width: 900px) {
        .workflow-compact-row {
          align-items: stretch;
          flex-direction: column;
        }

        .workflow-action-button {
          flex-basis: auto;
        }

        .workflow-inline-field {
          flex-basis: auto;
          grid-template-columns: 150px minmax(0, 1fr);
          width: 100%;
        }

        .workflow-missing-requirements {
          margin-left: 0;
        }
      }

      .work-item-status {
        background: #e7f0f8;
        border-radius: 999px;
        color: #315d84;
        display: inline-block;
        font-size: 12px;
        font-weight: 700;
        margin: 0 7px 3px 0;
        padding: 2px 7px;
      }

      .work-item-status.overdue {
        background: #fee2e2;
