        .email-folder-tab {
          min-width: 0;
          white-space: normal;
          width: 100%;
        }

        .opportunity-email-heading {
          padding-left: 0;
          padding-right: 0;
        }

        .opportunity-email-workspace {
          border: 1px solid var(--line);
          border-radius: 8px;
          min-height: auto;
        }

        .opportunity-email-conversation {
          max-height: 520px;
        }

        .customer-email-header-field,
        .customer-email-signature-field,
        .customer-email-attachment-field {
          align-items: stretch;
          gap: 5px;
          grid-template-columns: 1fr;
        }

        .page-header,
        .topbar {
          align-items: flex-start;
          flex-direction: column;
        }

        .page-header .quick-action {
          justify-content: center;
          width: 100%;
        }

        .form-panel.inquiry-filter-panel {
          display: grid;
          gap: 10px;
          grid-template-columns: minmax(0, 1fr);
          margin: 12px 0;
        }

        .opportunity-filter-panel {
          align-items: stretch;
          display: grid;
          grid-template-columns: minmax(0, 1fr);
          margin: 12px 0;
        }

        .opportunity-filter-panel label,
        .opportunity-filter-panel .opportunity-search-field {
          min-width: 0;
          width: 100%;
        }

        .opportunity-filter-panel button,
        .opportunity-filter-panel .secondary-action {
          justify-content: center;
          width: 100%;
        }

        .record-list-body {
          max-height: none;
          overflow: visible;
          padding-left: 0;
          padding-right: 0;
          scrollbar-gutter: auto;
        }

        .record-list-table {
          display: block;
          min-width: 0;
          width: 100%;
        }

        .record-list-table thead {
          clip: rect(0 0 0 0);
          clip-path: inset(50%);
          height: 1px;
          overflow: hidden;
          position: absolute;
          white-space: nowrap;
          width: 1px;
        }

        .record-list-table tbody {
          display: grid;
          gap: 12px;
        }

        .record-list-table tbody tr {
          background: #ffffff;
          border: 1px solid var(--line);
          border-radius: 8px;
          display: grid;
          overflow: hidden;
        }

        .record-list-table tbody td {
          align-items: start;
          border-bottom: 1px solid var(--line);
          border-right: 0;
          display: grid;
          gap: 10px;
          grid-template-columns: minmax(110px, 34%) minmax(0, 1fr);
          min-width: 0;
          padding: 9px 10px;
          text-align: left;
          white-space: normal;
          width: auto;
        }

        .record-list-table tbody td::before {
          color: var(--muted);
          content: attr(data-label);
          font-size: 13px;
          font-weight: 500;
          line-height: 1.35;
        }

        .record-list-table tbody td:last-child {
          border-bottom: 0;
        }

        .record-list-table tbody td.clickable-cell {
          padding: 9px 10px;
        }

        .record-list-table tbody td.clickable-cell .cell-link {
          display: block;
          min-width: 0;
          padding: 0;
          text-align: left;
          white-space: normal;
        }

        .record-list-table tbody td > a:not(.cell-link) {
          min-width: 0;
          overflow-wrap: anywhere;
          white-space: normal;
        }

        .inquiry-filter-panel label,
        .inquiry-filter-panel .inquiry-search-field {
          min-width: 0;
          width: 100%;
        }

        .inquiry-filter-actions {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          width: 100%;
        }

        .inquiry-filter-actions button,
        .inquiry-filter-actions .secondary-action {
          justify-content: center;
          width: 100%;
        }

        .inquiry-list-body {
          max-height: none;
          overflow: visible;
          padding-left: 0;
          padding-right: 0;
          scrollbar-gutter: auto;
        }

        .inquiry-list-table {
          display: block;
          min-width: 0;
          width: 100%;
        }

        .inquiry-list-table thead {
          clip: rect(0 0 0 0);
          clip-path: inset(50%);
          height: 1px;
          overflow: hidden;
          position: absolute;
          white-space: nowrap;
          width: 1px;
        }

        .inquiry-list-table tbody {
          display: grid;
          gap: 12px;
        }

        .inquiry-list-table tbody tr {
          background: #ffffff;
          border: 1px solid var(--line);
          border-radius: 8px;
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          overflow: hidden;
        }

        .content-fit-table.inquiry-list-table tbody td {
          border-bottom: 1px solid var(--line);
          border-right: 0;
          display: block;
          min-width: 0;
          padding: 9px 10px;
          text-align: left;
          width: auto;
        }

        .content-fit-table.inquiry-list-table tbody td:nth-child(odd) {
          border-right: 1px solid var(--line);
        }

        .content-fit-table.inquiry-list-table tbody td::before {
          color: var(--muted);
          content: attr(data-label);
          display: block;
          font-size: 12px;
          font-weight: 500;
          line-height: 1.25;
          margin-bottom: 4px;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .content-fit-table.inquiry-list-table tbody td:nth-child(4),
        .content-fit-table.inquiry-list-table tbody td:nth-child(5),
        .content-fit-table.inquiry-list-table tbody td:nth-child(6),
        .content-fit-table.inquiry-list-table tbody td:nth-child(7),
        .content-fit-table.inquiry-list-table tbody td:nth-child(10) {
          border-right: 0;
          grid-column: 1 / -1;
        }

        .content-fit-table.inquiry-list-table tbody td:nth-child(4),
        .content-fit-table.inquiry-list-table tbody td:nth-child(5),
        .content-fit-table.inquiry-list-table tbody td:nth-child(6),
        .content-fit-table.inquiry-list-table tbody td:nth-child(7),
        .content-fit-table.inquiry-list-table tbody td:nth-child(4) .cell-link {
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .content-fit-table.inquiry-list-table tbody td.clickable-cell {
          padding: 9px 10px;
        }

        .content-fit-table.inquiry-list-table tbody td.clickable-cell .cell-link {
          padding: 0;
        }

        .content-fit-table.inquiry-list-table tbody td:nth-child(10) {
          border-bottom: 0;
        }

        .content-fit-table.inquiry-list-table tbody td:nth-child(10) .secondary-action {
          justify-content: center;
          width: 100%;
        }

        .inquiry-pagination {
          align-items: stretch;
          display: grid;
          grid-template-columns: minmax(0, 1fr);
          justify-content: stretch;
          padding: 10px 0;
        }

        .inquiry-pagination > span,
        .inquiry-pagination > span:first-child {
          margin-right: 0;
          text-align: center;
        }

        .inquiry-view-mode-form select {
          width: 100%;
        }

        .inquiry-pagination-actions {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .inquiry-pagination-actions .secondary-action {
          justify-content: center;
          width: 100%;
        }

        .notification-row,
        .section-heading-row {
          align-items: flex-start;
          flex-direction: column;
        }

        .inquiry-form-grid,
        .inquiry-summary-grid,
        .approval-decision-grid,
        .customer-match-card,
        .inquiry-attachment-row {
          grid-template-columns: 1fr;
        }

        .lead-attachment-list .inquiry-attachment-row {
          grid-template-columns: 1fr;
        }

        .lead-attachment-list .inline-actions {
          grid-column: auto;
        }

        .lead-attachment-picker {
          grid-template-columns: 1fr;
        }

        .lead-attachment-picker > label {
          grid-column: auto;
        }

        .lead-attachment-picker .secondary-action {
          text-align: center;
          width: 100%;
        }

        .lead-review-action-list .workflow-compact-row,
        .lead-review-action-fields {
          grid-template-columns: minmax(0, 1fr);
        }

        .lead-review-action-list .workflow-inline-field {
          grid-template-columns: minmax(0, 1fr);
          gap: 6px;
        }

        .account-security-grid,
        .account-recovery-code-list {
          grid-template-columns: 1fr;
        }
      }
      .product-category-picker,
      .product-category-review {
        border: 1px solid #d7e2ee;
        border-radius: 8px;
        background: #f8fbfe;
        padding: 0.8rem 1rem;
      }
      .product-category-picker {
        grid-column: 1 / -1;
      }
      .product-category-picker p,
      .product-category-review p {
        margin: 0.3rem 0 0.55rem;
      }
      .product-category-suggestions,
      .product-category-confirmed {
        display: flex;
        gap: 0.45rem;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 0.55rem;
      }
      .product-category-suggestion {
        padding: 0.3rem 0.55rem;
        font-size: 0.9rem;
      }
      .product-category-choices summary {
        cursor: pointer;
        font-weight: 600;
      }
      .product-category-options {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
        gap: 0.35rem 0.8rem;
        margin-top: 0.6rem;
      }
      .product-category-options label {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin: 0;
        font-weight: 400;
      }
      .product-category-options input[type="checkbox"] {
        width: auto;
        min-height: auto;
      }
    </style>
  </head>
  <body>
    <% const navClass = (nav) => `nav-link${activeNav === nav ? ' active' : ''}`; %>
    <% const zhSidebarLabels = language === 'zh' ? {
      workbench: '我的工作', emailCenter: '邮件中心', websiteForms: '官网表单',
      leads: '销售线索', opportunities: '销售商机', development: '新品开发',
      customers: '客户档案', contacts: '联系名录', analytics: '数据分析',
      technicalCenter: '技术文档', technicalTemplates: '资料模板',
      standardClauses: '标准条款', system: '系统设置', users: '用户管理',
      roles: '角色管理', approvals: '审批设置', security: '账户安全',
      password: '修改密码', logout: '退出登录'
    } : {}; %>
    <% const enSidebarLabels = language === 'en' ? {
      websiteForms: 'Web Forms', development: 'R&D Products',
      technicalCenter: 'Technical Docs', technicalTemplates: 'Templates',
      standardClauses: 'Clauses', approvals: 'Approvals',
      security: 'Security', password: 'Password', logout: 'Sign Out'
    } : {}; %>
    <% const sidebarLabel = (key, fallback) => zhSidebarLabels[key] || enSidebarLabels[key] || fallback; %>
    <% const navIcon = (name) => `<svg class="nav-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#nav-icon-${name}"></use></svg>`; %>
    <% const canSeeSystemNav = Array.isArray(currentUser?.roles) && currentUser.roles.includes('administrator'); %>
    <% const canSeeWebsiteFormsNav = Array.isArray(currentUser?.roles) && currentUser.roles.some((role) => ['administrator', 'sales_manager'].includes(role)); %>
    <% const canSeeLeadNav = Boolean(currentUser && currentUser.isActive !== false); %>
    <% const canSeeTechnicalStandardsNav = Array.isArray(currentUser?.roles) && currentUser.roles.some((role) => ['administrator', 'technical_manager', 'quotation_engineer'].includes(role)); %>
    <% const canSeeEmailCenterNav = Boolean(typeof emailCenterEnabled !== 'undefined' && emailCenterEnabled); %>
    <svg class="nav-symbols" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <symbol id="nav-icon-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
      <symbol id="nav-icon-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></symbol>
      <symbol id="nav-icon-file" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M14 3v5h4M8 13h8M8 17h6"/></symbol>
      <symbol id="nav-icon-user-plus" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3.5 20v-2a5.5 5.5 0 0 1 11 0v2M18 8v8m-4-4h8"/></symbol>
      <symbol id="nav-icon-briefcase" viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18M10 12v3h4v-3"/></symbol>
      <symbol id="nav-icon-bulb" viewBox="0 0 24 24"><path d="M9 18h6m-5 3h4M8 15a7 7 0 1 1 8 0l-1 3H9l-1-3Z"/></symbol>
      <symbol id="nav-icon-building" viewBox="0 0 24 24"><path d="M4 21V6l8-3 8 3v15M2 21h20M9 21v-5h6v5M8 8h.01M12 8h.01M16 8h.01M8 12h.01M12 12h.01M16 12h.01"/></symbol>
      <symbol id="nav-icon-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2H3ZM17 5a3 3 0 0 1 0 6M17 14a5 5 0 0 1 4 5v1h-3"/></symbol>
      <symbol id="nav-icon-chart" viewBox="0 0 24 24"><path d="M3 20h18M6 17v-6m6 6V5m6 12v-9"/></symbol>
      <symbol id="nav-icon-folder" viewBox="0 0 24 24"><path d="M3 6a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6Z"/></symbol>
      <symbol id="nav-icon-bookmark" viewBox="0 0 24 24"><path d="M6 3h12v18l-6-4-6 4V3Z"/></symbol>
      <symbol id="nav-icon-sliders" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/><circle cx="8" cy="6" r="2"/><circle cx="16" cy="12" r="2"/><circle cx="10" cy="18" r="2"/></symbol>
      <symbol id="nav-icon-shield" viewBox="0 0 24 24"><path d="m12 2 8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4Z"/><path d="m9 12 2 2 4-4"/></symbol>
      <symbol id="nav-icon-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/></symbol>
      <symbol id="nav-icon-lock" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/></symbol>
      <symbol id="nav-icon-key" viewBox="0 0 24 24"><circle cx="8" cy="9" r="4"/><path d="m11 12 9 9m-4-4 2-2m-5-1 2-2"/></symbol>
      <symbol id="nav-icon-logout" viewBox="0 0 24 24"><path d="M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5M13 7l5 5-5 5m5-5H9"/></symbol>
    </svg>
    <div class="app-shell">
      <aside class="left-nav" aria-label="<%= t('primaryNavigation') %>">
        <a class="brand" href="/workbench" aria-label="Sunkaier workbench">
          <img class="brand-logo" src="/assets/sunkaier-logo.png" alt="SUNKAIER">
        </a>
        <% if (currentUser) { %>
          <div class="nav-account" aria-label="<%= t('currentLoginAccount') %>">
            <span class="nav-avatar" aria-hidden="true"><%= [...String(currentUser.displayName || '?')][0] %></span>
            <div class="nav-account-name" title="<%= currentUser.displayName %>"><%= currentUser.displayName %></div>
          </div>
        <% } %>
        <nav class="nav-group">
          <div class="nav-section-label"><%= language === 'zh' ? '业务导航' : 'Workspace' %></div>
          <a class="<%= navClass('workbench') %> notification-nav-link" href="/workbench">
            <%- navIcon('grid') %>
            <span><%= sidebarLabel('workbench', t('workbench')) %></span>
            <span class="notification-badge" data-notification-badge hidden>0</span>
          </a>
          <% if (canSeeEmailCenterNav) { %>
            <a class="<%= navClass('email-center') %>" href="/email-center"><%- navIcon('mail') %><span><%= sidebarLabel('emailCenter', t('emailCenter')) %></span></a>
          <% } %>
          <% if (canSeeWebsiteFormsNav) { %>
            <a class="<%= navClass('inquiries') %>" href="/inquiries"><%- navIcon('file') %><span><%= sidebarLabel('websiteForms', t('websiteForms')) %></span></a>
          <% } %>
          <% if (canSeeLeadNav) { %>
            <a class="<%= navClass('lead-submissions') %>" href="/lead-submissions"><%- navIcon('user-plus') %><span><%= sidebarLabel('leads', t('navLeadSubmissions')) %></span></a>
          <% } %>
          <a class="<%= navClass('opportunities') %>" href="/opportunities"><%- navIcon('briefcase') %><span><%= sidebarLabel('opportunities', t('opportunities')) %></span></a>
          <% if (typeof developmentWorkspaceEnabled !== 'undefined' && developmentWorkspaceEnabled) { %>
            <a class="<%= navClass('development') %>" href="/development/topics"><%- navIcon('bulb') %><span><%= sidebarLabel('development', 'New Product Development') %></span></a>
          <% } %>
          <a class="<%= navClass('customers') %>" href="/customers"><%- navIcon('building') %><span><%= sidebarLabel('customers', t('customers')) %></span></a>
          <a class="<%= navClass('contacts') %>" href="/contacts"><%- navIcon('users') %><span><%= sidebarLabel('contacts', t('contacts')) %></span></a>
          <a class="<%= navClass('analytics') %>" href="/analytics"><%- navIcon('chart') %><span><%= sidebarLabel('analytics', t('analytics')) %></span></a>
          <% if (canSeeTechnicalStandardsNav) { %>
            <div class="nav-parent"><%= sidebarLabel('technicalCenter', t('technicalDocumentsCenter')) %></div>
            <div class="nav-subgroup">
              <a class="<%= navClass('technical-templates') %>" href="/technical-templates"><%- navIcon('folder') %><span><%= sidebarLabel('technicalTemplates', t('technicalTemplateLibrary')) %></span></a>
              <a class="<%= navClass('technical-clauses') %>" href="/technical-clauses"><%- navIcon('bookmark') %><span><%= sidebarLabel('standardClauses', t('standardClauseLibrary')) %></span></a>
            </div>
          <% } %>
          <% if (canSeeSystemNav) { %>
            <div class="nav-parent"><%= sidebarLabel('system', t('system')) %></div>
            <div class="nav-subgroup">
              <a class="<%= navClass('system-users') %>" href="/system/users"><%- navIcon('users') %><span><%= sidebarLabel('users', t('users')) %></span></a>
              <a class="<%= navClass('system-roles') %>" href="/system/roles"><%- navIcon('shield') %><span><%= sidebarLabel('roles', t('roles')) %></span></a>
              <a class="<%= navClass('system-approval-settings') %>" href="/system/approval-settings"><%- navIcon('check') %><span><%= sidebarLabel('approvals', t('navApprovalSettings')) %></span></a>
            </div>
          <% } %>
        </nav>
        <div class="nav-footer">
          <a class="<%= navClass('account-security') %>" href="/account/security"><%- navIcon('lock') %><span><%= sidebarLabel('security', t('accountSecurity')) %></span></a>
          <a class="<%= navClass('account-password') %>" href="/account/password"><%- navIcon('key') %><span><%= sidebarLabel('password', t('changePassword')) %></span></a>
          <form class="logout-form" method="post" action="/logout">
            <%- csrfField() %>
            <button class="logout-button" type="submit"><%- navIcon('logout') %><span><%= sidebarLabel('logout', t('logout')) %></span></button>
          </form>
        </div>
      </aside>

      <main class="app-main<%= typeof mainClass !== 'undefined' && mainClass ? ` ${mainClass}` : '' %>">
        <% if (typeof writeMaintenanceActive !== 'undefined' && writeMaintenanceActive) { %>
          <div class="write-maintenance-banner" role="status">
            <%= language === 'zh' ? '系统正在创建发布前备份：浏览和查询可用，保存、提交及上传暂时暂停。' : 'A release backup is in progress. Reading remains available; saving, submitting and uploading are temporarily paused.' %>
          </div>
        <% } %>
