<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f5f7f9;
        --panel: #ffffff;
        --line: #d9e1e7;
        --ink: #16202a;
        --muted: #62717f;
        --accent: #0f766e;
        --accent-soft: #edf7f6;
        --rail: #0B0F6E;
        --rail-ink: #ffffff;
        --rail-muted: #c7d2fe;
        --rail-active: #1e40af;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 14px/1.4 Arial, "Microsoft YaHei", Helvetica, sans-serif;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th,
      td {
        padding: 8px 10px;
        border-bottom: 1px solid var(--line);
        text-align: left;
        vertical-align: top;
      }

      th {
        color: var(--muted);
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
      }

      label {
        display: grid;
        gap: 5px;
        margin-bottom: 12px;
        color: var(--muted);
        font-weight: 600;
      }

      input,
      select,
      textarea {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: white;
        color: var(--ink);
        font: inherit;
        padding: 8px 9px;
      }

      textarea {
        min-height: 82px;
        resize: vertical;
      }

      button,
      .quick-action {
        border: 0;
        border-radius: 6px;
        background: var(--accent);
        color: white;
        cursor: pointer;
        display: inline-block;
        font: inherit;
        font-weight: 700;
        padding: 9px 12px;
      }

      .secondary-action,
      .danger-action {
        border-radius: 6px;
        display: inline-block;
        font-weight: 700;
        padding: 7px 9px;
      }

      .secondary-action {
        background: #e8eef3;
        color: var(--ink);
      }

      .danger-action {
        background: #fee2e2;
        color: #991b1b;
      }

      button:disabled {
        cursor: not-allowed;
        opacity: 0.55;
      }

      .app-shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 220px minmax(0, 1fr);
      }

      .left-nav {
        position: sticky;
        top: 0;
        height: 100vh;
        background: var(--rail);
        color: var(--rail-ink);
        padding: 18px 14px;
      }

      .brand {
        margin: 0 0 18px;
        font-size: 17px;
        font-weight: 700;
      }

      .nav-group {
        display: grid;
        gap: 4px;
      }

      .nav-link {
        display: block;
        padding: 9px 10px;
        border-radius: 6px;
        color: var(--rail-muted);
        font-weight: 600;
      }

      .nav-parent {
        margin: 14px 0 2px;
        padding: 9px 10px;
        border-radius: 6px;
        color: var(--rail-ink);
        font-weight: 700;
      }

      .nav-subgroup {
        display: grid;
        gap: 2px;
        margin-left: 10px;
        padding-left: 10px;
        border-left: 1px solid rgba(255, 255, 255, 0.18);
      }

      .nav-subgroup .nav-link {
        padding: 7px 10px;
        font-size: 13px;
      }

      .nav-link:hover,
      .nav-link.active {
        background: var(--rail-active);
        color: var(--rail-ink);
      }

      .logout-form {
        margin-top: 18px;
      }

      .logout-button {
        width: 100%;
        border: 1px solid rgba(255, 255, 255, 0.18);
        background: transparent;
        color: var(--rail-muted);
        text-align: left;
      }

      .app-main {
        min-width: 0;
        padding: 18px 22px 28px;
      }

      .page-header,
      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 14px;
      }

      .page-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      h1 {
        margin: 0;
        font-size: 22px;
      }

      h2 {
        margin: 18px 0 10px;
        font-size: 16px;
      }

      h3 {
        margin: 0 0 10px;
        font-size: 14px;
      }

      .user-line,
      .state-label,
      .empty,
      .muted,
      .breadcrumb {
        color: var(--muted);
      }

      .breadcrumb {
        margin: 0 0 8px;
        font-weight: 600;
      }

      .state-strip {
        display: flex;
        gap: 10px;
        margin-bottom: 12px;
        overflow-x: auto;
        padding-bottom: 2px;
      }

      .state-item,
      .list-section,
      .content-section,
      .action-section {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 8px;
      }

      .state-item {
        flex: 0 0 190px;
        padding: 10px 12px;
      }

      .state-count {
        float: right;
        font-size: 20px;
        font-weight: 700;
      }

      .workbench-list,
      .section-stack {
        display: grid;
        gap: 10px;
      }

      .list-section h2,
      .content-section h2,
      .action-section h3 {
        margin: 0;
        padding: 9px 12px;
        border-bottom: 1px solid var(--line);
        font-size: 15px;
      }

      .business-section > h2 {
        color: #ffffff;
      }

      .business-section-basic {
        background: #f4f7fb;
        border-color: #bfdbfe;
      }

      .business-section-basic > h2 {
        background: #1e3a5f;
        border-bottom-color: #1e3a5f;
      }

      .business-section-requirement {
        background: #fffbeb;
        border-color: #fde68a;
      }

      .business-section-requirement > h2 {
        background: #92400e;
        border-bottom-color: #92400e;
      }

      .business-section-technical {
        background: #eff6ff;
        border-color: #bfdbfe;
      }

      .business-section-technical > h2 {
        background: #1d4ed8;
        border-bottom-color: #1d4ed8;
      }

      .business-section-quote {
        background: #ecfdf5;
        border-color: #a7f3d0;
      }

      .business-section-quote > h2 {
        background: #047857;
        border-bottom-color: #047857;
      }

      .business-section-contract {
        background: #f5f3ff;
        border-color: #ddd6fe;
      }

      .business-section-contract > h2 {
        background: #6d28d9;
        border-bottom-color: #6d28d9;
      }

      .list-body,
      .section-body {
        padding: 0 12px 10px;
      }

      .list-table th,
      .list-table td {
        padding: 7px 8px;
      }

      .list-table td.clickable-cell {
        padding: 0;
      }

      .cell-link {
        display: block;
        min-height: 100%;
        padding: 7px 8px;
      }

      .cell-link:hover {
        background: #f8fbfc;
      }

      .detail-list {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        gap: 8px 18px;
        margin: 0;
      }

      .detail-list dt {
        color: var(--muted);
        font-weight: 700;
      }

      .detail-list dd {
        margin: 0;
      }

      .inline-list {
        display: grid;
        gap: 8px;
        margin: 0;
        padding-left: 18px;
      }

      .inline-actions {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .inline-actions form {
        margin: 0;
      }

      .checkbox-list {
        display: grid;
        gap: 7px;
        margin-bottom: 12px;
      }

      .checkbox-row {
        align-items: center;
        display: flex;
        gap: 8px;
        margin: 0;
      }

      .checkbox-row input {
        width: auto;
      }

      .status {
        display: inline-block;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent);
        font-size: 12px;
        font-weight: 700;
        padding: 2px 8px;
      }

      .form-panel {
        max-width: 760px;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 14px;
      }

      .attachment-upload-panel {
        max-width: none;
        width: 100%;
        background: rgba(255, 255, 255, 0.35);
      }

      .attachment-upload-panel button {
        width: 190px;
        text-align: center;
        background: #dbeafe;
        color: #0B0F6E;
      }

      .inline-create-panel {
        border: 1px solid var(--line);
        border-radius: 6px;
        margin: -4px 0 12px;
        padding: 9px 10px;
      }

      .inline-create-panel summary {
        color: var(--ink);
        cursor: pointer;
        font-weight: 700;
      }

      .inline-create-panel form {
        display: grid;
        gap: 2px;
        margin-top: 10px;
      }

      @media (max-width: 860px) {
        .app-shell {
          grid-template-columns: 1fr;
        }

        .left-nav {
          position: static;
          height: auto;
        }

        .page-header,
        .topbar {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <% const navClass = (nav) => `nav-link${activeNav === nav ? ' active' : ''}`; %>
    <div class="app-shell">
      <aside class="left-nav" aria-label="Primary navigation">
        <p class="brand">BESTCRM</p>
        <nav class="nav-group">
          <a class="<%= navClass('workbench') %>" href="/workbench">Workbench</a>
          <a class="<%= navClass('opportunities') %>" href="/opportunities">Opportunities</a>
          <a class="<%= navClass('customers') %>" href="/customers">Customers</a>
          <a class="<%= navClass('contacts') %>" href="/contacts">Contacts</a>
          <div class="nav-parent">System</div>
          <div class="nav-subgroup">
            <a class="<%= navClass('system-users') %>" href="/system/users">Users</a>
            <a class="<%= navClass('system-roles') %>" href="/system/roles">Roles</a>
            <a class="<%= navClass('system-approval-settings') %>" href="/system/approval-settings">Approval Settings</a>
          </div>
        </nav>
        <form class="logout-form" method="post" action="/logout">
          <button class="logout-button" type="submit">Logout</button>
        </form>
      </aside>

      <main class="app-main">
