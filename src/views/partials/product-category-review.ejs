<%
  const confirmed = Array.isArray(record?.confirmedProductCategoryCodes)
    ? record.confirmedProductCategoryCodes : [];
  const suggested = (typeof suggestions !== 'undefined' && Array.isArray(suggestions)
    ? suggestions
    : suggestProductCategoryCodes({
        productInterest: record?.productInterest,
        subject: record?.subject || record?.title,
        requirementText: record?.requirementText || record?.requirement
      }));
  const selectedCategoryCode = confirmed[0] || suggested[0] || '';
%>
<section class="content-section product-category-review">
  <div class="product-category-review-row">
    <h2><%= t('productCategories') %></h2>
    <% if (canEditCategories) { %>
      <form class="product-category-review-form" method="post" action="<%= action %>">
        <%- csrfField() %>
        <input type="hidden" name="productCategoriesSubmitted" value="1">
        <label>
          <span class="visually-hidden"><%= t('selectProductCategory') %></span>
          <select name="confirmedProductCategoryCodes" required>
            <option value="" disabled<%= selectedCategoryCode ? '' : ' selected' %>><%= t('selectProductCategory') %></option>
            <% for (const category of productCategories) { %>
              <option value="<%= category.code %>"<%= category.code === selectedCategoryCode ? ' selected' : '' %>><%= category.label %></option>
            <% } %>
          </select>
        </label>
        <button class="product-category-confirm-button" type="submit"><%= t('confirmProductCategory') %></button>
      </form>
    <% } %>
    <div class="product-category-confirmed" aria-live="polite">
      <strong><%= t('categoryReviewStatusReviewed') %>:</strong>
      <% if (confirmed.length) { %>
        <% for (const code of confirmed) { %><span class="status"><%= productCategoryLabel(code) %></span><% } %>
      <% } else { %><span class="muted">—</span><% } %>
    </div>
  </div>
</section>
