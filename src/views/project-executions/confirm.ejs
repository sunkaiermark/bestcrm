<%- include('../partials/app-start', { title: `${t('confirmProjectExecution')} - BESTCRM`, activeNav: 'workbench' }) %>
        <p class="breadcrumb"><a href="/workbench"><%= t('workbench') %></a> / <%= t('confirmProjectExecution') %></p>
        <header class="page-header">
          <div>
            <h1><%= t('confirmProjectExecution') %></h1>
            <div class="muted"><%= language === 'zh' ? '项目执行号' : 'Project execution no.' %>：<strong><%= opportunity.opportunityNo %></strong> <%= language === 'zh' ? '（沿用获单商机号）' : '(uses the winning Opportunity number)' %> · <%= opportunity.title %></div>
          </div>
        </header>

        <section class="detail-grid">
          <div><span><%= t('customer') %></span><strong><%= opportunity.customerName %></strong></div>
          <div><span><%= t('status') %></span><strong><%= statusLabel(opportunity.status) %></strong></div>
        </section>

        <form class="form-panel" method="post" action="/opportunities/<%= opportunity.id %>/project-execution/confirm">
          <%- csrfField() %>
          <label>
            <%= t('contractSigningDate') %>
            <input name="contractSignedOn" type="date" required>
          </label>
          <label>
            <%= language === 'zh' ? '项目执行人（项目部）' : 'Project execution owner (Project Department)' %>
            <select name="projectOwnerUserId" required>
              <option value=""><%= language === 'zh' ? '请选择项目执行人' : 'Choose a project execution owner' %></option>
              <% for (const user of users) { %><option value="<%= user.id %>"><%= user.displayName %></option><% } %>
            </select>
          </label>
          <label>
            <%= language === 'zh' ? '项目工程师（提交技术方案）' : 'Project engineer (technical solution submitter)' %>
            <select name="projectEngineerUserId" required>
              <option value=""><%= language === 'zh' ? '请选择项目工程师' : 'Choose a project engineer' %></option>
              <% for (const user of users) { %><option value="<%= user.id %>" <%= Number(opportunity.quotationEngineerId) === Number(user.id) ? 'selected' : '' %>><%= user.displayName %></option><% } %>
            </select>
          </label>
          <label>
            <%= language === 'zh' ? '制造工艺工程师（提交工艺方案）' : 'Manufacturing process engineer (process plan submitter)' %>
            <select name="processEngineerUserId" required>
              <option value=""><%= language === 'zh' ? '请选择制造工艺工程师' : 'Choose a manufacturing process engineer' %></option>
              <% for (const user of users) { %><option value="<%= user.id %>"><%= user.displayName %></option><% } %>
            </select>
          </label>
          <label>
            <%= language === 'zh' ? '技术经理（评审）' : 'Technical manager (review)' %>
            <select name="technicalManagerUserId" required>
              <option value=""><%= language === 'zh' ? '请选择技术经理' : 'Choose a technical manager' %></option>
              <% for (const user of users) { %><option value="<%= user.id %>" <%= Number(opportunity.technicalManagerId) === Number(user.id) ? 'selected' : '' %>><%= user.displayName %></option><% } %>
            </select>
          </label>
          <label>
            <%= language === 'zh' ? '批准人' : 'Approver' %>
            <select name="approverUserId" required>
              <option value=""><%= language === 'zh' ? '请选择批准人' : 'Choose an approver' %></option>
              <% for (const user of users) { %><option value="<%= user.id %>"><%= user.displayName %></option><% } %>
            </select>
          </label>
          <label>
            <%= language === 'zh' ? '发布责任人' : 'Release publisher' %>
            <select name="publisherUserId" required>
              <option value=""><%= language === 'zh' ? '请选择发布责任人' : 'Choose a release publisher' %></option>
              <% for (const user of users) { %><option value="<%= user.id %>"><%= user.displayName %></option><% } %>
            </select>
          </label>
          <p class="muted"><%= language === 'zh' ? '项目执行人独立于销售负责人。技术方案和制造工艺方案的提交人不得自行评审或批准；每一步均记录人员、版本、时间和说明。' : 'The project execution owner is independent from sales. Submitters cannot review or approve their own release workflow; every step records actor, version, time and note.' %></p>
          <p class="muted"><%= t('projectExecutionConfirmationNotice') %></p>
          <div class="inline-actions">
            <button type="submit"><%= t('confirmAndCreate') %></button>
            <a class="secondary-action" href="/workbench"><%= t('cancel') %></a>
          </div>
        </form>
<%- include('../partials/app-end') %>
