<%- include('../partials/app-start', { title: `${language === 'zh' ? '项目执行' : 'Project Execution'} - BESTCRM`, activeNav: 'project-executions' }) %>
<% const zh = language === 'zh'; const stamp = value => value ? new Date(value).toLocaleString(zh?'zh-CN':'en-GB',{timeZone:'Asia/Shanghai',hour12:false}) : '—'; const label = value => ({ planning: zh ? '计划中' : 'Planning', in_progress: zh ? '执行中' : 'In progress', on_hold: zh ? '已暂停' : 'On hold', completed: zh ? '已完成' : 'Completed', cancelled: zh ? '已取消' : 'Cancelled', not_started: zh ? '未开始' : 'Not started', blocked: zh ? '受阻' : 'Blocked', pending_acceptance: zh ? '待验收' : 'Pending acceptance' }[value] || value); %>
<style>
  .project-execution-detail .panel{margin:0 0 16px;padding:16px;border:1px solid var(--line);border-radius:8px;background:var(--panel)}
  .project-execution-detail .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}.project-execution-detail label{display:grid;gap:5px}.project-execution-detail textarea{min-height:64px}.project-execution-detail .form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(165px,1fr));gap:10px;align-items:end}.project-execution-detail .form-grid button{width:auto;align-self:end}.project-execution-detail form{margin-top:12px}.project-execution-detail .meta strong{display:block;margin-top:3px}.project-execution-detail .package-actions{min-width:280px}
  .project-execution-detail .kickoff-flow{display:grid;grid-template-columns:repeat(4,minmax(180px,1fr));gap:10px;overflow-x:auto}.project-execution-detail .kickoff-step{min-width:180px;border:1px solid var(--line);border-radius:6px;padding:12px;background:var(--bg)}.project-execution-detail .kickoff-step .step-no{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:var(--accent);color:#fff;font-size:12px;font-weight:700;margin-right:7px}.project-execution-detail .gantt{min-width:1180px}.project-execution-detail .gantt-legend{display:flex;gap:14px;align-items:center;margin:0 0 8px 208px;color:var(--muted);font-size:12px}.project-execution-detail .gantt-legend i{display:inline-block;width:9px;height:9px;margin-right:4px;background:var(--accent);vertical-align:middle}.project-execution-detail .gantt-legend i.milestone{transform:rotate(45deg);border-radius:1px}.project-execution-detail .gantt-legend i.work{border-radius:8px;width:18px;height:7px}.project-execution-detail .gantt-dates{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin:2px 0 4px 208px}.project-execution-detail .gantt-body{position:relative}.project-execution-detail .gantt-dependencies{position:absolute;z-index:1;left:208px;right:0;top:0;width:calc(100% - 208px);height:100%;overflow:visible;pointer-events:none}.project-execution-detail .gantt-row{position:relative;z-index:2;display:grid;grid-template-columns:196px 1fr;gap:12px;align-items:center;height:42px;border-top:1px solid var(--line)}.project-execution-detail .gantt-row:first-of-type{border-top:0}.project-execution-detail .gantt-row-label{line-height:1.1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.project-execution-detail .gantt-row-label small{color:var(--muted);font-size:11px}.project-execution-detail .gantt-track{position:relative;height:18px;border-radius:3px;background:repeating-linear-gradient(90deg,transparent 0,transparent calc(25% - 1px),var(--line) calc(25% - 1px),var(--line) 25%)}.project-execution-detail .gantt-bar{position:absolute;z-index:3;top:5px;height:8px;min-width:8px;border-radius:7px;background:var(--accent)}.project-execution-detail .gantt-bar.milestone{width:11px!important;height:11px;border-radius:2px;transform:rotate(45deg);top:3px}.project-execution-detail .gantt-predecessor{margin-left:4px;color:var(--muted);font-size:11px}
  .project-execution-detail .workflow-grid{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(260px,.9fr);gap:16px}.project-execution-detail .workflow-steps{list-style:none;margin:12px 0 0;padding:0}.project-execution-detail .workflow-steps li{border-top:1px solid var(--line);padding:10px 0}.project-execution-detail .workflow-steps strong,.project-execution-detail .workflow-steps small{display:block}.project-execution-detail .workflow-steps small{color:var(--muted)}.project-execution-detail .audit-table td{font-size:14px}.project-execution-detail .blocker{color:#9a3412;font-weight:600}@media (max-width:900px){.project-execution-detail .workflow-grid{grid-template-columns:1fr}}
</style>
<% const namedUser = id => users.find(user => Number(user.id) === Number(id)); const salesOwner = namedUser(contractKickoff.salesOwnerUserId); const technicalResponsible = namedUser(contractKickoff.technicalResponsibleUserId); const projectOwner = namedUser(contractKickoff.projectOwnerUserId); const technicalApprover = namedUser(contractKickoff.technicalManagerId); const workflowLabel = value => ({ technical_solution_pending: zh ? '待提交技术方案' : 'Technical solution pending', manufacturing_process_pending: zh ? '待提交制造工艺方案' : 'Manufacturing process pending', technical_review_pending: zh ? '待技术经理评审' : 'Technical review pending', approval_pending: zh ? '待批准' : 'Approval pending', release_pending: zh ? '待发布' : 'Release pending', released: zh ? '已发布到项目执行' : 'Released to project execution' }[value] || value); const timestamp = value => value ? Date.parse(`${value}T00:00:00.000Z`) : NaN; const unsortedGanttItems = [...milestones.filter(item => !Number.isNaN(timestamp(item.plannedOn))).map(item => ({ title: item.title, start: item.plannedOn, end: item.plannedOn, kind: 'milestone' })), ...workPackages.filter(item => !Number.isNaN(timestamp(item.plannedStartOn || item.dueOn))).map(item => ({ title: item.title, start: item.plannedStartOn || item.dueOn, end: item.dueOn || item.plannedStartOn, kind: 'work' }))]; const ganttItems = unsortedGanttItems.sort((left, right) => timestamp(left.start) - timestamp(right.start)); const standardPredecessorTitles = { '首次技术评估': '合同执行首次会议', '图纸/技术文件提交评审': '首次技术评估', '图纸/技术文件批准发布': '图纸/技术文件提交评审' }; ganttItems.forEach((item, index) => { item.predecessorIndex = standardPredecessorTitles[item.title] ? ganttItems.findIndex(candidate => candidate.title === standardPredecessorTitles[item.title]) : -1; item.predecessorTitle = item.predecessorIndex >= 0 ? ganttItems[item.predecessorIndex].title : ''; item.index = index; }); const ganttTimes = ganttItems.flatMap(item => [timestamp(item.start), timestamp(item.end)]); const ganttStart = ganttTimes.length ? Math.min(...ganttTimes) : null; const ganttEnd = ganttTimes.length ? Math.max(...ganttTimes) : null; const ganttDays = ganttStart === null ? 1 : Math.max(1, Math.round((ganttEnd - ganttStart) / 86400000)); const ganttPosition = value => Math.max(0, Math.min(100, ((timestamp(value) - ganttStart) / 86400000) / ganttDays * 100)); const ganttWidth = item => item.kind === 'milestone' ? 0 : Math.max(2, ((timestamp(item.end) - timestamp(item.start)) / 86400000 + 1) / ganttDays * 100); const ganttCoordinate = value => Math.round(ganttPosition(value) * 10); const ganttRowHeight = 42; const ganttHeight = Math.max(ganttRowHeight, ganttItems.length * ganttRowHeight); const ganttY = index => index * ganttRowHeight + 21; %>
<section class="page-section project-execution-detail">
  <p class="breadcrumb"><a href="/project-executions"><%= zh ? '项目执行' : 'Project Execution' %></a> / <%= projectExecution.opportunityNo %></p>
  <header class="page-header"><div><h1><%= projectExecution.projectExecutionNo || projectExecution.opportunityNo %> · <%= projectExecution.opportunityTitle %></h1><p class="muted"><%= zh ? '项目执行号沿用获单商机号' : 'Project execution number uses the winning Opportunity number' %> · <%= projectExecution.customerName %> · <% if(canViewOriginOpportunity){ %><a href="/opportunities/<%= projectExecution.opportunityId %>"><%= zh ? '查看原商机' : 'View Opportunity' %></a><% } %></p></div></header>
  <section class="panel"><h2><%= zh ? '订单项目总览' : 'Order project overview' %></h2><div class="grid meta"><div><span><%= zh ? '合同签订' : 'Contract signed' %></span><strong><%= projectExecution.contractSignedOn || (zh?'以签署合同为准':'See signed contract') %></strong></div><div><span><%= zh ? '项目执行人（项目部）' : 'Project execution owner' %></span><strong><%= projectExecution.projectOwnerDisplayName || (zh?'待总经理分配':'Awaiting GM assignment') %></strong></div><div><span><%= zh ? '项目状态' : 'Project status' %></span><strong><%= label(projectExecution.status) %></strong></div><div><span><%= zh ? '计划完成' : 'Planned completion' %></span><strong><%= projectExecution.plannedCompletionOn || '—' %></strong></div><div><span><%= zh ? '实际交付' : 'Actual delivery' %></span><strong><%= projectExecution.actualDeliveryOn || '—' %></strong></div><div><span><%= zh ? '客户验收' : 'Customer acceptance' %></span><strong><%= projectExecution.actualAcceptanceOn || '—' %></strong></div></div>
  <% if (projectExecution.riskSummary) { %><p><strong><%= zh ? '风险 / 阻塞：' : 'Risk / blocker: ' %></strong><%= projectExecution.riskSummary %></p><% } %>
  <% if (canManage && projectExecution.projectOwnerUserId) { %><details><summary><%= zh ? '状态及交付记录' : 'Status and delivery records' %></summary><form method="post" action="/project-executions/<%= projectExecution.id %>" class="form-grid"><%- csrfField() %><label><%= zh ? '项目执行人（项目部）' : 'Project execution owner' %><input type="hidden" name="projectOwnerUserId" value="<%= projectExecution.projectOwnerUserId||'' %>"><span><%= projectExecution.projectOwnerDisplayName || (zh?'请在部门分工中安排':'Assign through department plan') %></span></label><label><%= zh ? '状态' : 'Status' %><select name="status"><% for (const value of ['planning','in_progress','on_hold','completed','cancelled']) { %><option value="<%= value %>" <%= projectExecution.status === value ? 'selected' : '' %>><%= label(value) %></option><% } %></select></label><label><%= zh ? '计划开始' : 'Planned start' %><input type="date" name="plannedStartOn" value="<%= projectExecution.plannedStartOn || '' %>"></label><label><%= zh ? '计划完成' : 'Planned completion' %><input type="date" name="plannedCompletionOn" value="<%= projectExecution.plannedCompletionOn || '' %>"></label><label><%= zh ? '实际交付' : 'Actual delivery' %><input type="date" name="actualDeliveryOn" value="<%= projectExecution.actualDeliveryOn || '' %>"></label><label><%= zh ? '客户验收' : 'Customer acceptance' %><input type="date" name="actualAcceptanceOn" value="<%= projectExecution.actualAcceptanceOn || '' %>"></label><label style="grid-column:1/-1"><%= zh ? '风险 / 阻塞说明' : 'Risk / blocker summary' %><textarea name="riskSummary" maxlength="2000"><%= projectExecution.riskSummary || '' %></textarea></label><button type="submit"><%= zh ? '保存项目计划' : 'Save project plan' %></button></form></details><% } %></section>
  <% if(projectExecution.signedContractAttachmentId){ %><section class="panel"><h2><%= zh?'签署合同与启动记录':'Signed contract and project start' %></h2><p><%= zh?'销售从合同栏推送项目执行。推送人：':'Pushed from the Opportunity contract section by: ' %><strong><%= projectExecution.confirmedByDisplayName %></strong> · <%= stamp(projectExecution.createdAt) %></p><a href="/project-executions/<%= projectExecution.id %>/signed-contract"><%= zh?'查看双方签署合同':'View mutually signed contract' %></a></section><% } %>
  <%- include('_department-plan.html', {zh}) %>
  <% if(projectExecution.projectOwnerUserId){ %><details class="panel"><summary><%= zh?'技术方案受控流程（按需配置）':'Controlled technical workflow (optional configuration)' %></summary><%- include('_workflow-setup.html', {zh}) %></details><% } %>
  <section class="panel" id="contract-kickoff">
    <h2><%= zh ? '合同执行启动 · 前期图纸发布流程' : 'Contract kickoff · Drawing release flow' %></h2>
    <p class="muted"><%= zh ? '此处聚焦图纸与技术文件从技术评估至批准发布的过程；采购、生产和交付节点在后续执行阶段管理。' : 'This section focuses on the drawing and technical-document flow from assessment through approved release; procurement, production and delivery are managed later.' %></p>
    <div class="kickoff-flow">
      <div class="kickoff-step"><strong><span class="step-no">1</span><%= zh ? '合同执行首次会议' : 'Kickoff meeting' %></strong><p class="muted"><%= zh ? '参与人' : 'Participants' %></p><p><%= zh ? '销售负责人：' : 'Sales: ' %><%= salesOwner?.displayName || '—' %><br><%= zh ? '技术负责人：' : 'Technical: ' %><%= technicalResponsible?.displayName || '—' %><br><%= zh ? '项目执行人：' : 'Project execution: ' %><%= projectOwner?.displayName || '—' %></p></div>
      <div class="kickoff-step"><strong><span class="step-no">2</span><%= zh ? '首次技术评估' : 'Initial technical assessment' %></strong><p class="muted"><%= zh ? '输出：图纸/技术文件输入' : 'Output: drawing/document inputs' %></p><p><%= technicalResponsible?.displayName || '—' %></p></div>
      <div class="kickoff-step"><strong><span class="step-no">3</span><%= zh ? '图纸/技术文件提交评审' : 'Submit drawings/documents for review' %></strong><p class="muted"><%= zh ? '提交人：技术负责人' : 'Submitter: Technical owner' %></p><p><%= technicalResponsible?.displayName || '—' %></p></div>
      <div class="kickoff-step"><strong><span class="step-no">4</span><%= zh ? '图纸/技术文件批准发布' : 'Approve and release drawings/documents' %></strong><p class="muted"><%= zh ? '批准人：技术经理' : 'Approver: Technical manager' %></p><p><%= technicalApprover?.displayName || '—' %></p></div>
    </div>
  </section>
  <section class="panel" id="gantt">
    <h2><%= zh ? '项目甘特图' : 'Project Gantt' %></h2>
    <% if (ganttItems.length) { %>
      <div class="table-wrap"><div class="gantt">
        <div class="gantt-legend"><span><i class="milestone"></i><%= zh ? '里程碑' : 'Milestone' %></span><span><i class="work"></i><%= zh ? '工作包' : 'Work package' %></span><span>↳ <%= zh ? '前置关系' : 'Predecessor' %></span></div>
        <div class="gantt-dates"><span><%= new Date(ganttStart).toISOString().slice(0, 10) %></span><span><%= new Date(ganttEnd).toISOString().slice(0, 10) %></span></div>
        <div class="gantt-body" style="height:<%= ganttHeight %>px">
          <svg class="gantt-dependencies" viewBox="0 0 1000 <%= ganttHeight %>" preserveAspectRatio="none" aria-label="<%= zh ? '前置关系连线' : 'Predecessor connections' %>"><defs><marker id="gantt-arrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="#6b8b86"></path></marker></defs><% for (const item of ganttItems) { if (item.predecessorIndex >= 0) { const predecessor = ganttItems[item.predecessorIndex]; %><path d="M <%= ganttCoordinate(predecessor.end) %> <%= ganttY(predecessor.index) %> V <%= ganttY(item.index) %> H <%= Math.max(0, ganttCoordinate(item.start) - 7) %>" fill="none" stroke="#6b8b86" stroke-width="1.5" marker-end="url(#gantt-arrow)"></path><% } } %></svg>
          <% for (const item of ganttItems) { %>
            <div class="gantt-row"><span class="gantt-row-label"><strong><%= item.title %></strong><% if (item.predecessorTitle) { %><span class="gantt-predecessor">← <%= item.predecessorTitle %></span><% } %><br><small><%= item.start %><%= item.end !== item.start ? ` — ${item.end}` : '' %></small></span><div class="gantt-track"><span class="gantt-bar <%= item.kind === 'milestone' ? 'milestone' : '' %>" style="left:<%= ganttPosition(item.start) %>%;width:<%= ganttWidth(item) %>%;"></span></div></div>
          <% } %>
        </div>
      </div></div>
    <% } else { %><p class="muted"><%= zh ? '尚未有可展示的排期。' : 'No scheduled items to display yet.' %></p><% } %>
  </section>
  <section class="panel" id="milestones"><h2><%= zh ? '交付里程碑' : 'Delivery milestones' %></h2><div class="table-wrap"><table><thead><tr><th><%= zh ? '里程碑' : 'Milestone' %></th><th><%= zh ? '计划' : 'Planned' %></th><th><%= zh ? '实际' : 'Actual' %></th><th><%= zh ? '负责人' : 'Responsible' %></th><th><%= zh ? '状态' : 'Status' %></th><th><%= zh ? '说明' : 'Note' %></th></tr></thead><tbody><% for (const item of milestones) { %><tr><td><%= item.title %></td><td><%= item.plannedOn %></td><td><%= item.actualOn || '—' %></td><td><%= item.responsibleDisplayName || '—' %></td><td><%= label(item.status) %></td><td><%= item.note || '—' %></td></tr><% } %><% if (!milestones.length) { %><tr><td colspan="6" class="muted"><%= zh ? '尚未添加里程碑。' : 'No milestones yet.' %></td></tr><% } %></tbody></table></div>
  <% if (canManage) { %><form method="post" action="/project-executions/<%= projectExecution.id %>/milestones" class="form-grid"><%- csrfField() %><label><%= zh ? '名称' : 'Title' %><input name="title" maxlength="200" required></label><label><%= zh ? '类型' : 'Type' %><select name="milestoneType"><option value="design_release"><%= zh ? '设计发布' : 'Design release' %></option><option value="production_readiness"><%= zh ? '生产准备' : 'Production readiness' %></option><option value="inspection"><%= zh ? '检验' : 'Inspection' %></option><option value="shipment"><%= zh ? '发货' : 'Shipment' %></option><option value="delivery"><%= zh ? '交付' : 'Delivery' %></option><option value="acceptance"><%= zh ? '验收' : 'Acceptance' %></option></select></label><label><%= zh ? '计划日期' : 'Planned date' %><input type="date" name="plannedOn" required></label><label><%= zh ? '责任人' : 'Responsible' %><select name="responsibleUserId"><option value=""><%= zh ? '未指定' : 'Unassigned' %></option><% for (const user of users) { %><option value="<%= user.id %>"><%= user.displayName %></option><% } %></select></label><label><%= zh ? '状态' : 'Status' %><select name="status"><option value="not_started"><%= label('not_started') %></option><option value="in_progress"><%= label('in_progress') %></option><option value="blocked"><%= label('blocked') %></option></select></label><label><%= zh ? '说明' : 'Note' %><input name="note" maxlength="2000"></label><button type="submit"><%= zh ? '新增里程碑' : 'Add milestone' %></button></form><% } %></section>
  <section class="panel" id="work-packages">
    <h2><%= zh ? '工作包' : 'Work packages' %></h2>
    <p class="muted"><%= zh ? '负责人、计划开始/完成、实际完成和受阻原因均为项目留痕及绩效基础数据。' : 'Owner, planned dates, actual completion and blockers are retained as project and performance-source facts.' %></p>
    <div class="table-wrap"><table><thead><tr><th><%= zh ? '工作包' : 'Work package' %></th><th><%= zh ? '负责人' : 'Responsible' %></th><th><%= zh ? '计划开始' : 'Planned start' %></th><th><%= zh ? '计划完成' : 'Planned completion' %></th><th><%= zh ? '实际完成' : 'Actual completion' %></th><th><%= zh ? '状态' : 'Status' %></th><th><%= zh ? '受阻原因' : 'Blocker reason' %></th><th><%= zh ? '更新 / 验收' : 'Update / accept' %></th></tr></thead><tbody><% for (const item of workPackages) { const mayUpdate = canManage || Number(item.responsibleUserId) === Number(currentUser.id); %><tr><td><strong><%= item.title %></strong><br><small><%= item.instruction || '' %></small></td><td><%= item.responsibleDisplayName %></td><td><%= item.plannedStartOn || '—' %></td><td><%= item.dueOn || '—' %></td><td><%= item.completedOn || '—' %></td><td><%= label(item.status) %></td><td class="blocker"><%= item.blockerNote || '—' %></td><td class="package-actions"><% if (mayUpdate) { %><form method="post" action="/project-executions/<%= projectExecution.id %>/work-packages/<%= item.id %>"><%- csrfField() %><% if (canManage) { %><select name="responsibleUserId"><% for (const user of users) { %><option value="<%= user.id %>" <%= Number(item.responsibleUserId) === Number(user.id) ? 'selected' : '' %>><%= user.displayName %></option><% } %></select><input name="plannedStartOn" type="date" value="<%= item.plannedStartOn || '' %>"><input name="dueOn" type="date" value="<%= item.dueOn || '' %>"><% } %><select name="status"><% for (const value of (canManage ? ['not_started','in_progress','blocked','pending_acceptance','completed','cancelled'] : ['in_progress','blocked','pending_acceptance'])) { %><option value="<%= value %>" <%= item.status === value ? 'selected' : '' %>><%= label(value) %></option><% } %></select><input name="blockerNote" value="<%= item.blockerNote || '' %>" maxlength="2000" placeholder="<%= zh ? '受阻原因' : 'Blocker reason' %>"><input name="acceptanceNote" value="<%= item.acceptanceNote || '' %>" maxlength="2000" placeholder="<%= zh ? '验收说明' : 'Acceptance note' %>"><button type="submit"><%= canManage ? (zh ? '保存 / 验收' : 'Save / accept') : (zh ? '更新' : 'Update') %></button></form><% } else { %>—<% } %></td></tr><% } %><% if (!workPackages.length) { %><tr><td colspan="8" class="muted"><%= zh ? '尚未新增工作包。' : 'No work packages yet.' %></td></tr><% } %></tbody></table></div>
    <% if (canManage) { %><form method="post" action="/project-executions/<%= projectExecution.id %>/work-packages" class="form-grid"><%- csrfField() %><label><%= zh ? '工作包' : 'Work package' %><input name="title" maxlength="200" required></label><label><%= zh ? '负责人' : 'Responsible' %><select name="responsibleUserId" required><option value=""><%= zh ? '请选择' : 'Choose' %></option><% for (const user of users) { %><option value="<%= user.id %>"><%= user.displayName %></option><% } %></select></label><label><%= zh ? '计划开始' : 'Planned start' %><input type="date" name="plannedStartOn"></label><label><%= zh ? '计划完成' : 'Planned completion' %><input type="date" name="dueOn"></label><label style="grid-column:1/-1"><%= zh ? '工作说明' : 'Instruction' %><textarea name="instruction" maxlength="2000"></textarea></label><button type="submit"><%= zh ? '新增工作包' : 'Add work package' %></button></form><% } %>
  </section>
  <div class="workflow-grid" id="release-workflow">
    <section class="panel"><h2><%= zh ? '技术方案至批准发布工作流' : 'Technical solution to release workflow' %></h2><% if (releaseWorkflow) { const actionByStatus = { technical_solution_pending: ['submit_technical_solution', releaseWorkflow.projectEngineerUserId, zh ? '提交技术方案' : 'Submit technical solution', true], manufacturing_process_pending: ['submit_manufacturing_process', releaseWorkflow.processEngineerUserId, zh ? '提交制造工艺方案' : 'Submit manufacturing process', true], technical_review_pending: ['complete_technical_review', releaseWorkflow.technicalManagerUserId, zh ? '完成技术经理评审' : 'Complete technical review', false], approval_pending: ['approve_release', releaseWorkflow.approverUserId, zh ? '批准发布' : 'Approve release', false], release_pending: ['publish_release', releaseWorkflow.publisherUserId, zh ? '发布到项目执行' : 'Publish to project execution', false] }; const availableAction = actionByStatus[releaseWorkflow.status]; %><p><strong><%= zh ? '当前阶段：' : 'Current stage: ' %></strong><%= workflowLabel(releaseWorkflow.status) %></p><ol class="workflow-steps"><li><strong><%= zh ? '项目工程师：' : 'Project engineer: ' %><%= releaseWorkflow.projectEngineerDisplayName %></strong><small><%= zh ? '提交技术方案' : 'Submits technical solution' %><%= releaseWorkflow.technicalSolutionVersion ? ` · ${releaseWorkflow.technicalSolutionVersion}` : '' %></small></li><li><strong><%= zh ? '制造工艺工程师：' : 'Manufacturing process engineer: ' %><%= releaseWorkflow.processEngineerDisplayName %></strong><small><%= zh ? '提交制造工艺方案' : 'Submits manufacturing process plan' %><%= releaseWorkflow.manufacturingProcessVersion ? ` · ${releaseWorkflow.manufacturingProcessVersion}` : '' %></small></li><li><strong><%= zh ? '技术经理：' : 'Technical manager: ' %><%= releaseWorkflow.technicalManagerDisplayName %></strong><small><%= zh ? '评审' : 'Reviews' %></small></li><li><strong><%= zh ? '批准人：' : 'Approver: ' %><%= releaseWorkflow.approverDisplayName %></strong><small><%= zh ? '批准' : 'Approves' %></small></li><li><strong><%= zh ? '发布责任人：' : 'Release publisher: ' %><%= releaseWorkflow.publisherDisplayName %></strong><small><%= zh ? '发布到项目执行' : 'Publishes to project execution' %></small></li></ol><% if (availableAction && Number(availableAction[1]) === Number(currentUser.id)) { %><form method="post" action="/project-executions/<%= projectExecution.id %>/release-workflow" class="form-grid"><%- csrfField() %><input type="hidden" name="action" value="<%= availableAction[0] %>"><% if (availableAction[3]) { %><label><%= zh ? '版本' : 'Version' %><input name="version" maxlength="100" required></label><% } %><label><%= zh ? '说明' : 'Note' %><input name="note" maxlength="2000"></label><button type="submit"><%= availableAction[2] %></button></form><% } %><% } else { %><p class="muted"><%= zh ? '总经理可按需要配置技术方案受控流程。' : 'The General Manager can configure the controlled technical workflow if needed.' %></p><% } %></section>
    <aside class="panel"><h2><%= zh ? '绩效基础数据' : 'Performance source data' %></h2><p class="muted"><%= zh ? '系统保留工作包负责人、计划/实际日期、受阻原因、提交/评审/批准/发布时间及版本。绩效口径另行配置，原始留痕不允许在此修改。' : 'The system retains package ownership, planned/actual dates, blockers, workflow timestamps and versions. Performance formulas are configured separately; source facts are not rewritten here.' %></p></aside>
  </div>
  <section class="panel" id="audit-log"><h2><%= zh ? '操作留痕' : 'Audit trail' %></h2><div class="table-wrap"><table class="audit-table"><thead><tr><th><%= zh ? '时间' : 'Time' %></th><th><%= zh ? '人员' : 'Actor' %></th><th><%= zh ? '动作' : 'Action' %></th><th><%= zh ? '状态变化' : 'Status change' %></th><th><%= zh ? '说明 / 受阻原因' : 'Note / blocker reason' %></th></tr></thead><tbody><% for (const event of auditEvents) { %><tr><td><%= stamp(event.createdAt) %></td><td><%= event.actorDisplayName || '—' %></td><td><%= ({sales_project_started:zh?'推送项目执行':'Pushed to Project Execution',signed_contract_received:zh?'补传签署合同':'Signed contract supplement',department_plan_assigned:zh?'总经理分配任务':'General Manager assignment'}[event.eventType] || event.eventType) %></td><td><%= [event.fromStatus, event.toStatus].filter(Boolean).join(' → ') || '—' %></td><td><%= event.note || '—' %></td></tr><% } %><% if (!auditEvents.length) { %><tr><td colspan="5" class="muted"><%= zh ? '尚无操作留痕。' : 'No audit events yet.' %></td></tr><% } %></tbody></table></div></section>
</section>
<%- include('../partials/app-end') %>
