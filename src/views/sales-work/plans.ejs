<%- include('../partials/app-start', { title: `${t('workPlans')} - BESTCRM`, activeNav: 'sales-work' }) %>
        <header class="page-header">
          <div>
            <p class="breadcrumb"><%= t('salesWork') %></p>
            <h1><%= t('workPlans') %></h1>
          </div>
          <a class="quick-action" href="/sales-work/plans/new"><%= t('newPlan') %></a>
        </header>

        <section class="list-section">
          <div class="list-body">
            <table class="list-table content-fit-table">
              <thead>
                <tr>
                  <th><%= t('planDate') %></th>
                  <th><%= t('salesperson') %></th>
                  <th><%= t('customer') %></th>
                  <th><%= t('contacts') %></th>
                  <th><%= t('opportunity') %></th>
                  <th><%= t('activityType') %></th>
                  <th><%= t('subject') %></th>
                  <th><%= t('status') %></th>
                  <th><%= t('nextStep') %></th>
                  <th><%= t('actions') %></th>
                </tr>
              </thead>
              <tbody>
                <% for (const plan of plans) { %>
                  <tr>
                    <td><%= plan.planDate || '' %></td>
                    <td><%= plan.salespersonDisplayName || '' %></td>
                    <td><%= plan.customerName || '' %></td>
                    <td><%= plan.contactName || '' %></td>
                    <td><%= plan.opportunityNo ? `${plan.opportunityNo} - ${plan.opportunityTitle || ''}` : '' %></td>
                    <td><%= t(`salesActivity.${plan.activityType}`) %></td>
                    <td><%= plan.subject %></td>
                    <td><span class="status"><%= t(`salesPlanStatus.${plan.status}`) %></span></td>
                    <td><%= plan.nextStep || '' %></td>
                    <td class="actions-cell">
                      <div class="inline-actions system-actions">
                        <a class="secondary-action" href="/sales-work/plans/<%= plan.id %>/edit"><%= t('edit') %></a>
                        <% if (plan.status === 'planned') { %>
                          <form method="post" action="/sales-work/plans/<%= plan.id %>/complete">
                            <%- csrfField() %>
                            <button class="secondary-action" type="submit"><%= t('complete') %></button>
                          </form>
                          <form method="post" action="/sales-work/plans/<%= plan.id %>/cancel">
                            <%- csrfField() %>
                            <button class="danger-action" type="submit"><%= t('cancel') %></button>
                          </form>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
            <% if (!plans.length) { %>
              <p class="empty"><%= t('noSalesWorkPlans') %></p>
            <% } %>
          </div>
        </section>
<%- include('../partials/app-end') %>
