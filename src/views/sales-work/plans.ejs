<%- include('../partials/app-start', { title: `${t('workPlans')} - BESTCRM`, activeNav: 'sales-work' }) %>
        <p class="breadcrumb"><a href="/workbench"><%= t('workbench') %></a> / <%= t('workPlans') %></p>
        <header class="page-header">
          <h1><%= t('workPlans') %></h1>
          <a class="quick-action" href="/sales-work/plans/new"><%= t('newPlan') %></a>
        </header>
        <%- include('../workbench/_shortcut-nav', { canAccessSalesPlans: true, activeShortcut: 'plan' }) %>

        <section class="work-plan-list" aria-label="<%= t('workPlans') %>">
          <% if (!plans.length) { %><p class="list-section empty"><%= t('noSalesWorkPlans') %></p><% } %>
          <% for (const plan of plans) { %>
            <article class="work-plan-row">
              <div class="work-plan-row-main">
                <div class="work-plan-row-eyebrow">
                  <time><%= plan.planDate || '—' %></time>
                  <span class="status"><%= t(`salesPlanStatus.${plan.status}`) %></span>
                </div>
                <h2><a href="/sales-work/plans/<%= plan.id %>"><%= plan.subject %></a></h2>
                <p class="muted"><%= t(`salesActivity.${plan.activityType}`) %><% if (plan.customerName) { %> · <%= plan.customerName %><% } %><% if (plan.opportunityNo) { %> · <%= plan.opportunityNo %> - <%= plan.opportunityTitle || '' %><% } %></p>
                <% if (plan.objective) { %><p><%= plan.objective %></p><% } %>
              </div>
              <a class="secondary-action work-plan-row-open" href="/sales-work/plans/<%= plan.id %>"><%= t('view') %> <span aria-hidden="true">→</span></a>
            </article>
          <% } %>
        </section>
<%- include('../partials/app-end') %>
