<%- include('../partials/app-start', { title: `${mode === 'new' ? 'New Approval Setting' : 'Edit Approval Setting'} - BESTCRM`, activeNav: 'system-approval-settings' }) %>
        <p class="breadcrumb"><a href="/system/approval-settings">Approval Settings</a> / <%= mode === 'new' ? 'New Approval Setting' : 'Edit Approval Setting' %></p>
        <header class="page-header">
          <h1><%= mode === 'new' ? 'New Approval Setting' : 'Edit Approval Setting' %></h1>
        </header>

        <form class="form-panel" method="post" action="<%= action %>">
          <label>
            Workflow stage
            <select name="settingKey" required>
              <% for (const option of stageOptions) { %>
                <option value="<%= option.key %>" <%= setting.settingKey === option.key ? 'selected' : '' %>><%= option.stage %></option>
              <% } %>
            </select>
          </label>

          <label>
            Approval role
            <select name="roleCode" required>
              <% for (const role of roles) { %>
                <option value="<%= role.code %>" <%= setting.roleCode === role.code ? 'selected' : '' %>><%= role.name %> (<%= role.code %>)</option>
              <% } %>
            </select>
          </label>

          <label>
            Approver
            <select name="userId" required>
              <% for (const user of users) { %>
                <option value="<%= user.id %>" <%= Number(setting.userId) === Number(user.id) ? 'selected' : '' %>><%= user.displayName %> (<%= user.username %>)</option>
              <% } %>
            </select>
          </label>

          <label>
            Sort order
            <input name="sortOrder" type="number" min="1" step="1" value="<%= setting.sortOrder || 1 %>" required>
          </label>

          <label class="checkbox-row">
            <input name="isActive" type="checkbox" <%= setting.isActive ? 'checked' : '' %>>
            <span>Active approval setting</span>
          </label>

          <div class="inline-actions">
            <button type="submit"><%= mode === 'new' ? 'Create setting' : 'Save setting' %></button>
            <a class="secondary-action" href="/system/approval-settings">Cancel</a>
          </div>
        </form>
<%- include('../partials/app-end') %>
