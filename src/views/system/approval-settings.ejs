<%- include('../partials/app-start', { title: 'Approval Settings - BESTCRM', activeNav: 'system-approval-settings' }) %>
        <header class="page-header">
          <div>
            <h1>Approval Settings</h1>
            <div class="muted">Maintain configured approvers by workflow stage.</div>
          </div>
          <% if (canManageSettings) { %>
            <a class="quick-action" href="/system/approval-settings/new">New setting</a>
          <% } %>
        </header>

        <section class="list-section">
          <div class="list-body">
            <table class="list-table content-fit-table">
              <thead>
                <tr>
                  <th>Stage</th>
                  <th>Role</th>
                  <th>Approver</th>
                  <th>Sort</th>
                  <th>Status</th>
                  <% if (canManageSettings) { %>
                    <th>Actions</th>
                  <% } %>
                </tr>
              </thead>
              <tbody>
                <% for (const setting of settings) { %>
                  <tr>
                    <td><%= setting.stage %></td>
                    <td><%= setting.roleName %> <span class="muted">(<%= setting.roleCode %>)</span></td>
                    <td><%= setting.userDisplayName %> <span class="muted">(<%= setting.username %>)</span></td>
                    <td><%= setting.sortOrder %></td>
                    <td><span class="status"><%= setting.isActive ? 'active' : 'inactive' %></span></td>
                    <% if (canManageSettings) { %>
                      <td>
                        <div class="inline-actions">
                          <a class="secondary-action" href="/system/approval-settings/<%= setting.id %>/edit">Edit</a>
                          <% if (setting.isActive) { %>
                            <form method="post" action="/system/approval-settings/<%= setting.id %>/delete">
                              <button class="danger-action" type="submit">Delete</button>
                            </form>
                          <% } %>
                        </div>
                      </td>
                    <% } %>
                  </tr>
                <% } %>
                <% if (!settings.length) { %>
                  <tr>
                    <td colspan="<%= canManageSettings ? 6 : 5 %>" class="empty">No approval settings configured.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
<%- include('../partials/app-end') %>
