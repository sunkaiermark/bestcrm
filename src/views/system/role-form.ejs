<%- include('../partials/app-start', { title: `${mode === 'new' ? t('newRole') : t('editRole')} - BESTCRM`, activeNav: 'system-roles' }) %>
        <p class="breadcrumb"><a href="/system/roles"><%= t('systemRoles') %></a> / <%= mode === 'new' ? t('newRole') : t('edit') %></p>
        <header class="page-header">
          <h1><%= mode === 'new' ? t('newRole') : t('editRole') %></h1>
        </header>

        <form class="form-panel" method="post" action="<%= action %>">
          <%- csrfField() %>
          <% if (mode === 'new') { %>
            <label>
              <%= t('roleCode') %>
              <input name="code" value="<%= role.code || '' %>" required pattern="[a-z][a-z0-9_]*">
            </label>
          <% } else { %>
            <label>
              <%= t('roleCode') %>
              <input value="<%= role.code %>" disabled>
            </label>
          <% } %>

          <label>
            <%= t('roleName') %>
            <input name="name" value="<%= role.name || '' %>" required>
          </label>
          <label>
            <%= t('description') %>
            <textarea name="description"><%= role.description || '' %></textarea>
          </label>

          <label class="checkbox-row">
            <input name="isActive" type="checkbox" <%= role.isActive ? 'checked' : '' %>>
            <span><%= t('activeRole') %></span>
          </label>

          <div class="inline-actions">
            <button type="submit"><%= mode === 'new' ? t('createRole') : t('saveRole') %></button>
            <a class="secondary-action" href="/system/roles"><%= t('cancel') %></a>
          </div>
        </form>
<%- include('../partials/app-end') %>
