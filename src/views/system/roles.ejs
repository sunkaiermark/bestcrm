<%- include('../partials/app-start', { title: 'System Roles - BESTCRM', activeNav: 'system-roles' }) %>
        <header class="page-header">
          <div>
            <h1>System Roles</h1>
            <div class="muted">Role definitions used by opportunity workflow permissions.</div>
          </div>
          <% if (canManageRoles) { %>
            <a class="quick-action" href="/system/roles/new">New role</a>
          <% } %>
        </header>

        <section class="list-section">
          <div class="list-body">
            <table class="list-table content-fit-table">
              <thead>
                <tr>
                  <th>Role</th>
                  <th>Code</th>
                  <th>Description</th>
                  <th>Status</th>
                  <% if (canManageRoles) { %>
                    <th>Actions</th>
                  <% } %>
                </tr>
              </thead>
              <tbody>
                <% for (const role of roles) { %>
                  <tr>
                    <td><%= role.name %></td>
                    <td><%= role.code %></td>
                    <td><%= role.description || '-' %></td>
                    <td><span class="status"><%= role.isActive ? 'active' : 'inactive' %></span></td>
                    <% if (canManageRoles) { %>
                      <td class="actions-cell">
                        <div class="inline-actions system-actions">
                          <a class="secondary-action" href="/system/roles/<%= role.id %>/edit">Edit</a>
                          <% if (role.isActive) { %>
                            <form method="post" action="/system/roles/<%= role.id %>/delete">
                              <button class="danger-action" type="submit">Delete</button>
                            </form>
                          <% } %>
                        </div>
                      </td>
                    <% } %>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
<%- include('../partials/app-end') %>
