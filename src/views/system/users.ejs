<%- include('../partials/app-start', { title: `${t('systemUsers')} - BESTCRM`, activeNav: 'system-users' }) %>
        <header class="page-header">
          <div>
            <h1><%= t('systemUsers') %></h1>
            <div class="muted"><%= t('systemUsersDescription') %></div>
          </div>
          <% if (canManageUsers) { %>
            <a class="quick-action" href="/system/users/new"><%= t('newUser') %></a>
          <% } %>
        </header>

        <section class="list-section">
          <div class="list-body">
            <table class="list-table content-fit-table">
              <thead>
                <tr>
                  <th><%= t('user') %></th>
                  <th><%= t('username') %></th>
                  <th><%= t('roles') %></th>
                  <th><%= t('email') %></th>
                  <th><%= t('phone') %></th>
                  <th><%= t('status') %></th>
                  <% if (canManageUsers) { %>
                    <th><%= t('actions') %></th>
                  <% } %>
                </tr>
              </thead>
              <tbody>
                <% for (const user of users) { %>
                  <tr>
                    <td><%= user.displayName %></td>
                    <td><%= user.username %></td>
                    <td>
                      <div class="role-list">
                        <% for (const role of user.roles) { %>
                          <div class="role-list-item"><%= role %></div>
                        <% } %>
                      </div>
                    </td>
                    <td><%= user.email || '-' %></td>
                    <td><%= user.phone || '-' %></td>
                    <td><span class="status"><%= user.isActive ? t('active') : t('inactive') %></span></td>
                    <% if (canManageUsers) { %>
                      <td class="actions-cell">
                        <div class="inline-actions system-actions">
                          <a class="secondary-action" href="/system/users/<%= user.id %>/edit"><%= t('edit') %></a>
                          <% if (user.isActive) { %>
                            <form method="post" action="/system/users/<%= user.id %>/delete" onsubmit="return confirm('<%= t('deleteUserConfirm') %>')">
                              <%- csrfField() %>
                              <button class="danger-action" type="submit"><%= t('delete') %></button>
                            </form>
                          <% } %>
                        </div>
                      </td>
                    <% } %>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
<%- include('../partials/app-end') %>
