<%- include('../partials/app-start', { title: `${t('systemUsers')} - BESTCRM`, activeNav: 'system-users', mainClass: 'system-users-page' }) %>
        <link rel="stylesheet" href="/assets/system-users.css">
        <header class="page-header">
          <div>
            <h1><%= t('systemUsers') %></h1>
          </div>
          <% if (canManageUsers) { %>
            <a class="quick-action" href="/system/users/new"><%= t('newUser') %></a>
          <% } %>
        </header>

        <% if (notice) { %><p class="success-text" role="status"><%= notice %></p><% } %>

        <section class="list-section">
          <div class="list-body">
            <table class="list-table system-users-table">
              <thead>
                <tr>
                  <th><%= t('user') %></th>
                  <th><%= t('username') %></th>
                  <th><%= t('roles') %></th>
                  <th><%= t('email') %></th>
                  <th><%= t('personalCrmMailbox') %></th>
                  <th><%= t('phone') %></th>
                  <th><%= t('status') %></th>
                  <th><%= t('multiFactorAuthentication') %></th>
                  <% if (canManageUsers) { %>
                    <th><%= t('actions') %></th>
                  <% } %>
                </tr>
              </thead>
              <tbody>
                <% for (const user of users) { %>
                  <tr>
                    <td data-label="<%= t('user') %>"><span class="system-user-value" title="<%= user.displayName %>"><%= user.displayName %></span></td>
                    <td data-label="<%= t('username') %>"><span class="system-user-value" title="<%= user.username %>"><%= user.username %></span></td>
                    <td data-label="<%= t('roles') %>">
                      <div class="role-list" title="<%= user.roles.join(', ') %>">
                        <% for (const role of user.roles) { %>
                          <div class="role-list-item" title="<%= role %>"><%= role %></div>
                        <% } %>
                      </div>
                    </td>
                    <td data-label="<%= t('email') %>"><span class="system-user-value" title="<%= user.email || '-' %>"><%= user.email || '-' %></span></td>
                    <td data-label="<%= t('personalCrmMailbox') %>"><span class="system-user-value" title="<%= user.personalMailboxAddress || '-' %>"><%= user.personalMailboxAddress || '-' %></span></td>
                    <td data-label="<%= t('phone') %>"><span class="system-user-value" title="<%= user.phone || '-' %>"><%= user.phone || '-' %></span></td>
                    <td data-label="<%= t('status') %>"><span class="status"><%= user.isActive ? t('active') : t('inactive') %></span></td>
                    <td data-label="<%= t('multiFactorAuthentication') %>"><div class="system-security-inline">
                      <% if (authenticatorMfaEnabled) { %>
                        <span class="status"><%= t(`adminMfaStatus.${user.mfa.status}`) %></span>
                        <% if (user.mfa.isRequired) { %><div class="muted"><%= t('mfaRequired') %></div><% } %>
                      <% } else { %>
                        <span class="muted" title="<%= t('authenticatorFeatureDisabledAdmin') %>"><%= language === 'zh' ? '未启用' : 'Disabled' %></span>
                      <% } %>
                      <a class="secondary-action" href="/system/users/<%= user.id %>/security" title="<%= t('manageSecurity') %>"><%= t('manageSecurity') %></a></div>
                    </td>
                    <% if (canManageUsers) { %>
                      <td class="actions-cell" data-label="<%= t('actions') %>">
                        <div class="inline-actions system-actions">
                          <a class="secondary-action" href="/system/users/<%= user.id %>/edit" title="<%= t('edit') %>"><%= t('edit') %></a>
                          <form method="post" action="/system/users/<%= user.id %>/reset-password" onsubmit="const password = prompt('<%= t('resetPasswordPrompt') %>'); if (!password) return false; this.elements.password.value = password; return confirm('<%= t('resetPasswordConfirm') %>');">
                            <%- csrfField() %>
                            <input name="password" type="hidden">
                            <button class="secondary-action" type="submit" title="<%= t('resetPassword') %>"><%= t('resetPassword') %></button>
                          </form>
                          <% if (user.login.isLocked) { %>
                            <form method="post" action="/system/users/<%= user.id %>/unlock-login" onsubmit="return confirm('<%= t('unlockLoginConfirm') %>')">
                              <%- csrfField() %>
                              <button class="secondary-action" type="submit" title="<%= t('unlockLogin') %>"><%= t('unlockLogin') %></button>
                            </form>
                          <% } else { %>
                            <span class="status"><%= t('loginUnlocked') %></span>
                          <% } %>
                          <% if (user.isActive) { %>
                            <form method="post" action="/system/users/<%= user.id %>/delete" onsubmit="return confirm('<%= t('deleteUserConfirm') %>')">
                              <%- csrfField() %>
                              <button class="danger-action" type="submit" title="<%= t('delete') %>"><%= t('delete') %></button>
                            </form>
                          <% } %>
                        </div>
                      </td>
                    <% } %>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
<%- include('../partials/app-end') %>
