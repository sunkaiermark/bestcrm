<%- include('../partials/app-start', { title: 'System Users - BESTCRM', activeNav: 'system-users' }) %>
        <header class="page-header">
          <div>
            <h1>System Users</h1>
            <div class="muted">Internal login accounts and assigned roles.</div>
          </div>
          <% if (canManageUsers) { %>
            <a class="quick-action" href="/system/users/new">New user</a>
          <% } %>
        </header>

        <section class="list-section">
          <div class="list-body">
            <table class="list-table content-fit-table">
              <thead>
                <tr>
                  <th>User</th>
                  <th>Username</th>
                  <th>Roles</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Status</th>
                  <% if (canManageUsers) { %>
                    <th>Actions</th>
                  <% } %>
                </tr>
              </thead>
              <tbody>
                <% for (const user of users) { %>
                  <tr>
                    <td><%= user.displayName %></td>
                    <td><%= user.username %></td>
                    <td>
                      <div class="role-list">
                        <% for (const role of user.roles) { %>
                          <div class="role-list-item"><%= role %></div>
                        <% } %>
                      </div>
                    </td>
                    <td><%= user.email || '-' %></td>
                    <td><%= user.phone || '-' %></td>
                    <td><span class="status"><%= user.isActive ? 'active' : 'inactive' %></span></td>
                    <% if (canManageUsers) { %>
                      <td class="actions-cell">
                        <div class="inline-actions system-actions">
                          <a class="secondary-action" href="/system/users/<%= user.id %>/edit">Edit</a>
                          <% if (user.isActive) { %>
                            <form method="post" action="/system/users/<%= user.id %>/delete" onsubmit="return confirm('Delete this user?')">
                              <button class="danger-action" type="submit">Delete</button>
                            </form>
                          <% } %>
                        </div>
                      </td>
                    <% } %>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
<%- include('../partials/app-end') %>
