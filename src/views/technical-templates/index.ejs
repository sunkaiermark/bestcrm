<%- include('../partials/app-start', { title: `${t('technicalTemplateLibrary')} - BESTCRM`, activeNav: 'technical-templates' }) %>
        <header class="page-header">
          <div>
            <h1><%= t('technicalTemplateLibrary') %></h1>
            <div class="muted"><%= t('technicalTemplateLibraryDescription') %></div>
          </div>
          <div class="inline-actions">
            <% if (canManageVariables) { %>
              <a class="secondary-action" href="/technical-templates/variables"><%= t('variableCatalog') %></a>
            <% } %>
            <% if (canAuthor) { %>
              <a class="quick-action" href="/technical-templates/new"><%= t('newTechnicalTemplate') %></a>
            <% } %>
          </div>
        </header>

        <section class="form-panel">
          <strong><%= canAuthor ? t('technicalManagerPublishingNotice') : t('onlyPublishedForProjects') %></strong>
        </section>

        <section class="list-section">
          <div class="list-heading">
            <div><h2><%= t('technicalTemplateMatrix') %></h2><div class="muted"><%= t('technicalTemplateMatrixDescription') %></div></div>
          </div>
          <div class="list-body">
            <table class="list-table content-fit-table">
              <thead><tr><th><%= t('productCategory') %></th><% for (const type of documentTypes) { %><th><%= t(`technicalDocumentType.${type.value}`) %></th><% } %></tr></thead>
              <tbody>
                <% for (const category of productCategories) { %>
                  <tr>
                    <td><strong><%= language === 'zh' ? category.labelZh : `${category.labelEn} / ${category.labelZh}` %></strong></td>
                    <% for (const type of documentTypes) { const slot = templates.find((template) => template.documentType === type.value && template.productCategoryCode === category.code && template.isActive); %>
                      <td>
                        <% if (slot) { %><a href="/technical-templates/<%= slot.id %>"><%= slot.templateCode %> · <%= slot.currentRevisionLabel || t('templateStatus.draft') %></a><% } else { %><span class="muted"><%= t('templateSlotEmpty') %></span><% } %>
                      </td>
                    <% } %>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>

        <section class="list-section">
          <div class="list-body">
            <table class="list-table content-fit-table">
              <thead>
                <tr>
                  <th><%= t('templateCode') %></th>
                  <th><%= t('templateName') %></th>
                  <th><%= t('technicalDocumentType') %></th>
                  <th><%= t('productCategory') %></th>
                  <th><%= t('productModel') %></th>
                  <th><%= t('application') %></th>
                  <th><%= t('outputLanguage') %></th>
                  <th><%= t('templateCurrentRevision') %></th>
                  <th><%= t('status') %></th>
                  <th><%= t('actions') %></th>
                </tr>
              </thead>
              <tbody>
                <% for (const template of templates) { %>
                  <tr>
                    <td><strong><%= template.templateCode %></strong></td>
                    <td><%= template.name %></td>
                    <td><%= t(`technicalDocumentType.${template.documentType || 'technical_agreement'}`) %></td>
                    <td><%= template.productCategoryCode ? t(`technicalProductCategory.${template.productCategoryCode}`) : template.productFamily %></td>
                    <td><%= template.productModel || '-' %></td>
                    <td><%= template.application || '-' %></td>
                    <td><%= t(`templateLanguage.${template.language}`) %></td>
                    <td><%= template.currentRevisionLabel || '-' %></td>
                    <td>
                      <span class="status"><%= template.isActive ? t('activeForNewProjects') : t('inactiveForNewProjects') %></span>
                    </td>
                    <td><a class="secondary-action" href="/technical-templates/<%= template.id %>"><%= t('openTemplate') %></a></td>
                  </tr>
                <% } %>
                <% if (!templates.length) { %>
                  <tr><td colspan="10" class="empty"><%= t('noTechnicalTemplates') %></td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
<%- include('../partials/app-end') %>
