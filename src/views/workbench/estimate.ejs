<%- include('../partials/app-start', { title: `${t('workItemEstimate')} - BESTCRM`, activeNav: 'workbench' }) %>
        <p class="breadcrumb"><a href="/workbench"><%= t('workbench') %></a> / <%= t('workItemEstimate') %></p>
        <header class="page-header">
          <div>
            <h1><%= t('workItemEstimate') %></h1>
            <div class="muted"><%= todoTitleLabel(workItem.title) %></div>
          </div>
        </header>

        <section class="detail-grid">
          <div>
            <span><%= t('relatedBusiness') %></span>
            <strong>
              <% if (workItem.opportunityId) { %>
                <a href="/opportunities/<%= workItem.opportunityId %>"><%= workItem.opportunityNo %> - <%= workItem.opportunityTitle %></a>
              <% } else { %>
                —
              <% } %>
            </strong>
          </div>
          <div><span><%= t('status') %></span><strong><%= t(`workItemStatus.${workItem.status}`) %></strong></div>
        </section>

        <form class="form-panel" method="post" action="/workbench/work-items/<%= workItem.id %>/estimate">
          <%- csrfField() %>
          <label>
            <%= t('estimatedHours') %>
            <input
              name="estimatedHours"
              type="number"
              min="0.01"
              max="10000"
              step="0.01"
              value="<%= workItem.estimatedHours ?? '' %>"
            >
          </label>
          <label>
            <%= t('workloadLevel') %>
            <select name="workloadLevel">
              <option value=""><%= t('notEstimated') %></option>
              <% for (const level of workloadLevels) { %>
                <option value="<%= level %>"<%= workItem.workloadLevel === level ? ' selected' : '' %>><%= t(`workloadLevel.${level}`) %></option>
              <% } %>
            </select>
          </label>
          <p class="muted"><%= t('workloadEstimateNotice') %></p>
          <div class="inline-actions">
            <button type="submit"><%= t('saveWorkEstimate') %></button>
            <a class="secondary-action" href="/workbench"><%= t('cancel') %></a>
          </div>
        </form>
<%- include('../partials/app-end') %>
