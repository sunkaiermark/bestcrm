<%- include('../partials/app-start', { title: 'Workbench - BESTCRM', activeNav: 'workbench' }) %>
        <header class="topbar">
          <div>
            <h1>Workbench</h1>
            <div class="user-line"><%= currentUser.displayName %> - <%= currentUser.roles.join(', ') %></div>
          </div>
          <a class="quick-action" href="/opportunities/new">New opportunity</a>
        </header>

        <section aria-labelledby="state-counts">
          <h2 id="state-counts" class="muted">Counts by workflow state</h2>
          <div class="state-strip">
            <% if (summary.stateCounts.length === 0) { %>
              <div class="state-item empty">No visible opportunities.</div>
            <% } %>
            <% for (const item of summary.stateCounts) { %>
              <div class="state-item">
                <span class="state-label"><%= item.status %></span>
                <span class="state-count"><%= item.count %></span>
              </div>
            <% } %>
          </div>
        </section>

        <section class="workbench-list">
          <article class="list-section">
            <h2>My pending todos</h2>
            <div class="list-body">
              <% if (summary.pendingTodos.length === 0) { %>
                <p class="empty">No pending todos.</p>
              <% } else { %>
                <table class="list-table">
                  <thead>
                    <tr>
                      <th>Todo</th>
                      <th>Opportunity</th>
                      <th>Customer</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (const todo of summary.pendingTodos) { %>
                      <tr>
                        <td><%= todo.title %></td>
                        <td><a href="/opportunities/<%= todo.opportunityId %>"><%= todo.opportunityNo %> - <%= todo.opportunityTitle %></a></td>
                        <td><%= todo.customerName %></td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              <% } %>
            </div>
          </article>

          <article class="list-section">
            <h2>Recent workflow messages</h2>
            <% if (summary.recentWorkflowMessages.length === 0) { %>
              <div class="list-body"><p class="empty">No workflow messages.</p></div>
            <% } else { %>
              <div class="list-body">
                <table class="list-table">
                  <thead>
                    <tr>
                      <th>Opportunity</th>
                      <th>Event</th>
                      <th>Actor</th>
                      <th>Comment</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (const message of summary.recentWorkflowMessages) { %>
                      <tr>
                        <td><a href="/opportunities/<%= message.opportunityId %>"><%= message.opportunityNo %> - <%= message.opportunityTitle %></a></td>
                        <td><span class="status"><%= message.eventType %></span> <span class="muted"><%= message.fromStatus || '' %> -> <%= message.toStatus || '' %></span></td>
                        <td><%= message.actorDisplayName %><% if (message.targetDisplayName) { %> to <%= message.targetDisplayName %><% } %></td>
                        <td><%= message.comment || '' %></td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </article>

          <article class="list-section">
            <h2>Opportunities I created</h2>
            <div class="list-body">
              <% if (summary.createdOpportunities.length === 0) { %>
                <p class="empty">No created opportunities.</p>
              <% } else { %>
                <table class="list-table">
                  <thead>
                    <tr>
                      <th>No.</th>
                      <th>Title</th>
                      <th>Status</th>
                      <th>Amount</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (const opportunity of summary.createdOpportunities) { %>
                      <tr>
                        <td><%= opportunity.opportunityNo %></td>
                        <td><a href="/opportunities/<%= opportunity.id %>"><%= opportunity.title %></a><br><span class="muted"><%= opportunity.customerName %></span></td>
                        <td><span class="status"><%= opportunity.status %></span></td>
                        <td><%= opportunity.estimatedAmount ?? '' %></td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              <% } %>
            </div>
          </article>

          <article class="list-section">
            <h2>Opportunities assigned to me</h2>
            <div class="list-body">
              <% if (summary.assignedOpportunities.length === 0) { %>
                <p class="empty">No assigned opportunities.</p>
              <% } else { %>
                <table class="list-table">
                  <thead>
                    <tr>
                      <th>No.</th>
                      <th>Title</th>
                      <th>Status</th>
                      <th>Amount</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (const opportunity of summary.assignedOpportunities) { %>
                      <tr>
                        <td><%= opportunity.opportunityNo %></td>
                        <td><a href="/opportunities/<%= opportunity.id %>"><%= opportunity.title %></a><br><span class="muted"><%= opportunity.customerName %></span></td>
                        <td><span class="status"><%= opportunity.status %></span></td>
                        <td><%= opportunity.estimatedAmount ?? '' %></td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              <% } %>
            </div>
          </article>
        </section>
<%- include('../partials/app-end') %>
