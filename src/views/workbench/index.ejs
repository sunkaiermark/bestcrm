<%- include('../partials/app-start', { title: `${t('workbench')} - BESTCRM`, activeNav: 'workbench' }) %>
        <% const formatWorkTime = (value) => {
          if (!value) return '\u2014';
          const date = new Date(value);
          if (Number.isNaN(date.getTime())) return String(value);
          return date.toLocaleString(language === 'zh' ? 'zh-CN' : 'en-US', {
            year: 'numeric', month: '2-digit', day: '2-digit',
            hour: '2-digit', minute: '2-digit', hour12: false
          });
        }; %>
        <% const workKpiLabel = (item) => {
          if (item.kpiTarget) return item.kpiTarget;
          const key = `workKpi.${item.kpiCode || 'complete_assigned_work'}`;
          const label = t(key);
          return label === key ? t('workKpi.complete_assigned_work') : label;
        }; %>
        <% const workStatusLabel = (status) => {
          const key = `workItemStatus.${status || 'pending'}`;
          const label = t(key);
          return label === key ? status : label;
        }; %>
        <% const businessTypeLabel = (sourceType) => {
          const keyByType = {
            workflow_event: 'businessTypeWorkflowEvent',
            opportunity: 'businessTypeOpportunity'
          };
          return keyByType[sourceType] ? t(keyByType[sourceType]) : (sourceType || t('notification'));
        }; %>
        <% const workEstimateLabel = (item) => {
          const parts = [];
          if (item.estimatedHours !== null && item.estimatedHours !== undefined) {
            const hours = Number(item.estimatedHours).toLocaleString(language === 'zh' ? 'zh-CN' : 'en-US', {
              maximumFractionDigits: 2
            });
            parts.push(`${hours} ${t('hourUnit')}`);
          }
          if (item.workloadLevel) {
            parts.push(t(`workloadLevel.${item.workloadLevel}`));
          }
          return parts.length ? parts.join(' · ') : t('notEstimated');
        }; %>
        <header class="topbar">
        <div>
          <h1><%= t('workbench') %></h1>
        </div>
        <div class="inline-actions">
          <% if (summary.canAccessSalesPlans) { %><a class="secondary-action" href="/sales-work/plans"><%= t('manageWorkPlans') %></a><% } %>
          <a class="secondary-action" href="/notifications"><%= t('notificationSettings') %><% if (summary.unreadNotificationCount) { %> (<%= summary.unreadNotificationCount %>)<% } %></a>
        </div>
        </header>

        <section aria-labelledby="state-counts">
          <h2 id="state-counts" class="muted"><%= t('countsByWorkflowState') %></h2>
          <div class="state-strip">
            <% if (summary.stateCounts.length === 0) { %>
              <div class="state-item empty"><%= t('noVisibleOpportunities') %></div>
            <% } %>
            <% for (const item of summary.stateCounts) { %>
              <div class="state-item">
                <span class="state-label"><%= statusLabel(item.status) %></span>
                <span class="state-count"><%= item.count %></span>
              </div>
            <% } %>
          </div>
        </section>

        <section class="workbench-list workbench-columns">
          <article class="list-section workbench-column workbench-column--action">
            <h2 class="workbench-column-heading"><%= t('needsMyAction') %></h2>
            <div class="list-body">
              <% if (summary.actionItems.length === 0) { %>
                <p class="empty"><%= t('noWorkItems') %></p>
              <% } else { %>
                <ol class="workbench-card-list">
                  <% for (const todo of summary.actionItems) { %>
                    <% const isOverdue = todo.dueAt && new Date(todo.dueAt).getTime() < Date.now(); %>
                    <li class="workbench-card">
                      <dl class="workbench-card-fields">
                        <div class="workbench-card-field workbench-card-field--wide">
                          <dt><%= t('relatedOpportunity') %></dt>
                          <dd>
                           <% if (todo.opportunityId) { %>
                             <a href="/opportunities/<%= todo.opportunityId %>"><%= todo.opportunityNo %> - <%= todo.opportunityTitle %></a>
                           <% } else { %>
                             <span class="muted">\u2014</span>
                           <% } %>
                          </dd>
                        </div>
                        <div class="workbench-card-field workbench-card-field--wide">
                          <dt><%= t('specificWork') %></dt>
                          <dd>
                            <span class="work-item-status<%= isOverdue ? ' overdue' : '' %>"><%= isOverdue ? t('overdue') : workStatusLabel(todo.status) %></span>
                            <strong><a href="<%= todo.actionUrl || `/opportunities/${todo.opportunityId}` %>"><%= todoTitleLabel(todo.title) %></a></strong>
                            <% if (todo.description) { %><small class="work-item-description"><%= todo.description %></small><% } %>
                          </dd>
                        </div>
                        <div class="workbench-card-field">
                          <dt><%= t('plannedStart') %></dt>
                          <dd><time datetime="<%= todo.plannedStartAt ? new Date(todo.plannedStartAt).toISOString() : '' %>"><%= formatWorkTime(todo.plannedStartAt) %></time></dd>
                        </div>
                        <div class="workbench-card-field">
                          <dt><%= t('deadline') %></dt>
                          <dd><time datetime="<%= todo.dueAt ? new Date(todo.dueAt).toISOString() : '' %>"><%= formatWorkTime(todo.dueAt) %></time></dd>
                        </div>
                        <div class="workbench-card-field workbench-card-field--wide">
                          <dt><%= t('estimatedHoursWorkload') %></dt>
                          <dd>
                            <%= workEstimateLabel(todo) %>
                            <% if (todo.estimateUrl) { %><small class="work-item-description"><a href="<%= todo.estimateUrl %>"><%= t('editWorkEstimate') %></a></small><% } %>
                          </dd>
                        </div>
                        <div class="workbench-card-field workbench-card-field--wide">
                          <dt><%= t('kpiCompletionStandard') %></dt>
                          <dd><%= workKpiLabel(todo) %></dd>
                        </div>
                      </dl>
                    </li>
                  <% } %>
                </ol>
              <% } %>
            </div>
          </article>

          <article class="list-section workbench-column workbench-column--plan">
            <h2 class="workbench-column-heading"><%= t('workPlan') %></h2>
            <div class="list-body">
              <% if (summary.workPlans.length === 0) { %>
                <p class="empty"><%= t('noWorkPlans') %></p>
              <% } else { %>
                <ol class="workbench-card-list">
                  <% for (const item of summary.workPlans) { %>
                    <li class="workbench-card">
                      <dl class="workbench-card-fields">
                        <div class="workbench-card-field workbench-card-field--wide">
                          <dt><%= t('relatedBusiness') %></dt>
                          <dd>
                           <% if (item.opportunityId) { %>
                             <a href="/opportunities/<%= item.opportunityId %>"><%= item.opportunityNo %> - <%= item.opportunityTitle %></a>
                           <% } else if (item.customerName) { %>
                             <%= item.customerName %>
                           <% } else { %>
                             <span class="muted">—</span>
                           <% } %>
                          </dd>
                        </div>
                        <div class="workbench-card-field workbench-card-field--wide">
                          <dt><%= t('specificWork') %></dt>
                          <dd>
                            <strong><a href="<%= item.actionUrl || '/workbench' %>"><%= todoTitleLabel(item.title) %></a></strong>
                            <% if (item.description) { %><small class="work-item-description"><%= item.description %></small><% } %>
                          </dd>
                        </div>
                        <div class="workbench-card-field">
                          <dt><%= t('plannedStart') %></dt>
                          <dd><%= formatWorkTime(item.plannedStartAt) %></dd>
                        </div>
                        <div class="workbench-card-field">
                          <dt><%= t('deadline') %></dt>
                          <dd><%= formatWorkTime(item.dueAt) %></dd>
                        </div>
                        <div class="workbench-card-field workbench-card-field--wide">
                          <dt><%= t('estimatedHoursWorkload') %></dt>
                          <dd>
                            <%= workEstimateLabel(item) %>
                            <% if (item.estimateUrl) { %><small class="work-item-description"><a href="<%= item.estimateUrl %>"><%= t('editWorkEstimate') %></a></small><% } %>
                          </dd>
                        </div>
                        <div class="workbench-card-field workbench-card-field--wide">
                          <dt><%= t('kpiCompletionStandard') %></dt>
                          <dd><%= workKpiLabel(item) %></dd>
                        </div>
                      </dl>
                    </li>
                  <% } %>
                </ol>
              <% } %>
            </div>
          </article>

          <article class="list-section workbench-column workbench-column--message">
            <h2 class="workbench-column-heading"><%= t('recentStatusMessages') %></h2>
            <% if (summary.statusMessages.length === 0) { %>
              <div class="list-body"><p class="empty"><%= t('noStatusMessages') %></p></div>
            <% } else { %>
              <div class="list-body">
                <ol class="workbench-card-list">
                  <% for (const message of summary.statusMessages) { %>
                    <li class="workbench-card">
                      <dl class="workbench-card-fields">
                        <div class="workbench-card-field workbench-card-field--wide">
                          <dt><%= t('relatedBusiness') %></dt>
                          <dd>
                         <% if (message.actionUrl) { %>
                            <a href="<%= message.actionUrl %>"><%= businessTypeLabel(message.sourceType) %></a>
                         <% } else { %>
                            <a href="/opportunities/<%= message.opportunityId %>"><%= message.opportunityNo %> - <%= message.opportunityTitle %></a>
                         <% } %>
                          </dd>
                        </div>
                        <div class="workbench-card-field workbench-card-field--wide">
                          <dt><%= t('statusMessage') %></dt>
                          <dd>
                            <% if (message.actionUrl) { %>
                              <strong><%= message.title %></strong><% if (message.body) { %><small class="work-item-description"><%= message.body %></small><% } %>
                            <% } else { %>
                              <span class="status"><%= workflowEventLabel(message.eventType) %></span> <span class="muted"><%= statusLabel(message.fromStatus) %> → <%= statusLabel(message.toStatus) %></span><% if (message.comment) { %><small class="work-item-description"><%= message.comment %></small><% } %>
                            <% } %>
                          </dd>
                        </div>
                        <div class="workbench-card-field workbench-card-field--wide">
                          <dt><%= t('time') %></dt>
                          <dd><%= formatWorkTime(message.createdAt) %></dd>
                        </div>
                      </dl>
                    </li>
                  <% } %>
                </ol>
              </div>
            <% } %>
          </article>

        </section>
<%- include('../partials/app-end') %>
