<%- include('../partials/app-start', { title: 'Workbench - BESTCRM', activeNav: 'workbench' }) %>
        <header class="topbar">
          <div>
            <h1><%= t('workbench') %></h1>
            <div class="user-line"><%= currentUser.displayName %> - <%= currentUser.roles.join(', ') %></div>
          </div>
        </header>

        <section aria-labelledby="state-counts">
          <h2 id="state-counts" class="muted"><%= t('countsByWorkflowState') %></h2>
          <div class="state-strip">
            <% if (summary.stateCounts.length === 0) { %>
              <div class="state-item empty"><%= t('noVisibleOpportunities') %></div>
            <% } %>
            <% for (const item of summary.stateCounts) { %>
              <div class="state-item">
                <span class="state-label"><%= statusLabel(item.status) %></span>
                <span class="state-count"><%= item.count %></span>
              </div>
            <% } %>
          </div>
        </section>

        <section class="workbench-list">
          <article class="list-section">
            <h2<% if (summary.pendingTodos.length > 0) { %> class="todo-alert-heading"<% } %>><%= t('myPendingTodos') %></h2>
            <div class="list-body">
              <% if (summary.pendingTodos.length === 0) { %>
                <p class="empty"><%= t('noPendingTodos') %></p>
              <% } else { %>
                <table class="list-table">
                  <thead>
                    <tr>
                      <th><%= t('todo') %></th>
                      <th><%= t('opportunity') %></th>
                      <th><%= t('customer') %></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (const todo of summary.pendingTodos) { %>
                      <tr>
                        <td><%= todo.title %></td>
                        <td><a href="/opportunities/<%= todo.opportunityId %>"><%= todo.opportunityNo %> - <%= todo.opportunityTitle %></a></td>
                        <td><%= todo.customerName %></td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              <% } %>
            </div>
          </article>

          <article class="list-section">
            <h2><%= t('recentWorkflowMessages') %></h2>
            <% if (summary.recentWorkflowMessages.length === 0) { %>
              <div class="list-body"><p class="empty"><%= t('noWorkflowMessages') %></p></div>
            <% } else { %>
              <div class="list-body">
                <table class="list-table">
                  <thead>
                    <tr>
                      <th><%= t('opportunity') %></th>
                      <th><%= t('event') %></th>
                      <th><%= t('actor') %></th>
                      <th><%= t('comment') %></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (const message of summary.recentWorkflowMessages) { %>
                      <tr>
                        <td><a href="/opportunities/<%= message.opportunityId %>"><%= message.opportunityNo %> - <%= message.opportunityTitle %></a></td>
                        <td><span class="status"><%= message.eventType %></span> <span class="muted"><%= message.fromStatus || '' %> -> <%= message.toStatus || '' %></span></td>
                        <td><%= message.actorDisplayName %><% if (message.targetDisplayName) { %> to <%= message.targetDisplayName %><% } %></td>
                        <td><%= message.comment || '' %></td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </article>

        </section>
<%- include('../partials/app-end') %>
